const t=[{name:"All moveable: Linear algebra proof",options:{pairs:[{column1:{content:"Let \\\\(A=[ a\\_{ij}]\\\\) and \\\\(B = [b\\_{ij}]\\\\) be real matrices with the same size. We shall prove that \\\\(A+B=B+A\\\\).",explanation:"The proof begins by defining the variables and stating the property that will be proven.",hint:"The proof begins by defining the variables and stating the property that will be proven.",moveable:!0},column2:{content:"Assumption",explanation:null,hint:null,moveable:!0},dependsOn:[]},{column1:{content:"\\\\(A + B = [ a\\_{ij}] + [b\\_{ij}] \\\\)",explanation:"The matrices are written in compact form in order to manipulate algebraically.",hint:"The next step is to define the matrices in compact form.",moveable:!0},column2:{content:"Definition of matrix \\\\(A\\\\) and matrix \\\\(B\\\\)",explanation:null,hint:null,moveable:!0},dependsOn:[0]},{column1:{content:"&amp;emsp;&amp;ensp;\\\\(= [ a\\_{ij} + b\\_{ij}]\\\\)",explanation:"Addition of matrices is performed entry by entry.",hint:"The next step is to combine the matrices entry by entry.",moveable:!0},column2:{content:"Definition of matrix addition",explanation:null,hint:null,moveable:!0},dependsOn:[1]},{column1:{content:"&amp;emsp;&amp;ensp;\\\\(= [b\\_{ij} +  a\\_{ij}]\\\\)",explanation:null,hint:null,moveable:!0},column2:{content:"Commutative property of addition of real numbers",explanation:null,hint:null,moveable:!0},dependsOn:[2]},{column1:{content:"&amp;emsp;&amp;ensp;\\\\(= [b\\_{ij}]+ [ a\\_{ij}]\\\\)",explanation:null,hint:null,moveable:!0},column2:{content:"Definition of matrix addition",explanation:null,hint:null,moveable:!0},dependsOn:[3]},{column1:{content:"&amp;emsp;&amp;ensp;\\\\(= B + A  \\\\)",explanation:"The compact form of the matrices can be rewritten using just \\\\(A\\\\) and \\\\(B\\\\).",hint:"The next step is to rewrite the matrices without using compact form.",moveable:!0},column2:{content:"Definition of matrix \\\\(A\\\\) and matrix \\\\(B\\\\)",explanation:null,hint:null,moveable:!0},dependsOn:[4]}],names:{all:"proof",column1:{header:"Statements",singular:"statement"},column2:{header:"Justifications",singular:"justification"},pair:"step"},prompt:"**Property:** Let \\\\(A\\\\) and \\\\(B\\\\) be real matrices with the same size.  Then \\\\(A+B=B+A\\\\)."}},{name:"First block in first column unmoveable: Proposition proof",options:{pairs:[{column1:{content:"\\\\( (a \\vee b) \\wedge \\neg ( \\neg a \\wedge b) \\\\)",explanation:"The proof begins by stating the expression that will be simplified.",hint:"The proof begins by stating the expression that will be simplified.",moveable:!1},column2:{content:"Beginning expression",explanation:"The instructions specify to start with \\\\( (a \\vee b) \\wedge \\neg ( \\neg a \\wedge b) \\equiv a\\\\) for this proof.",hint:"The instructions specify to start with \\\\( (a \\vee b) \\wedge \\neg ( \\neg a \\wedge b) \\equiv a\\\\) for this proof.",moveable:!0},dependsOn:[]},{column1:{content:"\\\\( (a \\vee b) \\wedge ( \\neg \\neg a \\vee \\neg b) \\\\)",explanation:"In order to simplify the expression, the first  \\\\(\\neg\\\\) operator needs to be brought inside the parentheses.",hint:"In order to simplify the expression, the first  \\\\(\\neg\\\\) operator needs to be brought inside the parentheses.",moveable:!0},column2:{content:"De Morgan’s Law",explanation:"De Morgan’s Law says that \\\\( \\neg (p \\wedge q) \\equiv (\\neg p \\vee \\neg q) \\\\). The law is applied to show that \\\\( \\neg ( \\neg a \\wedge b)\\\\) is equivalent to \\\\( ( \\neg \\neg a \\vee \\neg b)\\\\).",hint:"In this statement, the expression \\\\(\\neg ( \\neg a \\wedge b) \\\\) is rewritten as \\\\(\\neg \\neg a \\vee \\neg b\\\\)). What law justifies this equivalence?",moveable:!0},dependsOn:[0]},{column1:{content:"\\\\( (a \\vee b) \\wedge (a \\vee \\neg b) \\\\)",explanation:"The next step in simplifying the expression is to eliminate the double negation.",hint:"The next step in simplifying the expression is to eliminate the double negation.",moveable:!0},column2:{content:"Double negation law",explanation:"The double negation law says that \\\\(\\neg \\neg a\\\\) is equivalent to\\\\( a\\\\).",hint:"In this statement, \\\\(\\neg \\neg a\\\\) is rewritten as \\\\(a\\\\). What law justifies this equivalence?",moveable:!0},dependsOn:[1]},{column1:{content:"\\\\( a \\vee (b \\wedge \\neg b) \\\\)",explanation:"The expression can be simplified by pulling out the \\\\(a\\\\) from \\\\( (a \\vee b) \\\\) and \\\\( (a \\vee \\neg b) \\\\).",hint:"The expression can be simplified by pulling out the \\\\(a\\\\) from \\\\( (a \\vee b) \\\\) and \\\\( (a \\vee \\neg b) \\\\).",moveable:!0},column2:{content:"Distributive law",explanation:"The distributive law allows the \\\\(a\\\\) to be pulled out of the expression.",hint:"In this statement, \\\\(a\\\\) is pulled out of the expression \\\\( (a \\vee b) \\wedge (a \\vee \\neg b) \\\\). What law justifies this equivalence?",moveable:!0},dependsOn:[2]},{column1:{content:"\\\\( a \\vee \\text{F} \\\\)",explanation:"The expression can be simplified by replacing \\\\(b \\wedge \\neg b\\\\) which is always false.",hint:"The expression can be simplified by replacing \\\\(b \\wedge \\neg b\\\\) which is always false.",moveable:!0},column2:{content:"Complement law",explanation:"The complement law says that \\\\(b \\wedge \\neg b\\\\) is equivalent to F, since \\\\(b \\wedge \\neg b\\\\) is always false.",hint:"In this statement, \\\\((b \\wedge \\neg b\\\\)) is stated as false. What law justifies this equivalence?",moveable:!0},dependsOn:[3]},{column1:{content:"\\\\( a \\\\)",explanation:"The expression can be further simplified by removing the \\\\( \\vee F \\\\) from the expression.",hint:"The expression can be further simplified by removing the \\\\( \\vee F \\\\) from the expression.",moveable:!0},column2:{content:"Identity law",explanation:"The identity law says that \\\\( a \\vee F \\\\) is equivalent to \\\\( a \\\\).",hint:"In this last statement, \\\\( a \\vee \\text{F} \\\\) is rewritten as \\\\( a \\\\). What law justifies this equivalence?",moveable:!0},dependsOn:[4]}],names:{all:"proof",column1:{header:"Statements",singular:"statement"},column2:{header:"Justifications",singular:"justification"},pair:"step"},prompt:"Put the statements in the correct order to prove that \\\\( (a \\vee b) \\wedge \\neg ( \\neg a \\wedge b) \\equiv a \\\\). For each statement, also provide a justification."}},{name:"First column unmoveable: Gauss-Jordan elimination",options:{pairs:[{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{cc|c}\n-1 &amp; 2 &amp;-3 \\\\\\\\\n5 &amp; -7 &amp; 11\n\\\\end{array}\\\\right]\\\\]",explanation:"Correct.1 The steps of the proof are in a logical order.",hint:null,moveable:!1},column2:{content:"\\\\[ 5R\\_1 + R\\_2 \\\\rightarrow R\\_2\\\\]",explanation:null,hint:"The entry below the current pivot for column \\\\(1\\\\) needs to be zero. Row \\\\(1\\\\) will be unchanged.",moveable:!0},dependsOn:[]},{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{cc|c}\n-1 &amp; 2 &amp;-3 \\\\\\\\\n0 &amp; 3 &amp; -4\n\\\\end{array}\\\\right]\\\\]",explanation:null,hint:null,moveable:!1},column2:{content:"\\\\[ \\\\begin{align}- R\\_1\\\\rightarrow R\\_1\\\\\\\\ -\\frac{1}{3} R\\_2 \\\\rightarrow R\\_2 \\\\end{align}\\\\]",explanation:null,hint:"Pivots need to be scaled to \\\\(1\\\\).",moveable:!0},dependsOn:[0]},{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{cc|c}\n1 &amp; -2 &amp; 3 \\\\\\\\\n0 &amp; 1 &amp; -\\frac{4}{3}\n\\\\end{array}\\\\right]\\\\]",explanation:null,hint:null,moveable:!1},column2:{content:"\\\\[ 2R\\_2 + R\\_1 \\\\rightarrow R\\_1\\\\]",explanation:null,hint:"The entry above the current pivot for column \\\\(2\\\\) needs to be zero. Row \\\\(2\\\\) will be unchanged.",moveable:!0},dependsOn:[1]},{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{cc|c}\n1 &amp; 0 &amp;\\frac{1}{3} \\\\\\\\\n0 &amp; 1 &amp; -\\frac{4}{3}\n\\\\end{array}\\\\right]\\\\]",explanation:null,hint:null,moveable:!1},column2:{content:"Thus, the solution is:\n\\\\[x\\_1 = \\frac{1}{3}\\\\text{ and }x\\_2 = -\\frac{4}{3}\\\\]",explanation:"Correct. The steps are in a logical order.",hint:null,moveable:!0},dependsOn:[2]}],names:{all:"proof",column1:{header:"Augmented matrices",singular:"augmented matrix"},column2:{header:"Elementary row operations",singular:"elementary row operation"},pair:"step"},prompt:"Solve the system using Gauss-Jordan elimination.\n\\\\begin{align}\n-x\\_1 + 2x\\_2 &amp;= -3 \\\\\\\\\n 5x\\_1-7x_2 &amp;=11\n\\\\end{align}\n\n\n"}},{name:"Second column unmoveable: Gauss-Jordan elimination",options:{pairs:[{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 5 &amp; 0 &amp; -1 \\\\\\\\\n0 &amp; 12 &amp; -1 &amp; -2 \\\\\\\\\n0 &amp; 0 &amp; -\\frac{1}{4} &amp; \\frac{11}{2}\n\\\\end{array}\\\\right]\\\\]",explanation:"The coefficient matrix from the system of equations is combined with the column matrix for the constants to form the augmented matrix.",hint:"The augmented matrix contains the coefficients of the system of equations and the constants in the order they appear.",moveable:!0},column2:{content:"The augmented matrix needs no forward elimination steps.  Two pivots need scaling. \\\\[\\\\begin{align}\\\\frac{1}{12}  R\\\\_2 \\\\rightarrow R\\_2\\\\\\\\-4  R\\_3 \\\\rightarrow R\\_3\\\\end{align}\\\\]\n",explanation:null,hint:null,moveable:!1},dependsOn:[]},{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 5 &amp; 0 &amp; -1 \\\\\\\\\n0 &amp; 1 &amp; -\\frac{1}{12} &amp; -\\frac{1}{6} \\\\\\\\\n0 &amp; 0 &amp; 1 &amp; -22\n\\\\end{array}\\\\right]\\\\]",explanation:"Row \\\\(2\\\\) pivot is scaled by multiplying row \\\\(2\\\\) by \\\\(\\\\frac{1}{12}\\\\), the reciprocal of the \\\\(12\\\\) pivot.\nRow \\\\(3\\\\) pivot  is scaled by multiplying row \\\\(3\\\\) by \\\\(-\\\\frac{1}{4}\\\\), the reciprocal of the \\\\(-4\\\\) pivot.\n",hint:"Pivots on rows \\\\(2\\\\) and \\\\(3\\\\) should be scaled to \\\\(1\\\\). Row \\\\(1\\\\) is unchanged.",moveable:!0},column2:{content:"\\\\[ \\\\dfrac{1}{12}R\\_3 + R\\_2  \\\\rightarrow R\\_2\\\\]",explanation:null,hint:null,moveable:!1},dependsOn:[0]},{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 5 &amp; 0 &amp; -1 \\\\\\\\\n0 &amp; 1 &amp; 0 &amp; -2 \\\\\\\\\n0 &amp; 0 &amp; 1 &amp; -22\n\\\\end{array}\\\\right]\\\\]\n",explanation:"To get \\\\(0\\\\) in the third column of row \\\\(2\\\\), the sum of \\\\(\\\\frac{1}{12}\\\\)(row \\\\(3\\\\)) and row \\\\(2\\\\) replaces row \\\\(2\\\\).",hint:"Entries above the pivot in row \\\\(3\\\\) should be \\\\(0\\\\). Rows \\\\(1\\\\) and \\\\(3\\\\) are unchanged.",moveable:!0},column2:{content:"\\\\[-5R\\_2 + R\\_1 \\\\rightarrow R\\_1\\\\]",explanation:null,hint:null,moveable:!1},dependsOn:[1]},{column1:{content:"\\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 0 &amp; 0 &amp; 9 \\\\\\\\\n0 &amp; 1&amp; 0 &amp; -2 \\\\\\\\\n0 &amp; 0 &amp; 1 &amp; -22\n\\\\end{array}\\\\right]\\\\]\n",explanation:"To get \\\\(0\\\\) in the second column of row \\\\(1\\\\), the sum of \\\\(-5\\\\)(row \\\\(2\\\\)) and row \\\\(1\\\\) replaces row \\\\(1\\\\).",hint:"Entries above the pivot in row \\\\(2\\\\) should be \\\\(0\\\\). Rows \\\\(2\\\\) and \\\\(3\\\\) are unchanged.",moveable:!0},column2:{content:"The reduced row echelon matrix shows that\n\\\\(x\\_1 {=} 9,\\; x\\_2 {=}{-}2, \\text{ and }x\\_3 {=} {-}22\\\\)",explanation:null,hint:null,moveable:!1},dependsOn:[2]}],names:{all:"proof",column1:{header:"Augmented matrices",singular:"augmented matrix"},column2:{header:"Elementary row operations",singular:"elementary row operation"},pair:"step"},prompt:"Solve the system using Gauss-Jordan elimination.\n\\\\begin{align}\nx\\_1+5x\\_2&amp;=-1\\\\\\\\\n12x\\_2-x\\_3&amp;=-2\\\\\\\\\n-\\frac{1}{4}x_3&amp;=\\frac{11}{2}\n\\\\end{align}\n"}},{name:"Needs fullscreen",options:{pairs:Array(5).fill({column1:{content:"\\\\[ a \\\\\\\\ b \\\\\\\\ c \\\\\\\\ d \\\\]",moveable:!0},column2:{content:"short",moveable:!0},dependsOn:[]}),names:{all:"proof",column1:{header:"Statements",singular:"statement"},column2:{header:"Justifications",singular:"justification"},pair:"step"},prompt:"This needs fullscreen"}},{name:"First pair unmoveable",options:{pairs:[{column1:{content:"This is tall \\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 5 &amp; 0 &amp; -1 \\\\\\\\\n0 &amp; 1 &amp; 0 &amp; -2 \\\\\\\\\n0 &amp; 0 &amp; 1 &amp; -22\n\\\\end{array}\\\\right]\\\\]",explanation:"explanation, pair 1, column 1",hint:"hint, pair 1, column 1",moveable:!1},column2:{content:"This is short",explanation:"explanation, pair 1, column 2",hint:"hint, pair 1, column 2",moveable:!1},dependsOn:[]},{column1:{content:"me next",explanation:"explanation, pair 2, column 1",hint:"hint, pair 2, column 1",moveable:!0},column2:{content:"then me",explanation:"explanation, pair 2, column 2",hint:"hint, pair 2, column 2",moveable:!0},dependsOn:[0]}],names:{all:"proof",column1:{header:"Statements",singular:"statement"},column2:{header:"Justifications",singular:"justification"},pair:"step"},prompt:"Meep moop"}}]
e.blockOrderingPA2ColumnOptions=t}))
define("content-tools/utils/options/block-ordering-pa",["exports"],(function(e){"use strict"
Object.defineProperty(e,"__esModule",{value:!0}),e.blockOrderingPAOptions=void 0
e.blockOrderingPAOptions=[{name:"Direct proof (dependency bifurcation)",options:{blocks:[{content:"Let \\\\(r\\\\) be a rational number. We will show that \\\\(r^2\\\\) is also rational.",dependsOn:[],explanation:"The proof starts by stating what is assumed and what will be proven.",hint:"\\\\(r\\\\) is not defined yet."},{content:"Since \\\\(r\\\\) is rational, there exists integers \\\\(x\\\\) and \\\\(y\\\\) such that \\\\(r = \\\\frac{x}{y}\\\\) and \\\\(y \\\\ne 0\\\\).",dependsOn:[0],explanation:"The only available assumption is that \\\\(r\\\\) is rational, so the definition of a rational number is applied to \\\\(r\\\\) .",hint:"\\\\(x\\\\) and \\\\(y\\\\) are not defined yet."},{content:"\\\\(r^2 = \\\\left( \\\\frac{x}{y} \\\\right)^2 = \\\\frac{x^2}{y^2}\\\\)",dependsOn:[1],explanation:"The proof must show that \\\\(r^2\\\\) is rational, so the expression \\\\(\\\\frac{x}{y}\\\\) is plugged in to \\\\(r^2\\\\). The goal of this algebra is to express \\\\(r^2\\\\) as the ratio of two integers.",hint:"Some algebra is needed for \\\\(r^2\\\\) using the expression \\\\(\\\\frac{x}{y}\\\\)."},{content:"Since \\\\(x\\\\) is an integer, \\\\(x^2\\\\) is also an integer. Since \\\\(y\\\\) is an integer, \\\\(y^2\\\\) is also an integer. Since \\\\(y \\\\ne 0\\\\), \\\\(y^2 \\\\ne 0\\\\).",dependsOn:[1],explanation:"The proof needs to argue that the derived fraction \\\\(\\\\frac{x^2}{y^2}\\\\) satisfies the requirements for a rational number: the numerator and denominator must both be integers and the denominator must be non-zero.",hint:"\\\\(x^2\\\\) and \\\\(y^2\\\\) must satisfy the requirements for rational numbers."},{content:"Since \\\\(r^2 =\\\\frac{x^2}{y^2}\\\\), \\\\(x^2\\\\) and \\\\(y^2\\\\) are both integers, and \\\\(y^2 \\\\ne 0\\\\), \\\\(r^2\\\\) is a rational number.",dependsOn:[2,3],explanation:"The proof concludes by explaining that the expression for \\\\(r^2\\\\) satisfies the requirements for a rational number, and therefore \\\\(r^2\\\\) is rational."}],orderedListName:"proof",prompt:"Theorem: The square of any rational number is also rational."}},{name:"Proof by contradition (9 steps)",options:{blocks:[{content:"Assume \\\\(\\\\sqrt{2}\\\\) is rational.",dependsOn:[],explanation:"A proof by contradiction starts with the assumption that the theorem is false.",hint:"Proof by contradiction needs an assumption about \\\\(\\\\sqrt{2}\\\\)."},{content:"Express \\\\(\\\\sqrt{2}\\\\) as \\\\(\\\\frac{n}{d}\\\\), where \\\\(n\\\\) and \\\\(d\\\\) are integers, \\\\(d \\\\ne 0\\\\), and there is no integer greater than \\\\(1\\\\) that divides both \\\\(n\\\\) and \\\\(d\\\\).",dependsOn:[0],explanation:"Express the fact that \\\\(\\\\sqrt{2}\\\\) is rational mathematically and reduce the resulting fraction.",hint:"The proof needs a statement defining \\\\(n\\\\) and \\\\(d\\\\)."},{content:"\\\\(n^2 = 2d^2\\\\)",dependsOn:[1],explanation:"Square both sides of the equation \\\\(\\\\sqrt{2} = \\\\frac{n}{d}\\\\) and multiply by \\\\(d^2\\\\).",hint:"The proof needs a statement with some algebra as a consequence of \\\\(\\\\sqrt{2} = \\\\frac{n}{d}\\\\)."},{content:"\\\\(n^2\\\\) is even and therefore n is even.",dependsOn:[2],explanation:"The fact that \\\\(n^2 = 2d^2\\\\), means that \\\\(n^2\\\\) is equal to \\\\(2\\\\) times an integer and therefore \\\\(n^2\\\\) is even. Since \\\\(n^2\\\\) is even, \\\\(n\\\\) is also even.",hint:"No statement in the proof shows \\\\(n\\\\) is even."},{content:"Since \\\\(n\\\\) is even, and \\\\(n^2 = 2d^2\\\\),  then \\\\(4k^2 = 2d^2\\\\), for some integer \\\\(k\\\\).",dependsOn:[3],explanation:"If \\\\(n\\\\) is even then \\\\(n = 2k\\\\), where \\\\(k\\\\) is an integer. Plug in \\\\(2k\\\\) for \\\\(n\\\\) into \\\\(n^2 = 2d^2\\\\) to get \\\\(4k^2 = 2d^2\\\\).",hint:"No statement in the proof defines \\\\(k\\\\)."},{content:"Since \\\\(4k^2 = 2d^2\\\\) for some integer \\\\(k\\\\), \\\\(d^2\\\\) is also even.",dependsOn:[4],explanation:"Divide both sides of the equation \\\\(4k^2 = 2d^2\\\\) by \\\\(2\\\\) to conclude that \\\\(d^2\\\\) is a multiple of \\\\(2\\\\).",hint:"No statement in the proof shows \\\\(d^2\\\\) is a multiple of \\\\(2\\\\)."},{content:"Since \\\\(d^2\\\\) is even, \\\\(d\\\\) is even.",dependsOn:[5],explanation:"The previous step established that \\\\(d^2\\\\) is even. If the square of an integer is even, then the integer itself must also be even.",hint:"No statement in the proof shows \\\\(d\\\\) is even."},{content:"Since \\\\(n\\\\) and \\\\(d\\\\) are both even, \\\\(2\\\\) divides both \\\\(n\\\\) and \\\\(d\\\\).",dependsOn:[6],explanation:"We have now established that both \\\\(n\\\\) and \\\\(d\\\\) are even.",hint:"No statement in the proof shows a number greater than \\\\(1\\\\) dividing both \\\\(n\\\\) and \\\\(d\\\\)."},{content:"This contradicts the assumption that there is no integer greater than \\\\(1\\\\) that divides both \\\\(n\\\\) and \\\\(d\\\\). Therefore \\\\(\\\\sqrt{2}\\\\) must be irrational.",dependsOn:[7],explanation:"The fact that \\\\(n\\\\) and \\\\(d\\\\) are both divisible by \\\\(2\\\\) contradicts the assumption made at the beginning of the proof."}],orderedListName:"proof",prompt:"Theorem: \\\\(\\sqrt{2}\\\\) is an irrational number."}},{name:"Ordering the steps of a proof by cases.",options:{blocks:[{content:"Case 1: \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\ge 0\\\\)",dependsOn:[],explanation:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\\\(x\\\\) and \\\\(y\\\\) are both non-negative.",hint:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\\\(x\\\\) and \\\\(y\\\\) are both non-negative."},{content:"\\\\(xy \\\\ge 0\\\\) and therefore \\\\(|x \\\\cdot y| = xy\\\\). Meanwhile \\\\(|x| = x\\\\) and \\\\(|y| = y\\\\), so \\\\(|x|\\\\cdot|y| = (x)(y) = xy\\\\).",dependsOn:[0],explanation:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\ge 0\\\\).",hint:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\ge 0\\\\)."},{content:"\\\\( | x \\\\cdot y | = |x| \\\\cdot |y|\\\\) when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\ge 0\\\\).",dependsOn:[1],explanation:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\ge 0\\\\).",hint:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\ge 0\\\\)."},{content:"Case 2: \\\\(x \\\\le 0\\\\) and \\\\(y \\\\le 0\\\\)",dependsOn:[2],explanation:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\(x\\) and \\(y\\) are both non-positive.",hint:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\(x\\) and \\(y\\) are both non-positive."},{content:"\\\\(xy \\\\ge 0\\\\) and therefore \\\\(|x \\\\cdot y| = xy\\\\). Meanwhile \\\\(|x| = -x\\\\) and \\\\(|y| = -y\\\\), so \\\\(|x| \\\\cdot |y| = (-x)(-y) = xy\\\\).",dependsOn:[3],explanation:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\le 0\\\\).",hint:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\le 0\\\\)."},{content:"\\\\( | x \\\\cdot y | = |x| \\\\cdot |y|\\\\) when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\le 0\\\\).",dependsOn:[4],explanation:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\le 0\\\\).",hint:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\le 0\\\\)."},{content:"Case 3: \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\le 0\\\\)",dependsOn:[5],explanation:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\(x\\) is non-negative and \\(y\\) is non-positive.",hint:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\(x\\) is non-negative and \\(y\\) is non-positive."},{content:"\\\\(xy \\\\le 0\\\\) and therefore \\\\(|x\\\\cdot y| = -xy\\\\). Meanwhile \\\\(|x| = x\\\\) and \\\\(|y| = -y\\\\), so \\\\(|x|\\\\cdot|y| = (x)(-y)= -xy\\\\).",dependsOn:[6],explanation:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\le 0\\\\).",hint:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\le 0\\\\)."},{content:"\\\\( | x \\\\cdot y | = |x| \\\\cdot |y|\\\\) when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\le 0\\\\).",dependsOn:[7],explanation:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\le 0\\\\).",hint:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\ge 0\\\\) and \\\\(y \\\\le 0\\\\)."},{content:"Case 4: \\\\(x \\\\le 0\\\\) and \\\\(y \\\\ge 0\\\\)",dependsOn:[8],explanation:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\(x\\) is non-positive and \\(y\\) is non-positive.",hint:"Generally, the order in which cases are considered doesn't matter.\nHowever, in this proof, the first case is set to be when \\(x\\) is non-positive and \\(y\\) is non-negative."},{content:"\\\\(xy \\\\le 0\\\\) and therefore \\\\(|x\\\\cdot y| = -xy\\\\). Meanwhile \\\\(|x| = -x\\\\) and \\\\(|y| = y\\\\), so \\\\(|x|\\\\cdot|y| = (-x)(y) = -xy\\\\).",dependsOn:[9],explanation:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\ge 0\\\\).",hint:"In this step, the definition of absolute value is used to find expressions for \\\\(|x \\\\cdot y|\\\\) and \\\\(|x| \\\\cdot |y|\\\\) in terms of \\\\(x\\\\) and \\\\(y\\\\) when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\ge 0\\\\)."},{content:"\\\\( | x \\\\cdot y | = |x| \\\\cdot |y|\\\\) when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\ge 0\\\\).",dependsOn:[10],explanation:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\ge 0\\\\).",hint:"The previous step established that \\\\( | x \\\\cdot y | = |x| \\\\cdot |y| = xy\\\\), so this step states concisely that the theorem is true for the case when \\\\(x \\\\le 0\\\\) and \\\\(y \\\\ge 0\\\\)."},{content:"Since the \\\\( | x \\\\cdot y | = |x| \\\\cdot |y|\\\\) for all cases, \\\\( | x \\\\cdot y | = |x| \\\\cdot |y|\\\\)  for all real numbers \\\\(x\\\\) and \\\\(y\\\\).",dependsOn:[11],explanation:"The proof has shown that the theorem is true for all possible cases for \\\\(x\\\\) and \\\\(y\\\\).",hint:"The proof has shown that the theorem is true for all possible cases for \\\\(x\\\\) and \\\\(y\\\\)."}],orderedListName:"proof",prompt:"\n**Theorem:** For every pair of real numbers, \\\\(x\\\\) and \\\\(y\\\\), \\\\(|x \\\\cdot y| = |x| \\\\cdot |y|\\\\).\n\nInclude the cases in the numeric order given.\n"}},{name:"Duplicate content",options:{blocks:[{content:"t",dependsOn:[],explanation:"t\\_1's explanation",hint:"t\\_1's hint"},{content:"a",dependsOn:[0],explanation:"a's explanation",hint:"a's hint"},{content:"t",dependsOn:[1],explanation:"t\\_2's explanation",hint:"t\\_2's hint"}],orderedListName:"proof",prompt:"t\\_1 -> a -> t\\_2"}}]})),define("content-tools/utils/options/char-encoding",["exports"],(function(e){"use strict"

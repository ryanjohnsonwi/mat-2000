var t={"template.c":'int testPassed() {\n   // Write your test here. Return 1 if the test passes, and 0 otherwise.\n   // This function exists in the same scope as main. The student\'s main function\n   // will not be executed. This function will be called instead.\n\n   // Optionally use printf to provide feedback to the student.\n\n   // For example:\n   //\n   // int value1 = 4;\n   // int value2 = 2;\n   // int expectedResult = value1 + value2;\n   // int studentResult = add(value1, value2);\n   //\n   // if (studentResult == expectedResult) {\n   //    return 1;\n   // }\n   // else {\n   //    printf("add(%d, %d) incorrectly returned %d", value1, value2, studentResult);\n   //    return 0;\n   // }\n}\n',"template.cpp":'bool testPassed(std::ofstream& testFeedback) {\n   // Write your test here. Return true if the test passes, and false otherwise.\n   // This function exists in the same scope as main. The student\'s main function\n   // will not be executed. This function will be called instead.\n\n   // Optionally use testFeedback to provide feedback to the student.\n\n   // For example:\n   //\n   // int value1 = 4;\n   // int value2 = 2;\n   // int expectedResult = value1 + value2;\n   // int studentResult = add(value1, value2);\n   //\n   // if (studentResult == expectedResult) {\n   //    return true;\n   // } else {\n   //    testFeedback << "add(" << value1 << ", " << value2 << ") incorrectly returned " << studentResult << endl;\n   //    return false;\n   // }\n}\n',"template.java":'import java.io.PrintWriter;\n\n/*\n   Optionally import any other packages or classes.\n*/\n\npublic class zyLabsUnitTest {\n    public boolean passed(PrintWriter testFeedback) {\n        /*\n          Write your test here. Return true if the test passes, and false otherwise.\n\n          Optionally use the `write` method of the input parameter `testFeedback` to provide feedback to the student.\n\n          For example:\n\n          Main studentMain = new Main();\n\n          int value1 = 4;\n          int value2 = 2;\n          int expectedResult = value1 + value2;\n          int studentResult = studentMain.add(4, 2);\n\n          if (studentResult == expectedResult) {\n              return true;\n          }\n          else {\n              testFeedback.write("add(" + value1 + ", " + value2 + ") incorrectly returned " + studentResult);\n              return false;\n          }\n        */\n    }\n}\n',"template.js":"QUnit.test('{{description}}', function(assert) {\n   /*\n      Assert is an object that supports 6 assertions:\n      * equal: http://api.qunitjs.com/assert/equal\n      * ok: http://api.qunitjs.com/assert/ok\n      * strictEqual: http://api.qunitjs.com/assert/strictEqual\n      * async: http://api.qunitjs.com/assert/async\n      * step: https://api.qunitjs.com/assert/step\n      * verifySteps: https://api.qunitjs.com/assert/verifySteps\n\n      Tip: An assertion message appears in test results. Ex: assert.equal(myVar, 5, 'Checking value of myVar')\n\n      jQuery v3.3.1 supplied in QUnit.test(). Ex: $('p') returns the <p> tags. // eslint-disable-line ember/no-jquery\n   */\n});\n","template.py":'# Import student module you would like to test.\n# For example:\n# from main import add\n\ndef test_passed(test_feedback):\n    # Write your test here. Return True if the test passes, and False otherwise.\n\n    # Optionally use the `write` method of the input parameter `test_feedback` to provide feedback to the student.\n\n    # For example:\n    #\n    # value1 = 4\n    # value2 = 2\n    # expected_result = value1 + value2\n    # student_result = add(4, 2)\n    #\n    # if student_result == expected_result:\n    #    return True\n    # else:\n    #    test_feedback.write("add(" + str(value1) + ", " + str(value2) + ") incorrectly returned " + str(student_result))\n    #    return False\n',"template.R":'# Source student file you would like to test.\n# For example:\n# source("add.R")\n\ntest_passed <- function(){\n    # Write your test here. Return True if the test passes, and False otherwise.\n    # For example:\n    #\n    # value1 <- 4\n    # value2 <- 2\n    # expected_result <- value1 + value2\n    # student_result <- add(4, 2)\n    #\n    # if(student_result == expected_result) {\n    #    return(TRUE)\n    # } else {\n    #    return(FALSE)\n    # }\n}\n',"template_unittest.py":"import unittest\n\n# Import student module you would like to test.\n# For example:\n# from main import add\n\nclass UnitTest(unittest.TestCase):\n    def test_method(self):\n        '''\n            self contains the following assertions:\n            * assertEqual: https://docs.python.org/3/library/unittest.html#unittest.TestCase.assertEqual\n            * assertTrue: https://docs.python.org/3/library/unittest.html#unittest.TestCase.assertTrue\n            * assertFalse: https://docs.python.org/3/library/unittest.html#unittest.TestCase.assertFalse\n            * assertAlmostEqual: https://docs.python.org/3/library/unittest.html#unittest.TestCase.assertAlmostEqual\n            * assertRaises: https://docs.python.org/3/library/unittest.html#unittest.TestCase.assertRaises\n        '''\n        # self.assertEqual(1, 1, msg=\"1 is equal to 1\")\n","template.v":'`timescale 1 ns/ 1 ns\nmodule testbench;\n   /*\n      Declare nets, variables, and module to test. Ex:\n      reg inputSignal;\n      wire outputSignal;\n      Module studentModule(inputSignal, outputSignal);\n   */\n   initial begin\n      /*\n         Available macros:\n         * Assess a value: assert(actual, expected, outputName, inputs, description, format)\n            * actual: Value being tested.\n            * expected: Known comparison value.\n            * outputName: Meaningful name for value being tested.\n            * inputs: Description of inputs that affect the output value being tested.\n            * description: Description of testbench when output value is tested.\n            * format: Output format specifier. One of "%h", "%d", "%o", "%b", "%c".\n        * Display non-assessed info:\n           * info(message)\n              * message: Displayed to student.\n           * infof((formatString, arg1, arg2, ..., argI, ..., argN))\n              * formatString: A string containing format specifiers.\n              * argI: Value corresponding to Ith format specifier in formatString\n\n         Ex:\n         `info("Toggling inputSignal")\n         inputSignal = 1;\n         #5;\n         inputSignal = 0;\n         #5;\n         `assert(outputSignal, 1, "Module\'s output", "inputSignal=0", "Output after toggle", "%b")\n      */\n      $finish;\n   end\nendmodule'}

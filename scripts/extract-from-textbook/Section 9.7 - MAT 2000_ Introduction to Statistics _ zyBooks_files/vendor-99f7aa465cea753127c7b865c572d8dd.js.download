canner(inputFile);\n      PrintWriter out = new PrintWriter(outputFileName);\n'},{editable:!0,solution:'\n      // Read the input and write the output\n      double total = 0;\n      int counter = 0;\n\n      while (in.hasNextDouble())\n      {\n         double value = in.nextDouble();\n         out.printf("%17.2f\\n", value);\n         total = total + value;\n         counter = counter + 1;\n      }\n\n      out.printf("Average: %10.2f\\n", total / counter);\n',template:'\n      // Read the input and write the output\n      double total = 0;\n\n      while (in.hasNextDouble())\n      {\n         double value = in.nextDouble();\n         out.printf("%17.2f\\n", value);\n         total = total + value;\n      }\n\n      out.printf("Total: %10.2f\\n", total);\n'},{editable:!1,solution:null,template:"\n      in.close();\n      out.close();\n   }\n}"}],input:!1,main:!0,name:"Total.java"},{content:[{editable:!1,solution:null,template:"32.00\n54.00\n67.50\n29.00\n35.00\n80.00\n115.00\n44.50\n100.00\n65.00\n"}],input:!0,main:!1,name:"numbers.txt"}],prompt:"Modify the Total program so that it shows the average, not the total of the inputs.",randomization:{distractor:"def make_distractor_permutation(meaningful_permutation):\n    return {}",meaningful:"def make_meaningful_permutation():\n    return {}",setup:null,test:"def make_test_permutation(meaningful_permutation, distractor_permutation):\n    return {}"},tests:[{args:null,out:{type:"file",value:"output.txt"},stdin:"numbers.txt\noutput.txt"}]}]}},{name:"Python: Basic output",options:{global:"import random",language:"python3",levels:[{files:[{content:[{editable:!1,template:""},{editable:!0,solution:"print('This ${meaningful.noun} ${meaningful.verb} ${meaningful.adjective}.')",template:"# Your code goes here"},{editable:!1,template:""}],input:!1,main:!0,name:"main.py"}],randomization:{test:"\ndef make_test_permutation(meaningful_permutation, distractor_permutation):\n    return {}\n",setup:"\nnouns = ['day', 'week', 'month'
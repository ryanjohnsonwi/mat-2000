height=\'16px\'><text>\\(3 - (-1) = 4\\)</text></zyObject><zyObject objNum="10" objType="text" objName="$4 = 4$" top="194px" left="194px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(4 = 4\\)</text></zyObject><zyObject objNum="11" objType="text" objName="¿(-3, 1)?" top="106px" left="100px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\((3, -1)\\)</text></zyObject><zyObject objNum="12" objType="text" objName="✓" top="194px" left="113px" opacity="0" color=\'rgb(30, 200, 30)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>✓</text></zyObject><zyObject objNum="13" objType="text" objName="Object 12: Text" top="192px" left="236px" opacity="0" color=\'rgb(30, 200, 30)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>✓</text></zyObject><zyObject objNum="14" objType="text" objName="(-3, 1) is a solutio" top="228px" left="66px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\((3, -1)\\) is a solution</text></zyObject><zyObject objNum="15" objType="text" objName="Object 14: Text" top="47px" left="225px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(x_1 + x_2 = 2\\)</text></zyObject><zyObject objNum="16" objType="text" objName="Object 15: Text" top="69px" left="225px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(x_1 - x_2 = 4\\)</text></zyObject><zyObject objNum="17" objType="text" objName="$2 + 0 = 2$" top="167px" left="297px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(2 + 0 = 2\\)</text></zyObject><zyObject objNum="18" objType="text" objName="$2 = 2$" top="194px" left="325px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(2 = 2\\)</text></zyObject><zyObject objNum="19" objType="text" objName="$2 - 0  = 4 $" top="167px" left="415px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(2 - 0  = 4 \\)</text></zyObject><zyObject objNum="20" objType="text" objName="$2 = 4 $" top="194px" left="443px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\(2 = 4\\)</text></zyObject><zyObject objNum="21" objType="text" objName="(2, 0)?" top="106px" left="366px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\((2, 0)\\)</text></zyObject><zyObject objNum="22" objType="text" objName="Object 22: Text" top="192px" left="367px" opacity="0" color=\'rgb(30, 200, 30)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>✓</text></zyObject><zyObject objNum="23" objType="text" objName="✗" top="192px" left="486px" opacity="0" color=\'rgb(220, 4, 4)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>✗</text></zyObject><zyObject objNum="24" objType="text" objName="(2, 0) is not a solu" top="228px" left="326px" opacity="0" color=\'rgb(51, 51, 51)\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\' line-height=\'16px\'><text>\\((2, 0)\\) is not a solution</text></zyObject></zyObjects><zyInstructions>\n<zyInstruction instrType="step1"><text>To determine whether \\((3, -1)\\) is a solution, \\(3\\) is substituted for \\(x_1\\) and \\(-1\\) is substituted for \\(x_2\\).</text></zyInstruction>\n<zyInstruction instrType="fade" objNum="4" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="3" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="11" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="5" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="5" timeLabel="0" top="142" left="30"></zyInstruction><zyInstruction instrType="fade" objNum="6" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="7" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="8" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="0" top="141" left="153"></zyInstruction><zyInstruction instrType="fade" objNum="9" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="10" timeLabel="0" opacity="100"></zyInstruction>\n<zyInstruction instrType="step"><text>Since the resulting equations are true, \\((3, -1)\\) is a solution to the system.</text></zyInstruction>\n<zyInstruction instrType="fade" objNum="12" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="13" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="14" timeLabel="0" opacity="100"></zyInstruction>\n<zyInstruction instrType="step"><text>\\((2, 0)\\) is not a solution to the system because substituting \\(2\\) for \\(x_1\\) and \\(0\\) for \\(x_2\\) in the second equation fails to yield a true statement.</text></zyInstruction>\n<zyInstruction instrType="fade" objNum="21" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="15" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="15" timeLabel="0" top="139" left="285"></zyInstruction><zyInstruction instrType="fade" objNum="17" timeLabel="0" opacity="100"></zyInstruction><
icElement('yttrium', 39, 88.91, 'Y'),\n    'zirconium': PeriodicElement('zirconium', 40, 91.22, 'Zr'),\n    'niobium': PeriodicElement('niobium', 41, 92.91, 'Nb'),\n    'molybdenum': PeriodicElement('molybdenum', 42, 95.94, 'Mo'),\n    'technetium': PeriodicElement('technetium', 43, 98, 'Tc'),\n    'ruthenium': PeriodicElement('ruthenium', 44, 101.1, 'Ru'),\n    'rhodium': PeriodicElement('rhodium', 45, 102.9, 'Rh'),\n    'palladium': PeriodicElement('palladium', 46, 106.4, 'Pd'),\n    'silver': PeriodicElement('silver', 47, 107.9, 'Ag'),\n    'cadmium': PeriodicElement('cadmium', 48, 112.4, 'Cd'),\n    'indium': PeriodicElement('indium', 49, 114.8, 'In'),\n    'tin': PeriodicElement('tin', 50, 118.71, 'Sn'),\n    'antimony': PeriodicElement('antimony', 51, 121.8, 'Sb'),\n    'tellurium': PeriodicElement('tellurium', 52, 127.6, 'Te'),\n    'iodine': PeriodicElement('iodine', 53, 126.9, 'I'),\n    'xenon': PeriodicElement('xenon', 54, 131.3, 'Xe'),\n    'cesium': PeriodicElement('cesium', 55, 132.9, 'Cs'),\n    'barium': PeriodicElement('barium', 56, 137.3, 'Ba'),\n    'lanthanum': PeriodicElement('lanthanum', 57, 138.9, 'La'),\n    'cerium': PeriodicElement('cerium', 58, 140.1, 'Ce'),\n    'praseodymium': PeriodicElement('praseodymium', 59, 140.9, 'Pr'),\n    'neodymium': PeriodicElement('neodymium', 60, 144.2, 'Nd'),\n    'promethium': PeriodicElement('promethium', 61, 145, 'Pm'),\n    'samarium': PeriodicElement('samarium', 62, 150.4, 'Sm'),\n    'europium': PeriodicElement('europium', 63, 152.0, 'Eu'),\n    'gadolinium': PeriodicElement('gadolinium', 64, 157.3, 'Gd'),\n    'terbium': PeriodicElement('terbium', 65, 158.9, 'Tb'),\n    'dysprosium': PeriodicElement('dysprosium', 66, 162.5, 'Dy'),\n    'holmium': PeriodicElement('holmium', 67, 164.9, 'Ho'),\n    'erbium': PeriodicElement('erbium', 68, 167.3, 'Er'),\n    'thulium': PeriodicElement('thulium', 69, 168.9, 'Tm'),\n    'ytterbium': PeriodicElement('ytterbium', 70, 173.0, 'Yb'),\n    'lutetium': PeriodicElement('lutetium', 71, 175.0, 'Lu'),\n    'hafnium': PeriodicElement('hafnium', 72, 178.5, 'Hf'),\n    'tantalum': PeriodicElement('tantalum', 73, 180.9, 'Ta'),\n    'tungsten': PeriodicElement('tungsten', 74, 183.8, 'W'),\n    'rhenium': PeriodicElement('rhenium', 75, 186.2, 'Re'),\n    'osmium': PeriodicElement('osmium', 76, 190.2, 'Os'),\n    'iridium': PeriodicElement('iridium', 77, 192.2, 'Ir'),\n    'platinum': PeriodicElement('platinum', 78, 195.1, 'Pt'),\n    'gold': PeriodicElement('gold', 79, 197.0, 'Au'),\n    'mercury': PeriodicElement('mercury', 80, 200.6, 'Hg'),\n    'thallium': PeriodicElement('thallium', 81, 204.4, 'Tl'),\n    'lead': PeriodicElement('lead', 82, 207.2, 'Pb'),\n    'bismuth': PeriodicElement('bismuth', 83, 209.0, 'Bi'),\n    'polonium': PeriodicElement('polonium', 84, 209, 'Po'),\n    'astatine': PeriodicElement('astatine', 85, 210, 'At'),\n    'radon': PeriodicElement('radon', 86, 222, 'Rn'),\n    'francium': PeriodicElement('francium', 87, 223, 'Fr'),\n    'radium': PeriodicElement('radium', 88, 226, 'Ra'),\n    'actinium': PeriodicElement('actinium', 89, 227, 'Ac'),\n    'thorium': PeriodicElement('thorium', 90, 232.0, 'Th'),\n    'protactinium': PeriodicElement('protactinium', 91, 231.0, 'Pa'),\n    'uranium': PeriodicElement('uranium', 92, 238.0, 'U'),\n    'neptunium': PeriodicElement('neptunium', 93, 237, 'Np'),\n    'plutonium': PeriodicElement('plutonium', 94, 244, 'Pu'),\n    'americium': PeriodicElement('americium', 95, 243, 'Am'),\n    'curium': PeriodicElement('curium', 96, 247, 'Cm')\n}","src/lib/ConfigParser.py":'raise NotImplementedError("ConfigParser is not yet implemented in Skulpt")\n',"src/lib/pickle.py":'raise NotImplementedError("pickle is not yet implemented in Skulpt")\n',"src/lib/MimeWriter.py":'raise NotImplementedError("MimeWriter is not yet implemented in Skulpt")\n',"src/lib/code.py":'raise NotImplementedError("code is not yet implemented in Skulpt")\n',"src/lib/UserDict.py":'raise NotImplementedError("UserDict is not yet implemented in Skulpt")\n',"src/lib/codecs.py":'raise NotImplementedError("codecs is not yet implemented in Skulpt")\n',"src/lib/tty.py":'raise NotImplementedError("tty is not yet implemented in Skulpt")\n',"src/lib/pythonds/graphs/adjGraph.py":'#\n#  adjGraph\n#\n#  Created by Brad Miller on 2005-02-24.\n#  Copyright (c) 2005 Brad Miller, David Ranum, Luther College. All rights reserved.\n#\n\nimport sys\nimport os\nimport unittest\n\nclass Graph:\n    def __init__(self):\n        self.vertices = {}\n        self.numVertices = 0\n        \n    def addVertex(self,key):\n        self.numVertices = self.numVertices + 1\n        newVertex = Vertex(key)\n        self.vertices[key] = newVertex\n        return newVertex\n    \n    def getVertex(self,n):\n        if n in self.vertices:\n            return self.vertices[n]\n        else:\n            return None\n\n    def __contains__(self,n):\n        return n in self.vertices\n    \n    def addEdge(self,f,t,cost=0):\n            if f not in self.vertices:\n                nv = self.addVertex(f)\n            if t not in self.vertices:\n                nv = self.addVertex(t)\n            self.vertices[f].addNeighbor(self.vertices[t],cost)\n    \n    def getVertices(self):\n        return list(self.vertices.keys())\n        \n    def __iter__(self):\n        return iter(self.vertices.values())\n                \nclass Vertex:\n    def __init__(self,num):\n        self.id = num\n        self.connectedTo = {}\n        self.color = \'white\'\n        self.dist = sys.maxsize\n        self.pred = None\n        self.disc = 0\n        self.fin = 0\n\n    # def __lt__(self,o):\n    #     return self.id < o.id\n    \n    def addNeighbor(self,nbr,weight=0):\n        self.connectedTo[nbr] = weight\n        \n    def setColor(self,color):\n        self.color = color\n        \n    def setDistance(self,d):\n        self.dist = d\n\n    def setPred(self,p):\n        self.pred = p\n\n    def setDiscovery(self,dtime):\n        self.disc = dtime\n        \n    def setFinish(self,ftime):\n        self.fin = ftime\n        \n    def getFinish(self):\n        return self.fin\n        \n    def getDiscovery(self):\n        return self.disc\n        \n    def getPred(self):\n        return self.pred\n        \n    def getDistance(self):\n        return self.dist\n        \n    def getColor(self):\n        return self.color\n    \n    def getConnections(self):\n        return self.connectedTo.keys()\n        \n    def getWeight(self,nbr):\n        return self.connectedTo[nbr]\n                \n    def __str__(self):\n        return str(self.id) + ":color " + self.color + ":disc " + str(self.disc) + ":fin " + str(self.fin) + ":dist " + str(self.dist) + ":pred \\n\\t[" + str(self.pred)+ "]\\n"\n    \n    def getId(self):\n        return self.id\n\nclass adjGraphTests(unittest.TestCase):\n    def setUp(self):\n        self.tGraph = Graph()\n        \n    def testMakeGraph(self):\n        gFile = open("test.dat")\n        for line in gFile:\n            fVertex, tVertex = line.split(\'|\')\n            fVertex = int(fVertex)\n            tVertex = int(tVertex)\n            self.tGraph.addEdge(fVertex,tVertex)\n        for i in self.tGraph:\n            adj = i.getAdj()\n            for k in adj:\n                print(i, k)\n\n        \nif __name__ == \'__main__\':\n    unittest.main()\n              \n',"src/lib/macurl2path.py":'raise NotImplementedError("macurl2path is not yet implemented in Skulpt")\n',"src/lib/new.py":'raise NotImplementedError("new is not yet implemented in Skulpt")\n',"src/lib/nturl2path.py":'raise NotImplementedError("nturl2path is not yet implemented in Skulpt")\n',"src/lib/_abcoll.py":'raise NotImplementedError("_abcoll is not yet implemented in Skulpt")\n',"src/lib/hotshot/__init__.py":'raise NotImplementedError("hotshot is not yet implemented in Skulpt")\n',"src/lib/urllib2.py":'raise NotImplementedError("urllib2 is not yet implemented in Skulpt")\n',"src/lib/atexit.py":'raise NotImplementedError("atexit is not yet implemented in Skulpt")\n',"src/lib/compileall.py":'raise NotImplementedError("compileall is not yet implemented in Skulpt")\n',"src/lib/symtable.py":'raise NotImplementedError("symtable is not yet implemented in Skulpt")\n',"src/lib/warnings.py":'raise NotImplementedError("warnings is not yet implemented in Skulpt")\n',"src/lib/keyword.py":"\n__all__ = [\"iskeyword\", \"kwlist\"]\n\nkwlist = [\n#--start keywords--\n        'and',\n        'as',\n        'assert',\n        'break',\n        'class',\n        'continue',\n        'def',\n        'del',\n        'elif',\n        'else',\n        'except',\n        'exec',\n        'finally',\n        'for',\n        'from',\n        'global',\n        'if',\n        'import',\n        'in',\n        'is',\n        'lambda',\n        'not',\n        'or',\n        'pass',\n        'print',\n        'raise',\n        'return',\n        'try',\n        'while',\n        'with',\n        'yield',\n#--end keywords--\n        ]\n\ndef iskeyword(wd):\n    return wd in kwlist\n\n","src/lib/timeit.py":'raise NotImplementedError("timeit is not yet implemented in Skulpt")\n',"src/lib/statistics/__init__.py":"import math\nfrom P_DF_and_T import p_df_ts\nfrom P_DF_and_Chi import p_df_chis\nfrom P_and_Z import p_zscores\n\nclass StatisticsError(ValueError):\n    pass\n\ndef raise_error_if_not_enough_elements(num_elements, needed_elements, function_name):\n    '''\n    Raises a StatisticsError if |num_elements| is less than |needed_elements.\n\n    Keyword arguments:\n    num_elements -- The number of elements passed to the function.\n    needed_elements -- The minimum number of elements needed in the function.\n    function_name -- The function that called this function.\n    '''\n    if num_elements < needed_elements:\n        message = '%s requires at least %d data point(s).' % (function_name, needed_elements)\n        raise StatisticsError(message)\n\ndef mean(data):\n    '''\n    Return the arithmetic mean of data.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the mean.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 1, 'mean')\n    return sum(data) / float(num_elements)\n\ndef median(data):\n    '''\n    Return the median (middle value) of numeric data.\n\n    Keyword arguments:\n    data -- The sample from which to get the median.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 1, 'median')\n    data = sorted(data)\n    center_index = num_elements / 2\n    is_odd = (num_elements % 2) == 1\n\n    return data[center_index] if is_odd else mean([ data[center_index - 1], data[center_index] ])\n\ndef modes(data):\n    '''\n    Returns a list of the most common data points from data.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the mode.\n    '''\n    raise_error_if_not_enough_elements(len(data), 1, 'modes')\n    value_to_frequency = {}\n    for value in data:\n        value_to_frequency[value] = data.count(value)\n    max_frequency = max([ frequency for frequency in value_to_frequency.values() ])\n    return [ value for value in value_to_frequency if value_to_frequency[value] == max_frequency ]\n\ndef variance(data, calculated_mean=None):\n    '''\n    Return the variance of data.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the variance.\n    calculated_mean -- The arithmetic mean of data, if not given, it's calculated. Defaults to None.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 2, 'variance')\n    if calculated_mean is None:\n        calculated_mean = mean(data)\n\n    sum_of_mean_difference_squared = 0\n    for value in data:\n        sum_of_mean_difference_squared += math.pow((value - calculated_mean), 2)\n\n    return sum_of_mean_difference_squared / float(num_elements - 1)\n\ndef stdev(data, calculated_mean=None):\n    '''\n    Return the square root of the variance.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the standard deviation.\n    calculated_mean -- The arithmetic mean of data, if not given, it's calculated. Defaults to None.\n    '''\n    raise_error_if_not_enough_elements(len(data), 2, 'stdev')\n    return math.sqrt(variance(data, calculated_mean))\n\ndef mean_absolute_deviation(data, calculated_mean=None):\n    '''\n    Return the mean absolute deviation of a dataset.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the mean absolute deviation.\n    calculated_mean -- The arithmetic mean of data, if not given it's calculated. Defaults to None.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 2, 'mean_absolute_deviation')\n    if calculated_mean is None:\n        calculated_mean = mean(data)\n\n    sum_of_absolute_mean_difference = sum([ abs(value - calculated_mean) for value in data ])\n    return sum_of_absolute_mean_difference / float(num_elements)\n\ndef undefined_p_value_for_z_error(z_score):\n    raise StatisticsError('No defined p-value for z %f' % z_score)\n\ndef isclose(a, b, rel_tol=1e-09, abs_tol=0.0):\n    '''\n    Compares floating-point numbers.\n    '''\n    return abs(a-b) <= max(rel_tol * max(abs(a), abs(b)), abs_tol)\n\ndef find_p_from_z(z_score):\n    '''\n    Return the p-value for the given z-score.\n    Keyword argument:\n    z-score -- The z-score to find.\n    '''\n\n    if type(z_score) != float:\n        raise TypeError('Input for find_p_from_z must be a float')\n\n    # Ex: If z-score is 3.45, then |z_ones_and_tenths_places| is 3.4 and |z_hundredths_place| is 0.05.\n    z_ones_and_tenths_places = math.floor(z_score * 10) / 10.0\n    z_hundredths_place = z_score - z_ones_and_tenths_places\n\n    # Find p_zscore pairs wherein z_ones_and_tenths_places (index 1) is |z_ones_and_tenths_places|.\n    filter_for_z_ones_and_tenths_places = [ p_zscore for p_zscore in p_zscores if isclose(p_zscore[1], z_ones_and_tenths_places) ]\n    if not filter_for_z_ones_and_tenths_places:\n        undefined_p_value_for_z_error(z_score)\n\n    # Find p_zscore pairs wherein z_hundredths_place (index 0) is |z_hundredths_place|.\n    filter_for_z_hundredths_place = [ p_zscore for p_zscore in filter_for_z_ones_and_tenths_places if isclose(p_zscore[0], z_hundredths_place) ]\n    if not filter_for_z_hundredths_place:\n        undefined_p_value_for_z_error(z_score)\n\n    p_value = filter_for_z_hundredths_place[0][2]\n\n    return p_value\n\ndef undefined_p_value_for_df_and_statistic_error(degree_of_freedom, statistic_name, statistic_value):\n    raise StatisticsError(\n        'No defined p-value for df %d, %s %f' % (degree_of_freedom, statistic_name, statistic_value)\n    )\n\ndef _find_p_range_from_df_and_statistic(degree_of_freedom, statistic_name, statistic_value, table):\n    '''\n    Return the lower and upper-bound p-values for the given df, statistic, and table.x\n\n    Keyword arguments:\n    degree_of_freedom -- The degrees of freedom to find.\n    statistic_name -- The name of the statistic to find. Ex: chi-squared.\n    statistic_value -- The value of the statistic to find.\n    table -- The table from which to find. Ex: p_df_ts and p_df_chis.\n    '''\n\n    # Find rows wherein df (index 1) is |degree_of_freedom|.\n    filter_for_df = [ row for row in table if row[1] == degree_of_freedom ]\n    if not filter_for_df:\n        undefined_p_value_for_df_and_statistic_error(degree_of_freedom, statistic_name, statistic_value)\n\n    # Sort from smallest-to-largest statistic to make finding the lower- and upper-bound easier. Statistic is index 2.\n    filter_for_df.sort(key = lambda row: row[2])\n\n    # Find statistic greater than |statistic_value|.\n    larger_statistic_indices = [ index for index, row in enumerate(filter_for_df) if row[2] > statistic_value ]\n\n    lower_bound_index = len(filter_for_df)\n    lower_bound_p_value = 0\n    if larger_statistic_indices:\n        # The smallest of the larger statistics is the upper-bound statistic and lower-bound p (statistic and p are inversely correlated).\n        # p-value is at index 0.\n        lower_bound_index = larger_statistic_indices[0]\n        lower_bound_p_value = filter_for_df[lower_bound_index][0]\n\n    # The upper-bound p-value is at index 1 less than lower-bound.\n    upper_bound_index = lower_bound_index - 1\n    upper_bound_p_value = 1\n    if upper_bound_index >= 0:\n        upper_bound_p_value = filter_for_df[upper_bound_index][0]\n\n    return lower_bound_p_value, upper_bound_p_value\n\ndef find_p_range_from_df_and_t(degree_of_freedom, t_statistic):\n    '''\n    Refer to _find_p_range_from_df_and_statistic().\n    '''\n    return _find_p_range_from_df_and_statistic(degree_of_freedom, 't', t_statistic, p_df_ts)\n\ndef find_p_range_from_df_and_chi(degree_of_freedom, chi_squared_statistic):\n    '''\n    Refer to _find_p_range_from_df_and_statistic().\n    '''\n    return _find_p_range_from_df_and_statistic(degree_of_freedom, 'chi-squared', chi_squared_statistic, p_df_chis)\n\n","src/lib/meb/SaturatedWaterPressure.py":"class SaturatedWaterPressure:\n    def __init__(self, properties):\n        self.P = properties[0] # kPa\n        self.T = properties[1] # degrees C\n        self.vf = properties[2] # m^3/kg\n        self.vg = properties[3] # m^3/kg\n        self.uf = properties[4] # kJ/kg\n        self.ug = properties[5] # kJ/kg\n        self.ufg = properties[6] # kJ/kg\n        self.hf = properties[7] # kJ/kg\n        self.hg = properties[8] # kJ/kg\n        self.hfg = properties[9] # kJ/kg\n        self.sf = properties[10] # kJ/kg*K\n        self.sg = properties[11] # kJ/kg*K\n        self.sfg = properties[12] # kJ/kg*K\n\nsaturated_water_pressure_property_to_index = {\n    'P': 0,\n    'T': 1,\n    'vf': 2,\n    'vg': 3,\n    'uf': 4,\n    'ug': 5,\n    'ufg': 6,\n    'hf': 7,\n    'hg': 8,\n    'hfg': 9,\n    'sf': 10,\n    'sg': 11,\n    'sfg': 12,\n}\n\nsaturated_water_pressures = [\n    [ 0.6117, 0.01, 0.001000, 205.99, 0.0000, 2374.9, 2374.9, 0.00061178, 2500.9, 2500.9, 0.0000, 9.1555, 9.1555 ],\n    [ 1.0, 6.97, 0.001000, 129.18, 29.298, 2384.5, 2355.2, 29.299, 2513.7, 2484.4, 0.10591, 8.9749, 8.8690 ],\n    [ 1.5, 13.02, 0.001001, 87.959, 54.681, 2392.8, 2338.1, 54.683, 2524.7, 2470.0, 0.19556, 8.8270, 8.6314 ],\n    [ 2.0, 17.50, 0.001001, 66.987, 73.426, 2398.9, 2325.5, 73.428, 2532.9, 2459.5, 0.26056, 8.7226, 8.4620 ],\n    [ 2.5, 21.08, 0.001002, 54.240, 88.417, 2403.8, 2315.4, 88.420, 2539.4, 2451.0, 0.31182, 8.6420, 8.3302 ],\n    [ 3.0, 24.08, 0.001003, 45.653, 100.970, 2407.9, 2306.9, 100.980, 2544.8, 2443.8, 0.35429, 8.5764, 8.2221 ],\n    [ 4.0, 28.96, 0.001004, 34.791, 121.38, 2414.5, 2293.1, 121.39, 2553.7, 2432.3, 0.42239, 8.4734, 8.0510 ],\n    [ 5.0, 32.87, 0.001005, 28.185, 137.74, 2419.8, 2282.1, 137.75, 2560.7, 2423.0, 0.47620, 8.3938, 7.9176 ],\n    [ 7.5, 40.29, 0.001008, 19.233, 168.74, 2429.8, 2261.1, 168.75, 2574.0, 2405.3, 0.57627, 8.2501, 7.6738 ],\n    [ 10, 45.81, 0.001010, 14.670, 191.80, 2437.2, 2245.4, 191.81, 2583.9, 2392.1, 0.64920, 8.1488, 7.4996 ],\n    [ 15, 53.97, 0.001014, 10.020, 225.93, 2448.0, 2222.1, 225.94, 2598.3, 2372.4, 0.75486, 8.0071, 7.2522 ],\n    [ 20, 60.06, 0.001017, 7.6480, 251.40, 2456.0, 2204.6, 251.42, 2608.9, 2357.5, 0.83202, 7.9072, 7.0752 ],\n    [ 25, 64.96, 0.001020, 6.2032, 271.93, 2462.4, 2190.5, 271.96, 2617.4, 2345.4, 0.89319, 7.8302, 6.9370 ],\n    [ 30, 69.10, 0.001022, 5.2284, 289.24, 2467.7, 2178.5, 289.27, 2624.5, 2335.2, 0.94407, 7.7675, 6.8234 ],\n    [ 40, 75.86, 0.001026, 3.9930, 317.58, 2476.3, 2158.7, 317.62, 2636.1, 2318.5, 1.0261, 7.6690, 6.6429 ],\n    [ 50, 81.32, 0.001030, 3.2400, 340.49, 2483.2, 2142.7, 340.54, 2645.2, 2304.7, 1.0912, 7.5930, 6.5018 ],\n    [ 60, 85.93, 0.001033, 2.7317, 359.84, 2489.0, 2129.2, 359.91, 2652.9, 2293.0, 1.1454, 7.5311, 6.3857 ],\n    [ 70, 89.93, 0.001036, 2.3648, 376.68, 2493.9, 2117.2, 376.75, 2659.4, 2282.7, 1.1921, 7.4790, 6.2869 ],\n    [ 80, 93.49, 0.001039, 2.0871, 391.63, 2498.2, 2106.6, 391.71, 2665.2, 2273.5, 1.2330, 7.4339, 6.2009 ],\n    [ 90, 96.69, 0.001041, 1.8694, 405.10, 2502.1, 2097.0, 405.20, 2670.3, 2265.1, 1.2696, 7.3943, 6.1247 ],\n    [ 100, 99.61, 0.001043, 1.6939, 417.40, 2505.6, 2088.2, 417.50, 2674.9, 2257.4, 1.3028, 7.3588, 6.0560 ],\n    [ 101.325, 99.97, 0.001043, 1.6734, 418.95, 2506.0, 2087.1, 419.06, 2675.6, 2256.5, 1.3069, 7.3545, 6.0476 ],\n    [ 125, 105.97, 0.001048, 1.3749, 444.22, 2513.0, 2068.8, 444.35, 2684.9, 2240.6, 1.3741, 7.2840, 5.9099 ],\n    [ 150, 111.35, 0.001053, 1.1593, 466.97, 2519.2, 2052.2, 467.13, 2693.1, 2226.0, 1.4337, 7.2230, 5.7893 ],\n    [ 175, 116.04, 0.001057, 1.0036, 486.82, 2524.5, 2037.7, 487.00, 2700.1, 2213.1, 1.4850, 7.1715, 5.6865 ],\n    [ 200, 120.21, 0.001061, 0.88568, 504.49, 2529.1, 2024.6, 504.70, 2706.2, 2201.5, 1.5302, 7.1269, 5.5967 ],\n    [ 225, 123.97, 0.001064, 0.79320, 520.47, 2533.2, 2012.7, 520.71, 2711.6, 2190.9, 1.5706, 7.0876, 5.5170 ],\n    [ 250, 127.41, 0.001067, 0.71866, 535.08, 2536.8, 2001.7, 535.34, 2716.5, 2181.2, 1.6072, 7.0524, 5.4452 ],\n    [ 275, 130.58, 0.001070, 0.65725, 548.56, 2540.1, 1991.5, 548.86, 2720.9, 2172.0, 1.6408, 7.0207, 5.3799 ],\n    [ 300, 133.52, 0.001073, 0.60576, 561.10, 2543.2, 1982.1, 561.43, 2724.9, 2163.5, 1.6717, 6.9916, 5.3199 ],\n    [ 325, 136.27, 0.001076, 0.56194, 572.84, 2545.9, 1973.1, 573.19, 2728.6, 2155.4, 1.7005, 6.9649, 5.2644 ],\n    [ 350, 138.86, 0.001079, 0.52418, 583.88, 2548.5, 1964.6, 584.26, 2732.0, 2147.7, 1.7274, 6.9401, 5.2127 ],\n    [ 375, 141.30, 0.001081, 0.49129, 594.32, 2550.9, 1956.6, 594.73, 2735.1, 2140.4, 1.7526, 6.9171, 5.1645 ],\n    [ 400, 143.61, 0.001084, 0.46238, 604.22, 2553.1, 1948.9, 604.65, 2738.1, 2133.5, 1.7765, 6.8955, 5.1190 ],\n    [ 450, 147.90, 0.001088, 0.41390, 622.65, 2557.1, 1934.5, 623.14, 2743.4, 2120.3, 1.8205, 6.8560, 5.0355 ],\n    [ 50
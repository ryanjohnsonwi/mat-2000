n Rating(prop" top="50px" left="34px" color=\'rgb(51, 51, 51)\' font-weight=\'400\' padding-left=\'5px\' padding-right=\'5px\' padding-top=\'5px\' padding-bottom=\'5px\' border-color=\'rgb(51, 51, 51)\'><zyCode language="js" snippet="true" nobox="true" zyanimator="true">function Rating(props) {\n   return (\n      &lt;div&gt;\n         {props.stars}/4 stars\n      &lt;/div&gt;\n   );\n}\n\nfunction Review(props) {\n   return (\n      &lt;div className="Review"&gt;\n         &lt;div&gt;\n            Review by {props.username}\n         &lt;/div&gt;\n\n         &lt;Rating stars={props.rating} /&gt;\n\n         &lt;div&gt;\n            {props.text}\n         &lt;/div&gt;\n      &lt;/div&gt;\n   );\n}\n\nfunction App() {\n   return (\n      &lt;Review username="mrodriguez"\n         rating={3}\n         text="Burgers are amazing!" /&gt;\n   );\n}</zyCode></zyObject><zyObject objNum="4" objType="box" objName="browser" top="406px" left="442px" opacity="0" border-radius="10px" useConstrainedProportions="false" height="88px" width="148px" border-color="rgb(175, 175, 175)"></zyObject><zyObject objNum="5" objType="box" objName="virtual DOM bg" top="202px" left="406px" opacity="0" background-color="rgb(249, 216, 188)" useConstrainedProportions="false" height="168px" width="212px" border-color="rgb(249, 216, 188)"></zyObject><zyObject objNum="6" objType="text" objName="virtual DOM" top="178px" left="470px" opacity="0" color=\'rgb(51, 51, 51)\' font-style=\'italic\' font-weight=\'400\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\'><text>virtual DOM</text></zyObject><zyObject objNum="7" objType="box" objName="hide" top="262px" left="90px" opacity="0" background-color="rgb(176, 214, 251)" useConstrainedProportions="false" width="240px" border-color="rgb(176, 214, 251)"></zyObject><zyObject objNum="8" objType="box" objName="highlight" top="391px" left="30px" opacity="0" useConstrainedProportions="false" height="14px" width="20px" border-color="rgb(220, 4, 4)"></zyObject><zyObject objNum="9" objType="text" objName="&amp;lt;div&amp;gt;3/4 start" top="78px" left="258px" opacity="0" color=\'rgb(51, 51, 51)\' font-weight=\'400\' padding-left=\'5px\' padding-right=\'5px\' padding-top=\'5px\' padding-bottom=\'5px\' border-color=\'rgb(51, 51, 51)\'><zyCode language="html" snippet="true" nobox="true" zyanimator="true">&lt;div&gt;\n   3/4 stars\n&lt;/div&gt;</zyCode></zyObject><zyObject objNum="10" objType="text" objName="      &amp;lt;div classN" top="191px" left="77px" opacity="0" color=\'rgb(51, 51, 51)\' font-weight=\'400\' padding-left=\'5px\' padding-right=\'5px\' padding-top=\'5px\' padding-bottom=\'5px\' border-color=\'rgb(51, 51, 51)\'><zyCode language="html" snippet="true" nobox="true" zyanimator="true">&lt;div class="Review"&gt;\n   &lt;div&gt;\n      Review by mrodriguez\n   &lt;/div&gt;\n   &lt;div&gt;\n      3/4 stars\n   &lt;/div&gt;\n   &lt;div&gt;\n      Burgers are amazing!\n   &lt;/div&gt;\n&lt;/div&gt;\n</zyCode></zyObject><zyObject objNum="11" objType="text" objName="Review by mrodriguez" top="414px" left="450px" opacity="0" color=\'rgb(51, 51, 51)\' font-size=\'13px\' font-weight=\'400\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\'><text>Review by mrodriguez\n3/4 stars\nBurgers are amazing!</text></zyObject><zyObject objNum="12" objType="box" objName="Box 1" top="50px" left="466px" opacity="0" border-radius="5px" background-color="rgb(30, 200, 30)" useConstrainedProportions="false" width="84px" border-color="rgb(51, 51, 51)"></zyObject><zyObject objNum="15" objType="box" objName="Box 1" top="89px" left="466px" opacity="0" border-radius="5px" background-color="rgb(255, 211, 100)" useConstrainedProportions="false" width="84px" border-color="rgb(51, 51, 51)"></zyObject><zyObject objNum="17" objType="box" objName="Box 1" top="126px" left="466px" opacity="0" border-radius="5px" background-color="rgb(255, 211, 100)" useConstrainedProportions="false" width="84px" border-color="rgb(51, 51, 51)"></zyObject><zyObject objNum="13" objType="text" objName="App" top="390px" left="102px" opacity="0" color=\'rgb(51, 51, 51)\' font-weight=\'400\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\'><text>App</text></zyObject><zyObject objNum="14" objType="text" objName="Review" top="420px" left="85px" opacity="0" color=\'rgb(51, 51, 51)\' font-weight=\'400\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\'><text>Review</text></zyObject><zyObject objNum="16" objType="box" objName="Box 2" top="74px" left="510px" opacity="0" background-color="rgb(175, 175, 175)" useConstrainedProportions="false" height="15px" width="2px" border-width="0px" border-color="transparent"></zyObject><zyObject objNum="19" objType="box" objName="Box 2" top="112px" left="510px" opacity="0" background-color="rgb(175, 175, 175)" useConstrainedProportions="false" height="15px" width="2px" border-width="0px" border-color="rgba(0, 0, 0, 0)"></zyObject><zyObject objNum="18" objType="text" objName="Rating" top="263px" left="109px" opacity="0" color=\'rgb(51, 51, 51)\' font-weight=\'400\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\'><text>Rating</text></zyObject><zyObject objNum="20" objType="text" objName="component hierarchy" top="22px" left="442px" opacity="0" color=\'rgb(51, 51, 51)\' font-style=\'italic\' font-weight=\'400\' font-family=\'arial, sans-serif\' border-color=\'rgb(51, 51, 51)\'><text>component hierarchy</text></zyObject></zyObjects><zyInstructions>\n<zyInstruction instrType="step1"><text>The App component, which serves as the root component, has a child Review component with username, rating, and text props.</text></zyInstruction>\n<zyInstruction instrType="fade" objNum="8" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="102" width="324"></zyInstruction><zyInstruction instrType="fade" objNum="13" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="13" timeLabel="0" top="52" left="495"></zyInstruction><zyInstruction instrType="fade" objNum="12" timeLabel="0" opacity="30"></zyInstruction><zyInstruction instrType="fade" objNum="20" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="0.5" top="422" left="30"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="40" width="324"></zyInstruction><zyInstruction instrType="fade" objNum="14" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="14" timeLabel="0" top="91" left="485"></zyInstruction><zyInstruction instrType="fade" objNum="15" timeLabel="0" opacity="30"></zyInstruction><zyInstruction instrType="fade" objNum="16" timeLabel="-" opacity="100"></zyInstruction>\n<zyInstruction instrType="step"><text>The Review component contains several div elements and a child Rating component with stars props to display the number of stars.</text></zyInstruction>\n<zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="0" top="166" left="30"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="215" width="324"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="0.5" top="265" left="30"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="14" width="324"></zyInstruction><zyInstruction instrType="fade" objNum="18" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="18" timeLabel="0" top="128" left="489"></zyInstruction><zyInstruction instrType="fade" objNum="17" timeLabel="0" opacity="30"></zyInstruction><zyInstruction instrType="fade" objNum="19" timeLabel="-" opacity="100"></zyInstruction>\n<zyInstruction instrType="step"><text>The div element returned by Rating is inserted into Review&apos;s div element in the virtual DOM.  </text></zyInstruction>\n<zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="0" top="53" left="30"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="100" width="324"></zyInstruction><zyInstruction instrType="fade" objNum="9" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="9" timeLabel="0" top="248" left="99"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="-" top="252" left="30"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="38" width="324"></zyInstruction><zyInstruction instrType="fade" objNum="7" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="9" timeLabel="0" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="10" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="10" timeLabel="0" top="206" left="410"></zyInstruction><zyInstruction instrType="fade" objNum="7" timeLabel="-" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="6" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="5" timeLabel="-" opacity="100"></zyInstruction>\n<zyInstruction instrType="step"><text>App() returns the review, and the virtual DOM is rendered in the webpage showing the complete review.</text></zyInstruction>\n<zyInstruction instrType="move" easing="swing" objNum="8" timeLabel="0" top="422" left="30"></zyInstruction><zyInstruction instrType="resize" objNum="8" timeLabel="-" height="41" width="324"></zyInstruction><zyInstruction instrType="fade" objNum="8" timeLabel="0" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="11" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="4" timeLabel="-" opacity="100"></zyInstruction>\n<zyInstruction instrType="startStep"><text></text></zyInstruction>\n</zyInstructions>\n<zyAltDescription></zyAltDescription>\n</zyAnimator>'}},{na
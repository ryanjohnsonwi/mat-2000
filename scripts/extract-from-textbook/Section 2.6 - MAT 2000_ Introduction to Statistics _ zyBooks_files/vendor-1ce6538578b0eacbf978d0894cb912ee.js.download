 {\n                color[i] = (typeof color[i] === "number") ?\n                    Math.max(0, Math.min(255, parseInt(color[i]))) :\n                    0;\n            }\n            if (typeof color[i] === "number") {\n                color[3] = Math.max(0, Math.min(1, color[i]));\n                color = "rgba(" + color.join(",") + ")";\n            }\n            else {\n                color = "rgb(" + color.slice(0,3).join(",") + ")";\n            }\n        }\n        else if (typeof color === "string" && !color.match(/\\s*url\\s*\\(/i)) {\n            color = color.replace(/\\s+/g, "");\n        }\n        else {\n            return "black";\n        }\n\n        return color;\n    }\n\n    function calculateHeading(turtle, value, heading) {\n        var angle   = turtle._angle   || 0,\n            radians = turtle._radians || 0;\n\n        heading || (heading = {});\n\n        if (typeof value === "number") {\n            if (turtle._isRadians) {\n                angle = radians = value % Turtle.RADIANS;\n            }\n            else if (turtle._fullCircle) {\n                angle   = (value % turtle._fullCircle);\n                radians = angle / turtle._fullCircle * Turtle.RADIANS;\n            }\n            else {\n                angle = radians = 0;\n            }\n\n            if (angle < 0) {\n                angle   += turtle._fullCircle;\n                radians += Turtle.RADIANS;\n            }\n        }\n\n        heading.angle   = angle;\n        heading.radians = radians;\n\n        return heading;\n    }\n\n    function pythonToJavascriptFunction(pyValue, scope) {\n        return function() {\n            var argsJs = Array.prototype.slice.call(arguments),\n                argsPy = argsJs.map(\n                    function(argJs) {return Sk.ffi.remapToPy(argJs);}\n                );\n\n            if (typeof(scope) !== "undefined") {\n                argsPy.unshift(scope);\n            }\n            return Sk.misceval.applyAsync(\n                undefined, pyValue, undefined, undefined, undefined, argsPy\n            ).catch(Sk.uncaughtException);\n        };\n    }\n\n    function addModuleMethod(klass, module, method, scopeGenerator) {\n        var publicMethodName = method.replace(/^\\$/, ""),\n            displayName      = publicMethodName.replace(/_\\$[a-z]+\\$$/i, ""),\n            maxArgs          = klass.prototype[method].length,\n            minArgs          = klass.prototype[method].minArgs,\n            keywordArgs      = klass.prototype[method].keywordArgs,\n            returnType       = klass.prototype[method].returnType,\n            isSk             = klass.prototype[method].isSk,\n            wrapperFn;\n\n        if (minArgs === undefined) {\n            minArgs = maxArgs;\n        }\n\n        wrapperFn = function() {\n            var args     = Array.prototype.slice.call(arguments, 0),\n                instance = scopeGenerator ? scopeGenerator() : args.shift().instance,\n                i, result, susp, resolution, lengthError;\n\n            if (args.length < minArgs || args.length > maxArgs) {\n                lengthError = minArgs === maxArgs ?\n                    "exactly " + maxArgs :\n                    "between " + minArgs + " and " + maxArgs;\n\n                throw new Sk.builtin.TypeError(displayName + "() takes " + lengthError + " positional argument(s) (" + args.length + " given)");\n            }\n\n            for (i = args.length; --i >= 0;) {\n                if (args[i] !== undefined) {\n                    if (args[i] instanceof Sk.builtin.func) {\n                        args[i] = pythonToJavascriptFunction(args[i]);\n                    }\n                    else if (args[i] instanceof Sk.builtin.method) {\n                        args[i] = pythonToJavascriptFunction(args[i].im_func, args[i].im_self);\n                    }\n                    else if (args[i] && args[i].$d instanceof Sk.builtin.dict && args[i].instance) {\n                        args[i] = args[i].instance;\n                    }\n                    else {\n                        args[i] = Sk.ffi.remapToJs(args[i]);\n                    }\n                }\n            }\n\n            try {\n                result = instance[method].apply(instance, args);\n            } catch(e) {\n                if (window && window.console) {\n                    window.console.log("wrapped method failed");\n                    window.console.log(e.stack);\n                }\n                throw e;\n            }\n\n            if (result instanceof InstantPromise) {\n                result = result.lastResult;\n            }\n\n            if (result instanceof Promise) {\n                result = result.catch(function(e) {\n                    if (window && window.console) {\n                        window.console.log("promise failed");\n                        window.console.log(e.stack);\n                    }\n                    throw e;\n                });\n\n                susp = new Sk.misceval.Suspension();\n\n                susp.resume = function() {\n                    return (resolution === undefined) ?\n                        Sk.builtin.none.none$ :\n                        Sk.ffi.remapToPy(resolution);\n                };\n\n                susp.data = {\n                    type: "Sk.promise",\n                    promise: result.then(function(value) {\n                        resolution = value;\n                        return value;\n                    })\n                };\n\n                return susp;\n            }\n            else {\n                if (result === undefined) return Sk.builtin.none.none$;\n                if (isSk) return result;\n                if (typeof returnType === "function") {\n                    return returnType(result);\n                }\n\n                return Sk.ffi.remapToPy(result);\n            }\n        };\n\n        if (keywordArgs) {\n            wrapperFn.co_varnames = keywordArgs.slice();\n            // make room for required arguments\n            for(var i = 0; i < minArgs; i++) {\n                wrapperFn.co_varnames.unshift("");\n            }\n            if (!scopeGenerator) {\n                // make room for the "self" argument\n                wrapperFn.co_varnames.unshift("");\n            }\n        }\n\n        module[publicMethodName] = new Sk.builtin.func(wrapperFn);\n    }\n\n    function TurtleWrapper($gbl, $loc) {\n        $loc.__init__ = new Sk.builtin.func(function (self) {\n            self.instance = new Turtle();\n            self.instance.skInstance = self;\n        });\n\n        for(var key in Turtle.prototype) {\n            if (/^\\$[a-z_]+/.test(key)) {\n                addModuleMethod(Turtle, $loc, key);\n            }\n        }\n    }\n\n    function ScreenWrapper($gbl, $loc) {\n        $loc.__init__ = new Sk.builtin.func(function (self) {\n            self.instance = getScreen();\n        });\n\n        for(var key in Screen.prototype) {\n            if (/^\\$[a-z_]+/.test(key)) {\n                addModuleMethod(Screen, $loc, key);\n            }\n        }\n    }\n\n    for(var key in Turtle.prototype) {\n        if (/^\\$[a-z_]+/.test(key)) {\n            addModuleMethod(Turtle, _module, key, ensureAnonymous);\n        }\n    }\n\n    // add Screen method aliases to the main turtle module\n    // to allow things like:\n    //   import turtle\n    //   turtle.mainloop()\n    addModuleMethod(Screen, _module, "$mainloop", getScreen);\n    addModuleMethod(Screen, _module, "$done", getScreen);\n    addModuleMethod(Screen, _module, "$bye", getScreen);\n    addModuleMethod(Screen, _module, "$tracer", getScreen);\n    addModuleMethod(Screen, _module, "$update", getScreen);\n    addModuleMethod(Screen, _module, "$delay", getScreen);\n    addModuleMethod(Screen, _module, "$window_width", getScreen);\n    addModuleMethod(Screen, _module, "$window_height", getScreen);\n\n    _module.Turtle = Sk.misceval.buildClass(_module, TurtleWrapper, "Turtle", []);\n    _module.Screen = Sk.misceval.buildClass(_module, ScreenWrapper, "Screen", []);\n\n    // Calling focus(false) will block turtle key/mouse events\n    // until focus(true) is called again or until the turtle DOM target\n    // is clicked/tabbed into.\n    function focusTurtle(value) {\n        if (value !== undefined) {\n            _focus = !!value;\n            if (_focus) {\n                getTarget().focus();\n            }\n            else {\n                getTarget().blur();\n            }\n        }\n\n        return _focus;\n    }\n\n    function resetTurtle() {\n        cancelAnimationFrame();\n        getScreen().reset();\n        getFrameManager().reset();\n\n        while (_target.firstChild) {\n            _target.removeChild(_target.firstChild);\n        }\n\n        if (_mouseHandler) {\n            _mouseHandler.reset();\n        }\n\n        _durationSinceRedraw = 0;\n        _screenInstance      = undefined;\n        _anonymousTurtle     = undefined;\n        _mouseHandler        = undefined;\n        TURTLE_COUNT         = 0;\n    }\n\n    function stopTurtle() {\n        cancelAnimationFrame();\n\n        if (_mouseHandler) {\n            _mouseHandler.reset();\n        }\n\n        _durationSinceRedraw = 0;\n        _screenInstance      = undefined;\n        _anonymousTurtle     = undefined;\n        _mouseHandler        = undefined;\n        TURTLE_COUNT         = 0;\n    }\n\n    return {\n        skModule : _module,\n        reset    : resetTurtle,\n        stop     : stopTurtle,\n        focus    : focusTurtle,\n        Turtle   : Turtle,\n        Screen   : Screen\n    };\n}\n\n// See if the TurtleGraphics module has already been loaded\n// for the currently configured DOM target element.\nvar currentTarget = getConfiguredTarget();\n\nif (!currentTarget.turtleInstance) {\n    currentTarget.turtleInstance = generateTurtleModule(currentTarget);\n}\nelse {\n    currentTarget.turtleInstance.reset();\n}\n\nSk.TurtleGraphics.module = currentTarget.turtleInstance.skModule;\nSk.TurtleGraphics.reset  = currentTarget.turtleInstance.reset;\nSk.TurtleGraphics.stop   = currentTarget.turtleInstance.stop;\nSk.TurtleGraphics.focus  = currentTarget.turtleInstance.focus;\nSk.TurtleGraphics.raw = {\n    Turtle : currentTarget.turtleInstance.Turtle,\n    Screen : currentTarget.turtleInstance.Screen\n};\n\nreturn currentTarget.turtleInstance.skModule;\n\n};\n',"src/lib/PBBSTs/__init__.py":'# PBBSTs.py --------------------------------------------------------------------\n#\n# Made by Evan Olds for zyBooks/Wiley\n# Uploaded to GitHub May 2, 2025\n#\n# Classes declared in this module:\n#   PBBSTNode\n#   PBBinarySearchTree\n#   PBAVLTree\n#   PBRBTNode\n#   PBRedBlackTree\n\nimport math\nfrom PBCore import PBRandom\nfrom PBBinaryTrees import PBBinaryTreeNode\nfrom PBBinaryTrees import PBBinaryTree\n\nclass PBBSTNode(PBBinaryTreeNode):\n    def __init__(self, key, parent = None):\n        PBBinaryTreeNode.__init__(self, key)\n        self.parent = parent\n        \n        # Special case if the argument is a PBBSTNode, in which case\n        # properties must be deep copied. This construction method should only\n        # ever be used by the node\'s owning tree.\n        if isinstance(key, PBBSTNode):\n            node_to_copy = key\n            \n            # Assign basic properties first\n            self.key = node_to_copy.key\n            self.left = None\n            self.right = None\n            self.parent = None\n            self._height = node_to_copy._height\n            self.subtree_key_count = node_to_copy.subtree_key_count\n            self.insertion_index = node_to_copy.insertion_index\n            \n            # Deep copy non-None child subtrees\n            if node_to_copy.left != None:\n                self.left = PBBSTNode(node_to_copy.left)\n                self.left.parent = self\n            if node_to_copy.right != None:\n                self.right = PBBSTNode(node_to_copy.right)\n                self.right.parent = self\n            \n            # Copy render_info dictionary\n            self.render_info = dict(node_to_copy.render_info)\n        else:\n            self.key = key\n            self.left = None\n            self.right = None\n            self.parent = parent\n            self._height = 0\n            self.subtree_key_count = 1\n            self.insertion_index = -1\n    \n    # Returns True if the subtree rooted at this node contains the given key,\n    # False otherwise.\n    def contains_key(self, key):\n        node = self\n        while node != None:\n            node_key = node.get_key()\n            if key == node_key:\n                return True\n            elif key < node_key:\n                node = node.get_left()\n            else:\n                node = node.get_right()\n        # Not found\n        return False\n    \n    # Called when one or more descendant of this node is changed. Allows\n    # internal properties, like subtree height and subtree key count, to be\n    # properly updated. Must be called only when all descendants are in a\n    # valid state.\n    def descendant_changed(self):\n        # Update subtree key count and height\n        self._update_subtree_key_count()\n        self._update_height()\n    \n    def get_height(self):\n        return self._height\n    \n    # Returns this node\'s parent\n    def get_parent(self):\n        return self.parent\n    \n    def get_subtree_key_count(self):\n        return self.subtree_key_count\n    \n    def has_grandchildren(self):\n        if self.left != None:\n            if self.left.get_left() != None or self.left.get_right() != None:\n                return True\n            # Fall through to next check\n        if self.right != None:\n            if self.right.get_left() != None or self.right.get_right() != None:\n                return True\n        # No grandchildren\n        return False\n    \n    def insert_key(self, key):\n        if self.contains_key(key):\n            # Duplicates not allowed\n            return False\n        new_node = PBBSTNode(key)\n        return self.insert_node(new_node)\n    \n    # Precondition: new_node\'s key is NOT already in the tree\n    def insert_node(self, new_node):\n        if new_node == None:\n            return False\n        \n        key = new_node.get_key()\n        node = self\n        while node != None:\n            go_left = True\n            if key > node.get_key():\n                go_left = False\n            \n            # A new node will be inserted in one of node\'s subtrees, so node\'s\n            # subtree_key_count is incremented before node is reassigned\n            node.subtree_key_count += 1\n            \n            # Insert or branch\n            if go_left:\n                node_left = node.get_left()\n                if node_left != None:\n                    node = node_left\n                else:\n                    # Insert as node\'s left child\n                    node.set_left(new_node)\n                    return True\n            else:\n                node_right = node.get_right()\n                if node_right != None:\n                    node = node_right\n                else:\n                    # Insert as node\'s right child\n                    node.set_right(new_node)\n                    return True\n        return True\n    \n    # Returns True if this node\'s key is <= another key or node\'s key, False\n    # otherwise. The "other" argument can either be a key value or a PBBSTNode.\n    def is_key_LTE(self, other):\n        if isinstance(other, PBBSTNode):\n            return self.key <= other.get_key()\n        return self.key <= other\n    \n    # Replaces one of this node\'s children with a new child. Does nothing if\n    # the current_child argument is not either of this node\'s children. Returns\n    # self to allow chaining.\n    def replace_child(self, current_child, new_child):\n        if self.left is current_child:\n            self.set_left(new_child)\n        elif self.right is current_child:\n            self.set_right(new_child)\n        return self\n    \n    def set_key(self, new_key):\n        self.key = new_key\n        return self\n    \n    def set_left(self, new_left):\n        self.left = new_left\n        \n        # If not None, set the new child\'s parent\n        if new_left != None:\n            new_left.parent = self\n        \n        self.descendant_changed()\n        return self\n    \n    def set_parent_to_none(self):\n        self.parent = None\n    \n    def set_right(self, new_right):\n        self.right = new_right\n        \n        # If not None, set the new child\'s parent\n        if new_right != None:\n            new_right.parent = self\n        \n        self.descendant_changed()\n        return self\n    \n    def _update_height(self):\n        # Get current height of left subtree, or -1 if None\n        left_height = -1\n        if self.left != None:\n            left_height = self.left.get_height()\n                \n        # Get current height of right subtree, or -1 if None\n        right_height = -1\n        if self.right != None:\n            right_height = self.right.get_height()\n        \n        # Assign self._height with calculated node height.\n        self._height = max(left_height, right_height) + 1\n    \n    def _update_subtree_key_count(self):\n        left_count = 0 if self.left == None else self.left.subtree_key_count\n        right_count = 0 if self.right == None else self.right.subtree_key_count\n        self.subtree_key_count = 1 + left_count + right_count\n        return self\n\nclass PBBinarySearchTree(PBBinaryTree):\n    def __init__(self, optional_tree_to_copy = None):\n        PBBinaryTree.__init__(self)\n        self.root = None\n        \n        # _insertion_index is incremented each time a new key is inserted\n        self._insertion_index = 0\n        \n        self.render_info["nodesToHighlight"] = set()\n        self.render_info["nodesToShowSubtreeBounds"] = set()\n        self.render_info["showNodeHeights"] = False\n        \n        # Make a deep copy if the argument is a tree\n        if isinstance(optional_tree_to_copy, PBBinarySearchTree):\n            self.root = PBBSTNode(optional_tree_to_copy.root)\n            self._insertion_index = optional_tree_to_copy._insertion_index\n            \n            # Copy render_info properties\n            for key in optional_tree_to_copy.render_info:\n                value = optional_tree_to_copy.render_info[key]\n                if isinstance(value, set):\n                    # Each set in render_info is a set of nodes. Since a deep\n                    # copy is required, each set must be populated with nodes\n                    # from this tree itself.\n                    target_set = set()\n                    self.render_info[key] = target_set\n                    for other_node in value:\n                        our_node = self.get_node_with_key(other_node.get_key())\n                        target_set.add(our_node)\n                else:\n                    self.render_info[key] = value\n    \n    # Method for allocating a new node for this tree. PBBinarySearchTree\'s\n    # default implementation allocates a PBBSTNode. But inheriting classes can\n    # override to allocate the desired node type.\n    def alloc_node(self, key):\n        new_node = PBBSTNode(key)\n        new_node.insertion_index = self._insertion_index;\n        self._insertion_index += 1\n        return new_node\n    \n    # Returns True if this tree contains the given key, False otherwise.\n    def contains_key(self, key):\n        if self.root != None:\n            return self.root.contains_key(key)\n        return False\n    \n    @staticmethod\n    def create_from_keys(keys):\n        tree = PBBinarySearchTree()\n        for key in keys:\n            tree.insert_key(key);\n        return tree\n    \n    # Creates and returns a PBBinarySearchTree with a random collection of\n    # keys. The first two parameters, min_key_count and max_key_count, are\n    # required. Each is inclusive. Each must be a positive integer with\n    # max_key_count >= min_key_count.\n    @staticmethod\n    def create_random(min_key_count, max_key_count, min_key = 10, max_key = 99):\n        # Determine the actual key count\n        actual_key_count = PBRandom.get_int_inclusive(min_key_count,\n            max_key_count)\n        \n        tree = PBBinarySearchTree()\n        \n        # Special case if bad arguments cause an invalid key count\n        if actual_key_count < 1:\n            return tree\n        \n        # Add random keys until at the desired length\n        while tree.get_length() < actual_key_count:\n            random_key = PBRandom.get_int_inclusive(min_key, max_key)\n            tree.insert_key(random_key)\n        \n        return tree\n    \n    # Creates and returns a PBBinarySearchTree with a perfect structure (all\n    # internal nodes have 2 children and all leaf nodes are at the same\n    # level). The height argument must be an integer >= 0:\n    # - If height < 0, None is returned\n    # - If height == 0, a PBBinarySearchTree with a single node is returned\n    @staticmethod\n    def create_random_perfect(height, min_key = 10, max_key = 99):\n        if height < 0:\n            return None\n        \n        # Initialize the tree now\n        tree = PBBinarySearchTree()\n        \n        # If height is 0, tree has 1 node\n        # If height is 1, tree has 3 nodes\n        # If height is 2, tree has 7 nodes\n        # If height is 3, tree has 15 nodes\n        # ...\n        # If height is N, tree has 2^(N+1) - 1 nodes\n        node_count = pow(2, height + 1) - 1\n        \n        # Make a set of random, distinct keys\n        key_set = set()\n        while len(key_set) < node_count:\n            random_key = PBRandom.get_int_inclusive(min_key, max_key)\n            key_set.add(random_key)\n        \n        # Convert the set to a list and sort\n        keys = []\n        for key in key_set:\n            keys.append(key)\n        keys.sort()\n        \n        # Make tree from the bottom up\n        lower_level = None\n        current_level = []\n        deltaI = 2\n        startI = 0\n        while len(current_level) != 1:\n            for i in range(startI, len(keys), deltaI):\n                # Allocate a node and add to currenLevel array\n                node = tree.alloc_node(keys[i])\n                current_level.append(node)\n                \n                # If a lower level exists, add children to the node\n                if lower_level != None:\n                    child_index = (len(current_level) - 1) * 2\n                    node.set_left(lower_level[child_index])\n                    node.set_right(lower_level[child_index + 1])\n            \n            # If the current level has > 1 node, more passes are needed\n            if len(current_level) > 1:\n                # Update level arrays for next pass\n                lower_level = current_level\n                current_level = []\n                \n                # Update deltaI and startI for next pass\n                startI += (deltaI >> 1)\n                deltaI <<= 1 # next power of 2\n        \n        # Root is now the only node in the current_level array\n        root = current_level[0]\n        tree.set_root(root)\n        return tree\n    \n    def get_alt_text(self):\n        return self._get_alt_text("Binary search tree")\n    \n    def get_bounding_box(self):\n        return self.get_subtree_bounding_box(self.root)\n    \n    def get_height(self):\n        if self.root != None:\n            return self.root.get_height()\n        return -1;\n    \n    def get_keys_in_insertion_order(self):\n        nodes = self.get_nodes_list()\n        keys = [None] * len(nodes)\n        \n        for node in nodes:\n            keys[node.insertion_index] = node.get_key()\n        \n        return keys\n    \n    def get_keys_in_sorted_order(self):\n        nodes = self.get_nodes_list()\n        return list(map(lambda n: n.get_key(), nodes))\n    \n    # Returns a list of keys from nodes visited during the search for the\n    # specified key. If found, the search key is included in the returned\n    # list as the last element.\n    def get_keys_visited_in_search(self, search_key):\n        result = []\n        node = self.root\n        while node != None:\n            # First add the node\'s key to the result\n            result.append(node.get_key())\n            \n            if node.get_key() == search_key:\n                return result\n            elif search_key < node.get_key():\n                node = node.get_left()\n            else:\n                node = node.get_right()\n        return result\n    \n    # Returns the number of keys in this tree in O(1) time.\n    def get_length(self):\n        if self.root != None:\n            return self.root.get_subtree_key_count()\n        return 0\n    \n    # Returns this tree\'s maximum key, or NaN if this tree is empty.\n    def get_max_key(self):\n        if self.root == None:\n            return math.nan\n        node = self.root\n        while node.get_right() != None:\n            node = node.get_right()\n        return node.get_key()\n    \n    # Returns this tree\'s minimum key, or NaN if this tree is empty.\n    def get_min_key(self):\n        if self.root == None:\n            return math.nan\n        node = self.root\n        while node.get_left() != None:\n            node = node.get_left()\n        return node.get_key()\n    \n    # Returns the first found node with the specified key, or None if no\n    # such node exists.\n    def get_node_with_key(self, key):\n        node = self.root\n        while node != None:\n            if node.get_key() == key:\n                return node\n            elif key < node.get_key():\n                node = node.get_left()\n            else:\n                node = node.get_right()\n        # Not found\n        return None\n    \n    def get_random_leaf_key(self, to_return_if_no_leaves):\n        random_leaf_node = self.get_random_leaf_node()\n        if random_leaf_node != None:\n            # Return the chosen leaf node\'s key\n            return random_leaf_node.get_key()\n        return to_return_if_no_leaves\n    \n    # Returns a randomly chosen leaf node from this tree, or None if this tree\n    # is empty.\n    def get_random_leaf_node(self):\n        # Get all leaf nodes\n        leaf_nodes = self.get_leaf_nodes()\n        \n        # Special case if no leaves exist (empty tree)\n        if 0 == len(leaf_nodes):\n            return None\n        \n        # Pick and return a random leaf node\n        return PBRandom.pick(leaf_nodes)\n    \n    def highlight_node_with_key(self, key, color = "rgb(255, 255, 0)"):\n        node = self.get_node_with_key(key)\n        if node != None:\n            self.render_info["nodesToHighlight"].add(node)\n            node.render_info["bgColorLight"] = color\n            return True\n        return False\n    \n    def insert_key(self, key):\n        if self.contains_key(key):\n            # Duplicates not allowed in this implementation\n            return False\n        \n        # Allocate the node to insert\n        new_node = self.alloc_node(key)\n        \n        # Special case for empty tree\n        if self.root == None:\n            self.root = new_node\n            \n            # Positioning is calculated such that the root node\'s center is\n            # always (0,0). Tree rendering algorithms can shift the tree as\n            # desired.\n            self.root.set_render_center(0, 0)\n            \n            return True\n        \n        inserted = False\n        ancestors = []\n        parent = self.root\n        while not inserted:\n            ancestors.append(parent)\n            \n            if key < parent.get_key():\n                # Go left\n                if parent.get_left() != None:\n                    parent = parent.get_left()\n                else:\n                    parent.set_left(new_node)\n                    inserted = True\n            else:\n                # Go right\n                if parent.get_right() != None:\n                    parent = parent.get_right()\n                else:\n                    parent.set_right(new_node)\n                    inserted = True\n        \n        # Call descendant_changed() on each ancestor from the bottom up\n        while len(ancestors) > 0:\n            ancestor = ancestors.pop()\n            ancestor.descendant_changed()\n        \n        # Insertion of a new node can change the position of many nodes in\n        # the tree. So after each insertion, all node positions are\n        # updated.\n        self._position_all_nodes()\n        \n        return True\n    \n    def remove_key(self, key):\n        return self._remove_key(key, self.root, None)\n    \n    # Replaces an existing key in the tree with a new key. This method will\n    # allow any new key, including a key that violates BST requirements. So\n    # use this method with caution.\n    def replace_key(self, existing_key, new_key):\n        node = self.get_node_with_key(existing_key)\n        if node == None:\n            return False\n        node.set_key(new_key)\n        return True\n    \n    # Performs a left rotation at the given node. Returns the\n    # subtree\'s new root.\n    def rotate_left(self, node):\n        parent = node.get_parent()\n        right_child = node.get_right()\n        right_left_child = right_child.get_left()\n        \n        # Replace necessary children from the bottom up\n        node.set_right(right_left_child)\n        right_child.set_left(node)\n        if parent != None:\n            parent.replace_child(node, right_child)\n        else:\n            self.root = right_child\n            self.root.set_parent_to_none()\n        return node.get_parent()\n    \n    # Performs a right rotation at the given node. Returns the\n    # subtree\'s new root.\n    def rotate_right(self, node):\n        parent = node.get_parent()\n        left_child = node.get_left()\n        left_right_child = left_child.get_right()\n        \n        # Replace necessary children from the bottom up\n        node.set_left(left_right_child)\n        left_child.set_right(node)\n        if parent != None:\n            parent.replace_child(node, left_child)\n        else:\n            self.root = left_child\n            self.root.set_parent_to_none()\n        \n        return node.get_parent()\n    \n    def set_show_node_heights(self, show):\n        self.render_info["showNodeHeights"] = show\n        self._position_all_nodes()\n    \n    @staticmethod\n    def shift_subtree(node, shift_x, shift_y):\n        nodes = [node]\n        while len(nodes) > 0:\n            node = nodes.pop()\n            if node != None:\n                cx = node.get_center_x()\n                cy = node.get_center_y()\n                node.set_render_center(cx + shift_x, cy + shift_y)\n                nodes.append(node.get_left())\n                nodes.append(node.get_right())\n    \n    # Finds a node\'s successor and that successor\'s parent and returns a\n    # (successor_node, successor_node_parent) tuple. The node MUST have a right\n    # child.\n    def _get_successor_and_parent(self, node):\n        parent = node\n        successor = node.get_right()\n        while successor.get_left() != None:\n            parent = successor\n            successor = successor.get_left()\n        return (successor, parent)\n    \n    def _remove_key(self, key, node, parent):\n        if node == None:\n            return False\n        \n        if key < node.get_key():\n            # Go left\n            return self._remove_key(key, node.get_left(), node)\n        elif key > node.get_key():\n            # Go right\n            return self._remove_key(key, node.get_right(), node)\n        \n        # If key is in a leaf, remove the leaf\n        if node.is_leaf():\n            if parent == None:\n                self.root = None\n            else:\n                parent.replace_child(node, None)\n            return True\n        \n        # If node has only a left child, then replace node with node\'s left\n        if node.get_right() == None:\n            if parent == None:\n                self.root = node.get_left()\n            else:\n                parent.replace_child(node, node.get_left())\n            return True\n        \n        # If node has only a right child, then replace node with node\'s right\n        if node.get_left() == None:\n            if parent == None:\n                self.root = node.get_right()\n            else:\n                parent.replace_child(node, node.get_right())\n            return True\n        \n        # Get the successor and successor\'s parent\n        sucessor_and_parent = self._get_successor_and_parent(node)\n        successor = sucessor_and_parent[0]\n        \n        # Get successor\'s key, remove successor, and replace node\'s key\n        successor_key = successor.get_key()\n        self._remove_key(successor_key, successor, sucessor_and_parent[1])\n        node.set_key(successor_key)\n        return True\n\nclass PBAVLTree(PBBinarySearchTree):\n    def __init__(self, tree_to_copy = None):\n        PBBinarySearchTree.__init__(self, tree_to_copy)\n    \n    @staticmethod\n    def create_from_keys(keys):\n        tree = PBAVLTree()\n        for key in keys:\n            tree.insert_key(key)\n        return tree\n    \n    # Creates and returns a PBBinarySearchTree with a random collection of\n    # keys. The first two parameters, min_key_count and max_key_count, are\n    # required. Each is inclusive. Each must be a positive integer with\n    # max_key_count >= min_key_count. Parameters min_key and max_key are\n    # optional and default to 10 and 99, respectively.\n    @staticmethod\n    def create_random(min_key_count, max_key_count, min_key = 10, max_key = 99):\n        # Determine the actual key count\n        actual_key_count = PBRandom.get_int_inclusive(\n            min_key_count, max_key_count)\n        \n        tree = PBAVLTree()\n        \n        # Special case if bad arguments cause an invalid key count\n        if actual_key_count < 1:\n            return tree\n        \n        # Add random keys until at the desired length\n        while tree.get_length() < actual_key_count:\n            tree.insert_key(PBRandom.get_int_inclusive(min_key, max_key))\n        \n        return tree\n    \n    def get_alt_text(self):\n        return self._get_alt_text("AVL tree")\n    \n    def insert_key(self, key):\n        if self.contains_key(key):\n            # Duplicates not allowed in this AVL tree implementation\n            return False\n        \n        # Step 1: Normal BST insertion\n        PBBinarySearchTree.insert_key(self, key)\n        \n        # Step 2: Rebalance\n        node = self.get_node_with_key(key).get_parent()\n        while node != None:\n            self.rebalance(node)\n            node = node.get_parent()\n        \n        # Rebalancing may have changed the tree, so all nodes should be\n        # positioned again\n        self._position_all_nodes()\n        \n        return True\n    \n    # Updates the given node\'s height and rebalances the subtree if the\n    # balance factor is now -2 or +2. Rebalancing is done by performing a\n    # rotation.\n    def rebalance(self, node):\n        # Check for an imbalance\n        node_balance = PBAVLTree._get_balance(node)\n        if -2 == node_balance:\n            # Right subtree is too big\n            if 1 == PBAVLTree._get_balance(node.get_right()):\n                # Double rotation case. First do a right rotation on the right\n                # child.\n                self.rotate_right(node.get_right())\n            # A left rotation will now make the subtree balanced\n            self.rotate_left(node)\n        elif 2 == node_balance:\n            # Left subtree is too big\n            if -1 == PBAVLTree._get_balance(node.get_left()):\n                # Double rotation case. First do a left rotation on the\n                # left child.\n                self.rotate_left(node.get_left())\n            # A right rotation will now make the subtree balanced\n            self.rotate_right(node)\n    \n    # Attempts to remove the specified key from this tree. If the key does not\n    # exist in this tree then nothing is done and False is returned. Otherwise\n    # the key is removed and True is returned.\n    def remove_key(self, key):\n        node = self.get_node_with_key(key)\n        if node == None:\n            return False\n        return self.remove_node(node)\n    \n    def remove_node(self, node_to_remove):\n        # Base case:\n        if node_to_remove == None:\n            return False\n        \n        # node_to_remove\'s parent is needed for rebalancing\n        parent = node_to_remove.get_parent()\n        \n        # Case 1: Internal node with 2 children\n        if node_to_remove.get_left() != None and node_to_remove.get_right() != None:\n            # Find successor\n            successor_node = node_to_remove.get_right()\n            while successor_node.get_left() != None:\n                successor_node = successor_node.get_left()\n            \n            # Copy the value from the node\n            node_to_remove.set_key(successor_node.get_key())\n            \n            # Recursively remove successor\n            self.remove_node(successor_node)\n            \n            # Nothing left to do since the recursive call will have rebalanced\n            return True\n        \n        # Case 2: Root node (with 1 or 0 children)\n        elif node_to_remove is self.root:\n            if node_to_remove.get_left() != None:\n                self.root = node_to_remove.get_left()\n            else:\n                self.root = node_to_remove.get_right()\n            \n            if self.root != None:\n                self.root.set_parent_to_none()\n            \n            return True\n        \n        # Case 3: Internal with left child only\n        elif node_to_remove.get_left() != None:\n            parent.replace_child(node_to_remove, node_to_remove.get_left())\n        \n        # Case 4: Internal with right child only OR leaf\n        else:\n            parent.replace_child(node_to_remove, node_to_remove.get_right())\n        \n        # Anything that persists below node_to_remove is already correctly\n        # balanced, but ancestors of node_to_remove may need rebalancing\n        node_to_rebalance = parent\n        while node_to_rebalance != None:\n            self.rebalance(node_to_rebalance)\n            node_to_rebalance = node_to_rebalance.get_parent()\n        \n        return True\n    \n    @staticmethod\n    def _get_balance(node):\n        # Get current height of left subtree, or -1 if None\n        left_height = -1\n        if node.get_left():\n            left_height = node.get_left().get_height()\n\n        # Get current height of right subtree, or -1 if None\n        right_height = -1\n        if node.get_right():\n            right_height = node.get_right().get_height()\n\n        # Calculate and return the balance factor\n        return left_height - right_height\n\nclass PBRBTNode(PBBSTNode):\n    def __init__(self, key, parent, is_red = False):\n        PBBSTNode.__init__(self, key, parent)\n        self._is_red = is_red\n        # Set the render_info dictionary\'s colors appropriately\n        if is_red:\n            self.set_color_to_red()\n        else:\n            self.set_color_to_black()\n    \n    def get_color_string(self, capitalized = False):\n        if self._is_red:\n            return "Red" if capitalized else "red"\n        return "Black" if capitalized else "black"\n    \n    def get_grandparent(self):\n        if self.parent != None:\n            return self.parent.parent\n        return None\n    \n    def get_sibling(self):\n        if self.parent != None:\n            if self is self.parent.left:\n                return self.parent.right\n            return self.parent.left\n        return None\n    \n    def get_uncle(self):\n        grandparent = self.get_grandparent()\n        if grandparent != None:\n            if self.parent is grandparent.get_left():\n                return grandparent.get_right()\n            return grandparent.get_left()\n        return None\n    \n    def is_black(self):\n        return not self._is_red\n    \n    def is_parent_none(self):\n        return self.parent == None\n    \n    def is_red(self):\n        return self._is_red\n    \n    # Sets this node\'s color to black. Returns this node to allow chaining.\n    def set_color_to_black(self):\n        self._is_red = False\n        # Background is solid black in either light or dark mode\n        self.render_info["bgColorLight"] = "rgb(0,0,0)"\n        self.render_info["bgColorDark"] = "rgb(0,0,0)"\n        # Border is black in light mode, white in dark mode\n        self.render_info["borderColorLight"] = "rgb(0,0,0)"\n        self.render_info["borderColorDark"] = "rgb(255,255,255)"\n        # Text is white in both modes\n        self.render_info["textColorLight"] = "rgb(255,255,255)"\n        self.render_info["textColorDark"] = "rgb(255,255,255)"\n        return self\n    \n    # Sets this node\'s color to red. Returns this node to allow chaining.\n    def set_color_to_red(self):\n        self._is_red = True\n        # Background is "rgb(220,5,5)" light mode, "rgb(200,0,0)" in dark mode\n        self.render_info["bgColorLight"] = "rgb(220,5,5)"\n        self.render_info["bgColorDark"] = "rgb(200,0,0)"\n        # Border is red in light mode, white in dark mode\n        self.render_info["borderColorLight"] = "rgb(220,5,5)"\n        self.render_info["borderColorDark"] = "rgb(255,255,255)"\n        # Text is white in both modes\n        self.render_info["textColorLight"] = "rgb(255,255,255)"\n        self.render_info["textColorDark"] = "rgb(255,255,255)"\n        return self\n\nclass PBRedBlackTree(PBBinarySearchTree):\n    def __init__(self, tree_to_copy = None):\n        PBBinarySearchTree.__init__(self)\n        \n        # For internal use only - make a deep copy if the argument is a tree\n        if isinstance(tree_to_copy, PBRedBlackTree):\n            # Copy tree nodes\n            self.root = PBRedBlackTree._duplicate_subtree(tree_to_copy.root)\n            self._insertion_index = tree_to_copy._insertion_index\n            \n            # Copy render_info dictionary\n            for key in tree_to_copy.render_info:\n                value = tree_to_copy.render_info[key]\n                if isinstance(value, set):\n                    # Each set in render_info is a set of nodes. Since a deep\n                    # copy is required, each set must be populated with nodes\n                    # from this tree itself.\n                    target_set = set()\n                    self.render_info[key] = target_set\n                    for other_node in value:\n                        our_node = self.get_node_with_key(other_node.get_key())\n                        target_set.add(our_node)\n                else:\n                    self.render_info[key] = value\n    \n    @staticmethod\n    def _duplicate_subtree(node, parent_from_this_tree = None):\n        new_node = PBRBTNode(node.get_key(), parent_from_this_tree)\n        new_node._is_red = node._is_red\n        new_node.render_info = dict(node.render_info)\n        return new_node\n    \n    # Method for allocating a new node for this tree\n    def alloc_node(self, key):\n        new_node = PBRBTNode(key, None, True)\n        new_node.insertion_index = self._insertion_index\n        self._insertion_index += 1\n        return new_node\n    \n    @staticmethod\n    def create_from_keys(keys):\n        tree = PBRedBlackTree()\n        for key in keys:\n            tree.insert_key(key)\n        return tree\n    \n    # Override of parent class\'s get_alt_text()\n    def get_alt_text(self):\n        # Special case if root is None\n        if self.root == None:\n            return ""\n        \n        node_count = self.get_length()\n        text = "Red-black tree with " + str(node_count) + " node"\n        if node_count != 1:\n            text += "s"\n        text += (": Root is " + self.root.get_color_string() + " with key " +\n            str(self.root.get_key()) + ".")\n        \n        # Process remaining nodes\n        parents = [self.root]\n        while len(parents) > 0:\n            parent = parents.pop()\n            left = parent.get_left()\n            right = parent.get_right()\n            text += (" Node {0} is ".format(parent.get_key()) +\n                parent.get_color_string())\n            if left != None and right != None:\n                text += (" with left child {0} and ".format(left.get_key()) +\n                    "right child " + str(right.get_key()) + ".")\n                parents.append(left)\n                parents.append(right)\n            elif left != None:\n                text += (" with left child " + str(left.get_key()) + ".")\n                parents.append(left)\n            elif right != None:\n                text += (" with right child " + str(right.get_key()) + ".")\n                parents.append(right)\n            else:\n                text += "."\n        \n        # Add information about highlighted nodes\n        if 1 == len(self.render_info["nodesToHighlight"]):\n            highlighted_key = None\n            for node in self.render_info["nodesToHighlight"]:\n                highlighted_key = node.get_key()\n            text += " Node " + str(highlighted_key) + " is highlighted."\n        elif len(self.render_info["nodesToHighlight"]) > 1:\n            text += " The following nodes are highlighted: "\n            added_first = False\n            for node in self.render_info["nodesToHighlight"]:\n                key = node.get_key()\n                if added_first:\n                    text += (", " + str(key))\n                else:\n                    text += str(key)\n                    added_first = True\n            text += "."\n        return text\n    \n    def highlight_node_with_key(self, key):\n        node = self.get_node_with_key(key);\n        if node != None:\n            # Changing the node\'s background or border color are not good\n            # options for a red-black tree node. So the node is added to the\n            # "nodesToHighlight" set and the highlight is applied during\n            # rendering of the tree.\n            self.render_info["nodesToHighlight"].add(node)\n            return True\n        return False\n    \n    def insert_key(self, key):\n        if self.contains_key(key):\n            # Duplicates not allowed\n            return False\n        \n        # Start with normal BST insertion\n        if not PBBinarySearchTree.insert_key(self, key):\n            return False\n        \n        # Get the node just inserted\n        new_node = self.get_node_with_key(key)\n        \n        # Color the node red, then balance\n        new_node.set_color_to_red()\n        self._insertion_balance(new_node)\n        \n        # Position all nodes and then return True\n        self._position_all_nodes()\n        return True\n    \n    # Performs a left rotation at the given node\n    def rotate_left(self, node):\n        parent = node.get_parent()\n        right_child = node.get_right()\n        right_left_child = right_child.get_left()\n        \n        # Replace necessary children from the bottom up\n        node.set_right(right_left_child)\n        right_child.set_left(node)\n        if parent != None:\n            parent.replace_child(node, right_child)\n        else:\n            self.root = right_child\n            self.root.set_parent_to_none()\n        \n        return node.get_parent()\n    \n    # Performs a right rotation at the given node\n    def rotate_right(self, node):\n        parent = node.get_parent()\n        left_child = node.get_left()\n        left_right_child = left_child.get_right()\n        \n        # Replace necessary children from the bottom up\n        node.set_left(left_right_child)\n        left_child.set_right(node)\n        if parent != None:\n            parent.replace_child(node, left_child)\n        else:\n            self.root = left_child\n            self.root.set_parent_to_none()\n        \n        return node.get_parent()\n    \n    # Returns a Python dictionary with four keys:\n    #\n    # "renderables":\n    #   The corresponding value is a list of objects, each also a Python\n    #   dictionary, to render. Each object has a "renderType" key and a\n    #   corresponding value indicating the type of object to render (exs:\n    #   "line" or "rectangle").\n    #\n    # "alt":\n    #   Corresponding value is a string for the rendered content\'s alt text.\n    #\n    # "renderables_dark":\n    #   List of renderables for dark mode.\n    #\n    # "alt_dark":\n    #   Alt text for dark mode.\n    def get_renderables(self):\n        # Use parent class to get all renderables for the entire tree\n        result = PBBinarySearchTree.get_renderables(self)\n        \n        # Highlight each node in the nodesToHighlight set\n        for node in self.render_info["nodesToHighlight"]:\n            r = node.render_info["width"] / 2.0\n            \n            # Add an orange circle around the node\n            for lst in [result["renderables"], result["renderables_dark"]]:\n                lst.append({\n                    "renderType": "ring",\n                    "centerX": node.get_center_x(),\n                    "centerY": node.get_center_y(),\n                    "innerRadius": r + 2,\n                    "outerRadius": r + 4,\n                    "backgroundColor": "rgb(255,128,0)"\n                })\n        return result\n    \n    def _insertion_balance(self, node):\n        parent = node.get_parent()\n        \n        # If node is the tree\'s root, then color node black and return\n        if parent == None:\n            node.set_color_to_black()\n            return\n        # If parent is black, then return without any changes\n        if parent.is_black():\n            return\n        \n        # References to grandparent and uncle are needed for remaining\n        # operations\n        grandparent = node.get_grandparent()\n        uncle = node.get_uncle()\n        \n        # If parent and uncle are both red, then color parent and uncle black,\n        # color grandparent red, recursively balance  grandparent, then return\n        if uncle != None and uncle.is_red():\n            uncle.set_color_to_black()\n            parent.set_color_to_black()\n            grandparent.set_color_to_red()\n            self._insertion_balance(grandparent)\n            return\n        \n        # If node is parent\'s right child and parent is grandparent\'s left\n        # child, then rotate left at parent, reassign node with parent, and\n        # reassign parent with node\'s parent\n        if node is parent.get_right() and parent is grandparent.get_left():\n            self.rotate_left(parent)\n            node = parent\n            parent = node.get_parent()\n        # Else if node is parent\'s left child and parent is grandparent\'s\n        # right child, then rotate right at parent, reassign node with parent,\n        # and reassign parent with node\'s parent\n        elif node is parent.get_left() and parent is grandparent.get_right():\n            self.rotate_right(parent)\n            node = parent\n            parent = node.get_parent()\n        \n        # Color parent black and grandparent red\n        parent.set_color_to_black()\n        grandparent.set_color_to_red()\n        \n        # If node is parent\'s left child, then rotate right at grandparent,\n        # otherwise rotate left at grandparent\n        if node is parent.get_left():\n            self.rotate_right(grandparent)\n        else:\n            self.rotate_left(grandparent)\n',"src/lib/imputil.py":'raise NotImplementedError("imputil is not yet implemented in Skulpt")\n',"src/lib/glob.py":'raise NotImplementedError("glob is not yet implemented in Skulpt")\n',"src/lib/meb/SaturatedWaterTemperature.py":"class SaturatedWaterTemperature:\n    def __init__(self, properties):\n        self.T = properties[0] # degrees C\n        self.P = properties[1] # kPa\n        self.vf = properties[2] # m^3/kg\n        self.vg = properties[3] # m^3/kg\n        self.uf = properties[4] # kJ/kg\n        self.ug = properties[5] # kJ/kg\n        self.ufg = properties[6] # kJ/kg\n        self.hf = properties[7] # kJ/kg\n        self.hg = properties[8] # kJ/kg\n        self.hfg = properties[9] # kJ/kg\n        self.sf = properties[10] # kJ/kg*K\n        self.sg = properties[11] # kJ/kg*K\n        self.sfg = properties[12] # kJ/kg*K\n\nsaturated_water_temperature_property_to_index = {\n    'T': 0,\n    'P': 1,\n    'vf': 2,\n    'vg': 3,\n    'uf': 4,\n    'ug': 5,\n    'ufg': 6,\n    'hf': 7,\n    'hg': 8,\n    'hfg': 9,\n    'sf': 10,\n    'sg': 11,\n    'sfg': 12,\n}\n\nsaturated_water_temperatures = [\n    [ 0.01, 0.612, 0.001000, 205.99, 0.000, 2374.9, 2374.9, 0.001, 2500.9, 2500.9, 0.0000, 9.1555, 9.1555 ],\n    [ 5, 0.873, 0.001000, 147.01, 21.019, 2381.8, 2360.8, 21.020, 2510.1, 2489.1, 0.0763, 9.0248, 8.9485 ],\n    [ 10, 1.228, 0.001000, 106.30, 42.020, 2388.6, 2346.6, 42.021, 2519.2, 2477.2, 0.1511, 8.8998, 8.7487 ],\n    [ 15, 1.706, 0.001001, 77.875, 62.980, 2395.5, 2332.5, 62.981, 2528.3, 2465.3, 0.2245, 8.7803, 8.5558 ],\n    [ 20, 2.339, 0.001002, 57.757, 83.912, 2402.3, 2318.4, 83.914, 2537.4, 2453.5, 0.2965, 8.6660, 8.3695 ],\n    [ 25, 3.170, 0.001003, 43.337, 104.83, 2409.1, 2304.3, 104.83, 2546.5, 2441.7, 0.3672, 8.5566, 8.1894 ],\n    [ 30, 4.247, 0.001004, 32.878, 125.73, 2415.9, 2290.2, 125.73, 2555.5, 2429.8, 0.4368, 8.4520, 8.0153 ],\n    [ 35, 5.629, 0.001006, 25.205, 146.63, 2422.7, 2276.1, 146.63, 2564.5, 2417.9, 0.5051, 8.3517, 7.8466 ],\n    [ 40, 7.385, 0.001008, 19.515, 167.53, 2429.4, 2261.9, 167.53, 2573.5, 2406.0, 0.5724, 8.2555, 7.6831 ],\n    [ 45, 9.595, 0.001010, 15.252, 188.43, 2436.1, 2247.7, 188.43, 2582.4, 2394.0, 0.6386, 8.1633, 7.5247 ],\n    [ 50, 12.352, 0.001012, 12.027, 209.33, 2442.7, 2233.4, 209.34, 2591.3, 2382.0, 0.7038, 8.0748, 7.3710 ],\n    [ 55, 15.762, 0.001015, 9.5643, 230.24, 2449.3, 2219.1, 230.26, 2600.1, 2369.8, 0.7680, 7.9898, 7.2218 ],\n    [ 60, 19.946, 0.001017, 7.6672, 251.16, 2455.9, 2204.7, 251.18, 2608.8, 2357.6, 0.8313, 7.9081, 7.0768 ],\n    [ 65, 25.042, 0.001020, 6.1935, 272.09, 2462.4, 2190.3, 272.12, 2617.5, 2345.4, 0.8937, 7.8296, 6.9360 ],\n    [ 70, 31.201, 0.001023, 5.0395, 293.03, 2468.9, 2175.9, 293.07, 2626.1, 2333.0, 0.9551, 7.7540, 6.7989 ],\n    [ 75, 38.595, 0.001026, 4.1289, 313.99, 2475.2, 2161.2, 314.03, 2634.6, 2320.6, 1.0158, 7.6812, 6.6654 ],\n    [ 80, 47.414, 0.001029, 3.4052, 334.96, 2481.6, 2146.6, 335.01, 2643.0, 2308.0, 1.0756, 7.6111, 6.5355 ],\n    [ 85, 57.867, 0.001032, 2.8258, 355.95, 2487.8, 2131.9, 356.01, 2651.3, 2295.3, 1.1346, 7.5434, 6.4088 ],\n    [ 90, 70.182, 0.001036, 2.3591, 376.97, 2494.0, 2117.0, 377.04, 2659.5, 2282.5, 1.1929, 7.4781, 6.2852 ],\n    [ 95, 84.608, 0.001040, 1.9806, 398.00, 2500.0, 2102.0, 398.09, 2667.6, 2269.5, 1.2504, 7.4151, 6.1647 ],\n    [ 100, 101.42, 0.001044, 1.6718, 419.06, 2506.0, 2086.9, 419.17, 2675.6, 2256.4, 1.3072, 7.3541, 6.0469 ],\n    [ 105, 120.90, 0.001047, 1.4184, 440.15, 2511.9, 2071.8, 440.27, 2683.4, 2243.1, 1.3633, 7.2952, 5.9319 ],\n    [ 110, 143.38, 0.001052, 1.2093, 461.26, 2517.7, 2056.4, 461.42, 2691.1, 2229.7, 1.4188, 7.2381, 5.8193 ],\n    [ 115, 169.18, 0.001056, 1.0358, 482.41, 2523.3, 2040.9, 482.59, 2698.6, 22
ion:null,tests:[{stdin:null,args:null,out:{type:"std",value:null}}]}]}},{name:"Hidden text files",options:{global:"import random",language:"java",levels:[{explanation:null,files:[{content:[{editable:!1,solution:null,template:'import java.io.File;\nimport java.io.FileNotFoundException;\nimport java.io.PrintWriter;\nimport java.util.Scanner;\n\n/**\n   This program reads a file with numbers, and writes the numbers to another\n   file, lined up in a column and followed by their average.\n*/\npublic class Total\n{\n   public static void main(String[] args) throws FileNotFoundException\n   {\n      // Prompt for the input and output file names\n      Scanner console = new Scanner(System.in);\n      System.out.print("Input file: ");\n      String inputFileName = console.next();\n      System.out.print("Output file: ");\n      String outputFileName = console.next();\n\n      // Construct the Scanner and PrintWriter objects for reading and writing\n      File inputFile = new File(inputFileName);\n      Scanner in = new Scanner(inputFile);\n      PrintWriter out = new PrintWriter(outputFileName);\n'},{editable:!0,solution:'\n      // Read the input and write the output\n      double total = 0;\n      int counter = 0;\n\n      while (in.hasNextDouble())\n      {\n         double value = in.nextDouble();\n         out.printf("%17.2f\\n", value);\n         total = total + value;\n         counter = counter + 1;\n      }\n\n      out.printf("Average: %10.2f\\n", total / counter);\n',template:'\n      // Read the input and write the output\n      double total = 0;\n\n      while (in.hasNextDouble())\n      {\n         double value = in.nextDouble();\n         out.printf("%17.2f\\n", value);\n         total = total + value;\n      }\n\n      out.printf("Total: %10.2f\\n", total);\n'},{editable:!1,solution:null,template:"\n      in.close();\n      out.close();\n   }\n}"}],hide:!1,input:!1,main:!0,name:"Total.java"},{content:[{editable:!1,solution:null,template:"32.00\n54.00\n67.50\n29.00\n35.00\n80.00\n115.00\n44.50\n100.00\n65.00\n"}],hide:!1,input:!0,main:!1,name:"numbers.txt"},{content:[{editable:!1,solution:null,template:"32.00\n54.00\n67.50\n29.00\n35.00\n80.00\n115.00\n44.50\n100.00\n65.00\n"}],hide:!0,input:!0,main:!1,name:"numbers2.txt"}],prompt:"Modify the Total program so that it shows the average, not the total of the inputs.",randomization:{distractor:"def make_distractor_permutation(meaningful_permutation):\n    return {}",meaningful:"def make_meaningful_permutation():\n    return {}",setup:null,test:"def make_test_permutation(meaningful_permutation, distractor_permutation):\n    return {}"},tests:[{args:null,out:{type:"file",value:"output.txt"},stdin:"numbers.txt\noutput.txt"}]}]}},{name:"R: Basic output",options:{global:"import random",language:"r",levels:[{files:[{content:[{editable:!1,template:""},{editable:!0,solution:'write("This ${meaningful.noun} ${meaningful.verb} ${meaningful.adjective}.", stdout())',template:"# Your code goes here"},{editable:!1,template:""}],input:!1,main:!0,name:"basic.R"}],randomization:{test:"\ndef make_test_permutation(meaningful_permutation, distractor_permutation):\n    return {}\n",setup:"\nnouns = ['day', 'week', 'month', 'year', 'soup', 'dessert', 'cake', 'meal', 'salad', 'dinner', 'lunch', 'breakfast', 'weekend']\nverbs = ['is', 'was', 'will be']\nadjectives = ['good', 'awesome', 'great', 'superb', 'nice', 'wonderful', 'excellent', 'marvelous', 'satisfying']\n",meaningful:"\ndef make_meaningful_permutation():\n    return {\n        'noun': random.choice(nouns),\n        'verb': random.choice(verbs),\n        'adjective': random.choice(adjectives),\n    }\n",distractor:"\ndef make_distractor_permutation(meaningful_permutation):\n    return {}\n"},prompt:"Write code that outputs the following. End with a newline.\n\n`This ${meaningful.noun} ${meaningful.verb} ${meaningful.adjective}.`",explanation:null,tests:[{stdin:null,args:null,out:{type:"std",value:null}}]}]}}],e.codeWritingOptionsInvalid=[{name:"Invalid CodeWriting",options:{global:"import random\nfrom common_functions import pick_from, pick_from_range\n\nint_list = list(range(-50, 51))\nchar_list = [\n    &apos;B&apos;, &apos;C&apos;, &apos;D&apos;, &apos;E&apos;, &apos;F&apos;, &apos;G&apos;, &apos;H&apos;, &apos;J&apos;, &apos;K&apos;, &apos;M&apos;, &apos;N&apos;, &apos;P&apos;, &apos;Q&apos;, &apos;R&apos;, &apos;S&apos;, &apos;T&apos;, &apos;V&apos;, &apos;W&apos;, &apos;X&apos;, &apos;Y&apos;, &apos;Z&apos;, \n    &apos;b&apos;, &apos;c&apos;, &apos;d&apos;, &apos;e&apos;, &apos;f&apos;, &apos;g&apos;, &apos;h&apos;, &apos;j&apos;, &apos;k&apos;, &apos;m&apos;, &apos;n&apos;, &apos;p&apos;, &apos;q&apos;, &apos;r&apos;, &apos;s&apos;, &apos;t&apos;, &apos;v&apos;, &apos;w&apos;, &apos;x&apos;, &apos;y&apos;, &apos;z&apos;, \n]\n\ndtype_dict_dict = {\n    &apos;char&apos;: {\n        &apos;postfix_str&apos;: &apos;acter&apos;, \n        &apos;comparator_list&apos;: [&apos;q&apos;, &apos;s&apos;, &apos;e&apos;], \n        &apos;comparison_list&apos;: [&apos;!=&apos;], \n        &apos;data_list&apos;: char_list, \n        &apos;fstr&apos;: &apos;&quot;{}&quot;&apos;, \n    }, \n    &apos;int&apos;: {\n        &apos;postfix_str&apos;: &apos;eger&apos;, \n        &apos;comparator_list&apos;: [-10, -1, 1, 10], \n        &apos;comparison_list&apos;: [&apos;!=&apos;, &apos;&lt;&apos;, &apos;&gt;&apos;, &apos;&lt;=&apos;, &apos;&gt;=&apos;],\n        &apos;data_list&apos;: int_list, \n        &apos;fstr&apos;: &apos;{}&apos;, \n    }, \n    &apos;float&apos;: {\n        &apos;postfix_str&apos;: &apos;&apos;, \n        &apos;comparator_list&apos;: [-10.0, -1.0, 1.0, 10.0], \n        &apos;comparison_list&apos;: [&apos;&lt;&apos;, &apos;&gt;&apos;],\n        &apos;data_list&apos;: [(0.1 * i) for i in range(int_list[0] * 10, (int_list[-1] * 10) + 1)], \n        &apos;fstr&apos;: &apos;{:.1f}&apos;, \n    }, \n}\n\n\ndef get_article(noun):\n    return &apos;an&apos; if noun[0].lower() in &apos;aeiou&apos; else &apos;a&apos;\n\n\ndef get_test_dict(data_list, comparator_index, num_tests, ex_in_list, comparator, value_fstr, comparison):\n    # if comparison == &apos;!=&apos;:\n    valid_list = data_list[: comparator_index - 1] + data_list[comparator_index + 2 :]\n    input_list_list = [[None for _ in range(pick_from([3, 5]))] for _ in range(num_tests)]\n    for i in range(len(input_list_list)):\n        for j in range(len(input_list_list[i])):\n            input_list_list[i][j] = pick_from(valid_list, exclude=ex_in_list+sum(input_list_list, []))\n        \n        if i &gt; 0:\n            input_list_list[i][random.randrange(1, len(input_list_list[i]) - 1)] = comparator\n    \n    test_dict = {\n        &apos;test_case2&apos;: value_fstr.format(comparator), \n        &apos;test_case3&apos;: &apos;{}\\n{}&apos;.format(comparator, &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[0]])), \n        &apos;test_case4&apos;: &apos;\\n&apos;.join([value_fstr.format(data_list[i]) for i in range(comparator_index - 1, comparator_index + 2)]), \n        &apos;test_case5&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[1]]), \n        &apos;test_case6&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[2]]), \n        &apos;test_case7&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[3]]), \n    }\n    \n    if comparison == &apos;&gt;&apos;:\n        invalid_list = random.sample(set(data_list[: comparator_index - 1]) - set(ex_in_list), num_tests)\n        valid_list = data_list[comparator_index + 2 :]\n        input_list_list = [[None for _ in range(pick_from([3, 5]))] for _ in range(num_tests - 1)]\n        for i in range(len(input_list_list)):\n            for j in range(len(input_list_list[i])):\n                input_list_list[i][j] = pick_from(valid_list, exclude=ex_in_list+sum(input_list_list, []))\n            \n            input_list_list[i][random.randrange(1, len(input_list_list[i]) - 1)] = invalid_list[i + 1]\n        \n        test_dict = {\n            &apos;test_case2&apos;: value_fstr.format(comparator), \n            &apos;test_case3&apos;: value_fstr.format(invalid_list[0]), \n            &apos;test_case4&apos;: &apos;\\n&apos;.join([value_fstr.format(data_list[i]) for i in range(comparator_index + 1, comparator_index - 2, -1)]), \n            &apos;test_case5&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[0]]), \n            &apos;test_case6&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[1]]), \n            &apos;test_case7&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[2]]), \n        }\n    elif comparison == &apos;&lt;&apos;:\n        invalid_list = random.sample(set(data_list[comparator_index + 2 :]) - set(ex_in_list), num_tests)\n        valid_list = data_list[: comparator_index - 1]\n        input_list_list = [[None for _ in range(pick_from([3, 5]))] for _ in range(num_tests - 1)]\n        for i in range(len(input_list_list)):\n            for j in range(len(input_list_list[i])):\n                input_list_list[i][j] = pick_from(valid_list, exclude=ex_in_list+sum(input_list_list, []))\n            \n            input_list_list[i][random.randrange(1, len(input_list_list[i]) - 1)] = invalid_list[i + 1]\n        \n        test_dict = {\n            &apos;test_case2&apos;: value_fstr.format(comparator), \n            &apos;test_case3&apos;: value_fstr.format(invalid_list[0]), \n            &apos;test_case4&apos;: &apos;\\n&apos;.join([value_fstr.format(data_list[i]) for i in range(comparator_index - 1, comparator_index + 2)]), \n            &apos;test_case5&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[0]]), \n            &apos;test_case6&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[1]]), \n            &apos;test_case7&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[2]]), \n        }\n    elif comparison == &apos;&gt;=&apos;:\n        invalid_list = random.sample(set(data_list[: comparator_index - 1]) - set(ex_in_list), num_tests)\n        valid_list = data_list[comparator_index + 2 :]\n        input_list_list = [[None for _ in range(pick_from([3, 5]))] for _ in range(num_tests)]\n        for i in range(len(input_list_list)):\n            for j in range(len(input_list_list[i])):\n                input_list_list[i][j] = pick_from(valid_list, exclude=ex_in_list+sum(input_list_list, []))\n            \n            if i &gt; 0:\n                input_list_list[i][random.randrange(1, len(input_list_list[i]) - 1)] = invalid_list[i]\n        \n        input_list_list[0] = [0, 1] + input_list_list[0] + [-1]\n        \n        test_dict = {\n            &apos;test_case2&apos;: value_fstr.format(invalid_list[0]), \n            &apos;test_case3&apos;: &apos;\\n&apos;.join([value_fstr.format(data_list[i]) for i in range(comparator_index + 1, comparator_index - 2, -1)]), \n            &apos;test_case4&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[0]]), \n            &apos;test_case5&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[1]]), \n            &apos;test_case6&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[2]]), \n            &apos;test_case7&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[3]]), \n        }\n    elif comparison == &apos;&lt;=&apos;:\n        invalid_list = random.sample(set(data_list[comparator_index + 2 :]) - set(ex_in_list), num_tests)\n        valid_list = data_list[: comparator_index - 1]\n        input_list_list = [[None for _ in range(pick_from([3, 5]))] for _ in range(num_tests)]\n        for i in range(len(input_list_list)):\n            for j in range(len(input_list_list[i])):\n                input_list_list[i][j] = pick_from(valid_list, exclude=ex_in_list+sum(input_list_list, []))\n            \n            if i &gt; 0:\n                input_list_list[i][random.randrange(1, len(input_list_list[i]) - 1)] = invalid_list[i]\n        \n        input_list_list[0] = [0, -1] + input_list_list[0] + [1]\n        \n        test_dict = {\n            &apos;test_case2&apos;: value_fstr.format(invalid_list[0]), \n            &apos;test_case3&apos;: &apos;\\n&apos;.join([value_fstr.format(data_list[i]) for i in range(comparator_index - 1, comparator_index + 2)]), \n            &apos;test_case4&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[0]]), \n            &apos;test_case5&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[1]]), \n            &apos;test_case6&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[2]]), \n            &apos;test_case7&apos;: &apos;\\n&apos;.join([value_fstr.format(datum) for datum in input_list_list[3]]), \n        }\n    \n    return test_dict",levels:[{files:[{hide:!1,main:!0,name:"main.py",input:!1,content:[{editable:!1,solution:null,template:"${distractor.var} = ${distractor.input_func}\n"},{editable:!0,solution:"while ${distractor.var} ${meaningful.comparison} ${distractor.comparator_str}:",template:"while &quot;&quot;&quot; Your code goes here &quot;&quot;&quot;:"},{editable:!1,solution:null,template:"\n    print(f&quot;${distractor.inside_while_cout} {${distractor.var}}&quot;)\n    ${distractor.var} = ${distractor.input_func}\n\nprint(&quot;${distractor.outside_while_cout}&quot;)"}]}],tests:[{out:{type:"std",value:null},args:null,stdin:"${distractor.example_input}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case2}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case3}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case4}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case5}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case6}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case7}"}],prompt:"&lt;p&gt;A while loop reads ${distractor.data_type}s from input into variable ${distractor.var}. Write an expression that executes the while loop while ${distractor.comparator_prompt}.&lt;/p&gt;\n\n&lt;details&gt;&lt;summary style=&quot;color: #0277BD&quot;&gt;&lt;b&gt;Click here for example&lt;/b&gt;&lt;/summary&gt;\nEx: If the input is:\n```\n${distractor.example_input}\n```\nthen the output is:\n```\n${distractor.example_output}\n```\n&lt;/details&gt;\n\nNote: First, delete the comment &lt;code&gt;&quot;&quot;&quot; Your code goes here &quot;&quot;&quot;&lt;/code&gt;. Then, insert your expression for the while loop condition.",explanation:"&lt;p&gt;A while loop repeatedly executes while the loop&apos;s expression evaluates to True. Thus, the loop should iterate while ${distractor.comparator_prompt}. The loop will then terminate once ${distractor.comparator_prompt_opp}.&lt;/p&gt;",randomization:null},{files:[{hide:!1,main:!0,name:"main.py",input:!1,content:[{editable:!1,solution:null,template:"${distractor.result_var_assignment}${distractor.buffer}${distractor.input_var_name} = ${distractor.input_func}\n"},{editable:!0,solution:"while ${distractor.input_var_name} ${distractor.comparison} ${distractor.comparator_str}:\n    ${distractor.while_loop_line1}\n    ${distractor.while_loop_line2}",template:"\n&quot;&quot;&quot; Your code goes here &quot;&quot;&quot;\n"},{editable:!1,solution:null,template:"${distractor.cout}"}]}],tests:[{out:{type:"std",value:null},args:null,stdin:"${distractor.example_input}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case2}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case3}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case4}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case5}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case6}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case7}"}],prompt:"&lt;p&gt;${distractor.data_type_cap} ${distractor.input_var_name} is read from input. Write a while loop that ${distractor.purpose}${distractor.not_include}&lt;/p&gt;\n \n&lt;details&gt;&lt;summary style=&quot;color: #0277BD&quot;&gt;&lt;b&gt;Click here for example&lt;/b&gt;&lt;/summary&gt;\nEx: If the input is${distractor.ex_in}then the output is:\n```\n${distractor.example_output}\n```\n&lt;/details&gt;",explanation:"&lt;p&gt;While ${distractor.continuation}&lt;/p&gt;",randomization:{test:"def make_test_permutation(meaningful_permutation, distractor_permutation):\n    action = meaningful_permutation[&apos;action&apos;]\n    comparison = meaningful_permutation[&apos;comparison&apos;]\n    \n    data_list = distractor_permutation[&apos;data_list&apos;]\n    breaker = distractor_permutation[&apos;breaker&apos;]\n    comparator = distractor_permutation[&apos;comparator&apos;]\n    ex_in_list = distractor_permutation[&apos;ex_in_list&apos;]\n    value_fstr = distractor_permutation[&apos;value_fstr&apos;]\n    \n    # if action == &apos;update&apos;:\n    num_a = breaker\n    num_b = comparator\n    \n    all_data = list(set(data_list) - {num_a, num_b} - ex_in_list)\n    chosen_data = random.sample(all_data, 4)\n    neg_data = [x * -1 for x in all_data if x * -1 not in [num_a, num_b] + chosen_data]\n    \n    test_dict = {\n        &apos;test_case2&apos;: value_fstr.format(num_a),\n        &apos;test_case3&apos;: value_fstr.format(num_b),\n        &apos;test_case4&apos;: value_fstr.format(chosen_data[0]),\n        &apos;test_case5&apos;: value_fstr.format(chosen_data[1]),\n        &apos;test_case6&apos;: value_fstr.format(chosen_data[2]),\n        &apos;test_case7&apos;: value_fstr.format(chosen_data[3]),\n    }\n    \n    if comparison == &apos;&gt;&apos;:\n        test_dict[&apos;test_case7&apos;] = value_fstr.format(pick_from(neg_data))\n    \n    if action in [&apos;count&apos;, &apos;sum&apos;]:\n        test_dict = get_test_dict(data_list, data_list.index(comparator), 4, ex_in_list, comparator, value_fstr, comparison)\n    \n    return test_dict",setup:"op_dict_dict = {\n    &apos;+&apos;: {\n        &apos;present&apos;: &apos;add&apos;, \n        &apos;plural&apos;: &apos;adds&apos;, \n        &apos;preposition&apos;: &apos;to&apos;, \n        &apos;result&apos;: &apos;sum&apos;, \n        &apos;prompt_clause&apos;: &apos;{0} {1} {2}&apos;, \n        &apos;expl_clause&apos;: &apos;{0} {3} {2} {1}&apos;, \n        &apos;func&apos;: lambda num1, num2: num1 + num2, \n    },\n    &apos;-&apos;: {\n        &apos;present&apos;: &apos;subtract&apos;, \n        &apos;plural&apos;: &apos;subtracts&apos;, \n        &apos;preposition&apos;: &apos;from&apos;, \n        &apos;result&apos;: &apos;difference&apos;, \n        &apos;prompt_clause&apos;: &apos;{0} {1} {2}&apos;, \n        &apos;expl_clause&apos;: &apos;{0} {3} {2} {1}&apos;, \n        &apos;func&apos;: lambda num1, num2: num1 - num2, \n    },\n    &apos;*&apos;: {\n        &apos;present&apos;: &apos;multiply&apos;, \n        &apos;plural&apos;: &apos;multiplies&apos;, \n        &apos;preposition&apos;: &apos;by&apos;, \n        &apos;result&apos;: &apos;product&apos;, \n        &apos;prompt_clause&apos;: &apos;{2} {1} {0}&apos;, \n        &apos;expl_clause&apos;: &apos;{0} {1} {2} {3}&apos;, \n        &apos;func&apos;: lambda num1, num2: num1 * num2, \n    },\n    &apos;//&apos;: {\n        &apos;present&apos;: &apos;divide&apos;, \n        &apos;plural&apos;: &apos;divides&apos;, \n        &apos;preposition&apos;: &apos;by&apos;, \n        &apos;result&apos;: &apos;quotient&apos;, \n        &apos;prompt_clause&apos;: &apos;{2} {1} {0}, using the floor division operator (//)&apos;, \n        &apos;expl_clause&apos;: &apos;{0} {1} {2} {3}, using the floor division operator (//),&apos;, \n        &apos;func&apos;: lambda num1, num2: num1 // num2, \n    },\n    &apos;/&apos;: {\n        &apos;present&apos;: &apos;divide&apos;, \n        &apos;plural&apos;: &apos;divides&apos;, \n        &apos;preposition&apos;: &apos;by&apos;, \n        &apos;result&apos;: &apos;quotient&apos;, \n        &apos;prompt_clause&apos;: &apos;{2} {1} {0}, using the division operator (/)&apos;, \n        &apos;expl_clause&apos;: &apos;{0} {1} {2} {3}, using the division operator (/),&apos;, \n        &apos;func&apos;: lambda num1, num2: num1 / num2, \n    },\n}\n\ncomp_dict_dict = {\n    &apos;&lt;&apos;: {&apos;eng&apos;: &apos;greater than or equal to&apos;, &apos;opposite_comp&apos;: &apos;&gt;=&apos;}, \n    &apos;&gt;&apos;: {&apos;eng&apos;: &apos;less than or equal to&apos;, &apos;opposite_comp&apos;: &apos;&lt;=&apos;}, \n    &apos;&lt;=&apos;: {&apos;eng&apos;: &apos;greater than&apos;, &apos;opposite_comp&apos;: &apos;&gt;&apos;}, \n    &apos;&gt;=&apos;: {&apos;eng&apos;: &apos;less than&apos;, &apos;opposite_comp&apos;: &apos;&lt;&apos;}, \n    &apos;==&apos;: {&apos;eng&apos;: &apos;not equal to&apos;, &apos;opposite_comp&apos;: &apos;!=&apos;}, \n    &apos;!=&apos;: {&apos;eng&apos;: &apos;equal to&apos;, &apos;opposite_comp&apos;: &apos;==&apos;}, \n}",distractor:"def make_distractor_permutation(meaningful_permutation):\n    action = meaningful_permutation[&apos;action&apos;]\n    comparison = meaningful_permutation[&apos;comparison&apos;]\n    op = meaningful_permutation[&apos;op&apos;]\n    dtype = meaningful_permutation[&apos;dtype&apos;]\n    data_type = &apos;{}{}&apos;.format(dtype, dtype_dict_dict[dtype][&apos;postfix_str&apos;])\n    \n    comparator = pick_from(dtype_dict_dict[dtype][&apos;comparator_list&apos;])\n    if comparison in [&apos;&lt;=&apos;, &apos;&gt;=&apos;]:\n        comparator = 0\n        comparison = comparison.replace(&apos;=&apos;, &apos;&apos;)\n    \n    comparator_fstr = dtype_dict_dict[dtype][&apos;fstr&apos;]\n    value_fstr = comparator_fstr if dtype == &apos;float&apos; else &apos;{}&apos;\n    input_func = &apos;{}input(){}&apos;.format(&apos;&apos; if dtype == &apos;char&apos; else dtype+&apos;(&apos;, &apos;&apos; if dtype == &apos;char&apos; else &apos;)&apos;)\n    \n    data_list = dtype_dict_dict[dtype][&apos;data_list&apos;]\n    comparator_index = data_list.index(comparator)\n    comparator_str = comparator_fstr.format(comparator)\n    \n    var_name_tuple = (&apos;char&apos;, &apos;character&apos;) if dtype == &apos;char&apos; else (&apos;num&apos;, &apos;number&apos;)\n    input_var_name = pick_from([&apos;input_{0}&apos;, &apos;{0}_in&apos;, &apos;user_in&apos;, &apos;user_input&apos;, &apos;{0}_input&apos;, &apos;user_{0}&apos;, &apos;user_{1}&apos;])\n    input_var_name = input_var_name.format(var_name_tuple[0], var_name_tuple[1])\n    result_var_name = pick_from([&apos;sum_{}s&apos;, &apos;total_sum&apos;, &apos;{}_sum&apos;, &apos;result&apos;]).format(dtype)\n    \n    # if action == &apos;sum&apos;:\n    # if comparison == &apos;!=&apos;:\n    breaker = comparator\n    pre_breaker_ex_in_list = random.sample(set(data_list) - {breaker}, 4)\n    not_include = &apos; {} {}&apos;.format(data_type.capitalize(), comparator_str)\n    not_prompt = &apos; not&apos; if comparison == &apos;!=&apos; else &apos;&apos;\n    comparator_prompt = &apos;the {} {}&apos;.format(data_type, comparator_str)\n    if comparison == &apos;&gt;&apos;:\n        breaker = data_list[random.randrange(comparator_index - 1)]\n        pre_breaker_ex_in_list = random.sample(set(data_list[comparator_index + 2: ]) - {breaker}, 4)\n        \n        not_include = &apos; The {} that is less than or equal to {}&apos;.format(data_type, comparator_str)\n        comparator_prompt = &apos;the {} that is greater than {}&apos;.format(data_type, comparator_str)\n        if not comparator:\n            not_include = &apos; The negative integer&apos;\n            comparator_prompt = &apos;a positive integer&apos;\n    elif comparison == &apos;&lt;&apos;:\n        breaker = data_list[random.randrange(comparator_index + 2, len(data_list))]\n        pre_breaker_ex_in_list = random.sample(set(data_list[: comparator_index - 1]) - {breaker}, 4)\n        \n        not_include = &apos; The {} that is greater than or equal to {}&apos;.format(data_type, comparator_str)\n        comparator_prompt = &apos;the {} that is less than {}&apos;.format(data_type, comparator_str)\n        if not comparator:\n            not_include = &apos; The positive integer&apos;\n            comparator_prompt = &apos;a negative integer&apos;\n    \n    ex_in_list = pre_breaker_ex_in_list + [breaker]\n    example_input = &apos;\\n&apos;.join([value_fstr.format(ex_in) for ex_in in ex_in_list])\n    ex_in = &apos;:\\n```\\n{}\\n```\\n&apos;.format(example_input)\n    \n    example_output = &apos;&apos; if type(pre_breaker_ex_in_list[0]) == str else sum(pre_breaker_ex_in_list)\n    not_include = &apos;&lt;p&gt;{} should &lt;i&gt;not&lt;/i&gt; be included in the sum.&lt;/p&gt;&apos;.format(not_include)\n    purpose = &apos;reads values from input and casts the values into {}s, while {} is{} read. &apos;.format(data_type, comparator_prompt, not_prompt)\n    purpose += &apos;In each iteration:&lt;ul&gt;\\n&apos;\n    purpose += &apos;&lt;li&gt;Update {0} with the sum of {0} and {1}.&lt;/li&gt;\\n&apos;.format(result_var_name, input_var_name)\n    purpose += &apos;&lt;li&gt;Then, read the next {} from input into variable {}.&lt;/li&gt;\\n&lt;/ul&gt;\\n&apos;.format(data_type, input_var_name)\n    \n    result_var_assignment = &apos;{} = {}&apos;.format(result_var_name, value_fstr.format(0))\n    buffer_str = &apos;\\n&apos;\n    while_loop_line1 = &apos;{0} = {0} + {1}&apos;.format(result_var_name, input_var_name)\n    while_loop_line2 = &apos;{} = {}&apos;.format(input_var_name, input_func)\n    cout = &apos;\\nprint({})&apos;.format(result_var_name)\n\n    continuation = &apos;&lt;code&gt;{0} {3} {4}&lt;/code&gt; is True, the while loop continues to add {0} to {1}, followed by a newline.&apos;\\\n                    .format(input_var_name, result_var_name, comparator_prompt, comparison, comparator_str)\n    if action == &apos;count&apos;:\n        breaker = comparator\n        num_prefix_in_vals = pick_from_range(1, 2)\n        pre_breaker_ex_in_list = random.sample(set(data_list) - {breaker}, num_prefix_in_vals)\n        \n        ex_in_list = pre_breaker_ex_in_list + [breaker]\n        example_input = &apos;\\n&apos;.join([value_fstr.format(ex_in) for ex_in in ex_in_list])\n        ex_in = &apos;:\\n```\\n{}\\n```\\n&apos;.format(example_input)\n        \n        example_output = num_prefix_in_vals\n        not_include = &apos;&lt;p&gt;{} {} should &lt;i&gt;not&lt;/i&gt; be included in the count.&lt;/p&gt;&apos;.format(data_type.capitalize(), comparator_str)\n        purpose = &apos;reads {0}s from input while {0} {1} is not read. &apos;.format(data_type, comparator_str)\n        purpose += &apos;In each iteration:&lt;ul&gt;\\n&apos;\n        purpose += &apos;&lt;li&gt;Update {0} with the sum of {0} and 1.&lt;/li&gt;\\n&apos;.format(result_var_name)\n        purpose += &apos;&lt;li&gt;Then, read the next {} from input into variable {}.&lt;/li&gt;\\n&lt;/ul&gt;\\n&apos;.format(data_type, input_var_name)\n        \n        while_loop_line1 = &apos;{0} = {0} + 1&apos;.format(result_var_name)\n\n        continuation = &apos;&lt;code&gt;{} {} {}&lt;/code&gt; is True, the while loop increments {} until {} {} is read, followed by a newline.&apos;\\\n                        .format(input_var_name, comparison, comparator_str, result_var_name, data_type, comparator_str)\n    elif action == &apos;update&apos;:\n        k = pick_from_range(3, 5)\n        num_a = pick_from_range(2, 10, exclude=[k])\n        num_b = input_value = start_val = 0\n        data_list = out_str_list = []\n        \n        breaker = num_a\n        operand_str = comparator_fstr.format(num_a)\n        \n        op_comp_eng = comp_dict_dict[comp_dict_dict[comparison][&apos;opposite_comp&apos;]][&apos;eng&apos;]\n        op_comp = comp_dict_dict[comparison][&apos;opposite_comp&apos;]\n        op_plural = op_dict_dict[op][&apos;plural&apos;]\n        op_present = op_dict_dict[op][&apos;present&apos;]\n        op_prep = op_dict_dict[op][&apos;preposition&apos;]\n        op_func = op_dict_dict[op][&apos;func&apos;]\n        op_result = op_dict_dict[op][&apos;result&apos;]\n        expl_op_clause = op_dict_dict[op][&apos;expl_clause&apos;].format(op_present, input_var_name, op_prep, operand_str)\n        \n        prompt_clause = &apos;&apos;\n        prompt_op_clause = op_dict_dict[op][&apos;prompt_clause&apos;].format(operand_str, op_prep, input_var_name)\n        if &apos;,&apos; in prompt_op_clause:\n            comma_index = prompt_op_clause.find(&apos;,&apos;)\n            prompt_clause = prompt_op_clause[comma_index :]\n        \n        # if comparison == &apos;&gt;&apos;:\n        if op == &apos;-&apos;:\n            num_b = -k * num_a\n            data_list = list(range(num_b + 1, 1))\n            if pick_from([True, False]):\n                num_b = 0\n                data_list = list(range(1, num_a)) + list(range(num_a + 1, (k * num_a) + 1))\n            \n            mini_data_list = data_list[-3:]\n            input_value = pick_from(mini_data_list, exclude=[k, num_a, num_b])\n            \n            start_val = input_value\n            out_str_list = []\n            while start_val &gt; num_b:\n                start_val = op_func(start_val, num_a)\n                out_str_list.append(value_fstr.format(start_val))\n        elif op in [&apos;/&apos;, &apos;//&apos;]:\n            num_b = int(dtype == &apos;float&apos;)\n            data_list = list(range(num_a + 1, num_a * pick_from_range(9, 11), num_a + pick_from_range(0, 1)))\n            num_iters = pick_from_range(2, 4)\n            input_value = num_a ** num_iters\n            out_str_list = [value_fstr.format(num_a ** i) for i in range(num_iters - 1, -1, -1)]\n            if dtype == &apos;int&apos;:   \n                out_str_list.append(value_fstr.format(0))\n        \n        if comparison == &apos;&lt;&apos;:\n            num_b = k * num_a * (2 if op == &apos;*&apos; else 1)\n\n            data_list = ([0] if op == &apos;+&apos; else []) + list(range(1, num_a)) + list(range(num_a + 1, num_b))\n            \n            mini_data_list = data_list[:3]\n            input_value = pick_from(mini_data_list, exclude=[k, num_a, num_b])\n            \n            start_val = input_value\n            out_str_list = []\n            while start_val &lt; num_b:\n                start_val = op_func(start_val, num_a)\n                out_str_list.append(value_fstr.format(start_val))\n        \n        comparator = num_b\n        comparator_str = comparator_fstr.format(num_b)\n        \n        ex_in_list = [input_value]\n        example_input = value_fstr.format(input_value)\n        ex_in = &apos; `{}`, &apos;.format(example_input)\n        \n        example_output = &apos;\\n&apos;.join(out_str_list)\n        not_include = &apos;&apos;\n        round_instr = &apos; rounded to the nearest tenth&apos; if dtype == &apos;float&apos; else &apos;&apos;\n        purpose = &apos;iterates while {} is {} {}. In each iteration:&lt;ul&gt;\\n&apos;.format(input_var_name, op_comp_eng, comparator_str)\n        purpose += &apos;&lt;li&gt;Update {0} with the {1} of {0} and {2}{3}.&lt;/li&gt;\\n&apos;.format(input_var_name, op_result, comparator_fstr.format(num_a), prompt_clause)\n        purpose += &apos;&lt;li&gt;Output the updated {}{}.&lt;/li&gt;\\n&lt;/ul&gt;&apos;.format(input_var_name, round_instr)\n        \n        result_var_name = result_var_assignment = cout = buffer_str = &apos;&apos;\n        while_loop_line1 = &apos;{0} = {0} {1} {2}&apos;.format(input_var_name, op, operand_str)\n        while_loop_line2 = &apos;print({})&apos;.format(input_var_name)\n        if dtype == &apos;float&apos;:\n            while_loop_line2 = &apos;print(f&quot;{{}:.1f}&quot;)&apos;.format(input_var_name)\n\n        continuation = &apos;&lt;code&gt;{0} {2} {3}&lt;/code&gt; is True, the while loop continues to {1} and output {0}, followed by a newline.&apos;\\\n                        .format(input_var_name, expl_op_clause, comparison, comparator_str)\n    return {\n        &apos;breaker&apos;: breaker,\n        &apos;buffer&apos;: buffer_str,\n        &apos;comparator&apos;: comparator,\n        &apos;comparator_str&apos;: comparator_str,\n        &apos;continuation&apos;: continuation,\n        &apos;cout&apos;: cout,\n        &apos;data_list&apos;: data_list,\n        &apos;data_type_cap&apos;: data_type.capitalize(),\n        &apos;ex_in&apos;: ex_in,\n        &apos;ex_in_list&apos;: ex_in_list,\n        &apos;example_input&apos;: example_input,\n        &apos;example_output&apos;: example_output,\n        &apos;input_func&apos;: input_func,\n        &apos;input_var_name&apos;: input_var_name,\n        &apos;not_include&apos;: not_include,\n        &apos;purpose&apos;: purpose,\n        &apos;result_var_assignment&apos;: result_var_assignment,\n        &apos;value_fstr&apos;: value_fstr,\n        &apos;while_loop_line1&apos;: while_loop_line1,\n        &apos;while_loop_line2&apos;: while_loop_line2,\n        &apos;comparison&apos;: comparison,\n    }",meaningful:"def make_meaningful_permutation():\n    action = pick_from([&apos;count&apos;, &apos;sum&apos;, &apos;update&apos;])\n    \n    dtype = &apos;char&apos;\n    if action == &apos;sum&apos;:\n        dtype = &apos;int&apos;\n    \n    comparison = pick_from(dtype_dict_dict[dtype][&apos;comparison_list&apos;])\n    op = &apos;+&apos;\n    \n    if action == &apos;update&apos;:\n        dtype = pick_from([&apos;int&apos;, &apos;float&apos;])\n        comparison = pick_from([&apos;&lt;&apos;, &apos;&gt;&apos;])\n        op = pick_from([&apos;+&apos;, &apos;*&apos;]) if comparison == &apos;&lt;&apos; else pick_from([&apos;-&apos;, &apos;//&apos;])\n        \n        if dtype == &apos;float&apos; and op == &apos;//&apos;:\n            op = &apos;/&apos;\n    \n    return {&apos;action&apos;: action, &apos;dtype&apos;: dtype, &apos;comparison&apos;: comparison, &apos;op&apos;: op}"}},{files:[{hide:!1,main:!0,name:"main.py",input:!1,content:[{editable:!1,solution:null,template:"${distractor.result_var} = ${distractor.result_init_val}\n${distractor.input_var} = int(input())\n"},{editable:!0,solution:"while ${distractor.input_var} &gt; -1:\n    if ${distractor.if_bool_exp}:\n        ${distractor.if_body}\n    else:\n        ${distractor.else_body}\n\n    ${distractor.input_var} = int(input())",template:"\n&quot;&quot;&quot; Your code goes here &quot;&quot;&quot;\n"},{editable:!1,solution:null,template:"\nprint(f&quot;${distractor.result_var_english} is {${distractor.result_var}}&quot;)"}]}],tests:[{out:{type:"std",value:null},args:null,stdin:"${distractor.example_input}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case2}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case3}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case4}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case5}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case6}"},{out:{type:"std",value:null},args:null,stdin:"${test.test_case7}"}],prompt:"&lt;p&gt;Integer ${distractor.input_var} is read from input. Write a while loop that iterates while ${distractor.input_var} is non-negative. In each iteration:&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;Update value ${distractor.result_var} as follows:&lt;/li&gt;\n&lt;ul&gt;\n&lt;li&gt;If ${distractor.input_var} is ${distractor.if_divisibility}, ${distractor.if_prompt}.&lt;/li&gt;\n&lt;li&gt;Otherwise, ${distractor.else_prompt}.&lt;/li&gt;\n&lt;/ul&gt;\n&lt;li&gt;Then, read the next integer from input into variable ${distractor.input_var}.&lt;/li&gt;\n &lt;/ul&gt;\n\n&lt;details&gt;&lt;summary style=&quot;color: #0277BD&quot;&gt;&lt;b&gt;Click here for example&lt;/b&gt;&lt;/summary&gt;\nEx: If the input is:\n```\n${distractor.example_input}\n```\nthen the output is:\n```\n${distractor.example_output}\n```\n&lt;/details&gt;\n \nNote: x % ${distractor.divisor} == 0 returns True if x is ${distractor.divisibility}.",explanation:"For input:\n```\n${distractor.example_input}\n```\n&lt;p&gt;${distractor.result_var} is calculated as follows:&lt;/p&gt;\n&lt;ul&gt;\n${distractor.explanation_body}\n&lt;/ul&gt;\nThen, ${distractor.breaker} is read, so the loop terminates and &quot;${distractor.result_var_english} is ${distractor.result}&quot; is output.",randomization:{test:"def make_test_permutation(meaningful_permutation, distractor_permutation):\n    num_tests = 6\n    \n    pre_in_val_list = distractor_permutation[&apos;pre_in_val_list&apos;]\n    breaker = distractor_permutation[&apos;breaker&apos;]\n    \n    div_list = distractor_permutation[&apos;data_list&apos;]\n    non_div_list = [(div_list[i] + 1) if i % 2 else (div_list[i] - 1) for i in range(len(div_list))]\n    breaker_list = random.sample(set(distractor_permutation[&apos;breaker_list&apos;]) - {breaker, -1}, num_tests - 3)\n    \n    div_list_list = [([0] * num_tests) for _ in range(num_tests - 3)]\n    for i in range(len(div_list_list)):\n        for j in range(len(div_list_list[i])):\n            div_list_list[i][j] = pick_from(div_list, exclude=pre_in_val_list+sum(div_list_list, []))\n    \n    \n    non_div_list_list = [([0] * num_tests) for _ in range(num_tests - 3)]\n    for i in range(len(non_div_list_list)):\n        for j in range(len(non_div_list_list[i])):\n            non_div_list_list[i][j] = pick_from(non_div_list, exclude=pre_in_val_list+sum(non_div_list_list, []))\n    \n    test6_list = [0] + div_list_list[1][: len(div_list_list[1]) // 2] + non_div_list_list[1][len(non_div_list_list[1]) // 2 :]\n    random.shuffle(test6_list)\n    test6_list.append(breaker_list[1])\n    \n    test7_list = div_list_list[2][len(div_list_list[2]) // 2 :] + non_div_list_list[2][: len(non_div_list_list[2]) // 2]\n    test7_list.append(breaker_list[2])\n    random.shuffle(test7_list)\n    test7_list.insert(test7_list.index(breaker_list[2]), 0)\n    \n    return {\n        &apos;test_case2&apos;: breaker_list[0],\n        &apos;test_case3&apos;: &apos;0\\n-1\\n1&apos;, \n        &apos;test_case4&apos;: &apos;\\n&apos;.join(map(str, div_list_list[0]+[-1])), \n        &apos;test_case5&apos;: &apos;\\n&apos;.join(map(str, non_div_list_list[0]+[-1])), \n        &apos;test_case6&apos;: &apos;\\n&apos;.join(map(str, test6_list)), \n        &apos;test_case7&apos;: &apos;\\n&apos;.join(map(str, test7_list)), \n    }",setup:"opposite_dict = {\n    &apos;even&apos;: &apos;odd&apos;,\n    &apos;divisible by 3&apos;: &apos;&lt;i&gt;not&lt;/i&gt; divisible by 3&apos;,\n    &apos;divisible by 4&apos;: &apos;&lt;i&gt;not&lt;/i&gt; divisible by 4&apos;,\n    &apos;divisible by 5&apos;: &apos;&lt;i&gt;not&lt;/i&gt; divisible by 5&apos;,\n    &apos;win&apos;: &apos;lose&apos;,\n    &apos;hit&apos;: &apos;miss&apos;,\n    &apos;/&apos;: &apos;*&apos;,\n    &apos;divided&apos;: &apos;multiplied&apos;,\n    &apos;odd&apos;: &apos;even&apos;,\n    &apos;&lt;i&gt;not&lt;/i&gt; divisible by 3&apos;: &apos;divisible by 3&apos;,\n    &apos;&lt;i&gt;not&lt;/i&gt; divisible by 4&apos;: &apos;divisible by 4&apos;,\n    &apos;&lt;i&gt;not&lt;/i&gt; divisible by 5&apos;: &apos;divisible by 5&apos;,\n    &apos;lose&apos;: &apos;win&apos;,\n    &apos;miss&apos;: &apos;hit&apos;,\n    &apos;*&apos;: &apos;/&apos;,\n    &apos;multiplied&apos;: &apos;divided&apos;\n}\n\nprint_word_dict = {&apos;good&apos;: [&apos;win&apos;, &apos;hit&apos;], &apos;bad&apos;: [&apos;lose&apos;, &apos;miss&apos;]}\n \ndiv_dict_dict = {\n    &apos;div_dict&apos;: {\n        &apos;options_dict&apos;: {&apos;even&apos;: 2, &apos;divisible by 3&apos;: 3, &apos;divisible by 4&apos;: 4, &apos;divisible by 5&apos;: 5},\n        &apos;op&apos;: &apos;/&apos;,\n        &apos;verb&apos;: &apos;divided&apos;,\n        &apos;print_word_list&apos;: print_word_dict[&apos;good&apos;]\n    },\n    &apos;non_div_dict&apos;: {\n        &apos;options_dict&apos;: {&apos;odd&apos;: 2, &apos;&lt;i&gt;not&lt;/i&gt; divisible by 3&apos;: 3, &apos;&lt;i&gt;not&lt;/i&gt; divisible by 4&apos;: 4, &apos;&lt;i&gt;not&lt;/i&gt; divisible by 5&apos;: 5},\n        &apos;op&apos;: &apos;*&apos;,\n        &apos;verb&apos;: &apos;multiplied&apos;,\n        &apos;print_word_list&apos;: print_word_dict[&apos;bad&apos;]\n    }\n}\n \nresult_op_dict_dict = {\n    &apos;+&apos;: {&apos;verb&apos;: &apos;add&apos;, &apos;preposition&apos;: &apos;to&apos;}, \n    &apos;-&apos;: {&apos;verb&apos;: &apos;subtract&apos;, &apos;preposition&apos;: &apos;from&apos;}, \n}\n\n\ndef scenario_a_div_plus(init_val, in_val_list, divisor):\n    result = init_val\n    for in_val in in_val_list:\n        result = (result - in_val) if in_val % divisor else (result + in_val)\n    \n    return {&apos;result&apos;: result, &apos;div_equ_rhs_str&apos;: &apos;{} + {}&apos;, &apos;not_div_equ_rhs_str&apos;: &apos;{} - {}&apos;}\n\n\ndef scenario_a_div_minus(init_val, in_val_list, divisor):\n    result = init_val\n    for in_val in in_val_list:\n        result = (result + in_val) if in_val % divisor else (result - in_val)\n    \n    return {&apos;result&apos;: result, &apos;div_equ_rhs_str&apos;: &apos;{} - {}&apos;, &apos;not_div_equ_rhs_str&apos;: &apos;{} + {}&apos;}\n\n\ndef scenario_b_div_if_result(init_val, in_val_list, divisor, if_word, else_word):\n    result = init_val\n    print_statements = [&apos;&apos;] * len(in_val_list)\n    for i in range(len(in_val_list)):\n        if not in_val_list[i] % divisor:\n            print_statements[i] = if_word\n            result += 1\n        else:\n            print_statements[i] = else_word\n    \n    return {\n        &apos;result&apos;: result, \n        &apos;print_statements_str&apos;: &apos;\\n&apos;.join(print_statements), \n        &apos;div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;{} + 1&apos;, \n            &apos;word&apos;: if_word, \n        }, \n        &apos;not_div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;&apos;, \n            &apos;word&apos;: else_word, \n        }, \n    }\n\n\ndef scenario_b_div_else_result(init_val, in_val_list, divisor, if_word, else_word):\n    result = init_val\n    print_statements = [&apos;&apos;] * len(in_val_list)\n    for i in range(len(in_val_list)):\n        if not in_val_list[i] % divisor:\n            print_statements[i] = if_word\n        else:\n            print_statements[i] = else_word\n            result += 1\n    \n    return {\n        &apos;result&apos;: result, \n        &apos;print_statements_str&apos;: &apos;\\n&apos;.join(print_statements), \n        &apos;div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;&apos;, \n            &apos;word&apos;: if_word, \n        }, \n        &apos;not_div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;{} + 1&apos;, \n            &apos;word&apos;: else_word, \n        }, \n    }\n\n\ndef scenario_b_not_div_if_result(init_val, in_val_list, divisor, if_word, else_word):\n    result = init_val\n    print_statements = [&apos;&apos;] * len(in_val_list)\n    for i in range(len(in_val_list)):\n        if in_val_list[i] % divisor:\n            print_statements[i] = if_word\n            result += 1\n        else:\n            print_statements[i] = else_word\n    \n    return {\n        &apos;result&apos;: result, \n        &apos;print_statements_str&apos;: &apos;\\n&apos;.join(print_statements), \n        &apos;div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;&apos;, \n            &apos;word&apos;: else_word, \n        }, \n        &apos;not_div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;{} + 1&apos;, \n            &apos;word&apos;: if_word, \n        }\n    }\n\n\ndef scenario_b_not_div_else_result(init_val, in_val_list, divisor, if_word, else_word):\n    result = init_val\n    print_statements = [&apos;&apos;] * len(in_val_list)\n    for i in range(len(in_val_list)):\n        if in_val_list[i] % divisor:\n            print_statements[i] = if_word\n        else:\n            print_statements[i] = else_word\n            result += 1\n    \n    return {\n        &apos;result&apos;: result, \n        &apos;print_statements_str&apos;: &apos;\\n&apos;.join(print_statements), \n        &apos;div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;{} + 1&apos;, \n            &apos;word&apos;: else_word, \n        }, \n        &apos;not_div_branch_dict&apos;: {\n            &apos;rhs&apos;: &apos;&apos;, \n            &apos;word&apos;: if_word, \n        }, \n    }\n\n   \ndef get_int_div(integer, divisor, div):\n    return div if not integer % divisor else opposite_dict[div]\n\n  \ndef op_func(string):\n    string_list = string.split()\n    \n    if string_list[1] == &apos;+&apos;:\n        answer = int(string_list[0]) + int(string_list[2])\n    elif string_list[1] == &apos;-&apos;:\n        answer = int(string_list[0]) - int(string_list[2])\n    elif string_list[1] == &apos;*&apos;:\n        answer = int(string_list[0]) * int(string_list[2])\n    else:\n        answer = int(string_list[0]) // int(string_list[2])\n\n    string += &apos; = {}&apos;.format(answer)\n\n    return answer, string",distractor:"def make_distractor_permutation(meaningful_permutation):\n    scenario = meaningful_permutation[&apos;scenario&apos;]\n    key = meaningful_permutation[&apos;key&apos;]\n    div_or_not_div_key = meaningful_permutation[&apos;div_or_not_div_key&apos;]\n    \n    input_var = pick_from([&apos;num_in&apos;, &apos;user_in&apos;, &apos;user_input&apos;, &apos;num_input&apos;, &apos;user_num&apos;])\n    result_var_words_list_list = [[&apos;result&apos;], [&apos;final&apos;, &apos;number&apos;], [&apos;output&apos;, &apos;number&apos;]]\n    result_var_word_list = pick_from(result_var_words_list_list)\n    \n    result_var = result_var_word_list[0]\n    result_var_english = result_var.capitalize()\n    if len(result_var_word_list) &gt; 1:\n        result_var = &apos;{}_{}&apos;.format(result_var_word_list[0], result_var_word_list[1][:3])\n        result_var_english = &apos;{} {}&apos;.format(result_var_word_list[0].capitalize(), result_var_word_list[1])\n    \n    options_dict = div_dict_dict[div_or_not_div_key][&apos;options_dict&apos;]\n    divisibility = pick_from(options_dict.keys())\n    div = divisibility if div_or_not_div_key == &apos;div_dict&apos; else opposite_dict[divisibility]\n    comp = &apos;==&apos; if div_or_not_div_key == &apos;div_dict&apos; else &apos;!=&apos;\n    \n    data_list = list(range(options_dict[divisibility], 201, options_dict[divisibility]))\n    \n    pre_in_val_list = data_list[: 3]\n    random.shuffle(pre_in_val_list)\n    random_index = random.randrange(len(pre_in_val_list))\n    pre_in_val_list[random_index] += 1\n    \n    breaker_list = list(range(-10, 0))\n    breaker = pick_from(breaker_list, exclude=[-1])\n    result_init_val = 0\n    \n    if scenario == &apos;scenario_a&apos;:\n        if_result_op = key\n        else_result_op = pick_from(result_op_dict_dict.keys(), exclude=[if_result_op])\n        \n        is_div_plus = div_or_not_div_key == &apos;div_dict&apos; and if_result_op == &apos;+&apos;\n        is_non_div_minus = div_or_not_div_key == &apos;non_div_dict&apos; and if_result_op == &apos;-&apos;\n        \n        result_dict = scenario_a_div_minus(result_init_val, pre_in_val_list, options_dict[divisibility])\n        if is_div_plus or is_non_div_minus:\n            result_dict = scenario_a_div_plus(result_init_val, pre_in_val_list, options_dict[divisibility])\n        \n        in_val_exp_list = [&apos;&apos;] * len(pre_in_val_list)\n        init_val = result_init_val\n        for i in range(len(pre_in_val_list)):\n            div_str = get_int_div(pre_in_val_list[i], options_dict[divisibility], div)\n            in_val_exp_prefix = &apos;{} is {}, so {} =&apos;.format(pre_in_val_list[i], div_str, result_var)\n            \n            equ_rhs_str =  &apos;not_div_equ_rhs_str&apos;\n            if div_str in div_dict_dict[&apos;div_dict&apos;][&apos;options_dict&apos;].keys():\n                equ_rhs_str = &apos;div_equ_rhs_str&apos;\n            \n            equ_rhs_str1 = result_dict[equ_rhs_str].format(result_var, input_var)\n            equ_rhs_str2 = equ_rhs_str1.replace(result_var, str(init_val))\n            equ_rhs_str2 = equ_rhs_str2.replace(input_var, str(pre_in_val_list[i]))\n            \n            init_val, ending = op_func(equ_rhs_str2)\n            in_val_exp_list[i] = &apos;&lt;li&gt;{} {} = {}.&lt;/li&gt;&apos;.format(in_val_exp_prefix, equ_rhs_str1, ending)\n        \n        print_statements = &apos;&apos;\n        result = result_dict[&apos;result&apos;]\n        if_prompt = &apos;{} {} {} {}&apos;.format(result_op_dict_dict[if_result_op][&apos;verb&apos;], input_var, \n                                        result_op_dict_dict[if_result_op][&apos;preposition&apos;], result_var)\n        else_prompt = &apos;{} {} {} {}&apos;.format(result_op_dict_dict[else_result_op][&apos;verb&apos;], input_var, \n                                            result_op_dict_dict[else_result_op][&apos;preposition&apos;], result_var)\n        if_body = &apos;{0} = {0} {1} {2}&apos;.format(result_var, if_result_op, input_var)\n        else_body = &apos;{0} = {0} {1} {2}&apos;.format(result_var, else_result_op, input_var)\n    elif scenario == &apos;scenario_b&apos;:\n        print_word = pick_from(print_word_dict[key])\n        \n        if_prompt = &apos;output &quot;{}&quot; and increment {}&apos;.format(print_word, result_var)\n        else_prompt = &apos;output &quot;{}&quot; and do &lt;i&gt;not&lt;/i&gt; update {}&apos;.format(opposite_dict[print_word], result_var)\n        \n        if_body = &apos;print(&quot;{0}&quot;)\\n        {1} = {1} + 1&apos;.format(print_word, result_var)\n        else_body = &apos;print(&quot;{}&quot;)&apos;.format(opposite_dict[print_word])\n        \n        if key == &apos;bad&apos;:\n            if_prompt = &apos;output &quot;{}&quot; and do &lt;i&gt;not&lt;/i&gt; update {}&apos;.format(print_word, result_var)\n            else_prompt = &apos;output &quot;{}&quot; and increment {}&apos;.format(opposite_dict[print_word], result_var)\n            \n            if_body = &apos;print(&quot;{}&quot;)&apos;.format(print_word)\n            else_body = &apos;print(&quot;{0}&quot;)\\n        {1} = {1} + 1&apos;.format(opposite_dict[print_word], result_var)\n        \n        # if key == &apos;bad&apos; and comp == &apos;!=&apos;:\n        scenario_b_dict = scenario_b_not_div_else_result(\n            result_init_val, pre_in_val_list, options_dict[divisibility], print_word, opposite_dict[print_word]\n        )\n        if key == &apos;good&apos; and comp == &apos;==&apos;:\n            scenario_b_dict = scenario_b_div_if_result(\n                result_init_val, pre_in_val_list, options_dict[divisibility], print_word, opposite_dict[print_word]\n            )\n        elif key == &apos;bad&apos; and comp == &apos;==&apos;:\n            scenario_b_dict = scenario_b_div_else_result(\n                result_init_val, pre_in_val_list, options_dict[divisibility], print_word, opposite_dict[print_word]\n            )\n        elif key == &apos;good&apos; and comp == &apos;!=&apos;:\n            scenario_b_dict = scenario_b_not_div_if_result(\n                result_init_val, pre_in_val_list, options_dict[divisibility], print_word, opposite_dict[print_word]\n            )\n        \n        in_val_exp_list = [&apos;&apos;] * len(pre_in_val_list)\n        init_val = result_init_val\n        for i in range(len(pre_in_val_list)):\n            div_str = get_int_div(pre_in_val_list[i], options_dict[divisibility], div)\n            in_val_exp_prefix = &apos;{} is {}, so&apos;.format(str(pre_in_val_list[i]), div_str)\n            \n            equ_rhs_str = &apos;not_div_branch_dict&apos;\n          
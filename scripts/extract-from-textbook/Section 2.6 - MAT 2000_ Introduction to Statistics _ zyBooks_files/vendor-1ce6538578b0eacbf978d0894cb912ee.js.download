[3, 2, 0])                       3x^2 + 2x\n        Polynomial([4, 0, 0, 1])                    4x^3 + 1\n        '''\n        self.coefficients = coefficients[::-1]      # Coefficients are reversed internally for convenience\n        self.variable = variable                    # Defaults to 'x'\n\n    @staticmethod\n    def zip_longest(polynomial1, polynomial2):\n        '''\n        Creates a list of coefficient pairs where missing values are filled with zero coefficients.\n        Used for the __add__ operator overload\n        '''\n        for i in range(max(len(polynomial1), len(polynomial2))):\n            if i >= len(polynomial1):\n                yield (0, polynomial2[i])\n            elif i >= len(polynomial2):\n                yield (polynomial1[i], 0)\n            else:\n                yield (polynomial1[i], polynomial2[i])\n\n    def __neg__(self):\n        '''\n        Negation of a polynomial negates each coefficient\n        '''\n        result = [-coefficient for coefficient in self.coefficients]\n        return self.__class__(result[::-1])\n\n    def __add__(self, other):\n        '''\n        Uses the zip_longest() method to generate a list of coefficient pairs, then adds the pairs and forms a list.\n        '''\n        polynomial1 = self.coefficients\n        polynomial2 = other.coefficients\n        result = [ sum(coefficient_pair) for coefficient_pair in Polynomial.zip_longest(polynomial1, polynomial2) ]\n        return self.__class__(result[::-1])\n\n    def __sub__(self, other):\n        '''\n        Negates other and adds self and -other\n        '''\n        return self.__add__(-other)\n\n    def __mul__(self, other):\n        '''\n        If other is a polynomial, multiplies two polynomials. If other is a constant, multiplies self by the constant.\n        Throws error if self and other are different variables (because it creates mixed variable terms like xy^2, etc.\n        '''\n        if isinstance(other, Polynomial):\n            if self.variable != other.variable:\n                raise ValueError('The polynomials must have the same variable to be multiplied.')\n            _self_coefficients = self.coefficients\n            _other_coefficients = other.coefficients\n            result = [0] * (len(_self_coefficients) + len(_other_coefficients) - 1)\n            for self_power, self_coefficient in enumerate(_self_coefficients):\n                for other_power, other_coefficient in enumerate(_other_coefficients):\n                    result[self_power + other_power] += self_coefficient * other_coefficient\n        else:\n            result = [ coefficient * other for coefficient in self.coefficients ]\n        return self.__class__(result[::-1])\n\n    def __call__(self, value):\n        '''\n        Evaluates the polynomial at x = value\n        '''\n        result = 0\n        for power, coefficient in enumerate(self.coefficients):\n            result += coefficient * value ** power\n        return result\n\n    def to_latex(self, ascending=False):\n        '''\n        The string representation of Polynomial is the LaTeX format.\n\n        Examples:\n        str(Polynomial([1, -2, -1, 2])) returns 'x^3 - 2x^2 - x + 2'\n        str(Polynomial([1, 1, 0], variable = 'y')) returns 'y^2 + y'\n        '''\n\n        # Tuple represents (is first term, is coefficient < 0)\n        connecting_sign = {\n            (True, True): '-',\n            (True, False): '',\n            (False, True): ' - ',\n            (False, False): ' + '\n        }\n\n        list_of_terms = []\n        pairs = list(enumerate(self.coefficients))\n        order = pairs if ascending else reversed(pairs)\n        for power, coefficient in order:\n\n            # Skip term if zero coefficient\n            if coefficient == 0:\n                continue\n\n            connector = connecting_sign[not list_of_terms, coefficient < 0]\n            abs_coefficient = abs(coefficient)\n\n            # Do not show the explicit 1 if the coefficient is 1 or -1\n            # Explicitly show the coefficient if power == 0 (constant term)\n            if abs_coefficient == 1 and power != 0:\n                abs_coefficient = ''\n\n            # If power == 0 or power == 1 then handled differently.\n            # Otherwise, each term has the structure ('+' or '-' or '')(coefficient)(variable)^{(power)}\n            term = '%s%s' % (connector, abs_coefficient)\n            if power >= 1:\n                term += '%s' % self.variable\n            if power > 1:\n                term += '^{%s}' % power\n\n            list_of_terms.append(term)\n\n        return ''.join(list_of_terms) or '0'\n\n    def __str__(self):\n        return self.to_latex()\n\n    def __repr__(self):\n        '''\n        The code representation of Polynomial is Polynomial(list).\n\n        Examples:\n        repr(Polynomial([1, 2, 3])) returns Polynomial([1, 2, 3])\n        '''\n        return 'Polynomial(%s)' % self.coefficients[::-1]","src/lib/pythonds/graphs/__init__.py":"\n\nfrom .adjGraph import Graph\nfrom .adjGraph import Vertex\nfrom .priorityQueue import PriorityQueue\n"}},function(e){"use strict"

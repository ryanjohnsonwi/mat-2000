n1:{content:"\\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 0 &amp; 0 &amp; 9 \\\\\\\\\n0 &amp; 1&amp; 0 &amp; -2 \\\\\\\\\n0 &amp; 0 &amp; 1 &amp; -22\n\\\\end{array}\\\\right]\\\\]\n",hint:"Entries above the pivot in row \\\\(2\\\\) should be \\\\(0\\\\). Rows \\\\(2\\\\) and \\\\(3\\\\) are unchanged.",moveable:!0},column2:{content:"The reduced row echelon matrix shows that\n\\\\(x\\_1 {=} 9,\\; x\\_2 {=}{-}2, \\text{ and }x\\_3 {=} {-}22\\\\)",hint:null,moveable:!1},dependsOn:[2]}],names:{all:"proof",column1:{header:"Augmented matrices",singular:"augmented matrix"},column2:{header:"Elementary row operations",singular:"elementary row operation"},pair:"step"},prompt:"Solve the system using Gauss-Jordan elimination.\n\\\\begin{align}\nx\\_1+5x\\_2&amp;=-1\\\\\\\\\n12x\\_2-x\\_3&amp;=-2\\\\\\\\\n-\\frac{1}{4}x_3&amp;=\\frac{11}{2}\n\\\\end{align}\n"}},{name:"Needs fullscreen",options:{pairs:Array(5).fill({column1:{content:"\\\\[ a \\\\\\\\ b \\\\\\\\ c \\\\\\\\ d \\\\]",moveable:!0},column2:{content:"short",moveable:!0},dependsOn:[]}),names:{all:"proof",column1:{header:"Statements",singular:"statement"},column2:{header:"Justifications",singular:"justification"},pair:"step"},prompt:"This needs fullscreen"}},{name:"First pair unmoveable",options:{pairs:[{column1:{content:"This is tall \\\\[\\\\left[\n\\\\begin{array}{ccc|c}\n1 &amp; 5 &amp; 0 &amp; -1 \\\\\\\\\n0 &amp; 1 &amp; 0 &amp; -2 \\\\\\\\\n0 &amp; 0 &amp; 1 &amp; -22\n\\\\end{array}\\\\right]\\\\]",hint:"hint, pair 1, column 1",moveable:!1},column2:{content:"This is short",hint:"hint, pair 1, column 2",moveable:!1},dependsOn:[]},{column1:{content:"me next",hint:"hint, pair 2, column 1",moveable:!0},column2:{content:"then me",hint:"hint, pair 2, column 2",moveable:!0},dependsOn:[0]}],names:{all:"proof",column1:{header:"Statements",singular:"statement"},column2:{header:"Justifications",singular:"justification"},pair:"step"},prompt:"Meep moop"}},{name:"A logical statement that is a contradiction",options:{pairs
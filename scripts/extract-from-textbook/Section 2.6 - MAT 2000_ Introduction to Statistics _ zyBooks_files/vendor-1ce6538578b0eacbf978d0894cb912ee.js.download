7, 2581.2, 1829.5, 752.74, 2775.1, 2022.4, 2.1165, 6.6027, 4.4862 ],\n    [ 1000, 179.88, 0.001127, 0.19436, 761.39, 2582.7, 1821.3, 762.52, 2777.1, 2014.6, 2.1381, 6.5850, 4.4469 ],\n    [ 1100, 184.06, 0.001133, 0.17745, 779.78, 2585.5, 1805.7, 781.03, 2780.6, 1999.6, 2.1785, 6.5520, 4.3735 ],\n    [ 1200, 187.96, 0.001139, 0.16326, 796.96, 2587.8, 1790.8, 798.33, 2783.7, 1985.4, 2.2159, 6.5217, 4.3058 ],\n    [ 1300, 191.60, 0.001144, 0.15119, 813.11, 2589.9, 1776.8, 814.60, 2786.5, 1971.9, 2.2508, 6.4936, 4.2428 ],\n    [ 1400, 195.04, 0.001149, 0.14078, 828.36, 2591.8, 1763.4, 829.97, 2788.8, 1958.8, 2.2835, 6.4675, 4.1840 ],\n    [ 1500, 198.29, 0.001154, 0.13171, 842.83, 2593.4, 1750.6, 844.56, 2791.0, 1946.4, 2.3143, 6.4430, 4.1287 ],\n    [ 1600, 201.37, 0.001159, 0.12374, 856.60, 2594.8, 1738.2, 858.46, 2792.8, 1934.3, 2.3435, 6.4199, 4.0764 ],\n    [ 1700, 204.31, 0.001163, 0.11667, 869.76, 2596.1, 1726.3, 871.74, 2794.5, 1922.8, 2.3711, 6.3981, 4.0270 ],\n    [ 1800, 207.11, 0.001168, 0.11037, 882.37, 2597.2, 1714.8, 884.47, 2795.9, 1911.4, 2.3975, 6.3775, 3.9800 ],\n    [ 1900, 209.80, 0.001172, 0.10470, 894.48, 2598.2, 1703.7, 896.71, 2797.2, 1900.5, 2.4227, 6.3578, 3.9351 ],\n    [ 2000, 212.38, 0.001177, 0.099585, 906.14, 2599.1, 1693.0, 908.50, 2798.3, 1889.8, 2.4468, 6.3390, 3.8922 ],\n    [ 2250, 218.41, 0.001187, 0.088715, 933.57, 2600.9, 1667.3, 936.24, 2800.5, 1864.3, 2.5029, 6.2954, 3.7925 ],\n    [ 2500, 223.95, 0.001197, 0.079949, 958.91, 2602.1, 1643.2, 961.91, 2801.9, 1840.0, 2.5543, 6.2558, 3.7015 ],\n    [ 3000, 233.85, 0.001217, 0.066664, 1004.7, 2603.2, 1598.5, 1008.3, 2803.2, 1794.9, 2.6455, 6.1856, 3.5401 ],\n    [ 3500, 242.56, 0.001235, 0.057058, 1045.5, 2602.9, 1557.4, 1049.8, 2802.6, 1752.8, 2.7254, 6.1243, 3.3989 ],\n    [ 4000, 250.35, 0.001253, 0.049776, 1082.5, 2601.7, 1519.2, 1087.5, 2800.8, 1713.3, 2.7968, 6.0696, 3.2728 ],\n    [ 5000, 263.94, 0.001286, 0.039446, 1148.2, 2597.0, 1448.8, 1154.6, 2794.2, 1639.6, 2.9210, 5.9737, 3.0527 ],\n    [ 6000, 275.58, 0.001319, 0.032448, 1206.0, 2589.9, 1383.9, 1213.9, 2784.6, 1570.7, 3.0278, 5.8901, 2.8623 ],\n    [ 7000, 285.83, 0.001352, 0.027378, 1258.2, 2581.0, 1322.8, 1267.7, 2772.6, 1504.9, 3.1224, 5.8148, 2.6924 ],\n    [ 8000, 295.01, 0.001385, 0.023526, 1306.2, 2570.5, 1264.3, 1317.3, 2758.7, 1441.4, 3.2081, 5.7450, 2.5369 ],\n    [ 9000, 303.34, 0.001418, 0.020490, 1351.1, 2558.5, 1207.4, 1363.9, 2742.9, 1379.0, 3.2870, 5.6791, 2.3921 ],\n    [ 10000, 311.00, 0.001453, 0.018030, 1393.5, 2545.2, 1151.7, 1408.1, 2725.5, 1317.4, 3.3606, 5.6160, 2.2554 ],\n    [ 11000, 318.08, 0.001489, 0.015990, 1434.1, 2530.5, 1096.4, 1450.4, 2706.3, 1255.9, 3.4303, 5.5545, 2.1242 ],\n    [ 12000, 324.68, 0.001526, 0.014264, 1473.1, 2514.3, 1041.2, 1491.5, 2685.4, 1193.9, 3.4967, 5.4939, 1.9972 ],\n    [ 13000, 330.85, 0.001567, 0.012780, 1511.1, 2496.5, 985.4, 1531.5, 2662.7, 1131.2, 3.5608, 5.4336, 1.8728 ],\n    [ 14000, 336.67, 0.001610, 0.011485, 1548.4, 2477.1, 928.7, 1571.0, 2637.9, 1066.9, 3.6232, 5.3727, 1.7495 ],\n    [ 15000, 342.16, 0.001657, 0.010338, 1585.3, 2455.6, 870.3, 1610.2, 2610.7, 1000.5, 3.6846, 5.3106, 1.6260 ],\n    [ 17000, 352.29, 0.001769, 0.0083709, 1659.9, 2405.2, 745.3, 1690.0, 2547.5, 857.5, 3.8077, 5.1787, 1.3710 ],\n    [ 19000, 361.47, 0.001927, 0.0066773, 1740.5, 2339.1, 598.6, 1777.2, 2466.0, 688.8, 3.9401, 5.0256, 1.0855 ],\n    [ 20000, 365.75, 0.002040, 0.0058652, 1786.4, 2295.0, 508.6, 1827.2, 2412.3, 585.1, 4.0156, 4.9314, 0.9158 ],\n    [ 21000, 369.83, 0.002206, 0.0049961, 1841.2, 2233.7, 392.5, 1887.6, 2338.6, 451.0, 4.1064, 4.8079, 0.7015 ],\n    [ 22064, 373.95, 0.003106, 0.003106, 2015.7, 2015.7, 0.0, 2084.3, 2084.3, 0.0, 4.4070, 4.4070, 0.0000 ],\n]","src/lib/pythonds/basic/deque.py":"# Bradley N. Miller, David L. Ranum\n# Introduction to Data Structures and Algorithms in Python\n# Copyright 2005\n# \n#deque.py\n\n\nclass Deque:\n    def __init__(self):\n        self.items = []\n\n    def isEmpty(self):\n        return self.items == []\n\n    def addFront(self, item):\n        self.items.append(item)\n\n    def addRear(self, item):\n        self.items.insert(0,item)\n\n    def removeFront(self):\n        return self.items.pop()\n\n    def removeRear(self):\n        return self.items.pop(0)\n\n    def size(self):\n        return len(self.items)\n","src/lib/random.js":'/*\n I\'ve wrapped Makoto Matsumoto and Takuji Nishimura\'s code in a namespace\n so it\'s better encapsulated. Now you can have multiple random number generators\n and they won\'t stomp all over eachother\'s state.\n\n If you want to use this as a substitute for Math.random(), use the random()\n method like so:\n\n var m = new MersenneTwister();\n var randomNumber = m.random();\n\n You can also call the other genrand_{foo}() methods on the instance.\n\n If you want to use a specific seed in order to get a repeatable random\n sequence, pass an integer into the constructor:\n\n var m = new MersenneTwister(123);\n\n and that will always produce the same random sequence.\n\n Sean McCullough (banksean@gmail.com)\n */\n\n/* \n A C-program for MT19937, with initialization improved 2002/1/26.\n Coded by Takuji Nishimura and Makoto Matsumoto.\n\n Before using, initialize the state by using init_genrand(seed)\n or init_by_array(init_key, key_length).\n\n Copyright (C) 1997 - 2002, Makoto Matsumoto and Takuji Nishimura,\n All rights reserved.\n\n Redistribution and use in source and binary forms, with or without\n modification, are permitted provided that the following conditions\n are met:\n\n 1. Redistributions of source code must retain the above copyright\n notice, this list of conditions and the following disclaimer.\n\n 2. Redistributions in binary form must reproduce the above copyright\n notice, this list of conditions and the following disclaimer in the\n documentation and/or other materials provided with the distribution.\n\n 3. The names of its contributors may not be used to endorse or promote\n products derived from this software without specific prior written\n permission.\n\n THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\n "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT\n LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\n A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE COPYRIGHT OWNER OR\n CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,\n EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,\n PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR\n PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF\n LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING\n NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS\n SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n\n\n Any feedback is very welcome.\n http://www.math.sci.hiroshima-u.ac.jp/~m-mat/MT/emt.html\n email: m-mat @ math.sci.hiroshima-u.ac.jp (remove space)\n */\n\nvar MersenneTwister = function (seed) {\n    if (seed == undefined) {\n        seed = new Date().getTime();\n    }\n    /* Period parameters */\n    this.N = 624;\n    this.M = 397;\n    this.MATRIX_A = 0x9908b0df;\n    /* constant vector a */\n    this.UPPER_MASK = 0x80000000;\n    /* most significant w-r bits */\n    this.LOWER_MASK = 0x7fffffff;\n    /* least significant r bits */\n\n    this.mt = new Array(this.N);\n    /* the array for the state vector */\n    this.mti = this.N + 1;\n    /* mti==N+1 means mt[N] is not initialized */\n\n    this.init_genrand(seed);\n}\n\n/* initializes mt[N] with a seed */\nMersenneTwister.prototype.init_genrand = function (s) {\n    this.mt[0] = s >>> 0;\n    for (this.mti = 1; this.mti < this.N; this.mti++) {\n        var s = this.mt[this.mti - 1] ^ (this.mt[this.mti - 1] >>> 30);\n        this.mt[this.mti] = (((((s & 0xffff0000) >>> 16) * 1812433253) << 16) + (s & 0x0000ffff) * 1812433253)\n            + this.mti;\n        /* See Knuth TAOCP Vol2. 3rd Ed. P.106 for multiplier. */\n        /* In the previous versions, MSBs of the seed affect   */\n        /* only MSBs of the array mt[].                        */\n        /* 2002/01/09 modified by Makoto Matsumoto             */\n        this.mt[this.mti] >>>= 0;\n        /* for >32 bit machines */\n    }\n}\n\n/* initialize by an array with array-length */\n/* init_key is the array for initializing keys */\n/* key_length is its length */\n/* slight change for C++, 2004/2/26 */\nMersenneTwister.prototype.init_by_array = function (init_key, key_length) {\n    var i, j, k;\n    this.init_genrand(19650218);\n    i = 1;\n    j = 0;\n    k = (this.N > key_length ? this.N : key_length);\n    for (; k; k--) {\n        var s = this.mt[i - 1] ^ (this.mt[i - 1] >>> 30)\n        this.mt[i] = (this.mt[i] ^ (((((s & 0xffff0000) >>> 16) * 1664525) << 16) + ((s & 0x0000ffff) * 1664525)))\n            + init_key[j] + j;\n        /* non linear */\n        this.mt[i] >>>= 0;\n        /* for WORDSIZE > 32 machines */\n        i++;\n        j++;\n        if (i >= this.N) {\n            this.mt[0] = this.mt[this.N - 1];\n            i = 1;\n        }\n        if (j >= key_length) {\n            j = 0;\n        }\n    }\n    for (k = this.N - 1; k; k--) {\n        var s = this.mt[i - 1] ^ (this.mt[i - 1] >>> 30);\n        this.mt[i] = (this.mt[i] ^ (((((s & 0xffff0000) >>> 16) * 1566083941) << 16) + (s & 0x0000ffff) * 1566083941))\n            - i;\n        /* non linear */\n        this.mt[i] >>>= 0;\n        /* for WORDSIZE > 32 machines */\n        i++;\n        if (i >= this.N) {\n            this.mt[0] = this.mt[this.N - 1];\n            i = 1;\n        }\n    }\n\n    this.mt[0] = 0x80000000;\n    /* MSB is 1; assuring non-zero initial array */\n}\n\n/* generates a random number on [0,0xffffffff]-interval */\nMersenneTwister.prototype.genrand_int32 = function () {\n    var y;\n    var mag01 = new Array(0x0, this.MATRIX_A);\n    /* mag01[x] = x * MATRIX_A  for x=0,1 */\n\n    if (this.mti >= this.N) { /* generate N words at one time */\n        var kk;\n\n        if (this.mti == this.N + 1)   /* if init_genrand() has not been called, */\n        {\n            this.init_genrand(5489);\n        }\n        /* a default initial seed is used */\n\n        for (kk = 0; kk < this.N - this.M; kk++) {\n            y = (this.mt[kk] & this.UPPER_MASK) | (this.mt[kk + 1] & this.LOWER_MASK);\n            this.mt[kk] = this.mt[kk + this.M] ^ (y >>> 1) ^ mag01[y & 0x1];\n        }\n        for (; kk < this.N - 1; kk++) {\n            y = (this.mt[kk] & this.UPPER_MASK) | (this.mt[kk + 1] & this.LOWER_MASK);\n            this.mt[kk] = this.mt[kk + (this.M - this.N)] ^ (y >>> 1) ^ mag01[y & 0x1];\n        }\n        y = (this.mt[this.N - 1] & this.UPPER_MASK) | (this.mt[0] & this.LOWER_MASK);\n        this.mt[this.N - 1] = this.mt[this.M - 1] ^ (y >>> 1) ^ mag01[y & 0x1];\n\n        this.mti = 0;\n    }\n\n    y = this.mt[this.mti++];\n\n    /* Tempering */\n    y ^= (y >>> 11);\n    y ^= (y << 7) & 0x9d2c5680;\n    y ^= (y << 15) & 0xefc60000;\n    y ^= (y >>> 18);\n\n    return y >>> 0;\n}\n\n/* generates a random number on [0,0x7fffffff]-interval */\nMersenneTwister.prototype.genrand_int31 = function () {\n    return (this.genrand_int32() >>> 1);\n}\n\n/* generates a random number on [0,1]-real-interval */\nMersenneTwister.prototype.genrand_real1 = function () {\n    return this.genrand_int32() * (1.0 / 4294967295.0);\n    /* divided by 2^32-1 */\n}\n\n/* generates a random number on [0,1)-real-interval */\nMersenneTwister.prototype.random = function () {\n    return this.genrand_int32() * (1.0 / 4294967296.0);\n    /* divided by 2^32 */\n}\n\n/* generates a random number on (0,1)-real-interval */\nMersenneTwister.prototype.genrand_real3 = function () {\n    return (this.genrand_int32() + 0.5) * (1.0 / 4294967296.0);\n    /* divided by 2^32 */\n}\n\n/* generates a random number on [0,1) with 53-bit resolution*/\nMersenneTwister.prototype.genrand_res53 = function () {\n    var a = this.genrand_int32() >>> 5, b = this.genrand_int32() >>> 6;\n    return(a * 67108864.0 + b) * (1.0 / 9007199254740992.0);\n}\n\n/* These real versions are due to Isaku Wada, 2002/01/09 added */\n\n\nvar $builtinmodule = function (name) {\n\n    var mod = {};\n\n    var myGenerator = new MersenneTwister();\n    var nextNormalSample = undefined;\n\n    mod.seed = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("seed", arguments, 0, 1);\n        x = Sk.builtin.asnum$(x);\n\n        if (arguments.length > 0) {\n            myGenerator = new MersenneTwister(x);\n        }\n        else {\n            myGenerator = new MersenneTwister();\n        }\n\n        return Sk.builtin.none.none$;\n    });\n\n    mod.random = new Sk.builtin.func(function () {\n        Sk.builtin.pyCheckArgs("random", arguments, 0, 0);\n\n        return new Sk.builtin.float_(myGenerator.genrand_res53());\n    });\n\n    var toInt = function (num) {\n        return num | 0;\n    };\n\n    var randrange = function (start, stop, step) {\n        // Ported from CPython 2.7\n        var width, n, ret;\n\n        if (!Sk.builtin.checkInt(start)) {\n            throw new Sk.builtin.ValueError("non-integer first argument for randrange()");\n        }\n        ;\n\n        if (stop === undefined) {\n            // Random in [0, start)\n            ret = toInt(myGenerator.genrand_res53() * start);\n            return new Sk.builtin.int_(ret);\n        }\n        ;\n\n        if (!Sk.builtin.checkInt(stop)) {\n            throw new Sk.builtin.ValueError("non-integer stop for randrange()");\n        }\n        ;\n\n        if (step === undefined) {\n            step = 1;\n        }\n        ;\n\n        width = stop - start;\n\n        if ((step == 1) && (width > 0)) {\n            // Random in [start, stop), must use toInt on product for correct results with negative ranges\n            ret = start + toInt(myGenerator.genrand_res53() * width);\n            return new Sk.builtin.int_(ret);\n        }\n        ;\n\n        if (step == 1) {\n            throw new Sk.builtin.ValueError("empty range for randrange() (" + start + ", " + stop + ", " + width + ")");\n        }\n        ;\n\n        if (!Sk.builtin.checkInt(step)) {\n            throw new Sk.builtin.ValueError("non-integer step for randrange()");\n        }\n        ;\n\n        if (step > 0) {\n            n = toInt((width + step - 1) / step);\n        } else if (step < 0) {\n            n = toInt((width + step + 1) / step);\n        } else {\n            throw new Sk.builtin.ValueError("zero step for randrange()");\n        }\n        ;\n\n        if (n <= 0) {\n            throw new Sk.builtin.ValueError("empty range for randrange()");\n        }\n        ;\n\n        // Random in range(start, stop, step)\n        ret = start + (step * toInt(myGenerator.genrand_res53() * n));\n        return new Sk.builtin.int_(ret);\n    };\n\n    mod.randint = new Sk.builtin.func(function (a, b) {\n        Sk.builtin.pyCheckArgs("randint", arguments, 2, 2);\n\n        a = Sk.builtin.asnum$(a);\n        b = Sk.builtin.asnum$(b);\n        return randrange(a, b + 1);\n    });\n\n    mod.randrange = new Sk.builtin.func(function (start, stop, step) {\n        Sk.builtin.pyCheckArgs("randrange", arguments, 1, 3);\n\n        start = Sk.builtin.asnum$(start);\n        stop = Sk.builtin.asnum$(stop);\n        step = Sk.builtin.asnum$(step);\n        return randrange(start, stop, step);\n    });\n  \n    mod.uniform = new Sk.builtin.func(function (a, b) {\n        Sk.builtin.pyCheckArgs("uniform", arguments, 2, 2);\n\n        a = Sk.builtin.asnum$(a);\n        b = Sk.builtin.asnum$(b);\n        var rnd = myGenerator.genrand_res53();\n        c = a + rnd * (b - a)\n        return new Sk.builtin.float_(c);\n    });\n\n    mod.triangular = new Sk.builtin.func(function (low, high, mode) {\n        Sk.builtin.pyCheckArgs("triangular", arguments, 2, 3);\n        Sk.builtin.pyCheckType("low", "number", Sk.builtin.checkNumber(low));\n        Sk.builtin.pyCheckType("high", "number", Sk.builtin.checkNumber(high));\n\n        var rnd, sample, swap;\n\n        low = Sk.builtin.asnum$(low);\n        high = Sk.builtin.asnum$(high);\n        if (low > high) {\n            swap = low;\n            low = high;\n            high = swap;\n        }\n        if ((mode === undefined) || (mode instanceof Sk.builtin.none)) {\n            mode = (high - low)/2.0;\n        } else {\n            Sk.builtin.pyCheckType("mode", "number", Sk.builtin.checkNumber(mode));\n            mode = Sk.builtin.asnum$(mode);\n        }\n\n        // https://en.wikipedia.org/wiki/Triangular_distribution\n        rnd = myGenerator.genrand_res53();\n        if (rnd < (mode - low)/(high - low)) {\n            sample = low + Math.sqrt(rnd * (high - low) * (mode - low));\n        } else {\n            sample = high - Math.sqrt((1 - rnd) * (high - low) * (high - mode));\n        }\n\n        return new Sk.builtin.float_(sample);\n    });\n\n    var normalSample = function(mu, sigma) {\n        var r1, r2, u, v, s;\n\n        // Box-Muller transform\n        // (https://en.wikipedia.org/wiki/Box%E2%80%93Muller_transform)\n        // generates two independent samples from a Gaussian\n        // distribution. Return one of them and store the another one\n        // and return it next time.\n\n        if (nextNormalSample !== undefined) {\n            s = nextNormalSample;\n            nextNormalSample = undefined;\n        } else {\n            r1 = myGenerator.genrand_res53();\n            r2 = myGenerator.genrand_res53();\n            u = Math.sqrt(-2*Math.log(r1));\n            v = 2*Math.PI*r2;\n            s = u * Math.cos(v);\n            nextNormalSample = u * Math.sin(v);\n        }\n\n        return mu + sigma*s;\n    };\n    \n    mod.gauss = new Sk.builtin.func(function (mu, sigma) {\n        Sk.builtin.pyCheckArgs("gauss", arguments, 2, 2);\n        Sk.builtin.pyCheckType("mu", "number", Sk.builtin.checkNumber(mu));\n        Sk.builtin.pyCheckType("sigma", "number", Sk.builtin.checkNumber(sigma));\n\n        mu = Sk.builtin.asnum$(mu);\n        sigma = Sk.builtin.asnum$(sigma);\n\n        return new Sk.builtin.float_(normalSample(mu, sigma));\n    });\n\n    // CPython uses a different (slower but thread-safe) algorithm for\n    // normalvariate. We use the same algorithm for normalvariate and\n    // gauss.\n    mod.normalvariate = mod.gauss;\n\n    mod.lognormvariate = new Sk.builtin.func(function (mu, sigma) {\n        Sk.builtin.pyCheckArgs("lognormvariate", arguments, 2, 2);\n        Sk.builtin.pyCheckType("mu", "number", Sk.builtin.checkNumber(mu));\n        Sk.builtin.pyCheckType("sigma", "number", Sk.builtin.checkNumber(sigma));\n\n        mu = Sk.builtin.asnum$(mu);\n        sigma = Sk.builtin.asnum$(sigma);\n\n        return new Sk.builtin.float_(Math.exp(normalSample(mu, sigma)));\n    });\n\n    mod.expovariate = new Sk.builtin.func(function (lambd) {\n        Sk.builtin.pyCheckArgs("expovariate", arguments, 1, 1);\n        Sk.builtin.pyCheckType("lambd", "number", Sk.builtin.checkNumber(lambd));\n\n        lambd = Sk.builtin.asnum$(lambd);\n\n        var rnd = myGenerator.genrand_res53();\n        return new Sk.builtin.float_(-Math.log(rnd)/lambd);\n    });\n\n    mod.choice = new Sk.builtin.func(function (seq) {\n        Sk.builtin.pyCheckArgs("choice", arguments, 1, 1);\n        Sk.builtin.pyCheckType("seq", "sequence", Sk.builtin.checkSequence(seq));\n\n        if (seq.sq$length !== undefined) {\n            var r = toInt(myGenerator.genrand_res53() * seq.sq$length());\n            return seq.mp$subscript(r);\n        } else {\n            throw new Sk.builtin.TypeError("object has no length");\n        }\n    });\n\n    mod.shuffle = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("shuffle", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "sequence", Sk.builtin.checkSequence(x));\n\n        if (x.sq$length !== undefined) {\n            if (x.mp$ass_subscript !== undefined) {\n                for (var i = x.sq$length() - 1; i > 0; i -= 1) {\n                    var r = toInt(myGenerator.genrand_res53() * (i + 1));\n                    var tmp = x.mp$subscript(r);\n                    x.mp$ass_subscript(r, x.mp$subscript(i));\n                    x.mp$ass_subscript(i, tmp);\n                }\n                ;\n            } else {\n                throw new Sk.builtin.TypeError("object is immutable");\n            }\n            ;\n        } else {\n            throw new Sk.builtin.TypeError("object has no length");\n        }\n        ;\n\n        return Sk.builtin.none.none$;\n    });\n\n    mod.sample = new Sk.builtin.func(function (population, k) {\n        var i, j, iter, elem, reservoir;\n\n        Sk.builtin.pyCheckArgs("sample", arguments, 2, 2);\n        Sk.builtin.pyCheckType("population", "iterable", Sk.builtin.checkIterable(population));\n        Sk.builtin.pyCheckType("k", "integer", Sk.builtin.checkInt(k));\n        k = Sk.builtin.asnum$(k);\n        \n        // "Algorithm R" in\n        // https://en.wikipedia.org/wiki/Reservoir_sampling\n        //\n        // This algorithm guarantees that each element has\n        // equal probability of being included in the\n        // resulting list. See the Wikipedia page for a proof.\n        //\n        // This requires no extra space but the runtime is\n        // proportional to len(population). CPython implements a fast\n        // path for the case when k is much smaller than\n        // len(population). A similar optimization could be\n        // implemented here.\n        reservoir = [];\n        iter = Sk.abstr.iter(population);\n        for (i = 0, elem = iter.tp$iternext();\n             elem !== undefined;\n             i++, elem = iter.tp$iternext()) {\n            j = Math.floor(myGenerator.genrand_res53() * (i + 1));\n            if (i < k) {\n                // Fill the reservoir\n                if (j < i) {\n                    // Shuffle the existing elements to ensure that\n                    // subslices are valid random samples\n                    reservoir[i] = reservoir[j];\n                }\n                reservoir[j] = elem;\n            } else {\n                // Replace elements with a probability that decreases\n                // the further we get\n                if (j < k) {\n                    reservoir[j] = elem;\n                }\n            }\n        }\n        \n        if (i < k) {\n            throw new Sk.builtin.ValueError("sample larger than population");\n        }\n\n        return Sk.builtin.list(reservoir);\n    });\n\n    return mod;\n}\n',"src/lib/pprint.py":'raise NotImplementedError("pprint is not yet implemented in Skulpt")\n',"src/lib/mutex.py":'raise NotImplementedError("mutex is not yet implemented in Skulpt")\n',"src/lib/xml/sax/__init__.py":'raise NotImplementedError("sax is not yet implemented in Skulpt")\n',"src/lib/mimetypes.py":'raise NotImplementedError("mimetypes is not yet implemented in Skulpt")\n',"src/lib/PBCore/__init__.py":'# PBCore.py --------------------------------------------------------------------\n#\n# Made by Evan Olds for zyBooks/Wiley\n# Uploaded to GitHub May 2, 2025\n#\n# Note: This code is made to run in Skulpt, an in-browser Python implementation.\n# The following are NOT supported by Skulpt, and so are not used in this code:\n# - f-strings\n# - math.isfinite\n# - list class\'s clear() method\n#\n# Classes declared in this module:\n#   PBColors\n#   PBRandom\n#   PBBox\n#   PBVector\n#   PBRenderable\n#   PBBaseNode\n#   PBStackedRenderables\n#   PBAlignedRenderable\n#   PBSwappedModesRenderable\n\nimport math\nimport random\n\nclass PBColors:\n    @staticmethod\n    def get_dark_mode_colors():\n        return {\n            # "bg" is the default color for backgrounds in this mode\n            "bg": "rgb(6,8,9)",\n            \n            # highlight1 is a color to use to highlight an item in contexts\n            # where only one distinct highlight color is needed.\n            #\n            # Accessibility notes:\n            # - All contrast checks pass when white (rgb(255, 255, 255)) text\n            #   is used on top of this color.\n            # - Black text (rgb(0,0,0)) cannot be used on top of this color.\n            "highlight1": "rgb(120,80,0)",\n            \n            # "line" is the default color for lines (and arrows, borders, etc.)\n            # in this mode\n            "line": "rgb(255,255,255)",\n            \n            "node_border": "rgb(157,129,35)",\n            \n            "text": "rgb(255,255,255)"\n        }\n    \n    @staticmethod\n    def get_light_mode_colors():\n        return {\n            # "bg" is the default color for backgrounds in this mode\n            "bg": "rgb(255,255,255)",\n            \n            # highlight1 is a color to use to highlight an item in contexts\n            # where only one distinct highlight color is needed\n            "highlight1": "rgb(255,255,0)",\n            \n            # "line" is the default color for lines (and arrows, borders, etc.)\n            # in this mode\n            "line": "rgb(0,0,0)",\n            \n            "node_border": "rgb(98,126,220)",\n            \n            "text": "rgb(0,0,0)"\n        }\n    \n    @staticmethod\n    def invert(color_string):\n        # First parse the R,G,B values\n        rgb = PBColors.parse(color_string)\n        # Invert\n        for i in range(len(rgb)):\n            rgb[i] = 255 - rgb[i]\n        # Return string\n        return "rgb({0},{1},{2})".format(rgb[0], rgb[1], rgb[2])\n    \n    # Returns a three-element list with integer values parsed from a color\n    # string of one of the following forms:\n    # - "rgb(r, g, b)"\n    # - "RGB(r, g, b)"\n    # where r, g, and b can be parsed as integers. Spaces after commas are\n    # optional.\n    # Returns [0, 0, 0] if the string cannot be parsed.\n    @staticmethod\n    def parse(color_string):\n        if color_string.find("RGB(") == 0 or color_string.find("rgb(") == 0:\n            # Slice out the components\n            components = color_string[4:-1]\n            # Build and return the list\n            result = []\n            for component_string in components.split(","):\n                result.append(int(component_string))\n            return result\n        return [0, 0, 0]\n\n# PBRandom is a utility class with static methods for randomization tasks like\n# generating a random number or picking a random item from a list.\nclass PBRandom:\n    @staticmethod\n    def flip_coin():\n        return random.random() < 0.5\n    \n    # Utility method to generate a random integer in an range inclusive of\n    # both the minimum and maximum. Both arguments must be integers with\n    # inclusive_min <= inclusive_max.\n    @staticmethod\n    def get_int_inclusive(inclusive_min, inclusive_max):\n        return random.randint(inclusive_min, inclusive_max)\n    \n    # Utility method to generate a random integer in a range exclusive of\n    # both the minimum and maximum. The following must be true for arguments:\n    # 1. exclusive_min is a real number or negative infinity\n    # 2. exclusive_max is a real number or positive infinity\n    # 3. exclusive_min < exclusive_max\n    @staticmethod\n    def get_int_exclusive(exclusive_min, exclusive_max):\n        if exclusive_min == float("-inf"):\n            # Use a 32-bit signed integer\'s minimum value\n            exclusive_min = -2147483648\n        if exclusive_max == float("inf"):\n            # Use a 32-bit signed integer\'s maximum value\n            exclusive_max = 2147483647\n        \n        # Make inclusive min and max\n        inclusive_min = int(math.ceil(exclusive_min))\n        if math.floor(exclusive_min) == exclusive_min:\n            inclusive_min = int(exclusive_min) + 1\n        inclusive_max = int(math.floor(exclusive_max))\n        if math.floor(exclusive_max) == exclusive_max:\n            inclusive_max = int(exclusive_max) - 1\n        \n        return PBRandom.get_int_inclusive(inclusive_min, inclusive_max)\n    \n    # Utility method to generate a list of random integers\n    @staticmethod\n    def get_int_list(list_length, inclusive_min = 1, inclusive_max = 99):\n        result = []\n        for i in range(list_length):\n            rand_int = PBRandom.get_int_inclusive(inclusive_min, inclusive_max)\n            result.append(rand_int)\n        return result\n    \n    # Utility method to pick and return a random element from a list. The\n    # list\'s length must be at least 1.\n    @staticmethod\n    def pick(list_to_pick_from):\n        index = PBRandom.get_int_inclusive(0, len(list_to_pick_from) - 1)\n        return list_to_pick_from[index]\n    \n    # Removes and returns a random item from a list or set.\n    @staticmethod\n    def remove(collection):\n        if isinstance(collection, list):\n            index = PBRandom.get_int_inclusive(0, len(collection) - 1)\n            item = collection.pop(index)\n            return item\n        # Pick a random item to remove\n        to_remove = PBRandom.pick(list(collection))\n        collection.remove(to_remove)\n        return to_remove\n    \n    # Utility method to randomly shuffle a list\n    @staticmethod\n    def shuffle(list_to_shuffle):\n        for i in range(len(list_to_shuffle)):\n            i1 = PBRandom.get_int_inclusive(0, len(list_to_shuffle) - 1)\n            i2 = PBRandom.get_int_inclusive(0, len(list_to_shuffle) - 1)\n            temp = list_to_shuffle[i1]\n            list_to_shuffle[i1] = list_to_shuffle[i2]\n            list_to_shuffle[i2] = temp\n\n# Represents an axis-aligned box in 2D. Immutable.\nclass PBBox:\n    def __init__(self, minX = 0, minY = 0, maxX = 0, maxY = 0):\n        if maxX >= minX:\n            self.minX = minX\n            self.maxX = maxX\n        else:\n            self.minX = maxX\n            self.maxX = minX\n        if maxY >= minY:\n            self.minY = minY\n            self.maxY = maxY\n        else:\n            self.minY = maxY\n            self.maxY = minY\n    \n    @staticmethod\n    def bound(box1, box2):\n        # Special case if either box is None\n        if box1 is None:\n            return box2\n        if box2 is None:\n            return box1\n        \n        return PBBox(\n            min(box1.minX, box2.minX), min(box1.minY, box2.minY),\n            max(box1.maxX, box2.maxX), max(box1.maxY, box2.maxY)\n        )\n    \n    def center_equals(self, center_x, center_y):\n        if self.get_center_x() != center_x:\n            return False\n        return self.get_center_y() == center_y\n    \n    def get_center_x(self):\n        return (self.minX + self.maxX) / 2.0\n    \n    def get_center_y(self):\n        return (self.minY + self.maxY) / 2.0\n    \n    def get_height(self):\n        return self.maxY - self.minY\n    \n    def get_min_x(self):\n        return self.minX\n    \n    def get_min_y(self):\n        return self.minY\n    \n    # Static utility to get the maximum height from a collection of boxes.\n    # Returns 0 if the collection is empty.\n    @staticmethod\n    def get_max_height(collection_of_boxes):\n        result = 0\n        for box in collection_of_boxes:\n            result = max(result, box.get_height())\n        return result\n    \n    # Static utility to get the maximum width from a collection of boxes.\n    # Returns 0 if the collection is empty.\n    @staticmethod\n    def get_max_width(collection_of_boxes):\n        result = 0\n        for box in collection_of_boxes:\n            result = max(result, box.get_width())\n        return result\n    \n    def get_max_x(self):\n        return self.maxX\n    \n    def get_max_y(self):\n        return self.maxY\n    \n    def get_width(self):\n        return self.maxX - self.minX\n    \n    def to_string(self, separator = ", ", prefix = "", suffix = ""):\n        return (prefix + "min X = " + str(self.minX) + separator + "min y = " +\n            str(self.minY) + separator + "max x = " + str(self.maxX) +\n            separator + "max y = " + str(self.maxY) + suffix)\n\n# Represents an 2-component vector. Immutable.\nclass PBVector:\n    def __init__(self, arg0 = None, y = None):\n        if arg0 == None:\n            self.x = 0\n            self.y = 0\n        elif isinstance(arg0, PBVector):\n            # Copy construction shouldn\'t be needed for immutable objects, but\n            # this implementation is provided just in case\n            self.x = arg0.x\n            self.y = arg0.y\n        elif isinstance(arg0, list):\n            self.x = arg0[0]\n            self.y = arg0[1]\n        else:\n            self.x = arg0\n            self.y = y\n    \n    # add(PBVector other)\n    # OR\n    # add(number x, number y)\n    #\n    # Returns a new PBVector representing this vector plus another.\n    def add(self, arg0, y = None):\n        if isinstance(arg0, PBVector):\n            return PBVector(self.x + arg0.x, self.y + arg0.y)\n        return PBVector(self.x + arg0, self.y + y)\n    \n    # div(number value)\n    #\n    # Returns a new PBVector representing this vector divided by a scalar\n    # value.\n    def div(self, value):\n        return PBVector(self.x / value, self.y / value)\n    \n    def get_length(self):\n        return math.sqrt(self.x * self.x + self.y * self.y)\n    \n    def get_perpendicular(self):\n        return PBVector(-self.y, self.x)\n    \n    # mul(number value)\n    #\n    # Returns a new PBVector representing this vector multiplied by a scalar\n    # value.\n    def mul(self, value):\n        return PBVector(self.x * value, self.y * value)\n    \n    def normalize(self):\n        len = self.get_length()\n        return PBVector(self.x / len, self.y / len)\n    \n    def rotate(self, angle_in_radians):\n        cos_angle = math.cos(angle_in_radians)\n        sin_angle = math.sin(angle_in_radians)\n        return PBVector(\n            self.x * cos_angle + self.y * sin_angle,\n            -self.x * sin_angle + self.y * cos_angle)\n    \n    # sub(PBVector other)\n    # OR\n    # sub(number x, number y)\n    #\n    # Returns a new PBVector representing this vector minus another.\n    def sub(self, arg0, y = None):\n        if isinstance(arg0, PBVector):\n            return PBVector(self.x - arg0.x, self.y - arg0.y)\n        return PBVector(self.x - arg0, self.y - y)\n    \n    # to_list()\n    #\n    # Returns a two-element list with this vector\'s X and Y values.\n    def to_list(self):\n        return [self.x, self.y]\n\nclass PBRenderable:\n    # Dividing a font size (ex: 14) by a factor yields that character\'s\n    # rendered width, in pixels.\n    FONT_FACTORS = {\n        "0": 1.7980684811237928,"1": 1.7980684811237928,\n        "2": 1.7980684811237928,"3": 1.7980684811237928,\n        "4": 1.7980684811237928,"5": 1.7980684811237928,\n        "6": 1.7980684811237928,"7": 1.7980684811237928,\n        "8": 1.7980684811237928,"9": 1.7980684811237928,\n        " ": 3.5992970123022845,"!": 3.5992970123022845,\n        "\\"": 2.8170563961485557,"#": 1.7980684811237928,\n        "$": 1.7980684811237928,"%": 1.1246567819879187,"&": 1.499267935578331,\n        "\'": 5.2378516624040925,"(": 3.002932551319648,")": 3.002932551319648,\n        "*": 2.5696361355081554,"+": 1.7123745819397993,\n        ",": 3.5992970123022845,"-": 3.002932551319648,".": 3.5992970123022845,\n        "/": 3.5992970123022845,":": 3.5992970123022845,\n        ";": 3.5992970123022845,"<": 1.7123745819397993,\n        "=": 1.7123745819397993,">": 1.7123745819397993,\n        "?": 1.7980684811237928,"@": 0.9850889850889851,"A": 1.499267935578331,\n        "B": 1.499267935578331,"C": 1.3847194050033806,"D": 1.3847194050033806,\n        "E": 1.499267935578331,"F": 1.6370903277378097,"G": 1.285624607658506,\n        "H": 1.3847194050033806,"I": 3.5992970123022845,"J": 2,\n        "K": 1.499267935578331,"L": 1.7980684811237928,"M": 1.2004689331770222,\n        "N": 1.3847194050033806,"O": 1.285624607658506,"P": 1.499267935578331,\n        "Q": 1.285624607658506,"R": 1.3847194050033806,"S": 1.499267935578331,\n        "T": 1.6370903277378097,"U": 1.3847194050033806,"V": 1.499267935578331,\n        "W": 1.0594930160372478,"X": 1.499267935578331,"Y": 1.499267935578331,\n        "Z": 1.6370903277378097,"[": 3.5992970123022845,\n        "\\\\": 3.5992970123022845,"]": 3.5992970123022845,"^": 2.13111342351717,\n        "_": 1.7980684811237928,"`": 3.002932551319648,"a": 1.7980684811237928,\n        "b": 1.7980684811237928,"c": 2,"d": 1.7980684811237928,\n        "e": 1.7980684811237928,"f": 3.5992970123022845,\n        "g": 1.7980684811237928,"h": 1.7980684811237928,"i": 4.501098901098901,\n        "j": 4.501098901098901,"k": 2,"l": 4.501098901098901,\n        "m": 1.2004689331770222,"n": 1.7980684811237928,\n        "o": 1.7980684811237928,"p": 1.7980684811237928,\n        "q": 1.7980684811237928,"r": 3.002932551319648,"s": 2,\n        "t": 3.5992970123022845,"u": 1.7980684811237928,"v": 2,\n        "w": 1.3847194050033806,"x": 2,"y": 2,"z": 2,"{": 2.9941520467836256,\n        "|": 3.8496240601503757,"}": 2.9941520467836256,\n        "~": 1.7123745819397993,"average": 2.1919799627000227\n    }\n    \n    def __init__(self):\n        pass\n    \n    # ---- Start of abstract methods that inheriting classes must implement ----\n    \n    # Returns a Python dictionary with at least the following two keys:\n    #\n    # "renderables":\n    #   The corresponding value is a list of objects, each also a Python\n    #   dictionary, to render. Each object has a "renderType" key and a\n    #   corresponding value indicating the type of object to render (exs:\n    #   "line" or "rectangle").\n    #\n    # "alt":\n    #   Corresponding value is a string for the rendered content\'s alt text.\n    #\n    #\n    # Two more keys can be included if the renderable wants specific control\n    # over items for dark mode:\n    #\n    # "renderables_dark":\n    #   List of renderables to be used in dark mode.\n    #\n    # "alt_dark":\n    #   Alt text string to be used in dark mode.\n    #\n    # If "renderables_dark" and "alt_dark" are omitted, the PBRenderable\n    # base class\'s to_JSON_string() will build "renderables_dark" by copying\n    # "renderables" and inverting colors, and "alt_dark" will be assigned with\n    # "alt".\n    def get_renderables(self):\n        # Inheriting classes must implement\n        pass\n    \n    # ---- End of abstract methods that inheriting classes must implement ----\n    \n    @staticmethod\n    def auto_shift_renderables(renderables):\n        # Get the bounding box for the renderables\n        bounds = PBRenderable.compute_renderables_bounds(renderables)\n        # Determine the shift that puts the bound\'s upper-left at (0,0)\n        shift_x = -bounds.get_min_x()\n        shift_y = -bounds.get_min_y()\n        # Apply the shift to all renderable items\n        for renderable in renderables:\n            PBRenderable.shift_renderable(renderable, shift_x, shift_y)\n    \n    @staticmethod\n    def center_renderables(renderables, center_x, center_y):\n        # Get the bounding box for the renderables\n        bounds = PBRenderable.compute_renderables_bounds(renderables)\n        # Determine the shift that centers bounds at (center_x, center_y)\n        shift_x = center_x - bounds.get_center_x()\n        shift_y = center_y - bounds.get_center_y()\n        # Apply the shift to all renderable items\n        for renderable in renderables:\n            PBRenderable.shift_renderable(renderable, shift_x, shift_y)\n    \n    # Computes and returns a PBBox that bounds all items in a list of\n    # renderables. Returns None if the list is empty.\n    @staticmethod\n    def compute_renderables_bounds(renderables):\n        bounds = None\n        for renderable in renderables:\n            renderable_bounds = PBRenderable.get_renderable_bounds(renderable)\n            bounds = PBBox.bound(bounds, renderable_bounds)\n        return bounds\n    \n    # Returns a PBBox that represents the bounds of this renderable object\n    def get_bounding_box(self):\n        renderables_dictionary = self.get_renderables()\n        renderables_list = renderables_dictionary["renderables"]\n        return PBRenderable.compute_renderables_bounds(renderables_list)\n    \n    # Gets a PBBox that bounds a single renderable item. The renderable\n    # argument must be a dictionary with the "renderType" key and all other\n    # appropriate keys based on that render type.\n    @staticmethod\n    def get_renderable_bounds(renderable):\n        if renderable["renderType"] == "text":\n            font_arg = 14\n            if "font" in renderable:\n                font_arg = renderable["font"]\n            text_size = PBRenderable.measure_text(renderable["text"], font_arg)\n            width = text_size[0]\n            height = text_size[1]\n\n            # Compute left and top\n            left = 0\n            top = 0\n            if "left" in renderable:\n                left = renderable["left"]\n            else:\n                left = renderable["centerX"] - width / 2\n            if "top" in renderable:\n                top = renderable["top"]\n            else:\n                top = renderable["centerY"] - height / 2\n\n            # Return the box\n            return PBBox(left, top, left + width, top + height)\n        elif renderable["renderType"] == "ring":\n            # Outer radius determines the bounding size\n            outer_r = renderable["outerRadius"]\n            # Compute left and top\n            left = 0\n            top = 0\n            if "left" in renderable:\n                left = renderable["left"]\n            else:\n                left = renderable["centerX"] - outer_r\n            if "top" in renderable:\n                top = renderable["top"]\n            else:\n                top = renderable["centerY"] - outer_r\n\n            # Return the box\n            size = outer_r * 2\n            return PBBox(left, top, left + size, top + size)\n        elif "centerX" in renderable and "centerY" in renderable:\n            cx = renderable["centerX"]\n            cy = renderable["centerY"]\n            if "radius" in renderable:\n                r = renderable["radius"]\n                return PBBox(cx - r, cy - r, cx + r, cy + r)\n            elif "width" in renderable:\n                # "width" and "height" are expected in this case\n                w = renderable["width"]\n                h = renderable["height"]\n                return PBBox(cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2)\n        elif "left" in renderable and "width" in renderable:\n            left = renderable["left"]\n            top = renderable["top"]\n            w = renderable["width"]\n            h = renderable["height"]\n            return PBBox(left, top, left + w, top + h)\n        elif "fromX" in renderable:\n            min_x = min(renderable["fromX"], renderable["toX"])\n            min_y = min(renderable["fromY"], renderable["toY"])\n            max_x = max(renderable["fromX"], renderable["toX"])\n            max_y = max(renderable["fromY"], renderable["toY"])\n            return PBBox(min_x, min_y, max_x, max_y)\n        elif "x1" in renderable:\n            # "x1" is currently only used by the "line" render type\n            min_x = min(renderable["x1"], renderable["x2"])\n            min_y = min(renderable["y1"], renderable["y2"])\n            max_x = max(renderable["x1"], renderable["x2"])\n            max_y = max(renderable["y1"], renderable["y2"])\n            return PBBox(min_x, min_y, max_x, max_y)\n        elif "points" in renderable:\n            # "points" exists in "lineStrip" and "polygon" objects\n            points = renderable["points"]\n            # Special case for empty list\n            if 0 == len(points):\n                return PBBox()\n            # Initialize minimum and maximum values\n            min_x = points[0]\n            min_y = points[1]\n            max_x = points[0]\n            max_y = points[1]\n            for i in range(2, len(points), 2):\n                min_x = min(min_x, points[i])\n                min_y = min(min_y, points[i + 1])\n                max_x = max(max_x, points[i])\n                max_y = max(max_y, points[i + 1])\n            return PBBox(min_x, min_y, max_x, max_y)\n        else:\n            # Unknown object!\n            return PBBox()\n    \n    @staticmethod\n    def measure_text(text, font):\n        # Determine the font size\n        font_size = 14\n        if isinstance(font, int):\n            font_size = font\n        elif isinstance(font, str):\n            index = font.index("px")\n            font_size = int(font[0:index])\n        \n        # Sum character widths to get total width\n        width = 0\n        for char in text:\n            factor = PBRenderable.FONT_FACTORS["average"]\n            if char in PBRenderable.FONT_FACTORS:\n                factor = PBRenderable.FONT_FACTORS[char]\n            # Divide font size by factor to get character width and add to sum\n            width += (font_size / factor)\n        \n        return (width, font_size)\n    \n    @staticmethod\n    def object_to_JSON(obj):\n        if isinstance(obj, str):\n            return (\'"\' + obj.replace(\'"\', \'\\\\"\') + \'"\')\n        elif isinstance(obj, list):\n            value_str = "["\n            if len(obj) > 0:\n                value_str += PBRenderable.object_to_JSON(obj[0])\n            for i in range(1, len(obj)):\n                value_str += "," + PBRenderable.object_to_JSON(obj[i])\n            return value_str + "]"\n        elif isinstance(obj, dict):\n            result = "{"\n            need_comma_prefix = False\n            for key in obj:\n                if need_comma_prefix:\n                    result += ","\n                value_str = PBRenderable.object_to_JSON(obj[key])\n                result += \'"\' + key + \'":\' + value_str\n                need_comma_prefix = True\n            result += "}"\n            return result\n        # Remaining cases should all be numbers, which can just be converted to\n        # strings\n        return str(obj)\n    \n    @staticmethod\n    def shift_renderable(renderable, shift_x, shift_y):\n        if "centerX" in renderable and "centerY" in renderable:\n            renderable["centerX"] = renderable["centerX"] + shift_x\n            renderable["centerY"] = renderable["centerY"] + shift_y\n        elif "left" in renderable and "top" in renderable:\n            renderable["left"] = renderable["left"] + shift_x\n            renderable["top"] = renderable["top"] + shift_y\n        elif "fromX" in renderable:\n            renderable["fromX"] = renderable["fromX"] + shift_x\n            renderable["fromY"] = renderable["fromY"] + shift_y\n            renderable["toX"] = renderable["toX"] + shift_x\n            renderable["toY"] = renderable["toY"] + shift_y\n        elif "x1" in renderable:\n            # "x1" is currently only used by the "line" render type\n            renderable["x1"] = renderable["x1"] + shift_x\n            renderable["y1"] = renderable["y1"] + shift_y\n            renderable["x2"] = renderable["x2"] + shift_x\n            renderable["y2"] = renderable["y2"] + shift_y\n        elif "points" in renderable:\n            # "points" exists in "lineStrip" and "polygon" objects\n            points = renderable["points"]\n            for i in range(0, len(points), 2):\n                points[i] += shift_x\n                points[i + 1] += shift_y\n    \n    # Returns a JSON string representing the object returned from\n    # get_renderables()\n    def to_JSON_string(self, content_center_x = None, content_center_y = None):\n        d = self.get_renderables()\n        PBRenderable._fix_renderables(d)\n        \n        # If content_center_y is None then position all renderables so that the\n        # bounding box\'s upper-left is at (0,0)\n        if content_center_y == None:\n            PBRenderable.auto_shift_renderables(d["renderables"])\n            PBRenderable.auto_shift_renderables(d["renderables_dark"])\n        else:\n            # Center the renderables in the requested location\n            PBRenderable.center_renderables(d["renderables"], content_center_x,\n                content_center_y)\n            PBRenderable.center_renderables(d["renderables_dark"],\n                content_center_x, content_center_y)\n        return PBRenderable.object_to_JSON(d)\n    \n    @staticmethod\n    def _append_arrow(renderables, points, color, dashed = False):\n        # Arrow head length is hard-coded for now\n        ARROW_HEAD_LENGTH = 10\n        \n        from_x = points[0]\n        from_y = points[1]\n        to_x = points[2]\n        to_y = points[3]\n        \n        # Make vectors:\n        # - a vector for the arrow\'s ending point (tip of arrow head)\n        # - a directional vector for the arrow\n        end = PBVector(to_x, to_y)\n        direction = PBVector(to_x - from_x, to_y - from_y)\n        \n        # Compute meeting point of line and arrow head\n        line_length = direction.get_length() - ARROW_HEAD_LENGTH\n        meet = end.sub(direction.normalize().mul(ARROW_HEAD_LENGTH))\n        \n        # If line_length is positive, add a renderable for the line\n        if line_length > 0:\n            new_line_renderable = {\n                "renderType": "line",\n                "x1": from_x,\n                "y1": from_y,\n                "x2": to_x,\n                "y2": to_y,\n                "borderColor": color\n            }\n            if dashed:\n                new_line_renderable["dashed"] = True\n            renderables.append(new_line_renderable)\n        \n        # Now build the triangle at the arrow\'s end\n        # Compute base point of arrow head\n        base = end.sub(direction.normalize().mul(ARROW_HEAD_LENGTH))\n        # Make a normalized, perpendicular vector\n        perpendicular = PBVector(-direction.y, direction.x).normalize()\n        # Compute the two other (non-tip) points of the arrow head\n        pt1 = base.add(perpendicular.mul(ARROW_HEAD_LENGTH / 2.0))\n        pt2 = base.sub(perpendicular.mul(ARROW_HEAD_LENGTH / 2.0))\n        # Add the polygon object\n        renderables.append({\n            "renderType": "polygon",\n            "color": color,\n            "points": [ end.x, end.y, pt1.x, pt1.y, pt2.x, pt2.y ]\n        })\n    \n    # Makes needed fixes to the dictionary object returned from a PBRenderable\n    # object\'s get_renderables() method by doing any of the following:\n    # - Convert objects with a renderType not supported by PB\'s JS code\n    # - Add dark mode entries "renderables_dark" and "alt_dark", if missing\n    @staticmethod\n    def _fix_renderables(renderables_dictionary):\n        items_light = renderables_dictionary["renderables"]\n        PBRenderable._fix_items(items_light)\n        \n        # If the dictionary has a "renderables_dark" list, then _fix_items() is\n        # called directly on that list. Otherwise, renderables_dark is made by\n        # copying items_light and then inverting colors.\n        if "renderables_dark" in renderables_dictionary:\n            PBRenderable._fix_items(renderables_dictionary["renderables_dark"])\n        else:\n            items_dark = PBRenderable._invert_renderables(items_light)\n            renderables_dictionary["renderables_dark"] = items_dark\n            renderables_dictionary["alt_dark"] = renderables_dictionary["alt"]\n    \n    @staticmethod\n    def _fix_items(renderables_list):\n        # Code below looks for objects not supported in PB\'s JavaScript\n        # rendering code and replaces each with equivalent objects that are\n        # supported.\n        original_list_copy = list(renderables_list)\n        del renderables_list[:]\n        for renderable in original_list_copy:\n            if renderable["renderType"] == "linestrip":\n                color = PBColors.get_light_mode_colors()["line"]\n                if "color" in renderable:\n                    color = renderable["color"]\n                pts = renderable["points"]\n                end_index = len(pts) - 2\n                if "endShape" in renderable:\n                    if renderable["endShape"] == "arrow":\n                        end_index -= 2\n                        arrow_points = pts[-4:]\n                        PBRenderable._append_arrow(renderables_list,\n                            arrow_points, color, False)\n                    elif renderable["endShape"] == "circle":\n                        renderables_list.append({\n                            "renderType": "circle",\n                            "centerX": pts[-2],\n                            "centerY": pts[-1],\n                            "radius": 4\n                        })\n                for i in range(0, end_index, 2):\n                    renderables_list.append({\n                        "renderType": "line",\n                        "x1": pts[i],\n                        "y1": pts[i + 1],\n                        "x2": pts[i + 2],\n                        "y2": pts[i + 3],\n                        "borderColor": color\n                    })\n            elif renderable["renderType"] == "arrow":\n                color = PBColors.get_light_mode_colors()["line"]\n                if "color" in renderable:\n                    color = renderable["color"]\n                dashed = False\n                if "dashed" in renderable and renderable["dashed"]:\n                    dashed = True\n                \n                pts = [\n                    renderable["fromX"], renderable["fromY"],\n                    renderable["toX"], renderable["toY"]\n                ]\n                PBRenderable._append_arrow(renderables_list, pts, color, dashed)\n            elif (renderable["renderType"] == "rectangle" and\n                "borderColor" in renderable):\n                # As of a conversation with the devs late March 2025, support\n                # for "borderColor" will be removed from their JS rendering\n                # code. The code that follows here gives support for\n                # "borderColor" by expanding rectangles with borders into two\n                # overlapping rectangle objects.\n                \n                # The border width defaults to 2, but can optionally be\n                # specified by the renderable object\n                border_size = 2\n                if "borderSize" in renderable:\n                    border_size = int(renderable["borderSize"])\n                    del renderable["borderSize"]\n                \n                # A "background" rectangle is added only if the border width is\n                # positive\n                if border_size > 0:\n                    # First rectangle fits in the same space as the original\n                    # and has a background color equal to the border color\n                    bg_rect = dict(renderable)\n                    bg_rect["backgroundColor"] = renderable["borderColor"]\n                    del bg_rect["borderColor"]\n                    renderables_list.append(bg_rect)\n                \n                # Second rectangle has same center point, but has width and\n                # height decreased by border_size * 2\n                fg_rect = dict(renderable)\n                del fg_rect["borderColor"]\n                fg_rect["width"] = renderable["width"] - (border_size * 2)\n                fg_rect["height"] = renderable["height"] - (border_size * 2)\n                if "left" in renderable:\n                    fg_rect["left"] += border_size\n                if "top" in renderable:\n                    fg_rect["top"] += border_size\n                renderables_list.append(fg_rect)\n            elif (renderable["renderType"] == "circle" and\n                "borderColor" in renderable):\n                # As of a conversation with the devs late March 2025, support\n                # for "borderColor" will be removed from their JS rendering\n                # code. The code that follows here gives support for\n                # "borderColor" by expanding circles with borders into two\n                # overlapping circle objects.\n                \n                # The border width defaults to 2, but can optionally be\n                # specified by the renderable object\n                border_size = 2\n                if "borderSize" in renderable:\n                    border_size = int(renderable["borderSize"])\n                    del renderable["borderSize"]\n                \n                # A "background" circle is added only if the border size is > 0\n                if border_size > 0:\n                    # First circle fits in the same space as the original\n                    # and has a background color equal to the border color\n                    bg_obj = dict(renderable)\n                    bg_obj["backgroundColor"] = renderable["borderColor"]\n                    del bg_obj["borderColor"]\n                    renderables_list.append(bg_obj)\n                \n                # Second circle has same center point, but has radius decreased\n                # by border_size\n                fg_obj = dict(renderable)\n                del fg_obj["borderColor"]\n                fg_obj["radius"] = renderable["radius"] - border_size\n                renderables_list.append(fg_obj)\n            else:\n                renderables_list.append(renderable)\n    \n    @staticmethod\n    def _invert_renderables(renderables_list):\n        key_names = ["color", "backgroundColor", "borderColor"]\n        result = []\n        for renderable in renderables_list:\n            # Copy the renderable first\n            new_renderable = dict(renderable)\n            # Check for colors and invert each\n            for key_name in key_names:\n                if key_name in new_renderable:\n                    new_color = PBColors.invert(new_renderable[key_name])\n                    new_renderable[key_name] = new_color\n            # Append new_renderable to result\n            result.append(new_renderable)\n        return result\n\n# Base class for a node that includes a dictionary of rendering-oriented\n# properties for nodes, like sizes and colors. Intended to be the base class\n# for any node in a linked structure, like a tree or linked list.\nclass PBBaseNode:\n    def __init__(self):\n        light_colors = PBColors.get_light_mode_colors()\n        dark_colors = PBColors.get_dark_mode_colors()\n        self.render_info = {\n            "bgColorLight": light_colors["bg"],\n            "bgColorDark": dark_colors["bg"],\n            "borderColorLight": light_colors["node_border"],\n            "borderColorDark": dark_colors["node_border"],\n            "centerX": 0,\n            "centerY": 0,\n            "height": 40,\n            "shape": "circle",\n            "textColorLight": light_colors["text"],\n            "textColorDark": dark_colors["text"],\n            "width": 40\n        }\n    \n    # Returns a PBBox object representing this node\'s bounding box\n    def get_bounding_box(self):\n        cx = self.render_info["centerX"]\n        cy = self.render_info["centerY"]\n        r = self.render_info["height"] / 2.0\n        wo2 = self.render_info["width"] / 2.0\n        return PBBox(cx - wo2, cy - r, cx + wo2, cy + r)\n    \n    # Returns a list with 2 numbers representing the size of the bounding box\n    # needed to render this node:\n    #   [boxWidth, boxHeight]\n    # The box size represents this node\'s render size only and does not\n    # include subtrees.\n    def get_bounding_size(self):\n        return [self.render_info["width"], self.render_info["height"]]\n    \n    def get_center_x(self):\n        return self.render_info["centerX"]\n    \n    def get_center_y(self):\n        return self.render_info["centerY"]\n    \n    def get_render_left(self):\n        return self.render_info["centerX"] - self.render_info["width"] / 2.0\n    \n    def get_render_top(self):\n        return self.render_info["centerY"] - self.render_info["height"] / 2.0\n    \n    #  Returns a string for this node\'s inner text content\n    def get_text(self):\n        # Must be overridden in inheriting classes\n        return ""\n    \n    def get_top_center_y(self):\n        bounding_size = self.get_bounding_size()\n        return self.render_info["centerY"] - bounding_size[1] / 2.0\n    \n    # Sets this node\'s position via a center point\n    def set_render_center(self, x, y):\n        self.render_info["centerX"] = x\n        self.render_info["centerY"] = y\n        return self\n    \n    # Sets this node\'s position via an upper-left point\n    def set_render_upper_left(self, upper_left_x, upper_left_y):\n        box_size = self.get_bounding_size()\n        self.set_render_center(\n            upper_left_x + box_size[0] / 2.0, upper_left_y + box_size[1] / 2.0)\n        return self\n\nclass PBStackedRenderables(PBRenderable):\n    def __init__(self, list_of_renderables, space_between_items = 4):\n        PBRenderable.__init__(self)\n        self.renderables = list(list_of_renderables)\n        self._align = "min"\n        self._space_between = space_between_items\n        self._vertical = True\n        self._alt_override = None\n    \n    def get_renderables(self):\n        # Call get_renderables() for every item in self.renderables\n        all_dicts = []\n        for pb_renderable in self.renderables:\n            d = pb_renderable.get_renderables()\n            all_dicts.append(d)\n            # Code after this loop requires each dictionary to have both light\n            # and dark mode renderables. So dark mode renderables must be added\n            # now, if missing.\n            if "alt_dark" not in d:\n                d["alt_dark"] = d["alt"]\n            if "renderables_dark" not in d:\n                d["renderables_dark"] = PBRenderable._invert_renderables(\n                    d["renderables"])\n        \n        alt_light = self._alt_override\n        alt_dark = alt_light\n        if not isinstance(self._alt_override, str):\n            alt_light = self._combine_alts(all_dicts, "alt")\n            alt_dark = self._combine_alts(all_dicts, "alt_dark")\n        \n        lights = self._build_renderables_list(all_dicts, "renderables")\n        darks = self._build_renderables_list(all_dicts, "renderables_dark")\n        return { "renderables": lights, "renderables_dark": darks,\n            "alt": alt_light, "alt_dark": alt_dark }\n    \n    # Sets a custom alt text string that overrides the default\n    def set_alt_text(self, alt_text_override):\n        self._alt_override = alt_text_override\n        return self\n    \n    def set_layout_to_horizontal(self):\n        self._vertical = False\n        return self\n    \n    def set_layout_to_vertical(self):\n        self._vertical = True\n        return self\n    \n    # The list_name argument must be "renderables" or "renderables_dark"\n    def _build_renderables_list(self, all_dictionaries, list_name):\n        # Compute all bounding boxes\n        all_boxes = []\n        for renderable_dictionary in all_dictionaries:\n            renderable_obj_list = renderable_dictionary[list_name]\n            box = PBRenderable.compute_renderables_bounds(renderable_obj_list)\n            all_boxes.append(box)\n        \n        # Build the final list of renderables based on a vertical or\n        # horizontal layout\n        final_renderables = []\n        if self._vertical:\n            # Compute the maximum bounding box width\n            max_bb_width = PBBox.get_max_width(all_boxes)\n            \n            # Shift all renderables as needed and build the final list\n            top = 0\n            for i in range(len(all_boxes)):\n                box = all_boxes[i]\n                renderables_list = all_dictionaries[i][list_name]\n                \n                # Compute desired center (x,y) and center renderables\n                cx = max_bb_width / 2\n                if "min" == self._align:\n                    cx = box.get_width() / 2\n                elif "max" == self._align:\n                    cx = max_bb_width - box.get_width() / 2\n                cy = top + box.get_height() / 2\n                PBRenderable.center_renderables(renderables_list, cx, cy)\n                \n                # Update top for next iteration\n                top += (self._space_between + box.get_height())\n                \n                # Add shifted renderables to final list\n                final_renderables += renderables_list\n        else:\n            # Compute the maximum bounding box height\n            max_bb_height = PBBox.get_max_height(all_boxes)\n            \n            # Shift all renderables as needed and build the final list\n            left = 0\n            for i in range(len(all_boxes)):\n                box = all_boxes[i]\n                renderables_list = all_dictionaries[i][list_name]\n                \n                # Compute desired center (x,y) and center renderables\n                cx = left + box.get_width() / 2\n                cy = max_bb_height / 2\n                if "min" == self._align:\n                    cy = box.get_height() / 2\n                elif "max" == self._align:\n                    cx = max_bb_height - box.get_height() / 2\n                PBRenderable.center_renderables(renderables_list, cx, cy)\n                \n                # Update left for next iteration\n                left += (self._space_between + box.get_width())\n                \n                # Add shifted renderables to final list\n                final_renderables += renderables_list\n        return final_renderables\n    \n    def _combine_alts(self, all_dictionaries, attr_name = "alt"):\n        if len(all_dictionaries) == 0:\n            return ""\n        if len(all_dictionaries) == 1:\n            # Special case: Use the only item\'s alt text\n            return all_dictionaries[0][attr_name]\n        \n        # Start the alt text with an item count and basic layout info\n        alt_text = str(len(self.renderables)) + " stacked items (from "\n        if self._vertical:\n            alt_text += "top to bottom):"\n        else:\n            alt_text += "left to right):"\n        # Build and return the rest of the alt text\n        for renderable_dictionary in all_dictionaries:\n            alt_text += (" | " + renderable_dictionary[attr_name])\n        return alt_text\n\n# PBAlignedRenderable aligns a child PBRenderable object within a fixed size\n# area\nclass PBAlignedRenderable(PBRenderable):\n    def __init__(self, child_renderable, width, height):\n        PBRenderable.__init__(self)\n        self._child = child_renderable\n        self._width = width\n        self._height = height\n        \n        # Default to center for both horizontal and vertical alignment\n        self._h_align = "center"\n        self._v_align = "center"\n    \n    def get_renderables(self):\n        # Call get_renderables() to get the child\'s renderables\n        result = dict(self._child.get_renderables())\n        \n        LIST_NAMES = ["renderables"]\n        BGS = [PBColors.get_light_mode_colors()["bg"]]\n        if "renderables_dark" in result:\n            LIST_NAMES.append("renderables_dark")\n            BGS.append(PBColors.get_dark_mode_colors()["bg"])\n        \n        for i in range(len(LIST_NAMES)):\n            list_name = LIST_NAMES[i]\n            # Compute bounding box of child renderables\n            child_list = result[list_name]\n            child_bounds = PBRenderable.compute_renderables_bounds(child_list)\n            \n            # Compute the desired center point of the child renderables based on\n            # alignment attributes\n            center_x = 0\n            center_y = 0\n            if "left" == self._h_align:\n                center_x = child_bounds.get_width() / 2.0\n            elif "center" == self._h_align:\n                center_x = self._width / 2.0\n            elif "right" == self._h_align:\n                center_x = self._width - (child_bounds.get_width() / 2.0)\n            if "top" == self._v_align:\n                center_y = child_bounds.get_height() / 2.0\n            elif "center" == self._v_align:\n                center_y = self._height / 2.0\n            elif "bottom" == self._v_align:\n                center_y = self._height - (child_bounds.get_height() / 2.0)\n            \n            # Shift child renderables to computed center point\n            PBRenderable.center_renderables(child_list, center_x, center_y)\n            \n            # Create a final list of renderables that includes a fixed-size\n            # rectangle as the first item\n            final_renderables = [{\n                "renderType": "rectangle",\n                "left": 0,\n                "top": 0,\n                "width": self._width,\n                "height": self._height,\n                "backgroundColor": BGS[i]\n            }]\n            final_renderables += child_list\n            result[list_name] = final_renderables\n        return result\n    \n    def set_h_align_to_center(self):\n        self._h_align = "center"\n        return self\n    \n    def set_h_align_to_left(self):\n        self._h_align = "left"\n        return self\n    \n    def set_h_align_to_right(self):\n        self._h_align = "right"\n        return self\n    \n    def set_v_align_to_bottom(self):\n        self._v_align = "bottom"\n        return self\n    \n    def set_v_align_to_center(self):\n        self._v_align = "center"\n        return self\n    \n    def set_v_align_to_top(self):\n        self._v_align = "top"\n        return self\n\n# PBSwappedModesRenderable wraps a PBRenderable and swaps the light and dark\n# mode items.\nclass PBSwappedModesRenderable(PBRenderable):\n    def __init__(self, child_renderable):\n        self._child = child_renderable\n    \n    def get_renderables(self):\n        result = self._child.get_renderables()\n        # Swap item lists\n        lights = result["renderables"]\n        result["renderables"] = result["renderables_dark"]\n        result["renderables_dark"] = lights\n        # Swap alt text values\n        result["alt"], result["alt_dark"] = result["alt_dark"], result["alt"]\n        # Return the result\n        return result\n',"src/lib/aifc.py":'raise NotImplementedError("aifc is not yet implemented in Skulpt")\n',"src/lib/webgl/matrix4.js":"// more from 'tdl'\nvar $builtinmodule = function(name)\n{\n    var mod = {};\n\n    var temp0v3_ = new Float32Array(3);\n    var temp1v3_ = new Float32Array(3);\n    var temp2v3_ = new Float32Array(3);\n\n    var temp0v4_ = new Float32Array(4);\n    var temp1v4_ = new Float32Array(4);\n    var temp2v4_ = new Float32Array(4);\n\n    var temp0m4_ = new Float32Array(16);\n    var temp1m4_ = new Float32Array(16);\n    var temp2m4_ = new Float32Array(16);\n\n    var normalize = function(dst, a) {\n        var n = 0.0;\n        var aLength = a.length;\n        for (var i = 0; i < aLength; ++i)\n            n += a[i] * a[i];\n        n = Math.sqrt(n);\n        if (n > 0.00001) {\n            for (var i = 0; i < aLength; ++i)\n                dst[i] = a[i] / n;\n        } else {\n            for (var i = 0; i < aLength; ++i)\n                dst[i] = 0;\n        }\n        return dst;\n    };\n\n    var cross = function(dst, a, b) {\n        dst[0] = a[1] * b[2] - a[2] * b[1];\n        dst[1] = a[2] * b[0] - a[0] * b[2];\n        dst[2] = a[0] * b[1] - a[1] * b[0];\n        return dst;\n    };\n\n    var subVector = function(dst, a, b) {\n        var aLength = a.length;\n        for (var i = 0; i < aLength; ++i)\n            dst[i] = a[i] - b[i];\n        return dst;\n    };\n\n    var dot = function(a, b) {\n        return (a[0] * b[0]) + (a[1] * b[1]) + (a[2] * b[2]);\n    };\n\n    mod.lookAt = new Sk.builtin.func(function(view, eye, target, up)\n            {\n                var t0 = temp0v3_;\n                var t1 = temp1v3_;\n                var t2 = temp2v3_;\n\n                var vz = normalize(t0, subVector(t0, eye.v, target.v));\n                var vx = normalize(t1, cross(t1, up.v, vz));\n                var vy = cross(t2, vz, vx);\n\n                var dst = view.v;\n                dst[ 0] = vx[0];\n                dst[ 1] = vy[0];\n                dst[ 2] = vz[0];\n                dst[ 3] = 0;\n                dst[ 4] = vx[1];\n                dst[ 5] = vy[1];\n                dst[ 6] = vz[1];\n                dst[ 7] = 0;\n                dst[ 8] = vx[2];\n                dst[ 9] = vy[2];\n                dst[10] = vz[2];\n                dst[11] = 0;\n                dst[12] = -dot(vx, eye.v);\n                dst[13] = -dot(vy, eye.v);\n                dst[14] = -dot(vz, eye.v);\n                dst[15] = 1;\n\n                return view;\n            });\n\n    mod.perspective = new Sk.builtin.func(function(proj, angle, aspect, near, far)\n            {\n                var f = Math.tan(Math.PI * 0.5 - 0.5 * (angle * Math.PI / 180));\n                var rangeInv = 1.0 / (near - far);\n\n                var dst = proj.v;\n\n                dst[0]  = f / aspect;\n                dst[1]  = 0;\n                dst[2]  = 0;\n                dst[3]  = 0;\n\n                dst[4]  = 0;\n                dst[5]  = f;\n                dst[6]  = 0;\n                dst[7]  = 0;\n\n                dst[8]  = 0;\n                dst[9]  = 0;\n                dst[10] = (near + far) * rangeInv;\n                dst[11] = -1;\n\n                dst[12] = 0;\n                dst[13] = 0;\n                dst[14] = near * far * rangeInv * 2;\n                dst[15] = 0;\n\n                return proj;\n            });\n\n    // builds, not appending\n    mod.rotationY = new Sk.builtin.func(function(target, angle)\n            {\n                var dst = target.v;\n                var c = Math.cos(angle * Math.PI / 180);\n                var s = Math.sin(angle * Math.PI / 180);\n\n                dst[ 0] = c;\n                dst[ 1] = 0;\n                dst[ 2] = -s;\n                dst[ 3] = 0;\n                dst[ 4] = 0;\n                dst[ 5] = 1;\n                dst[ 6] = 0;\n                dst[ 7] = 0;\n                dst[ 8] = s;\n                dst[ 9] = 0;\n                dst[10] = c;\n                dst[11] = 0;\n                dst[12] = 0;\n                dst[13] = 0;\n                dst[14] = 0;\n                dst[15] = 1;\n\n                return target;\n            });\n\n    mod.identity = new Sk.builtin.func(function(target)\n            {\n                var dst = target.v;\n                dst[ 0] = 1;\n                dst[ 1] = 0;\n                dst[ 2] = 0;\n                dst[ 3] = 0;\n                dst[ 4] = 0;\n                dst[ 5] = 1;\n                dst[ 6] = 0;\n                dst[ 7] = 0;\n                dst[ 8] = 0;\n                dst[ 9] = 0;\n                dst[10] = 1;\n                dst[11] = 0;\n                dst[12] = 0;\n                dst[13] = 0;\n                dst[14] = 0;\n                dst[15] = 1;\n                return target;\n            });\n\n    // row major\n    mod.mul = new Sk.builtin.func(function(target, x, y)\n            {\n                var dst = target.v;\n                var a = x.v;\n                var b = y.v;\n                var a00 = a[0];\n                var a01 = a[1];\n                var a02 = a[2];\n                var a03 = a[3];\n                var a10 = a[ 4 + 0];\n                var a11 = a[ 4 + 1];\n                var a12 = a[ 4 + 2];\n                var a13 = a[ 4 + 3];\n                var a20 = a[ 8 + 0];\n                var a21 = a[ 8 + 1];\n                var a22 = a[ 8 + 2];\n                var a23 = a[ 8 + 3];\n                var a30 = a[12 + 0];\n                var a31 = a[12 + 1];\n                var a32 = a[12 + 2];\n                var a33 = a[12 + 3];\n                var b00 = b[0];\n                var b01 = b[1];\n                var b02 = b[2];\n                var b03 = b[3];\n                var b10 = b[ 4 + 0];\n                var b11 = b[ 4 + 1];\n                var b12 = b[ 4 + 2];\n                var b13 = b[ 4 + 3];\n                var b20 = b[ 8 + 0];\n                var b21 = b[ 8 + 1];\n                var b22 = b[ 8 + 2];\n                var b23 = b[ 8 + 3];\n                var b30 = b[12 + 0];\n                var b31 = b[12 + 1];\n                var b32 = b[12 + 2];\n                var b33 = b[12 + 3];\n                dst[ 0] = a00 * b00 + a01 * b10 + a02 * b20 + a03 * b30;\n                dst[ 1] = a00 * b01 + a01 * b11 + a02 * b21 + a03 * b31;\n                dst[ 2] = a00 * b02 + a01 * b12 + a02 * b22 + a03 * b32;\n                dst[ 3] = a00 * b03 + a01 * b13 + a02 * b23 + a03 * b33;\n                dst[ 4] = a10 * b00 + a11 * b10 + a12 * b20 + a13 * b30;\n                dst[ 5] = a10 * b01 + a11 * b11 + a12 * b21 + a13 * b31;\n                dst[ 6] = a10 * b02 + a11 * b12 + a12 * b22 + a13 * b32;\n                dst[ 7] = a10 * b03 + a11 * b13 + a12 * b23 + a13 * b33;\n                dst[ 8] = a20 * b00 + a21 * b10 + a22 * b20 + a23 * b30;\n                dst[ 9] = a20 * b01 + a21 * b11 + a22 * b21 + a23 * b31;\n                dst[10] = a20 * b02 + a21 * b12 + a22 * b22 + a23 * b32;\n                dst[11] = a20 * b03 + a21 * b13 + a22 * b23 + a23 * b33;\n                dst[12] = a30 * b00 + a31 * b10 + a32 * b20 + a33 * b30;\n                dst[13] = a30 * b01 + a31 * b11 + a32 * b21 + a33 * b31;\n                dst[14] = a30 * b02 + a31 * b12 + a32 * b22 + a33 * b32;\n                dst[15] = a30 * b03 + a31 * b13 + a32 * b23 + a33 * b33;\n                return target;\n            });\n\n    mod.invert = new Sk.builtin.func(function(target, mat)\n            {\n                var dst = target.v;\n                var m = mat.v;\n                var m00 = m[0 * 4 + 0];\n                var m01 = m[0 * 4 + 1];\n                var m02 = m[0 * 4 + 2];\n                var m03 = m[0 * 4 + 3];\n                var m10 = m[1 * 4 + 0];\n                var m11 = m[1 * 4 + 1];\n                var m12 = m[1 * 4 + 2];\n                var m13 = m[1 * 4 + 3];\n                var m20 = m[2 * 4 + 0];\n                var m21 = m[2 * 4 + 1];\n                var m22 = m[2 * 4 + 2];\n                var m23 = m[2 * 4 + 3];\n                var m30 = m[3 * 4 + 0];\n                var m31 = m[3 * 4 + 1];\n                var m32 = m[3 * 4 + 2];\n                var m33 = m[3 * 4 + 3];\n                var tmp_0  = m22 * m33;\n                var tmp_1  = m32 * m23;\n                var tmp_2  = m12 * m33;\n                var tmp_3  = m32 * m13;\n                var tmp_4  = m12 * m23;\n                var tmp_5  = m22 * m13;\n                var tmp_6  = m02 * m33;\n                var tmp_7  = m32 * m03;\n                var tmp_8  = m02 * m23;\n                var tmp_9  = m22 * m03;\n                var tmp_10 = m02 * m13;\n                var tmp_11 = m12 * m03;\n                var tmp_12 = m20 * m31;\n                var tmp_13 = m30 * m21;\n                var tmp_14 = m10 * m31;\n                var tmp_15 = m30 * m11;\n                var tmp_16 = m10 * m21;\n                var tmp_17 = m20 * m11;\n                var tmp_18 = m00 * m31;\n                var tmp_19 = m30 * m01;\n                var tmp_20 = m00 * m21;\n                var tmp_21 = m20 * m01;\n                var tmp_22 = m00 * m11;\n                var tmp_23 = m10 * m01;\n\n                var t0 = (tmp_0 * m11 + tmp_3 * m21 + tmp_4 * m31) -\n                    (tmp_1 * m11 + tmp_2 * m21 + tmp_5 * m31);\n                var t1 = (tmp_1 * m01 + tmp_6 * m21 + tmp_9 * m31) -\n                    (tmp_0 * m01 + tmp_7 * m21 + tmp_8 * m31);\n                var t2 = (tmp_2 * m01 + tmp_7 * m11 + tmp_10 * m31) -\n                    (tmp_3 * m01 + tmp_6 * m11 + tmp_11 * m31);\n                var t3 = (tmp_5 * m01 + tmp_8 * m11 + tmp_11 * m21) -\n                    (tmp_4 * m01 + tmp_9 * m11 + tmp_10 * m21);\n\n                var d = 1.0 / (m00 * t0 + m10 * t1 + m20 * t2 + m30 * t3);\n\n                dst[ 0] = d * t0;\n                dst[ 1] = d * t1;\n                dst[ 2] = d * t2;\n                dst[ 3] = d * t3;\n                dst[ 4] = d * ((tmp_1 * m10 + tmp_2 * m20 + tmp_5 * m30) -\n                        (tmp_0 * m10 + tmp_3 * m20 + tmp_4 * m30));\n                dst[ 5] = d * ((tmp_0 * m00 + tmp_7 * m20 + tmp_8 * m30) -\n                        (tmp_1 * m00 + tmp_6 * m20 + tmp_9 * m30));\n                dst[ 6] = d * ((tmp_3 * m00 + tmp_6 * m10 + tmp_11 * m30) -\n                        (tmp_2 * m00 + tmp_7 * m10 + tmp_10 * m30));\n                dst[ 7] = d * ((tmp_4 * m00 + tmp_9 * m10 + tmp_10 * m20) -\n                        (tmp_5 * m00 + tmp_8 * m10 + tmp_11 * m20));\n                dst[ 8] = d * ((tmp_12 * m13 + tmp_15 * m23 + tmp_16 * m33) -\n                        (tmp_13 * m13 + tmp_14 * m23 + tmp_17 * m33));\n                dst[ 9] = d * ((tmp_13 * m03 + tmp_18 * m23 + tmp_21 * m33) -\n                        (tmp_12 * m03 + tmp_19 * m23 + tmp_20 * m33));\n                dst[10] = d * ((tmp_14 * m03 + tmp_19 * m13 + tmp_22 * m33) -\n                        (tmp_15 * m03 + tmp_18 * m13 + tmp_23 * m33));\n                dst[11] = d * ((tmp_17 * m03 + tmp_20 * m13 + tmp_23 * m23) -\n                        (tmp_16 * m03 + tmp_21 * m13 + tmp_22 * m23));\n                dst[12] = d * ((tmp_14 * m22 + tmp_17 * m32 + tmp_13 * m12) -\n                        (tmp_16 * m32 + tmp_12 * m12 + tmp_15 * m22));\n                dst[13] = d * ((tmp_20 * m32 + tmp_12 * m02 + tmp_19 * m22) -\n                        (tmp_18 * m22 + tmp_21 * m32 + tmp_13 * m02));\n                dst[14] = d * ((tmp_18 * m12 + tmp_23 * m32 + tmp_15 * m02) -\n                        (tmp_22 * m32 + tmp_14 * m02 + tmp_19 * m12));\n                dst[15] = d * ((tmp_22 * m22 + tmp_16 * m02 + tmp_21 * m12) -\n                        (tmp_20 * m12 + tmp_23 * m22 + tmp_17 * m02));\n                return target;\n            });\n\n    mod.transpose = new Sk.builtin.func(function(target, mat)\n            {\n                var dst = target.v;\n                var m = mat.v;\n                for (var j = 0; j < 4; ++j) {\n                    for (var i = 0; i < 4; ++i)\n                    dst[j * 4 + i] = m[i * 4 + j];\n                }\n                return dst;\n            });\n\n    return mod;\n};\n","src/lib/idlelib/__init__.py":'raise NotImplementedError("idlelib is not yet implemented in Skulpt")\n',"src/lib/formatter.py":'raise NotImplementedError("formatter is not yet implemented in Skulpt")\n',"src/lib/tabnanny.py":'raise NotImplementedError("tabnanny is not yet implemented in Skulpt")\n',"src/lib/urllib/__init__.js":"var $builtinmodule = function (name) {\n    var urllib = {};\n\n    return urllib;\n};\n","src/lib/base64.py":'raise NotImplementedError("base64 is not yet implemented in Skulpt")\n',"src/lib/sqlite3/__init__.py":'raise NotImplementedError("sqlite3 is not yet implemented in Skulpt")\n',"src/lib/abc.py":'raise NotImplementedError("abc is not yet implemented in Skulpt")\n',"src/lib/email/mime/__init__.py":'raise NotImplementedError("mime is not yet implemented in Skulpt")\n',"src/builtin/this.py":'s = """Gur Mra bs Clguba, ol Gvz Crgref\n\nOrnhgvshy vf orggre guna htyl.\nRkcyvpvg vf orggre guna vzcyvpvg.\nFvzcyr vf orggre guna pbzcyrk.\nPbzcyrk vf orggre guna pbzcyvpngrq.\nSyng vf orggre guna arfgrq.\nFcnefr vf orggre guna qrafr.\nErnqnovyvgl pbhagf.\nFcrpvny pnfrf nera\'g fcrpvny rabhtu gb oernx gur ehyrf.\nNygubhtu cenpgvpnyvgl orngf chevgl.\nReebef fubhyq arire cnff fvyragyl.\nHayrff rkcyvpvgyl fvyraprq.\nVa gur snpr bs nzovthvgl, ershfr gur grzcgngvba gb thrff.\nGurer fubhyq or bar-- naq cersrenoyl bayl bar --boivbhf jnl gb qb vg.\nNygubhtu gung jnl znl abg or boivbhf ng svefg hayrff lbh\'er Qhgpu.\nAbj vf orggre guna arire.\nNygubhtu arire vf bsgra orggre guna *evtug* abj.\nVs gur vzcyrzragngvba vf uneq gb rkcynva, vg\'f n onq vqrn.\nVs gur vzcyrzragngvba vf rnfl gb rkcynva, vg znl or n tbbq vqrn.\nAnzrfcnprf ner bar ubaxvat terng vqrn -- yrg\'f qb zber bs gubfr!"""\n\nd = {}\nfor c in (65, 97):\n    for i in range(26):\n        d[chr(i+c)] = chr((i+13) % 26 + c)\n\nprint "".join([d.get(c, c) for c in s])\n',"src/lib/token.py":'raise NotImplementedError("token is not yet implemented in Skulpt")\n',"src/lib/multiprocessing/dummy/__init__.py":'raise NotImplementedError("dummy is not yet implemented in Skulpt")\n',"src/lib/distutils/tests/__init__.py":'raise NotImplementedError("tests is not yet implemented in Skulpt")\n',"src/lib/pythonds/trees/binheap.py":"# Bradley N. Miller, David L. Ranum\n# Introduction to Data Structures and Algorithms in Python\n# Copyright 2005\n# \n\n# this heap takes key value pairs, we will assume that the keys are integers\nclass BinHeap:\n    def __init__(self):\n        self.heapList = [0]\n        self.currentSize = 0\n\n\n    def buildHeap(self,alist):\n        i = len(alist) // 2\n        self.currentSize = len(alist)\n        self.heapList = [0] + alist[:]\n        print(len(self.heapList), i)\n        while (i > 0):\n            print(self.heapList, i)\n            self.percDown(i)\n            i = i - 1\n        print(self.heapList,i)\n                        \n    def percDown(self,i):\n        while (i * 2) <= self.currentSize:\n            mc = self.minChild(i)\n            if self.heapList[i] > self.heapList[mc]:\n                tmp = self.heapList[i]\n                self.heapList[i] = self.heapList[mc]\n                self.heapList[mc] = tmp\n            i = mc\n                \n    def minChild(self,i):\n        if i * 2 + 1 > self.currentSize:\n            return i * 2\n        else:\n            if self.heapList[i * 2] < self.heapList[i * 2 + 1]:\n                return i * 2\n            else:\n                return i * 2 + 1\n\n    def percUp(self,i):\n        while i // 2 > 0:\n            if self.heapList[i] < self.heapList[i//2]:\n               tmp = self.heapList[i // 2]\n               self.heapList[i // 2] = self.heapList[i]\n               self.heapList[i] = tmp\n            i = i // 2\n \n    def insert(self,k):\n        self.heapList.append(k)\n        self.currentSize = self.currentSize + 1\n        self.percUp(self.currentSize)\n\n    def delMin(self):\n        retval = self.heapList[1]\n        self.heapList[1] = self.heapList[self.currentSize]\n        self.currentSize = self.currentSize - 1\n        self.heapList.pop()\n        self.percDown(1)\n        return retval\n        \n    def isEmpty(self):\n        if currentSize == 0:\n            return True\n        else:\n            return False\n","src/lib/PBBinaryTrees/__init__.py":'# PBBinaryTrees.py -------------------------------------------------------------\n#\n# Made by Evan Olds for zyBooks/Wiley\n# Uploaded to GitHub May 2, 2025\n#\n# Note: This code must run in Skulpt, an in-browser Python implementation. The\n# following are NOT supported by Skulpt, and so are not used in this code:\n# - f-strings\n# - math.isfinite\n#\n# Classes declared in this module:\n#   PBBinaryTreeNode\n#   PBBinaryTree\n\nfrom PBCore import PBBox\nfrom PBCore import PBColors\nfrom PBCore import PBRenderable\nfrom PBCore import PBBaseNode\n\nclass PBBinaryTreeNode(PBBaseNode):\n    def __init__(self, key):\n        PBBaseNode.__init__(self)\n        self.key = key\n        self.left = None\n        self.right = None\n    \n    def duplicate_subtree(self):\n        new_node = PBBinaryTreeNode(self.key)\n        new_node.render_info = dict(self.render_info)\n        if self.left != None:\n            new_left = self.left.duplicate_subtree()\n            new_node.set_left(new_left)\n        if self.right != None:\n            new_right = self.right.duplicate_subtree()\n            new_node.set_right(new_right)\n        return new_node\n    \n    def get_key(self):\n        return self.key\n    \n    # Returns this node\'s left child\n    def get_left(self):\n        return self.left\n    \n    # Returns the maximum render-height among the children. If both children\n    # are None then 0 is returned.\n    def get_max_child_render_height(self):\n        max_height = 0\n        if self.left != None:\n            max_height = max(max_height, self.left.get_bounding_size()[1])\n        if self.right != None:\n            max_height = max(max_height, self.right.get_bounding_size()[1])\n        return max_height\n    \n    # Returns this node\'s right child\n    def get_right(self):\n        return self.right\n    \n    # Returns a string for this node\'s inner text content\n    def get_text(self):\n        return str(self.key)\n    \n    def is_leaf(self):\n        return self.left == None and self.right == None\n    \n    def set_key(self, new_key):\n        self.key = new_key\n        return self\n    \n    def set_left(self, new_left):\n        self.left = new_left\n        return self\n    \n    def set_right(self, new_right):\n        self.right = new_right\n        return self\n\n# Base class for a binary tree. Implements positioning and rendering logic for\n# binary trees.\nclass PBBinaryTree(PBRenderable):\n    def __init__(self, tree_to_copy = None):\n        PBRenderable.__init__(self)\n        self.root = None\n        self.render_info = { }\n        # "heightBetweenLevels" is the space between the bottom bound of a node\n        # and the top bound of that node\'s children\n        self.render_info["heightBetweenLevels"] = 20\n        self.render_info["nodeHeightTextColorLight"] = "rgb(128,0,128)"\n        self.render_info["nodeHeightTextColorDark"] = "rgb(200,0,200)"\n        self.render_info["nodesToHighlight"] = set()\n        self.render_info["showNodeHeights"] = False\n        \n        # _needs_respositioning indicates whether or not nodes need to be\n        # positioned. Most tree-altering methods assign _needs_repositioning\n        # with True so that the next call to get_renderables() updates node\n        # positions before building renderables.\n        self._needs_positioning = True\n        \n        # Copy tree_to_copy\'s data, if tree_to_copy is a PBBinaryTree\n        if isinstance(tree_to_copy, PBBinaryTree):\n            other_root = tree_to_copy.root\n            if other_root != None:\n                self.root = other_root.duplicate_subtree()\n            self.render_info = dict(tree_to_copy.render_info)\n            # Node sets must be rebuilt\n            self.render_info["nodesToHighlight"] = set()\n            for other_node in tree_to_copy.render_info["nodesToHighlight"]:\n                our_node = self.get_node_with_key(other_node.get_key())\n                self.render_info["nodesToHighlight"].add(our_node)\n    \n    # Method for allocating a new node for this tree. PBBinaryTree\'s default\n    # implementation allocates a PBBinaryTreeNode. But inheriting classes can\n    # override to allocate the desired node type.\n    def alloc_node(self, key):\n        return PBBinaryTreeNode(key)\n    \n    def get_alt_text(self):\n        return self._get_alt_text("Binary tree")\n    \n    # Returns a list of all internal nodes in this tree. An empty list is\n    # returned if no internal nodes exist in this tree.\n    def get_internal_nodes(self):\n        return self.get_nodes_filtered(lambda node: not node.is_leaf())\n    \n    def get_leaf_nodes(self):\n        return self.get_nodes_filtered(lambda node: node.is_leaf())\n    \n    def get_node_with_key(self, key):\n        nodes = [self.root]\n        while len(nodes) > 0:\n            node = nodes.pop()\n            if node != None:\n                if node.get_key() == key:\n                    return node\n            # Push children\n            nodes.append(node.get_left())\n            nodes.append(node.get_right())\n        return None\n    \n    def get_nodes_filtered(self, predicate):\n        return list(filter(predicate, self.get_nodes_list()))\n    \n    def get_nodes_list(self):\n        return self._get_nodes_list(self.root, [])\n    \n    # Returns the number of nodes in this binary tree. O(N) time complexity.\n    # Inheriting classes may override this method to provide a more efficient\n    # implementation.\n    def get_length(self):\n        return len(self.get_nodes_list())\n    \n    # Returns this tree\'s root node, or null if this tree is empty\n    def get_root(self):\n        return self.root\n    \n    def get_subtree_bounding_box(self, subtree_root):\n        if subtree_root == None:\n            return PBBox()\n        \n        box = None\n        remaining_nodes = [subtree_root]\n        while len(remaining_nodes) > 0:\n            node = remaining_nodes.pop()\n            if node == None:\n                continue\n            \n            # Build a box to bound the existing bounds plus the node\'s box\n            box = PBBox.bound(box, node.get_bounding_box())\n            \n            # Append children\n            remaining_nodes.append(node.get_left())\n            remaining_nodes.append(node.get_right())\n        return box\n    \n    # Performs an inorder traversal of this tree, invoking the callback for\n    # each node. The callback has three parameters:\n    # - node:\n    #   The node to visit\n    # - ancestors:\n    #   List of the node\'s ancestors. The first entry in this list is the root\n    #   (unless node itself is the root, in which case this list is empty). The\n    #   last entry is the node\'s parent.\n    # - level_index:\n    #   0-based level index for node. 0 for the root, 1 for the root\'s\n    #   children, 2 for the root\'s grandchildren, and so on.\n    def inorder(self, callback):\n        self._inorder(callback, self.root, [], 0)\n    \n    # Performs a postorder traversal of this tree, invoking the callback for\n    # each node. The callback has three parameters:\n    # - node:\n    #   The node to visit\n    # - ancestors:\n    #   List of the node\'s ancestors. The first entry in this list is the\n    #   root (unless node itself is the root, in which case this list is\n    #   empty). The last entry is the node\'s parent.\n    # - level_index:\n    #   0-based level index for node. 0 for the root, 1 for the root\'s\n    #   children, 2 for the root\'s grandchildren, and so on.\n    def postorder(self, callback):\n        self._postorder(callback, self.root, [], 0)\n    \n    def set_root(self, new_root):\n        self.root = new_root\n        self._needs_positioning = True\n    \n    @staticmethod\n    def shift_subtree(node, shift_x, shift_y):\n        nodes = [node]\n        while len(nodes) > 0:\n            node = nodes.pop()\n            if node != None:\n                cx = node.render_info["centerX"]\n                cy = node.render_info["centerY"]\n                node.render_info["centerX"] = cx + shift_x\n                node.render_info["centerY"] = cy + shift_y\n                nodes.append(node.get_left())\n                nodes.append(node.get_right())\n    \n    # Returns a Python dictionary with four keys:\n    #\n    # "renderables":\n    #   The corresponding value is a list of objects, each also a Python\n    #   dictionary, to render. Each object has a "renderType" key and a\n    #   corresponding value indicating the type of object to render (exs:\n    #   "line" or "rectangle").\n    #\n    # "alt":\n    #   Corresponding value is a string for the rendered content\'s alt text.\n    #\n    # "renderables_dark":\n    #   List of renderables for dark mode.\n    #\n    # "alt_dark":\n    #   Alt text for dark mode.\n    def get_renderables(self):\n        # Position all nodes first, if needed\n        if self._needs_positioning:\n            self._position_all_nodes()\n        \n        # Get the alt text\n        alt = self.get_alt_text()\n        \n        # Special case if no tree\n        if self.root == None:\n            return { "renderables": [], "renderables_dark": [], "alt": alt,\n                "alt_dark": alt }\n        \n        LIGHT_MODE_COLORS = PBColors.get_light_mode_colors()\n        DARK_MODE_COLORS = PBColors.get_dark_mode_colors()\n        \n        # Initialize lists of renderable objects for light and dark modes\n        renderables = []\n        darks = []\n        RENDERABLES_LISTS = [renderables, darks]\n        \n        # Initialize a stack of nodes\n        node_stack = [self.root]\n        \n        # Pass 1: Lines between parent and child nodes\n        while len(node_stack) > 0:\n            node = node_stack.pop()\n            ncx = node.render_info["centerX"]\n            ncy = node.render_info["centerY"]\n            \n            # A branch line is needed for any children not assigned with None\n            for child in [node.get_left(), node.get_right()]:\n                if child != None:\n                    renderables.append({\n                        "renderType": "line",\n                        "x1": ncx,\n                        "y1": ncy,\n                        "x2": child.render_info.get("centerX"),\n                        "y2": child.render_info.get("centerY"),\n                        "borderColor": LIGHT_MODE_COLORS["line"]\n                    })\n                    darks.append({\n                        "renderType": "line",\n                        "x1": ncx,\n                        "y1": ncy,\n                        "x2": child.render_info.get("centerX"),\n                        "y2": child.render_info.get("centerY"),\n                        "borderColor": DARK_MODE_COLORS["line"]\n                    })\n                    # Push the child onto the stack\n                    node_stack.append(child)\n        \n        # Pass 2: All nodes\n        node_stack = [ [self.root, None] ]\n        while len(node_stack) > 0:\n            node_parent = node_stack.pop()\n            node = node_parent[0]\n            parent = node_parent[1]\n            \n            # Compute center point and radius\n            cx = node.render_info["centerX"]\n            cy = node.render_info["centerY"]\n            r = node.render_info["height"] / 2.0\n            \n            node_shape = "circle"\n            if "shape" in node.render_info:\n                node_shape = node.render_info["shape"]\n\n            if node_shape == "circle":\n                # Add a circle for the node\n                renderables.append({\n                    "renderType": "circle",\n                    "centerX": cx,\n                    "centerY": cy,\n                    "radius": r,\n                    "backgroundColor": node.render_info["bgColorLight"],\n                    "borderColor": node.render_info["borderColorLight"]\n                })\n                darks.append({\n                    "renderType": "circle",\n                    "centerX": cx,\n                    "centerY": cy,\n                    "radius": r,\n                    "backgroundColor": node.render_info["bgColorDark"],\n                    "borderColor": node.render_info["borderColorDark"]\n                })\n            else:\n                renderables.append({\n                    "renderType": node.render_info["shape"],\n                    "centerX": cx,\n                    "centerY": cy,\n                    "width": node.render_info["width"],\n                    "height": node.render_info["height"],\n                    "backgroundColor": node.render_info["bgColorLight"],\n                    "borderColor": node.render_info["borderColorLight"]\n                })\n                darks.append({\n                    "renderType": node.render_info["shape"],\n                    "centerX": cx,\n                    "centerY": cy,\n                    "width": node.render_info["width"],\n                    "height": node.render_info["height"],\n                    "backgroundColor": node.render_info["bgColorDark"],\n                    "borderColor": node.render_info["borderColorDark"]\n                })\n\n            # Regardless of shape, the node\'s text is rendered in the center\n            text_colors = [\n                node.render_info["textColorLight"],\n                node.render_info["textColorDark"]\n            ]\n            for i in range(len(RENDERABLES_LISTS)):\n                RENDERABLES_LISTS[i].append({\n                    "renderType": "text",\n                    "centerX": cx,\n                    "centerY": cy,\n                    "color": text_colors[i],\n                    "font": "18px sans-serif",\n                    "text": node.get_text()\n                })\n            \n            # Show node heights, if requested\n            if self.render_info["showNodeHeights"]:\n                height_center_x = cx + r\n                if parent != None and parent.get_left() is node:\n                    height_center_x = cx - r\n                text_colors = [\n                    node.render_info["nodeHeightTextColor"],\n                    node.render_info["nodeHeightTextColorDark"]\n                ]\n                for i in range(len(RENDERABLES_LISTS)):\n                    RENDERABLES_LISTS[i].append({\n                        "renderType": "text",\n                        "centerX": height_center_x,\n                        "centerY": cy - r,\n                        "color": self.render_info["nodeHeightTextColor"],\n                        "font": "14px sans-serif",\n                        "text": String(node.getHeight())\n                    })\n            \n            # Push children\n            if node.get_left() != None:\n                node_stack.append([node.get_left(), node])\n            if node.get_right() != None:\n                node_stack.append([node.get_right(), node])\n        \n        return { "renderables": renderables, "renderables_dark": darks,\n            "alt": alt, "alt_dark": alt }\n    \n    def set_root(self, new_root):\n        self.root = new_root\n        self._needs_positioning = True\n    \n    def _get_alt_text(self, tree_name_prefix):\n        # Special case if root is None\n        if self.root == None:\n            return ""\n        node_count = self.get_length()\n        text = tree_name_prefix + " with " + str(node_count) + " node"\n        if node_count != 1:\n            text += "s"\n        text += ": Root\'s key is " + str(self.root.get_key()) + "."\n        \n        # Process remaining nodes\n        parents = [self.root]\n        while len(parents) > 0:\n            parent = parents.pop()\n            left = parent.get_left()\n            right = parent.get_right()\n            if left != None and right != None:\n                text += (" Node " + str(parent.get_key()) + "\'s left child " +\n                    "has key " + str(left.get_key()) + " and right child " +\n                    "has key " + str(right.get_key()) + ".")\n                parents.append(left)\n                parents.append(right)\n            elif left != None:\n                text += (" Node " + str(parent.get_key()) + "\'s left child " +\n                    "has key " + str(left.get_key()) + ".")\n                parents.append(left)\n            elif right != None:\n                text += (" Node " + str(parent.get_key()) + "\'s right " +\n                    "child has key " + str(right.get_key()) + ".")\n                parents.append(right)\n        \n        # Add information about highlighted nodes\n        if 1 == len(self.render_info["nodesToHighlight"]):\n            highlighted_key = None\n            for node in self.render_info["nodesToHighlight"]:\n                highlighted_key = node.get_key()\n            text += " Node " + str(highlighted_key) + " is highlighted."\n        elif len(self.render_info["nodesToHighlight"]) > 1:\n            text += " The following nodes are highlighted: "\n            added_first = False\n            for node in self.render_info["nodesToHighlight"]:\n                key = node.get_key()\n                if added_first:\n                    text += (", " + str(key))\n                else:\n                    text += str(key)\n                    added_first = True\n            text += "."\n        return text\n    \n    def _get_nodes_list(self, node, output_list):\n        if node != None:\n            # Left subtree first\n            self._get_nodes_list(node.get_left(), output_list)\n            # Then the node itself\n            output_list.append(node)\n            # Then the right subtree\n            self._get_nodes_list(node.get_right(), output_list)\n        return output_list\n    \n    def _inorder(self, callback, node, ancestors, level_index):\n        if node == None:\n            return\n        \n        # Recursively visit left subtree\n        self._inorder(callback, node.get_left(), ancestors + [node],\n            level_index + 1)\n        \n        # Visit the node itself\n        callback(node, ancestors, level_index)\n        \n        # Recursively visit right subtree\n        self._inorder(callback, node.get_right(), ancestors + [node],\n            level_index + 1)\n    \n    def _position_all_nodes(self):\n        # Reset _needs_positioning to False\n        self._needs_positioning = False\n        \n        # Nothing to do if no nodes\n        if self.root == None:\n            return\n        \n        # min_space represents the minimum spacing between any two nodes\'\n        # bounding boxes\n        min_space = 8\n        \n        hbl = self.render_info["heightBetweenLevels"]\n        \n        # Position root at (0, 0)\n        self.root.set_render_center(0, 0)\n        \n        # Pass 1: Position each node\'s children below the node itself, with no\n        # regard for possible overlaps with other subtrees\n        nodes = [self.root]\n        while len(nodes) > 0:\n            node = nodes.pop()\n            nodeBB = node.get_bounding_box()\n            nodeCX = node.render_info["centerX"]\n            \n            # Get maximum render height of children\n            max_child_render_height = node.get_max_child_render_height()\n            \n            # Each child has the same center-y value\n            cy = nodeBB.get_max_y() + hbl + max_child_render_height / 2\n            \n            # Position children\n            left = node.get_left()\n            if left != None:\n                left_size = left.get_bounding_size()\n                left.set_render_center(\n                    nodeCX - min_space / 2 - left_size[0] / 2, cy)\n                nodes.append(left)\n            right = node.get_right()\n            if right != None:\n                right_size = right.get_bounding_size()\n                right.set_render_center(\n                    nodeCX + min_space / 2 + right_size[0] / 2, cy)\n                nodes.append(right)\n        # Pass 2: Find overlaps from the bottom up and resolve each\n        self.postorder(self._resolve_overlap)\n    \n    def _postorder(self, callback, node, ancestors, level_index):\n        if node == None:\n            return\n        \n        # Recursively visit left subtree, then right\n        self._postorder(callback, node.get_left(), ancestors + [node],\n            level_index + 1)\n        self._postorder(callback, node.get_right(), ancestors + [node],\n            level_index + 1)\n        \n        # Visit the node itself\n        callback(node, ancestors, level_index)\n    \n    def _resolve_overlap(self, node, ancestors, level_index):\n        # No possible child overlap if 0 or 1 child\n        if node.get_left() == None or node.get_right() == None:\n            return\n        \n        # min_space represents the minimum spacing between any two nodes\'\n        # bounding boxes\n        min_space = 8\n        \n        # Get bounds for each child subtree\n        leftBB = self.get_subtree_bounding_box(node.get_left())\n        rightBB = self.get_subtree_bounding_box(node.get_right())\n        \n        # Compute amount of space between right edge of left subtree\'s box\n        # and left edge of right subtree\'s box\n        x_difference = rightBB.get_min_x() - leftBB.get_max_x()\n        \n        # If not at least the minimum space then shift\n        if x_difference < min_space:\n            # Space out each subtree with half the needed space\n            amount = (min_space - x_difference) / 2\n            PBBinaryTree.shift_subtree(node.get_left(), -amount, 0)\n            PBBinaryTree.shift_subtree(node.get_right(), amount, 0)\n',"src/lib/copy_reg.py":'raise NotImplementedError("copy_reg is not yet implemented in Skulpt")\n',"src/lib/distutils/__init__.py":'raise NotImplementedError("distutils is not yet implemented in Skulpt")\n',"src/lib/_strptime.py":'raise NotImplementedError("_strptime is not yet implemented in Skulpt")\n',"src/lib/Queue.py":'raise NotImplementedError("Queue is not yet implemented in Skulpt")\n',"src/lib/time.js":'/*\n implementation of the Python time package.\n\n notes:\n - struct_time is a structseq but structseq does not implement methods: \'n_fields\', \'n_sequence_fields\', \'n_unnamed_fields\' yet\n\n [\'__doc__\', \'__file__\', \'__name__\', \'__package__\', \'accept2dyear\', \'altzone\', \'asctime\', \'clock\', \'ctime\', \'daylight\', \'gmtime\', \'localtime\', \'mktime\', \'sleep\', \'strftime\', \'strptime\', \'struct_time\', \'time\', \'timezone\', \'tzname\', \'tzset\']\n */\n\nvar $builtinmodule = function (name) {\n    var mod = {};\n\n    mod.__file__ = "/src/lib/time/__init__.js";\n\n    mod.__package__ = Sk.builtin.none.none$;\n\n    var struct_time_fields = {\n        "tm_year": "year, for example, 1993",\n        "tm_mon": "month of year, range [1, 12]",\n        "tm_mday": "day of month, range [1, 31]",\n        "tm_hour": "hours, range [0, 23]",\n        "tm_min": "minutes, range [0, 59]",\n        "tm_sec": "seconds, range [0, 61]",\n        "tm_wday": "day of week, range [0, 6], Monday is 0",\n        "tm_yday": "day of year, range [1, 366]",\n        "tm_isdst": "1 if summer time is in effect, 0 if not, and -1 if unknown"\n    };\n\n    var struct_time_f = Sk.builtin.make_structseq(\'time\', \'struct_time\', struct_time_fields);\n\n    mod.struct_time = struct_time_f;\n\n    function check_struct_time(t) {\n        if (!(t instanceof struct_time_f)) {\n            throw new Sk.builtin.TypeError("Required argument \'struct_time\' must be of type: \'struct_time\'");\n        }\n        var i;\n        var len = t.v.length;\n        var obj = t.v;\n        for (i = 0; i < len; ++i) {\n            if (!Sk.builtin.checkInt(obj[i])) {\n                throw new Sk.builtin.TypeError("struct_time may only contain integers");\n            }\n        }\n        return true;\n    }\n\n    mod.time = new Sk.builtin.func(function () {\n        Sk.builtin.pyCheckArgs("time", arguments, 0, 0);\n        var res = Date.now();\n        if (this.performance && this.performance.now)\n        {\n            res = res + performance.now() % 1;\n        }\n        return Sk.builtin.assk$(res / 1000, undefined);\n    });\n\n    // This is an experimental implementation of time.sleep(), using suspensions\n    mod.sleep = new Sk.builtin.func(function(delay) {\n        Sk.builtin.pyCheckArgs("sleep", arguments, 1, 1);\n        Sk.builtin.pyCheckType("delay", "float", Sk.builtin.checkNumber(delay));\n\n        return new Sk.misceval.promiseToSuspension(new Promise(function(resolve) {\n            Sk.setTimeout(function() {\n                resolve(Sk.builtin.none.none$);\n            }, Sk.ffi.remapToJs(delay)*1000);\n        }));\n    });\n\n    function padLeft(str, l, c) {\n        var _str = str.toString();\n        return Array(l - _str.length + 1).join(c || " ") + _str;\n    }\n\n    function isLeapYear(year) {\n        if((year & 3) != 0) return false;\n        return ((year % 100) != 0 || (year % 400) == 0);\n    }\n\n    function getDayOfYear(date,utc) {\n        utc = utc || false;\n        var dayCount = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];\n        var mn = utc ? date.getUTCMonth() : date.getMonth();\n        var dn = utc ? date.getUTCDate() : date.getDate();\n        var dayOfYear = dayCount[mn] + dn;\n        if(mn > 1 && isLeapYear(utc ? date.getUTCFullYear() : date.getFullYear())) dayOfYear++;\n        return dayOfYear;\n    }\n\n    function stdTimezoneOffset() {\n        var jan = new Date(2002, 0, 1);\n        var jul = new Date(2002, 6, 1);\n        return Math.max(jan.getTimezoneOffset(), jul.getTimezoneOffset());\n    }\n\n    function altTimezoneOffset() {\n        var jan = new Date(2002, 0, 1);\n        var jul = new Date(2002, 6, 1);\n        return Math.min(jan.getTimezoneOffset(), jul.getTimezoneOffset());\n    }\n\n    function dst(date) {\n        return date.getTimezoneOffset() < stdTimezoneOffset();\n    }\n\n    function timeZoneName(date) {\n        var i = /\\((.*)\\)/.exec(date.toString());\n        return i ? i[1] : "UTC";\n    }\n\n    function timeZoneNames() {\n        var jan = new Date(2002, 0, 1);\n        var jul = new Date(2002, 6, 1);\n        if (dst(jan)) {\n            return [Sk.builtin.str(timeZoneName(jul)), Sk.builtin.str(timeZoneName(jan))];\n        } else {\n            return [Sk.builtin.str(timeZoneName(jan)), Sk.builtin.str(timeZoneName(jul))];\n        }\n    }\n\n    function date_to_struct_time(date, utc) {\n        utc = utc || false;\n        // y, m, d, hh, mm, ss, weekday, jday, dst\n        return new struct_time_f(\n            [\n                Sk.builtin.assk$(utc ? date.getUTCFullYear() : date.getFullYear()),\n                Sk.builtin.assk$((utc ? date.getUTCMonth() : date.getMonth()) + 1), // want January == 1\n                Sk.builtin.assk$(utc ? date.getUTCDate() : date.getDate()),\n                Sk.builtin.assk$(utc ? date.getUTCHours() : date.getHours()),\n                Sk.builtin.assk$(utc ? date.getUTCMinutes() : date.getMinutes()),\n                Sk.builtin.assk$(utc ? date.getUTCSeconds() : date.getSeconds()),\n                Sk.builtin.assk$(((utc ? date.getUTCDay() : date.getDay()) + 6) % 7), // Want Monday == 0\n                Sk.builtin.assk$(getDayOfYear(date, utc)), // Want January, 1 == 1\n                Sk.builtin.assk$(utc ? 0 : (dst(date) ? 1 : 0)) // 1 for DST /0 for non-DST /-1 for unknown\n            ]\n        );\n    }\n\n    function localtime_f(secs) {\n        Sk.builtin.pyCheckArgs("localtime", arguments, 0, 1);\n        var d = new Date();\n        if (secs) {\n            Sk.builtin.pyCheckType("secs", "number", Sk.builtin.checkNumber(secs));\n            var seconds = Sk.builtin.asnum$(secs);\n            d.setTime(seconds * 1000);\n        }\n        return date_to_struct_time(d);\n    }\n\n    mod.localtime = new Sk.builtin.func(localtime_f);\n\n    mod.gmtime = new Sk.builtin.func(function(secs) {\n        Sk.builtin.pyCheckArgs("localtime", arguments, 0, 1);\n        var d = new Date();\n        if (secs) {\n            Sk.builtin.pyCheckType("secs", "number", Sk.builtin.checkNumber(secs));\n            var seconds = Sk.builtin.asnum$(secs);\n            d.setTime(seconds * 1000);\n        }\n        return date_to_struct_time(d, true);\n    });\n\n    var monthnames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];\n    var daynames = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];\n\n    function asctime_f(time) {\n        if (!time || Sk.builtin.checkNone(time))\n        {\n            time = localtime_f();\n        } else if (!(time instanceof struct_time_f)) {\n            time = new struct_time_f(time);\n        }\n        if (time instanceof Sk.builtin.tuple && time.v.length == 9)\n        {\n            // todo: test validity??\n            var parts = [];\n            parts.push(daynames[Sk.builtin.asnum$(time.v[6])]);\n            parts.push(monthnames[Sk.builtin.asnum$(time.v[1])-1]);\n            parts.push(padLeft(Sk.builtin.asnum$(time.v[2]).toString(), 2, \'0\'));\n            parts.push(\n                padLeft(Sk.builtin.asnum$(time.v[3]).toString(), 2, \'0\') + ":" +\n                padLeft(Sk.builtin.asnum$(time.v[4]).toString(), 2, \'0\') + ":" +\n                padLeft(Sk.builtin.asnum$(time.v[5]).toString(), 2, \'0\')\n            );\n            parts.push(padLeft(Sk.builtin.asnum$(time.v[0]).toString(), 4, \'0\'));\n\n            return Sk.builtin.str(parts.join(" "));\n        }\n    }\n\n    mod.asctime = new Sk.builtin.func(asctime_f);\n\n    mod.ctime = new Sk.builtin.func(function(secs) {\n        return asctime_f(localtime_f(secs));\n    });\n\n    function mktime_f(time) {\n        if (time instanceof Sk.builtin.tuple && time.v.length == 9)\n        {\n            var d = new Date(Sk.builtin.asnum$(time.v[0]),\n                             Sk.builtin.asnum$(time.v[1])-1,\n                             Sk.builtin.asnum$(time.v[2]),\n                             Sk.builtin.asnum$(time.v[3]),\n                             Sk.builtin.asnum$(time.v[4]),\n                             Sk.builtin.asnum$(time.v[5]));\n            return Sk.builtin.assk$(d.getTime() / 1000, undefined);\n        } else {\n            throw new Sk.builtin.TypeError("mktime() requires a struct_time or 9-tuple");\n        }\n    }\n\n    mod.mktime = new Sk.builtin.func(mktime_f);\n\n    /*\n    The offset of the local (non-DST) timezone, in seconds west of UTC (negative in most of Western Europe,\n    positive in the US, zero in the UK).\n    */\n    mod.timezone = new Sk.builtin.int_(stdTimezoneOffset() * 60);\n\n    /*\n    The offset of the local DST timezone, in seconds west of UTC, if one is defined. This is negative if the\n    local DST timezone is east of UTC (as in Western Europe, including the UK). Only use this if daylight is nonzero.\n    */\n    mod.altzone = new Sk.builtin.int_(altTimezoneOffset() * 60);\n\n    /*\n    Nonzero if a DST timezone is defined.\n    */\n    mod.daylight = new Sk.builtin.int_(dst(new Date()) ? 1 : 0);\n\n    /*\n    A tuple of two strings: the first is the name of the local non-DST timezone, the second is the name of the local\n    DST timezone. If no DST timezone is defined, the second string should not be used.\n    */\n    mod.tzname = Sk.builtin.tuple(timeZoneNames());\n\n    mod.accept2dyear = Sk.builtin.assk$(1, Sk.builtin.nmber.int$);\n\n    mod.clock = new Sk.builtin.func(function() {\n        var res = 0.0;\n        if (this.performance && this.performance.now)\n        {\n            res = performance.now() / 1000;\n        } else {\n            res = new Date().getTime() / 1000;\n        }\n        return new Sk.builtin.float_(res);\n    });\n\n    function strftime_f(format, t) {\n        var jsFormat;\n\n        Sk.builtin.pyCheckArgs("strftime", arguments, 1, 2);\n        if (!Sk.builtin.checkString(format)) {\n            throw new Sk.builtin.TypeError("format must be a string");\n        }\n        if (!t)\n        {\n            t = localtime_f();\n        } else if (!(t instanceof struct_time_f)) {\n            t = new struct_time_f(t);\n        }\n\n        check_struct_time(t);\n\n        jsFormat = Sk.ffi.remapToJs(format);\n\n        return Sk.ffi.remapToPy(strftime(jsFormat, new Date(mktime_f(t).v*1000)));\n    }\n\n    mod.strftime = new Sk.builtin.func(strftime_f);\n\n    function tzset_f()\n    {\n        throw new Sk.builtin.NotImplementedError("time.tzset() is not yet implemented");\n        Sk.builtin.pyCheckArgs("tzset", arguments, 0, 0);\n    }\n\n    mod.tzset = new Sk.builtin.func(tzset_f);\n\n    function strptime_f(s, format)\n    {\n        Sk.builtin.pyCheckArgs("strptime", arguments, 1, 2);\n        Sk.builtin.pyCheckType("string", "string", Sk.builtin.checkString(s));\n        if (format !== undefined) {\n            Sk.builtin.pyCheckType("format", "string", Sk.builtin.checkString(format));\n        } else {\n            format = new Sk.builtin.str("%a %b %d %H:%M:%S %Y");\n        }\n\n        return date_to_struct_time(strptime(Sk.ffi.remapToJs(s), Sk.ffi.remapToJs(format), true));\n    }\n\n    mod.strptime = new Sk.builtin.func(strptime_f);\n\n    return mod;\n};\n',"src/lib/pythonds/basic/stack.py":"# Bradley N. Miller, David L. Ranum\n# Introduction to Data Structures and Algorithms in Python\n# Copyright 2005\n# \n#stack.py\n\nclass Stack:\n    def __init__(self):\n        self.items = []\n\n    def isEmpty(self):\n        return self.items == []\n\n    def push(self, item):\n        self.items.append(item)\n\n    def pop(self):\n        return self.items.pop()\n\n    def peek(self):\n        return self.items[len(self.items)-1]\n\n    def size(self):\n        return len(self.items)\n\n","src/lib/sndhdr.py":'raise NotImplementedError("sndhdr is not yet implemented in Skulpt")\n',"src/lib/codeop.py":'raise NotImplementedError("codeop is not yet implemented in Skulpt")\n',"src/lib/getpass.py":'raise NotImplementedError("getpass is not yet implemented in Skulpt")\n',"src/lib/anydbm.py":'raise NotImplementedError("anydbm is not yet implemented in Skulpt")\n',"src/lib/urlparse.py":'raise NotImplementedError("urlparse is not yet implemented in Skulpt")\n',"src/lib/htmllib.py":'raise NotImplementedError("htmllib is not yet implemented in Skulpt")\n',"src/lib/fnmatch.py":'raise NotImplementedError("fnmatch is not yet implemented in Skulpt")\n',"src/lib/HTMLParser.py":'raise NotImplementedError("HTMLParser is not yet implemented in Skulpt")\n',"src/lib/calendar.py":'raise NotImplementedError("calendar is not yet implemented in Skulpt")\n',"src/lib/struct.py":'raise NotImplementedError("struct is not yet implemented in Skulpt")\n',"src/lib/pydoc.py":'raise NotImplementedError("pydoc is not yet implemented in Skulpt")\n',"src/lib/PBHashTables/__init__.py":'# PBHashTables.py --------------------------------------------------------------\n#\n# Made by Evan Olds for zyBooks/Wiley\n# Uploaded to GitHub May 2, 2025\n#\n# Classes declared in this module:\n#   PBHashTable\n#   PBChainingHashTableItem\n#   PBChainingHashTable\n#   PBOpenAddressingBucket\n#   PBOpenAddressingHashTable\n#   PBDoubleHashingHashTable\n#   PBLinearProbingHashTable\n#   PBQuadraticProbingHashTable\n\nfrom PBCore import PBBox\nfrom PBCore import PBColors\nfrom PBCore import PBRandom\nfrom PBCore import PBRenderable\nfrom PBCore import PBVector\nfrom PBArray import PBArray\n\nclass PBHashTable(PBRenderable):\n    BUCKET_COLOR_OCCUPIED_DARK = "rgb(110,81,58)"\n    BUCKET_COLOR_OCCUPIED_LIGHT = "rgb(249,216,188)"\n    BUCKET_COLOR_EAR = "rgb(192,192,192)"\n    \n    def __init__(self):\n        PBRenderable.__init__(self)\n        self._hash_function = lambda key: abs(hash(key))\n        self.data = []\n        self.render_info = {\n            "cellWidth": "auto",\n            "showLegend": True\n        }\n    \n    # Removes all items from this hash table. Returns self to allow chaining.\n    def clear(self):\n        # Derived classes must implement\n        pass\n    \n    # Returns True if the specific key exists in the table, False otherwise.\n    def contains(self, key):\n        # Derived classes must implement\n        pass\n    \n    # Returns a deep copy of this table\n    def duplicate(self):\n        # Derived classes must implement\n        return None\n    \n    # Searches for the item with the specified key. Returns the item\'s value if\n    # found, None if not found.\n    def get(self, key):\n        # Derived classes must implement\n        pass\n    \n    # Returns a list of all keys in this hash table\n    def get_keys_list(self):\n        # Derived classes must implement\n        pass\n    \n    # Returns a value indicating the rendered width of a table cell. The\n    # returned value will either be a number indicating the width of a cell, in\n    # pixels, or the string "auto". The string "auto" is a special case that\n    # auto-sizes the cell width based on content. Note that some hash table\n    # types may use a fixed cell width even in the case of "auto", since no\n    # content is actually rendered inside table cells (ex: chaining hash\n    # tables).\n    def get_cell_width(self):\n        return self.render_info["cellWidth"]\n    \n    # Gets a bool that indicates whether or not the hash table\'s legend is\n    # shown in the rendered content. If shown, the legend describes bucket\n    # colors for empty-since-start, empty-after-removal, and occupied buckets.\n    def get_show_legend(self):\n        return self.render_info["showLegend"]\n    \n    # Returns the number of items in the hash table\n    def get_length(self):\n        pass\n    \n    # Returns a non-negative hash code for the specified key\n    def hash(self, key):\n        return self._hash_function(key)\n    \n    def set_cell_width(self, new_width):\n        if isinstance(new_width, int) or isinstance(new_width, float):\n            self.render_info["cellWidth"] = new_width\n        elif new_width == "auto":\n            self.render_info["cellWidth"] = "auto"\n        return self\n    \n    # Sets a bool that indicates whether or not the hash table\'s legend is\n    # shown in the rendered content. If shown, the legend describes bucket\n    # colors for empty-since-start, empty-after-removal, and occupied buckets.\n    # Returns self to allow for chaining.\n    def set_show_legend(self, show_legend):\n        self.render_info["showLegend"] = show_legend\n        return self\n\nclass PBChainingHashTableItem:\n    def __init__(self, item_key, item_value):\n        self.key = item_key\n        self.value = item_value\n        self.next = None\n    \n    def __str__(self):\n        return str(self.key) + ", " + str(self.value)\n\nclass PBChainingHashTable(PBHashTable):\n    def __init__(self, initial_capacity = 11):\n        PBHashTable.__init__(self)\n        # Special case for copy construction\n        if isinstance(initial_capacity, PBChainingHashTable):\n            other = initial_capacity\n            self.table = [None] * len(other.table)\n            for i in range(len(other.table)):\n                self.table[i] = PBChainingHashTable._duplicate_list(\n                    other.table[i])\n        else:\n            self.table = [None] * initial_capacity\n    \n    # Removes all items from this hash table. Returns self to allow chaining.\n    def clear(self):\n        cur_table_len = len(self.table)\n        self.table = [None] * cur_table_len\n        return self\n    \n    # Returns True if the specific key exists in the table, False otherwise.\n    def contains(self, key):\n        # Hash the key and compute the bucket index\n        bucket_index = self.hash(key) % len(self.table)\n        \n        # Search the bucket\'s linked list for the key\n        item = self.table[bucket_index]\n        while item != None:\n            if key == item.key:\n                return True\n            item = item.next\n        \n        return False # key not found\n    \n    # Returns a deep copy of this table\n    def duplicate(self):\n        return PBChainingHashTable(self)\n    \n    # Searches for the item with the specified key. Returns the item\'s value if\n    # found, None if not found.\n    def get(self, key):\n        # Hash the key and compute the bucket index\n        bucket_index = self.hash(key) % len(self.table)\n        \n        # Search the bucket\'s linked list for the key\n        item = self.table[bucket_index]\n        while item != None:\n            if key == item.key:\n                return item.value\n            item = item.next\n        \n        return None # key not found\n    \n    # Returns a list of all keys in this hash table\n    def get_keys_list(self):\n        result = []\n        for head_item in self.table:\n            item = head_item\n            while item != None:\n                result.append(item.key)\n                item = item.next\n        return result\n    \n    def get_alt_text(self):\n        result = ("Chaining hash table with " + str(len(self.table)) +\n            " buckets: ")\n        item_prefix = ""\n        for i in range(len(self.table)):\n            result += item_prefix + str(i) + ": "\n            if self.table[i] != None:\n                result += "(" + str(self.table[i]) + ")"\n            else:\n                result += "empty"\n            item_prefix = ", "\n        return result\n    \n    def get_length(self):\n        length = 0\n        # Loop through buckets\n        for bucket in self.table:\n            item = bucket\n            # Loop through the bucket\'s linked list\n            while item != None:\n                # Increment length\n                length += 1\n                # Advance to next item in the bucket\'s linked list\n                item = item.next\n        return length\n    \n    def get_load_factor(self):\n        occupied_bucket_count = 0\n        for bucket in self.table:\n            if bucket != None:\n                occupied_bucket_count += 1\n        # Note: float() call needed for correctly functionality in Skulpt\n        return float(occupied_bucket_count) / len(self.table)\n    \n    # Returns a Python dictionary with two keys:\n    #\n    # "renderables":\n    #   The corresponding value is a list of objects, each also a Python\n    #   dictionary, to render. Each object has a "renderType" key and a\n    #   corresponding value indicating the type of object to render (exs:\n    #   "line" or "rectangle").\n    #\n    # "alt":\n    #   Corresponding value is a string for the rendered content\'s alt text.\n    def get_renderables(self):\n        FONT_SIZE = 14\n        PAD = 4\n        ITEM_BG = PBHashTable.BUCKET_COLOR_OCCUPIED_LIGHT\n        \n        # Make a PBArray to represent self.table\n        pb_arr = PBArray()\n        pb_arr.set_show_indices(True)\n        pb_arr.set_vertical(True)\n        pb_arr.set_cell_width(40)\n        pb_arr.set_index_font_color("rgb(0,0,0)")\n        \n        # Append an empty string for each bucket\n        for bucket in self.table:\n            pb_arr.append("")\n        \n        # Get the array\'s renderables as a starting point\n        renderables_dict = pb_arr.get_renderables()\n        renderables_dict["alt"] = self.get_alt_text()\n        r_list = renderables_dict["renderables"]\n        \n        # Add linked lists for non-empty buckets\n        clr = "rgb(0,0,0)"\n        for i in range(len(self.table)):\n            if self.table[i] == None:\n                # Skip empty bucket\n                continue\n            # Get the bucket\'s center point\n            center = pb_arr.get_cell_center_as_vector(i)\n            # Add renderables for all items\n            item = self.table[i]\n            while item != None:\n                # Add an arrow\n                r_list.append({\n                    "renderType": "arrow",\n                    "fromX": center.x,\n                    "fromY": center.y,\n                    "toX": center.x + 40,\n                    "toY": center.y,\n                    "color": clr\n                })\n                # Make and measure the item\'s text\n                item_text = str(item)\n                item_text_size = PBRenderable.measure_text(item_text, FONT_SIZE)\n                box_w = item_text_size[0] + PAD * 2\n                # Add the rectangle and text for the item\n                item_cx = PAD + center.x + 40 + box_w / 2\n                r_list.append({\n                    "renderType": "rectangle",\n                    "centerX": item_cx,\n                    "centerY": center.y,\n                    "width": box_w,\n                    "height": pb_arr.get_cell_height() - 4,\n                    "backgroundColor": ITEM_BG\n                })\n                r_list.append({\n                    "renderType": "text",\n                    "centerX": item_cx,\n                    "centerY": center.y,\n                    "color": "rgb(0,0,0)",\n                    "font": str(FONT_SIZE) + "px sans-serif",\n                    "text": item_text\n                })\n                # Update center for next item\n                center = center.add(PAD + 40 + box_w, 0)\n                # Go to next item\n                item = item.next\n        return renderables_dict\n    \n    # Inserts the specified key/value pair. If the key already exists, the\n    # corresponding value is updated. If inserted or updated, True is returned.\n    # If not inserted, then False is returned.\n    def insert(self, key, value):\n        # Hash the key to get the bucket index\n        bucket_index = self.hash(key) % len(self.table)\n        \n        # Traverse the linked list, searching for the key. If the key exists in\n        # an item, the value is replaced. Otherwise a new item is appended.\n        current_item = self.table[bucket_index]\n        previous_item = None\n        while current_item != None:\n            if key == current_item.key:\n                current_item.value = value\n                return True\n            previous_item = current_item\n            current_item = current_item.next\n        \n        # Append to the linked list\n        if self.table[bucket_index] == None:\n            self.table[bucket_index] = PBChainingHashTableItem(key, value)\n        else:\n            previous_item.next = PBChainingHashTableItem(key, value)\n        return True\n    \n    # Searches for the specified key. If found, the key/value pair is removed\n    # from the hash table and True is returned. If not found, False is returned.\n    def remove(self, key):\n        # Hash the key and compute bucket index\n        bucket_index = self.hash(key) % len(self.table)\n        \n        # Search the bucket\'s linked list for the key\n        current_item = self.table[bucket_index]\n        previous_item = None\n        while current_item != None:\n            if key == current_item.key:\n                if previous_item == None:\n                    # Remove linked list\'s first item\n                    self.table[bucket_index] = current_item.next\n                else:\n                    previous_item.next = current_item.next\n                return True\n            previous_item = current_item\n            current_item = current_item.next\n        \n        return False # key not found\n    \n    @staticmethod\n    def _duplicate_list(head_item):\n        if head_item == None:\n            return None\n        new_head = PBChainingHashTableItem(head_item.key, head_item.value)\n        our_prev = new_head\n        other_cur = head_item.next\n        while other_cur != None:\n            our_cur = PBChainingHashTableItem(other_cur.key, other_cur.value)\n            our_prev.next = our_cur\n            our_prev = our_cur\n            # Advance to next node in other list\n            other_cur = other_cur.next\n        return new_head\n\n# PBOpenAddressingBucket represents a bucket with a key and a value\nclass PBOpenAddressingBucket:\n    def __init__(self, bucket_key = None, bucket_value = None):\n        self.key = bucket_key\n        self.value = bucket_value\n    \n    def is_empty(self):\n        if self is PBOpenAddressingBucket.EMPTY_SINCE_START:\n            return True\n        return self is PBOpenAddressingBucket.EMPTY_AFTER_REMOVAL\n    \n    def is_empty_after_removal(self):\n        return self is PBOpenAddressingBucket.EMPTY_AFTER_REMOVAL\n    \n    def is_empty_since_start(self):\n        return self is PBOpenAddressingBucket.EMPTY_SINCE_START\n        \n# Initialize two special bucket types: empty-since-start and empty-after-removal\nPBOpenAddressingBucket.EMPTY_SINCE_START = PBOpenAddressingBucket()\nPBOpenAddressingBucket.EMPTY_AFTER_REMOVAL = PBOpenAddressingBucket()\n\n# PBOpenAddressingHashTable is a base class for an open addressing hash table\nclass PBOpenAddressingHashTable(PBHashTable):\n    def __init__(self, initial_capacity):\n        PBHashTable.__init__(self)\n        tbl = [PBOpenAddressingBucket.EMPTY_SINCE_START] * initial_capacity\n        self.table = tbl\n    \n    def probe(self, key, i):\n        # Each derived class must implement\n        pass\n    \n    # Returns a bool indicating if the bucket at the specified bucket index\n    # the specified key\n    def bucket_contains(self, bucket_index, key):\n        if self.table[bucket_index].is_empty():\n            return False\n        return self.table[bucket_index].key == key\n    \n    # Removes all items from this hash table. Returns self to allow chaining.\n    def clear(self):\n        cur_table_len = len(self.table)\n        self.table = [PBOpenAddressingBucket.EMPTY_SINCE_START] * cur_table_len\n        return self\n    \n    # Returns True if the specific key exists in the table, False otherwise.\n    def contains(self, key):\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            # An empty-since-start bucket implies the key is not in the table\n            if self.table[bucket_index].is_empty_since_start():\n                return False\n            \n            if not self.table[bucket_index].is_empty_after_removal():\n                # Check if the non-empty bucket has the key\n                if key == self.table[bucket_index].key:\n                    return True\n        return False # key not found\n    \n    def duplicate(self):\n        # Each derived class must implement\n        pass\n    \n    # Searches for the key, returning the corresponding value if found, None if\n    # not found.\n    def get(self, key):\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            \n            # An empty-since-start bucket implies the key is not in the table\n            if self.table[bucket_index].is_empty_since_start():\n                return None\n            \n            if not self.table[bucket_index].is_empty_after_removal():\n                # Check if the non-empty bucket has the key\n                if key == self.table[bucket_index].key:\n                    return self.table[bucket_index].value\n        return None # key not found\n    \n    def get_alt_text(self):\n        return self._get_alt_text("Open addressing hash table with " +\n            str(len(self.table)) + " buckets: ")\n    \n    def get_ear_bucket_indices(self):\n        result = []\n        for i in range(len(self.table)):\n            bucket = self.table[i]\n            if bucket.is_empty_after_removal():\n                result.append(i)\n        return result\n    \n    # Returns the number of empty buckets in this table. The returned values is\n    # the sum of the number of empty-since-start buckets plus the number of\n    # empty-after-removal buckets.\n    def get_empty_bucket_count(self):\n        result = 0\n        for i in range(len(self.table)):\n            if self.table[i].is_empty():\n                result += 1\n        return result\n    \n    def get_ess_bucket_indices(self):\n        result = []\n        for i in range(len(self.table)):\n            bucket = self.table[i]\n            if bucket.is_empty_since_start():\n                result.append(i)\n        return result\n    \n    # Returns a list of all keys in this hash table\n    def get_keys_list(self):\n        result = []\n        for bucket in self.table:\n            if not bucket.is_empty():\n                result.append(bucket.key)\n        return result\n    \n    # Returns the number of items in this hash table\n    def get_length(self):\n        num_occupied = 0\n        for bucket in self.table:\n            if not bucket.is_empty():\n                num_occupied += 1\n        return num_occupied\n    \n    def get_load_factor(self):\n        # Note: float() call needed for correctly functionality in Skulpt\n        return float(self.get_length()) / len(self.table)\n    \n    # Returns a string for the bucket at the specified bucket index. If the\n    # bucket is occupied, a string of the form "(key, value)" is returned.\n    # Otherwise an empty string is returned.\n    def get_bucket_item_string(self, bucket_index):\n        bucket = self.table[bucket_index]\n        if bucket.is_empty():\n            return ""\n        value_str = str(bucket.value)\n        if isinstance(bucket.value, str):\n            value_str = \'"\' + value_str + \'"\'\n        return "({0}, {1})".format(bucket.key, value_str)\n    \n    def get_bucket_key(self, bucket_index, to_return_if_empty = -1):\n        bucket = self.table[bucket_index]\n        if bucket.is_empty():\n            return to_return_if_empty\n        return bucket.key\n    \n    # Returns a Python dictionary with two keys:\n    #\n    # "renderables":\n    #   The corresponding value is a list of objects, each also a Python\n    #   dictionary, to render. Each object has a "renderType" key and a\n    #   corresponding value indicating the type of object to render (exs:\n    #   "line" or "rectangle").\n    #\n    # "alt":\n    #   Corresponding value is a string for the rendered content\'s alt text.\n    def get_renderables(self):\n        BORDER_COLOR = "rgb(0,0,0)"\n        # Make a PBArray to represent self.table\n        pb_arr = PBArray()\n        pb_arr.set_show_indices(True)\n        pb_arr.set_vertical(True)\n        pb_arr.set_cell_width(180)\n        pb_arr.set_index_font_color("rgb(0,0,0)")\n        for bucket in self.table:\n            index = pb_arr.get_length()\n            if bucket.is_empty():\n                pb_arr.append("")\n                if bucket.is_empty_after_removal():\n                    pb_arr.set_cell_background(index,\n                        PBHashTable.BUCKET_COLOR_EAR)\n            else:\n                item = "(" + str(bucket.key) + ", "\n                if isinstance(bucket.value, str):\n                    item += \'"\' + bucket.value + \'"\'\n                else:\n                    item += str(bucket.value)\n                item += ")"\n                pb_arr.append(item)\n                pb_arr.set_cell_background(index,\n                    PBHashTable.BUCKET_COLOR_OCCUPIED_LIGHT,\n                    PBHashTable.BUCKET_COLOR_OCCUPIED_DARK)\n        if self.render_info["cellWidth"] == "auto":\n            # Tell the array to auto-size the width\n            pb_arr.auto_size_cell_width()\n        else:\n            pb_arr.set_cell_width(self.render_info["cellWidth"])\n        # Get the PBArray\'s renderables\n        arr_renderables = pb_arr.get_renderables()\n        lights = arr_renderables["renderables"]\n        darks = arr_renderables["renderables_dark"]\n        LISTS = [lights, darks]\n        # If needed, build the legend\n        if self.render_info["showLegend"]:\n            for list_index in range(len(LISTS)):\n                self._add_legend_renderables(LISTS[list_index],\n                    pb_arr.get_bounding_box(), list_index == 0)\n        alt = self.get_alt_text()\n        return { "renderables": lights, "renderables_dark": darks, "alt": alt,\n            "alt_dark": alt }\n    \n    def insert(self, key, value):\n        # Search for the key in the table. If found, update the bucket\'s value.\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            \n            # An empty-since-start bucket implies the key is not in the table\n            if self.table[bucket_index].is_empty_since_start():\n                break\n            \n            if not self.table[bucket_index].is_empty_after_removal():\n                # Check if the non-empty bucket has the key\n                if key == self.table[bucket_index].key:\n                    # Update the value\n                    self.table[bucket_index].value = value\n                    return True\n        \n        # The key is not in the table, so insert into first empty bucket\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            if self.table[bucket_index].is_empty():\n                self.table[bucket_index] = PBOpenAddressingBucket(key, value)\n                return True\n        \n        return False # no empty bucket found\n    \n    # Inserts an item and returns a string with an explanation of how the\n    # insertion occurred. The key must NOT already be in the table.\n    def insert_with_explanation(self, key, value):\n        item_str = "(" + str(key)\n        if isinstance(value, str):\n            item_str += \', "{0}")\'.format(value)\n        else:\n            item_str += ", {0})".format(value)\n        \n        # Start the explanation string\n        explanation = "Insertion of " + item_str + ":"\n        \n        # Perform the insertion\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            explanation += "\\ni = {0}: ".format(i)\n            explanation += self._get_bucket_index_computation_string(key, i)\n            explanation += ". Bucket {0} is ".format(bucket_index)\n            if self.table[bucket_index].is_empty():\n                explanation += "empty, so {0} is inserted.".format(item_str)\n                self.table[bucket_index] = PBOpenAddressingBucket(key, value)\n                return explanation\n            else:\n                explanation += "occupied with "\n                explanation += self.get_bucket_item_string(bucket_index)\n                explanation += ", so i is incremented."\n        # Arriving here means that insertion failed\n        explanation += "\\nInsertion fails."\n        return explanation\n    \n    # Checks to see if the bucket at the specified bucket index (not key!) is\n    # empty, returning either True or False\n    def is_bucket_empty(self, bucket_index):\n        return self.table[bucket_index].is_empty()\n    \n    # Checks to see if the bucket at the specified bucket index (not key!) is\n    # empty-after-removal, returning either True or False\n    def is_bucket_empty_after_removal(self, bucket_index):\n        return self.table[bucket_index].is_empty_after_removal()\n    \n    # Checks to see if the bucket at the specified bucket index (not key!) is\n    # empty-since-start, returning either True or False\n    def is_bucket_empty_since_start(self, bucket_index):\n        return self.table[bucket_index].is_empty_since_start()\n    \n    def pick_colliding_items_to_insert(self, item_count, values_collection,\n        max_attempts = 50):\n        if max_attempts <= 0:\n            # Out of attempts\n            return None\n        if item_count < 0 or len(values_collection) < item_count:\n            return None\n        elif item_count == 0:\n            return []\n        \n        result = []\n        \n        # Make a temporary table and a copy of the values collection\n        temp_table = self.duplicate()\n        original_values_collection = list(values_collection)\n        \n        # Pick remaining items and insert each into the temporary table\n        i = 0\n        while len(result) < item_count:\n            picked = temp_table.pick_key_to_insert(i)\n            if picked == None:\n                return self.pick_colliding_items_to_insert(item_count,\n                    original_values_collection, max_attempts - 1)\n            key = picked[0]\n            value = PBRandom.remove(values_collection)\n            temp_table.insert(key, value)\n            result.append((key, value))\n            i += 1\n        return result\n    \n    # Picks a random key in the range [10, 99] to insert into this table such\n    # the the insertion causes the desired number of collisions. The desired\n    # number of collisions can be 0 to pick a non-colliding key.\n    # If no such key can be determined, None is returned. Otherwise a tuple of\n    # the following form is returned:\n    #   (random_key, list_of_bucket_indices_probed_during_insertion)\n    def pick_key_to_insert(self, desired_collision_count):\n        if desired_collision_count < 0:\n            # Can\'t satisfy a negative number of collisions\n            return None\n        \n        # Start the set of possible keys with all keys in the range [10, 99]\n        possible_set = set(range(10, 100))\n        \n        # Remove all keys already in this hash table\n        for possible_key in set(possible_set):\n            if self.contains(possible_key):\n                possible_set.remove(possible_key)\n        \n        # Check which possible keys work\n        for possible_key in set(possible_set):\n            actual_collisions = self._get_i_for_insert(possible_key)\n            if actual_collisions != desired_collision_count:\n                possible_set.remove(possible_key)\n        \n        # Pick a random key in possible_set until one that works is found\n        while len(possible_set) > 0:\n            # Pick a random key from the set of possible keys\n            random_key = PBRandom.pick(list(possible_set))\n            \n            # Remove random_key from possible_set in case the probing sequence\n            # that follows fails to find an empty bucket\n            possible_set.remove(random_key)\n            \n            # Make a list of buckets probed during insertion of the chosen key\n            probed_buckets = []\n            for i in range(len(self.table)):\n                bucket_index = self.probe(random_key, i)\n                probed_buckets.append(bucket_index)\n                # Can only insert if bucket is empty\n                if self.table[bucket_index].is_empty():\n                    return (random_key, probed_buckets)\n        # No possible keys\n        return None\n    \n    # Clears the table and then adds random keys until at the desired length.\n    # Returns True if the table was populated successfully, False otherwise.\n    # Ex: False is returned if the desired_length argument is greater than this\n    # table\'s bucket count or the length of values_collection.\n    def populate_random(self, desired_length, values_collection,\n        avoid_collisions = False):\n        if (desired_length > len(self.table) or\n            desired_length > len(values_collection)):\n            return False\n        # Clear first\n        self.clear()\n        # Make a list of the collection of values and shuffle so that a random\n        # value can be easily obtained via a pop()\n        vals_pool = list(values_collection)\n        PBRandom.shuffle(vals_pool)\n        # Build a pool of random keys in the range [10, 99]\n        key_pool = list(range(10, 100))\n        PBRandom.shuffle(key_pool)\n        # Add random items until at the desired length\n        while self.get_length() < desired_length:\n            # Failure if key_pool or vals_pool is empty\n            if 0 == len(key_pool) or 0 == len(vals_pool):\n                return False\n            # Get a random key from the pool\n            random_key = key_pool.pop()\n            # Get random_key\'s first bucket index\n            bucket_index = self.probe(random_key, 0)\n            # Skip key if avoid_collisions is True and a collision occurs\n            if avoid_collisions and not self.table[bucket_index].is_empty():\n                continue\n            # Get a random value from the pool\n            random_value = vals_pool.pop()\n            # Insert the item\n            self.insert(random_key, random_value)\n        return True\n    \n    def remove(self, key):\n        EMPTY_BUCKET_REF = PBOpenAddressingBucket.EMPTY_AFTER_REMOVAL\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            \n            # An empty-since-start bucket implies the key is not in the table\n            if self.table[bucket_index].is_empty_since_start():\n                return False\n            \n            if not self.table[bucket_index].is_empty_after_removal():\n                # Check if the non-empty bucket has the key\n                if key == self.table[bucket_index].key:\n                   # Remove by setting the bucket to empty-after-removal\n                   self.table[bucket_index] = EMPTY_BUCKET_REF\n                   return True\n        return False # key not found\n    \n    def _add_legend_renderables(self, target_list, table_bounds, light_mode):\n        background_color = None\n        text_color = None\n        legend_box_colors = None\n        if light_mode:\n            background_color = PBColors.get_light_mode_colors()["bg"]\n            text_color = PBColors.get_light_mode_colors()["text"]\n            legend_box_colors = [background_color,\n                PBHashTable.BUCKET_COLOR_EAR,\n                PBHashTable.BUCKET_COLOR_OCCUPIED_LIGHT]\n        else:\n            background_color = PBColors.get_dark_mode_colors()["bg"]\n            text_color = PBColors.get_dark_mode_colors()["text"]\n            legend_box_colors = [\n                background_color,\n                PBHashTable.BUCKET_COLOR_EAR,\n                PBHashTable.BUCKET_COLOR_OCCUPIED_DARK\n            ]\n        legend_box_cx = table_bounds.get_max_x() + 16\n        legend_box_cy = table_bounds.get_min_y() + 8\n        legend_box_labels = ["Empty-since-start", "Empty-after-removal",\n            "Occupied"]\n        for legend_box_index in range(len(legend_box_labels)):\n            target_list.append({\n                "renderType": "rectangle",\n                "centerX": legend_box_cx,\n                "centerY": legend_box_cy,\n                "width": 16,\n                "height": 16,\n                "backgroundColor": legend_box_colors[legend_box_index],\n                "borderColor": text_color\n            })\n            target_list.append({\n                "renderType": "text",\n                "left": legend_box_cx + 16,\n                "top": legend_box_cy - 8,\n                "color": text_color,\n                "font": "14px sans-serif",\n                "text": legend_box_labels[legend_box_index]\n            })\n            legend_box_cy += 24\n        # At the time of this writing (March 2025) the legend text gets\n        # partially cut off. So a background rectangle is added to force\n        # the render engine to use a sufficient size.\n        bounds = PBRenderable.compute_renderables_bounds(target_list)\n        target_list.insert(0, {\n            "renderType": "rectangle",\n            "left": 0,\n            "top": 0,\n            "width": bounds.get_width() + 8,\n            "height": bounds.get_height(),\n            "backgroundColor": background_color\n        })\n    \n    def _get_bucket_index_computation_string(self, key, i):\n        # Inheriting classes must implement\n        return "ERROR: No implementation of _get_bucket_index_computation_string()"\n    \n    # Returns the probing sequence i-value that would be used when inserting\n    # key. The key itself is NOT inserted, so the table is not modified. If the\n    # key cannot be inserted then infinity is returned.\n    def _get_i_for_insert(self, key):\n        for i in range(len(self.table)):\n            bucket_index = self.probe(key, i)\n            if self.table[bucket_index].is_empty():\n                return i\n        # No empty bucket found in the probing sequence\n        return float("inf")\n    \n    def _get_alt_text(self, prefix):\n        result = prefix\n        item_prefix = ""\n        for i in range(len(self.table)):\n            result += (item_prefix + str(i) + ": ")\n            if self.table[i] is PBOpenAddressingBucket.EMPTY_SINCE_START:\n                result += "Empty-since-start"\n            elif self.table[i] is PBOpenAddressingBucket.EMPTY_AFTER_REMOVAL:\n                result += "Empty-after-removal"\n            else:\n                result += "(%s, %s)" % (self.table[i].key, self.table[i].value)\n            item_prefix = ", "\n        return result\n    \n    def _pick_key_for_bucket(self, available_keys, bucket_index, probe_i):\n        for candidate_key in list(available_keys):\n            actual_bucket_index = self.probe(candidate_key, probe_i)\n            if actual_bucket_index == bucket_index:\n                available_keys.remove(candidate_key)\n                return candidate_key\n        return None\n\nclass PBDoubleHashingHashTable(PBOpenAddressingHashTable):\n    def __init__(self, initial_capacity = 11):\n        # Special case for copy construction\n        if isinstance(initial_capacity, PBDoubleHashingHashTable):\n            other = initial_capacity\n            PBOpenAddressingHashTable.__init__(self, len(other.table))\n            for i in range(len(other.table)):\n                other_bucket = other.table[i]\n                if other_bucket.is_empty():\n                    # Empty bucket references can be shallow copied\n                    self.table[i] = other.table[i]\n                else:\n                    self.table[i] = PBOpenAddressingBucket(other_bucket.key,\n                        other_bucket.value)\n            self._hash2 = other._hash2\n        else:\n            PBOpenAddressingHashTable.__init__(self, initial_capacity)\n            self._hash2 = lambda key: 7 - self.hash(key) % 7\n    \n    # Returns a deep copy of this table\n    def duplicate(self):\n        return PBDoubleHashingHashTable(self)\n    \n    def h2(self, key):\n        return self._hash2(key)\n    \n    # Returns the bucket index for the specified key and i value using the\n    # double hashing probing sequence.\n    def probe(self, key, i):\n        return (self.hash(key) + i * self.h2(key)) % len(self.table)\n    \n    def _get_bucket_index_computation_string(self, key, i):\n        return "({0} + {1} * {2}) % {3} = {4}".format(self.hash(key), i,\n            self.h2(key), len(self.table), self.probe(key, i))\n\nclass PBLinearProbingHashTable(PBOpenAddressingHashTable):\n    def __init__(self, initial_capacity = 11):\n        # Special case for copy construction\n        if isinstance(initial_capacity, PBLinearProbingHashTable):\n            other = initial_capacity\n            PBOpenAddressingHashTable.__init__(self, len(other.table))\n            for i in range(len(other.table)):\n                other_bucket = other.table[i]\n                if other_bucket.is_empty():\n                    # Empty bucket references can be shallow copied\n                    self.table[i] = other.table[i]\n                else:\n                    self.table[i] = PBOpenAddressingBucket(other_bucket.key,\n                        other_bucket.value)\n        else:\n            PBOpenAddressingHashTable.__init__(self, initial_capacity)\n    \n    # Returns a deep copy of this table\n    def duplicate(self):\n        return PBLinearProbingHashTable(self)\n    \n    def get_alt_text(self):\n        return self._get_alt_text("Linear probing hash table with " +\n            str(len(self.table)) + " buckets: ")\n    \n    # Returns the bucket index for the specified key and i value using the\n    # linear probing sequence.\n    def probe(self, key, i):\n        return (self.hash(key) + i) % len(self.table)\n    \n    def _get_bucket_index_computation_string(self, key, i):\n        return "({0} + {1}) % {2} = {3}".format(self.hash(key), i,\n            len(self.table), self.probe(key, i))\n\nclass PBQuadraticProbingHashTable(PBOpenAddressingHashTable):\n    def __init__(self, c1 = 1, c2 = 1, initial_capacity = 11):\n        # Special case for copy construction\n        if isinstance(c1, PBQuadraticProbingHashTable):\n            other = c1\n            PBOpenAddressingHashTable.__init__(self, len(other.table))\n            self.c1 = other.c1\n            self.c2 = other.c2\n            self._simplify_comp_strings = other._simplify_comp_strings\n            for i in range(len(other.table)):\n                other_bucket = other.table[i]\n                if other_bucket.is_empty():\n                    # Empty bucket references can be shallow copied\n                    self.table[i] = other.table[i]\n                else:\n                    other_key = other_bucket.key\n                    other_val = other_bucket.value\n                    self.table[i] = PBOpenAddressingBucket(other_key, other_val)\n        else:\n            PBOpenAddressingHashTable.__init__(self, initial_capacity)\n            self.c1 = c1\n            self.c2 = c2\n            self._simplify_comp_strings = True\n    \n    # Returns a deep copy of this table\n    def duplicate(self):\n        return PBQuadraticProbingHashTable(self)\n    \n    def get_alt_text(self):\n        return self._get_alt_text("Quadratic probing hash table with c1 = " +\n            str(self.c1) + ", c2 = " + str(self.c2) + ", and " +\n            str(len(self.table)) + " buckets: ")\n    \n    # Returns the bucket index for the specified key and i value using the\n    # quadratic probing sequence.\n    def probe(self, key, i):\n        tbl_len = len(self.table)\n        return (self.hash(key) + self.c1 * i + self.c2 * i * i) % tbl_len\n    \n    def _get_bucket_index_computation_string(self, key, i):\n        num_buckets = len(self.table)\n        result = "({0}".format(self.hash(key))\n        if self._simplify_comp_strings:\n            # The term involving c1, normally "c1 * i", can be simplified:\n            # - to just "i" if c1 == 1\n            # - to an empty string if c1 == 0\n            if self.c1 == 1:\n                result += " + " + str(i)\n            elif self.c1 != 0:\n                result += " + {0} * {1}".format(self.c1, i)\n            # Similar story for c2, which has the unsimplified term "c2 * i * i"\n            if self.c2 == 1:\n                result += " + {0} * {0}".format(i)\n            elif self.c2 != 0:\n                result += " + {0} * {1} * {1}".format(self.c2, i)\n            # Finalize the result\n            result += ") % {0} = {1}".format(num_buckets, self.probe(key, i))\n        else:\n            # Don\'t simplify\n            result += "{0} * {1} + {2} * {0} * {0}) % {3} = {4}".format(\n                self.c1, i, self.c2, num_buckets, self.probe(key, i))\n        return result\n',"src/lib/pipes.py":'raise NotImplementedError("pipes is not yet implemented in Skulpt")\n',"src/lib/lib2to3/pgen2/__init__.py":'raise NotImplementedError("pgen2 is not yet implemented in Skulpt")\n',"src/lib/dbhash.py":'raise NotImplementedError("dbhash is not yet implemented in Skulpt")\n',"src/lib/ihooks.py":'raise NotImplementedError("ihooks is not yet implemented in Skulpt")\n',"src/lib/lib2to3/tests/__init__.py":'raise NotImplementedError("tests is not yet implemented in Skulpt")\n',"src/lib/genericpath.py":'raise NotImplementedError("genericpath is not yet implemented in Skulpt")\n',"src/lib/unittest/__init__.py":'__author__ = \'bmiller\'\n\'\'\'\nThis is the start of something that behaves like\nthe unittest module from cpython.\n\n\'\'\'\n\nclass TestCase:\n    def __init__(self):\n        self.numPassed = 0\n        self.numFailed = 0\n        self.assertPassed = 0\n        self.assertFailed = 0\n        self.verbosity = 1\n        self.tlist = []\n        testNames = {}\n        for name in dir(self):\n            if name[:4] == \'test\' and name not in testNames:\n                self.tlist.append(getattr(self,name))\n                testNames[name]=True\n\n    def setUp(self):\n        pass\n\n    def tearDown(self):\n        pass\n    \n    def cleanName(self,funcName):\n    # work around skulpts lack of an __name__\n        funcName = str(funcName)\n        funcName = funcName[13:]\n        funcName = funcName[:funcName.find(\'<\')-3]\n        return funcName\n\n    def main(self):\n\n        for func in self.tlist:\n            if self.verbosity > 1:\n                print(\'Running %s\' % self.cleanName(func))\n            try:\n                self.setUp()\n                self.assertPassed = 0\n                self.assertFailed = 0\n                func()\n                self.tearDown()\n                if self.assertFailed == 0:\n                    self.numPassed += 1\n                else:\n                    self.numFailed += 1\n                    print(\'Tests failed in %s \' % self.cleanName(func))\n            except Exception as e:\n                self.assertFailed += 1\n                self.numFailed += 1\n                print(\'Test threw exception in %s (%s)\' % (self.cleanName(func), e))\n        self.showSummary()\n\n    def assertEqual(self, actual, expected, feedback=""):\n        res = actual==expected\n        if not res and feedback == "":\n            feedback = "Expected %s to equal %s" % (str(actual),str(expected))\n        self.appendResult(res, actual ,expected, feedback)\n\n    def assertNotEqual(self, actual, expected, feedback=""):\n        res = actual != expected\n        if not res and feedback == "":\n            feedback = "Expected %s to not equal %s" % (str(actual),str(expected))\n        self.appendResult(res, actual, expected, feedback)\n\n    def assertTrue(self,x, feedback=""):\n        res = bool(x) is True\n        if not res and feedback == "":\n            feedback = "Expected %s to be True" % (str(x))\n        self.appendResult(res, x, True, feedback)\n\n    def assertFalse(self,x, feedback=""):\n        res = not bool(x)\n        if not res and feedback == "":\n            feedback = "Expected %s to be False" % (str(x))\n        self.appendResult(res, x, False, feedback)\n\n    def assertIs(self,a,b, feedback=""):\n        res = a is b\n        if not res and feedback == "":\n            feedback = "Expected %s to be the same object as %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertIsNot(self,a,b, feedback=""):\n        res = a is not b\n        if not res and feedback == "":\n            feedback = "Expected %s to not be the same object as %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertIsNone(self,x, feedback=""):\n        res = x is None\n        if not res and feedback == "":\n            feedback = "Expected %s to be None" % (str(x))\n        self.appendResult(res, x, None, feedback)\n\n    def assertIsNotNone(self,x, feedback=""):\n        res = x is not None\n        if not res and feedback == "":\n            feedback = "Expected %s to not be None" % (str(x))\n        self.appendResult(res, x, None, feedback)\n\n    def assertIn(self, a, b, feedback=""):\n        res = a in b\n        if not res and feedback == "":\n            feedback = "Expected %s to be in %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertNotIn(self, a, b, feedback=""):\n        res = a not in b\n        if not res and feedback == "":\n            feedback = "Expected %s to not be in %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertIsInstance(self,a,b, feedback=""):\n        res = isinstance(a,b)\n        if not res and feedback == "":\n            feedback = "Expected %s to be an instance of %s" % (str(a), str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertNotIsInstance(self,a,b, feedback=""):\n        res = not isinstance(a,b)\n        if not res and feedback == "":\n            feedback = "Expected %s to not be an instance of %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertAlmostEqual(self, a, b, places=7, feedback="", delta=None):\n\n        if delta is not None:\n            res = abs(a-b) <= delta\n        else:\n            if places is None:\n                places = 7\n            res = round(a-b, places) == 0\n        \n        if not res and feedback == "":\n            feedback = "Expected %s to equal %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertNotAlmostEqual(self, a, b, places=7, feedback="", delta=None):\n\n        if delta is not None:\n            res = not (a == b) and abs(a - b) > delta\n        else:\n            if places is None:\n                places = 7\n            res = round(a-b, places) != 0\n\n        if not res and feedback == "":\n            feedback = "Expected %s to not equal %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n\n    def assertGreater(self,a,b, feedback=""):\n        res = a > b\n        if not res and feedback == "":\n            feedback = "Expected %s to be greater than %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertGreaterEqual(self,a,b, feedback=""):\n        res = a >= b\n        if not res and feedback == "":\n            feedback = "Expected %s to be >= %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertLess(self, a, b, feedback=""):\n        res = a < b\n        if not res and feedback == "":\n            feedback = "Expected %s to be less than %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def assertLessEqual(self,a,b, feedback=""):\n        res = a <= b\n        if not res and feedback == "":\n            feedback = "Expected %s to be <= %s" % (str(a),str(b))\n        self.appendResult(res, a, b, feedback)\n\n    def appendResult(self,res,actual,expected,feedback):\n        if res:\n            msg = \'Pass\'\n            self.assertPassed += 1\n        else:\n            msg = \'Fail: \' +  feedback\n            print(msg)\n            self.assertFailed += 1\n\n    def assertRaises(self, exception, callable=None, *args, **kwds):\n        # with is currently not supported hence we just try and catch\n        if callable is None:\n            raise NotImplementedError("assertRaises does currently not support assert contexts")\n        if kwds:\n            raise NotImplementedError("assertRaises does currently not support **kwds")\n\n        res = False\n        actualerror = str(exception())\n        try:\n            callable(*args)\n        except exception as ex:\n            res = True\n        except Exception as inst:\n            actualerror = str(inst)\n            print("ACT = ", actualerror, str(exception()))\n        else:\n            actualerror = "No Error"\n\n        self.appendResult(res, str(exception()), actualerror, "")\n\n    def fail(self, msg=None):\n        if msg is None:\n            msg = \'Fail\'\n        else:\n            msg = \'Fail: \' + msg\n        print(msg)\n        self.assertFailed += 1\n\n    def showSummary(self):\n        pct = self.numPassed / (self.numPassed+self.numFailed) * 100\n        print("Ran %d tests, passed: %d failed: %d\\n" % (self.numPassed+self.numFailed,\n                                               self.numPassed, self.numFailed))\n\n\n\ndef main(verbosity=1):\n    glob = globals() # globals() still needs work\n    for name in glob:\n        if issubclass(glob[name],TestCase):\n            try:\n                tc = glob[name]()\n                tc.verbosity = verbosity\n                tc.main()\n            except:\n                print("Uncaught Error in: ", name)\n',"src/lib/webgl/__init__.js":"var $builtinmodule = function(name)\n{\n  var mod = {};\n\n  var makeFailHTML = function(msg) {\n    return '' +\n      '<table style=\"background-color: #8CE; width: 100%; height: 100%;\"><tr>' +\n      '<td align=\"center\">' +\n      '<div style=\"display: table-cell; vertical-align: middle;\">' +\n      '<div style=\"\">' + msg + '</div>' +\n      '</div>' +\n      '</td></tr></table>';\n  };\n\n  var GET_A_WEBGL_BROWSER = '' +\n    'This page requires a browser that supports WebGL.<br/>' +\n    '<a href=\"http://get.webgl.org\">Click here to upgrade your browser.</a>';\n\n  var NEED_HARDWARE = '' +\n    \"It doesn't appear your computer can support WebGL.<br/>\" +\n    '<a href=\"http://get.webgl.org\">Click here for more information.</a>';\n  \n  var create3DContext = function(canvas) {\n    var names = [\"webgl\", \"experimental-webgl\", \"webkit-3d\", \"moz-webgl\"];\n    var gl = null;\n    for (var ii = 0; ii < names.length; ++ii) {\n      try {\n        gl = canvas.getContext(names[ii]);\n      }\n      catch(e) {\n      }\n      if (gl) {\n          break;\n      }\n    }\n    if (gl) {\n      // Disallow selection by default. This keeps the cursor from changing to an\n      // I-beam when the user clicks and drags. It's easier on the eyes.\n      function returnFalse() {\n        return false;\n      }\n\n      canvas.onselectstart = returnFalse;\n      canvas.onmousedown = returnFalse;\n    }\n    return gl;\n  };\n\n  var setupWebGL = function(canvasContainerId, opt_canvas) {\n    var container = document.getElementById(canvasContainerId);\n    var context;\n    if (!opt_canvas) {\n      opt_canvas = container.getElementsByTagName(\"canvas\")[0];\n    }\n    if (!opt_canvas) {\n        // this browser doesn't support the canvas tag at all. Not even 2d.\n      container.innerHTML = makeFailHTML(GET_A_WEBGL_BROWSER);\n      return;\n    }\n\n    var gl = create3DContext(opt_canvas);\n    if (!gl) {\n      // TODO(gman): fix to official way to detect that it's the user's machine, not the browser.\n      var browserStrings = navigator.userAgent.match(/(\\w+\\/.*? )/g);\n      var browsers = {};\n      try {\n        for (var b = 0; b < browserStrings.length; ++b) {\n          var parts = browserStrings[b].match(/(\\w+)/g);\n          var bb = [];\n          for (var ii = 1; ii < parts.length; ++ii) {\n            bb.push(parseInt(parts[ii]));\n          }\n          browsers[parts[0]] = bb;\n        }\n      }\n      catch (e) {\n      }\n      if (browsers.Chrome &&\n           (browsers.Chrome[0] > 7 ||\n                 (browsers.Chrome[0] == 7 && browsers.Chrome[1] > 0) ||\n                 (browsers.Chrome[0] == 7 && browsers.Chrome[1] == 0 && browsers.Chrome[2] >= 521))) {\n        container.innerHTML = makeFailHTML(NEED_HARDWARE);\n      }\n      else {\n        container.innerHTML = makeFailHTML(GET_A_WEBGL_BROWSER);\n      }\n    }\n    return gl;\n  };\n\n  /**\n   * The Context encapsulates the underlying WebGL native JavaScript API.\n   */\n  mod.Context = Sk.misceval.buildClass(mod, function($gbl, $loc) {\n    $loc.__init__ = new Sk.builtin.func(\n      function(self, canvasid) {\n        var canvas = document.getElementById(canvasid.v);\n        var gl = setupWebGL(canvasid.v, canvas)\n        if (!gl) {\n          throw new Error(\"Your browser does not appear to support WebGL.\");\n        }\n\n        self.gl = gl;\n\n        // Copy symbolic constants and functions from native WebGL, encapsulating where necessary.       \n        for (var k in gl.__proto__) {\n          if (typeof gl.__proto__[k] === 'number') {\n            Sk.abstr.objectSetItem(self['$d'], new Sk.builtin.str(k), gl.__proto__[k]);\n          }\n          else if (typeof gl.__proto__[k] === \"function\") {\n            switch(k) {\n              case 'bufferData': {\n              }\n              break;\n              case 'clearColor': {\n              }\n              break;\n              case 'drawArrays': {\n              }\n              break;\n              case 'getAttribLocation': {\n              }\n              break;\n              case 'getUniformLocation': {\n              }\n              break;\n              case 'shaderSource': {\n              }\n              break;\n              case 'uniformMatrix4fv': {\n              }\n              break;\n              case 'vertexAttribPointer': {\n              }\n              break;\n              case 'viewport': {\n              }\n              break;\n              default: {\n                (function(key) {\n                  Sk.abstr.objectSetItem(self['$d'], new Sk.builtin.str(k), new Sk.builtin.func(function() {\n                    var f = gl.__proto__[key];\n                    return f.apply(gl, arguments);\n                  }));\n                 }(k));\n              }\n            }\n          }\n        }\n\n        gl.clearColor(100.0/255.0, 149.0/255.0, 237.0/255.0, 1.0);\n        gl.clear(gl.COLOR_BUFFER_BIT);\n      }\n    );\n\n    $loc.tp$getattr = Sk.builtin.object.prototype.GenericGetAttr;\n\n    $loc.bufferData = new Sk.builtin.func(\n      function(self, target, data, usage) {\n        self.gl.bufferData(target, data.v, usage);\n      }\n    );\n\n    $loc.clearColor = new Sk.builtin.func(\n      function(self, red, green, blue, alpha) {\n        self.gl.clearColor(Sk.builtin.asnum$(red), Sk.builtin.asnum$(green), Sk.builtin.asnum$(blue), Sk.builtin.asnum$(alpha));\n      }\n    );\n\n    $loc.getAttribLocation = new Sk.builtin.func(\n      function(self, program, name) {\n        return self.gl.getAttribLocation(program, name.v);\n      }\n    );\n\n    $loc.getUniformLocation = new Sk.builtin.func(\n      function(self, program, name) {\n        return self.gl.getUniformLocation(program, name.v);\n      }\n    );\n\n    $loc.shaderSource = new Sk.builtin.func(\n      function(self, shader, src) {\n        self.gl.shaderSource(shader, src.v);\n      }\n    );\n\n    $loc.drawArrays = new Sk.builtin.func(\n      function(self, mode, first, count) {\n        self.gl.drawArrays(Sk.builtin.asnum$(mode), Sk.builtin.asnum$(first), Sk.builtin.asnum$(count));\n      }\n    );\n\n    $loc.vertexAttribPointer = new Sk.builtin.func(\n      function(self, index, size, type, normalized, stride, dunno) {\n        self.gl.vertexAttribPointer(index, Sk.builtin.asnum$(size), Sk.builtin.asnum$(type), normalized, Sk.builtin.asnum$(stride), Sk.builtin.asnum$(dunno));\n      }\n    );\n\n    $loc.viewport = new Sk.builtin.func(\n      function(self, x, y, width, height) {\n        self.gl.viewport(Sk.builtin.asnum$(x), Sk.builtin.asnum$(y), Sk.builtin.asnum$(width), Sk.builtin.asnum$(height));\n      }\n    );\n\n    $loc.uniformMatrix4fv = new Sk.builtin.func(\n      function(self, location, transpose, values) {\n//        console.log(\"location  \" + (typeof location));\n//        console.log(\"transpose \" + (typeof transpose));\n//        console.log(\"values.v  \" + (typeof values.v));\n        self.gl.uniformMatrix4fv(Sk.builtin.asnum$(location), transpose, values.v);\n      }\n    );\n\n    $loc.setDrawFunc = new Sk.builtin.func(function(self, func) {\n      var startTime = (new Date()).getTime();\n      var intervalId = setInterval(\n        function() {\n          Sk.misceval.callsim(func, self, (new Date()).getTime() - startTime);\n        }, 1000.0 / 60.0); // 60 fps\n    });\n\n  }, 'Context', []);\n\n  mod.Float32Array = Sk.misceval.buildClass(mod, function($gbl, $loc) {\n    $loc.__init__ = new Sk.builtin.func(function(self, data) {\n      if (typeof data === \"number\") {\n        self.v = new Float32Array(data);\n      }\n      else {\n        self.v = new Float32Array(Sk.ffi.remapToJs(data));\n      }\n    });\n\n    $loc.__repr__ = new Sk.builtin.func(function(self) {\n      var copy = [];\n      for (var i = 0; i < self.v.length; ++i) {\n        copy.push(self.v[i]);\n      }\n      return new Sk.builtin.str(\"[\" + copy.join(', ') + \"]\");\n     });\n  }, 'Float32Array', []);\n\n  /**\n   * A 4x4 (mutable) matrix suitable for OpenGL.\n   *\n   * Mutability is chosen for performance.\n   * The inderlying implementation is Float32Array.\n   * The indexing of the elements is\n   * 0 4  8 12\n   * 1 5  9 13\n   * 2 6 10 14\n   * 3 7 11 15\n   */\n  mod.Matrix4x4 = Sk.misceval.buildClass(mod, function($gbl, $loc) {\n    $loc.__init__ = new Sk.builtin.func(function(self, data) {\n      self.v = new Float32Array(Sk.ffi.remapToJs(data));\n    });\n\n    $loc.identity = new Sk.builtin.func(\n      function(self) {\n\n        var m = self.v;\n\n        m[0]  = 1;\n        m[1]  = 0;\n        m[2]  = 0;\n        m[3]  = 0;\n\n        m[4]  = 0;\n        m[5]  = 1;\n        m[6]  = 0;\n        m[7]  = 0;\n\n        m[8]  = 0;\n        m[9]  = 0;\n        m[10] = 1;\n        m[11] = 0;\n\n        m[12] = 0;\n        m[13] = 0;\n        m[14] = 0;\n        m[15] = 1;\n      }\n    );\n\n    $loc.perspective = new Sk.builtin.func(\n      function(self, fov, aspect, near, far) {\n        \n        var t = Math.tan(Math.PI * 0.5 - 0.5 * (Sk.builtin.asnum$(fov) * Math.PI / 180));\n        var a = Sk.builtin.asnum$(aspect)\n        var n = Sk.builtin.asnum$(near)\n        var f = Sk.builtin.asnum$(far)\n        var k = 1.0 / (n - f);\n\n        var m = self.v;\n\n        m[0]  = t / a;\n        m[1]  = 0;\n        m[2]  = 0;\n        m[3]  = 0;\n\n        m[4]  = 0;\n        m[5]  = t;\n        m[6]  = 0;\n        m[7]  = 0;\n\n        m[8]  = 0;\n        m[9]  = 0;\n        m[10] = (n + f) * k;\n        m[11] = -1;\n\n        m[12] = 0;\n        m[13] = 0;\n        m[14] = n * f * k * 2;\n        m[15] = 0;\n      }\n    );\n\n    $loc.translate = new Sk.builtin.func(\n      function(self, translation) {\n\n        var m = self.v;\n        var t = Sk.ffi.remapToJs(translation);\n\n        m[0]  = 1;\n        m[1]  = 0;\n        m[2]  = 0;\n        m[3]  = 0;\n\n        m[4]  = 0;\n        m[5]  = 1;\n        m[6]  = 0;\n        m[7]  = 0;\n\n        m[8]  = 0;\n        m[9]  = 0;\n        m[10] = 1;\n        m[11] = 0;\n\n        m[12] = t[0];\n        m[13] = t[1];\n        m[14] = t[2];\n        m[15] = 1;\n      }\n    );\n\n    $loc.__repr__ = new Sk.builtin.func(function(self) {\n      var copy = [];\n      for (var i = 0; i < self.v.length; ++i) {\n        copy.push(self.v[i]);\n      }\n      return new Sk.builtin.str(\"[\" + copy.join(', ') + \"]\");\n     });\n  }, 'Matrix4x4', []);\n\n  return mod;\n};","src/lib/test/test_support.py":'"""Supporting definitions for the Python regression tests."""\n\nif __name__ != \'test.test_support\':\n    raise ImportError(\'test_support must be imported from the test package\')\n\nimport unittest\n\n\n# def run_unittest(*classes):\n#     """Run tests from unittest.TestCase-derived classes."""\n#     valid_types = (unittest.TestSuite, unittest.TestCase)\n#     suite = unittest.TestSuite()\n#     for cls in classes:\n#         if isinstance(cls, str):\n#             if cls in sys.modules:\n#                 suite.addTest(unittest.findTestCases(sys.modules[cls]))\n#             else:\n#                 raise ValueError("str arguments must be keys in sys.modules")\n#         elif isinstance(cls, valid_types):\n#             suite.addTest(cls)\n#         else:\n#             suite.addTest(unittest.makeSuite(cls))\n#     _run_suite(suite)\n\ndef run_unittest(*classes):\n    """Run tests from unittest.TestCase-derived classes."""\n    for cls in classes:\n        print cls\n        if issubclass(cls, unittest.TestCase):\n            cls().main()\n        else:\n            print "Don\'t know what to do with ", cls\n',"src/lib/sunau.py":'raise NotImplementedError("sunau is not yet implemented in Skulpt")\n',"src/lib/modulefinder.py":'raise NotImplementedError("modulefinder is not yet implemented in Skulpt")\n',"src/lib/config/__init__.py":'raise NotImplementedError("config is not yet implemented in Skulpt")\n',"src/lib/decimal.py":'raise NotImplementedError("decimal is not yet implemented in Skulpt")\n',"src/lib/meb/SupercooledWater.py":"class SupercooledWater:\n    def __init__(self, properties):\n        self.phase = 'supercooled vapor'\n        self.P = properties[0] # kPa\n        self.T = properties[1] # degrees C\n        self.v = properties[2] # m3/kg\n        self.u = properties[3] # kJ/kg\n        self.h = properties[4] # kJ/kg\n        self.s = properties[5] # kJ/kg*K\n\nsupercooled_waters_property_to_index = {\n    'P': 0,\n    'T': 1,\n    'v': 2,\n    'u': 3,\n    'h': 4,\n    's': 5,\n}\n\nsupercooled_waters = [\n    [ 10, 40, 0.0010079, 1
t-family="Arial" border-width="2px" lineType="none" transformDeg="0"><text latex="true">\\text{Heater}</text></zyObject><zyObject objNum="57" objType="image" objName="Arr UL" top="346px" left="507px" opacity="0" useConstrainedProportions="true" constrainedProportionsHeight="11" constrainedProportionsWidth="35" googleDriveFileID="1mAdHUA8TAgOc5PqqRDTbWJO2ntyg0VTA" height="11px" width="35px" border-width="2px" border-color="transparent" lineType="none" transformDeg="0"></zyObject><zyObject objNum="58" objType="text" objName="\\text{Die}" top="347px" left="542px" opacity="0" color="black" font-weight="400" font-family="Arial" border-width="2px" lineType="none" transformDeg="0"><text latex="true">\\text{Die}</text></zyObject><zyObject objNum="59" objType="box" objName="Hide all" isLocked="true" top="239px" left="92px" background-color="white" useConstrainedProportions="false" height="142px" width="428px" border-width="2px" border-color="transparent" lineType="solid" transformDeg="0"></zyObject><zyObject objNum="61" objType="text" objName="\\text{Extruder}" top="393px" left="75px" opacity="0" color="black" font-weight="400" font-family="Arial" border-width="2px" lineType="none" transformDeg="0"><text latex="true">\\text{Extruder}</text></zyObject><zyObject objNum="62" objType="image" objName="Arr rot" top="305px" left="76px" opacity="0" useConstrainedProportions="true" constrainedProportionsHeight="150" constrainedProportionsWidth="96" googleDriveFileID="15lT4eGo2tbDBxthGfxNwQriJvJgio-fZ" height="44px" width="28px" border-width="2px" border-color="transparent" lineType="none" transformDeg="0"></zyObject><zyObject objNum="64" objType="text" objName="N" top="110px" left="402px" opacity="0" color="black" font-weight="400" font-family="Arial" border-width="2px" lineType="none" transformDeg="0"><text latex="true">N</text></zyObject></zyObjects>\n<zyGroups></zyGroups>\n<zyInstructions><zyInstruction instrType="step1"><text>Plastic (or elastomer) pellets are fed into a single-screw extruder through the hopper.</text></zyInstruction><zyInstruction instrType="fade" objNum="59" timeLabel="0" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="60" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="61" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="52" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="51" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="50" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="55" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="3" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="3" timeLabel="0" top="216" left="153"></zyInstruction><zyInstruction instrType="fade" objNum="2" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="2" timeLabel="-" top="262" left="145"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="3" timeLabel="-" top="266" left="151"></zyInstruction><zyInstruction instrType="fade" objNum="46" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="47" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="step"><text>From the hopper, the pellets descend into the feed section, where the pellets are preheated while being pushed through the section by a turning screw.</text></zyInstruction><zyInstruction instrType="fade" objNum="6" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="3" timeLabel="-" opacity="0"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="2" timeLabel="-" top="273" left="144"></zyInstruction><zyInstruction instrType="fade" objNum="20" timeLabel="-" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="4" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="54" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="56" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="17" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="41" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="62" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="6" timeLabel="1" top="306" left="-180"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="8" timeLabel="-" top="303" left="186"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="11" timeLabel="-" top="308" left="-200"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="9" timeLabel="-" top="308" left="-180"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="67" timeLabel="-" top="345" left="143"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="2" timeLabel="-" top="274" left="144"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="11" timeLabel="0" top="308" left="-151"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="9" timeLabel="-" top="308" left="-131"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="6" timeLabel="-" top="306" left="-136"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="8" timeLabel="-" top="303" left="223"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="2" timeLabel="-" top="275" left="144"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="69" timeLabel="-" top="341" left="143"></zyInstruction><zyInstruction instrType="step"><text>The operation of the screw is defined by channel width \\((w_c)\\) and depth \\((d_c)\\), flight width \\((w_f)\\) and angle \\((A)\\), barrel diameter \\((D)\\), pitch \\((p)\\), and rotational speed \\((N)\\).</text></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="25" timeLabel="0" top="86" left="431"></zyInstruction><zyInstruction instrType="resize" easing="swing" objNum="25" timeLabel="-" height="97" width="131"></zyInstruction><zyInstruction instrType="fade" objNum="25" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="23" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="67" timeLabel="-" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="69" timeLabel="-" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="26" timeLabel="1" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="64" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="67" timeLabel="-" top="295" left="143"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="69" timeLabel="-" top="295" left="143"></zyInstruction><zyInstruction instrType="step"><text>In the compression section, the pellets melt, the molten polymeris compressed, and any excess air from between the pellets is extracted.</text></zyInstruction><zyInstruction instrType="fade" objNum="16" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="42" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="67" timeLabel="-" opacity="50"></zyInstruction><zyInstruction instrType="fade" objNum="69" timeLabel="-" opacity="50"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="6" timeLabel="0" top="306" left="-101"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="8" timeLabel="-" top="303" left="265"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="9" timeLabel="-" top="308" left="-87"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="11" timeLabel="-" top="308" left="-107"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="67" timeLabel="-" top="343" left="143"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="2" timeLabel="-" top="278" left="144"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="11" timeLabel="0" top="308" left="-63"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="9" timeLabel="-" top="308" left="-43"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="6" timeLabel="-" top="306" left="-65"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="8" timeLabel="-" top="303" left="307"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="2" timeLabel="-" top="280" left="144"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="69" timeLabel="-" top="343" left="143"></zyInstruction><zyInstruction instrType="fade" objNum="67" timeLabel="0" opacity="0"></zyInstruction><zyInstruction instrType="fade" objNum="69" timeLabel="-" opacity="0"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="67" timeLabel="0" top="296" left="143"></zyInstruction><zyInstruction instrType="move" easing="swing" objNum="69" timeLabel="-" top="296" left="143"></zyInstruction><zyInstruction instrType="step"><text>The polymer melt is pushed into the metering section, in which the melt is homogenized and pressurized.</text></zyInstruction><zyInstruction instrType="fade" objNum="18" timeLabel="0" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="43" timeLabel="-" opacity="100"></zyInstruction><zyInstruction instrType="fade" objNum="67" timeLabel="-" opacity="50"></zyInstruction><zyInstruction instrType="fade" objNum="69" timeLabel="-" opacity="50"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="6" timeLabel="0" top="306" left="-20"></zyInstruction><zyInstruction instrType="move" easing="linear" objNum="8" timeLabel="-" top="303" lef
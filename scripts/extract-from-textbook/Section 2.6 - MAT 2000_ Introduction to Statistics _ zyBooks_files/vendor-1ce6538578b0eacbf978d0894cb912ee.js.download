riables(expression, solution):\n\n    # Make list from a to y.\n    num_a = 97\n    num_z = 122\n    possible_variables = [chr(num) for num in range(num_a, num_z)]\n\n    # Pick 2 elements from list.\n    first_variable, second_variable = sorted(random.sample(possible_variables, 2))\n\n    return first_variable, second_variable, swap_variables(expression, first_variable, second_variable), swap_variables(solution, first_variable, second_variable)\n",language:"cpp",levels:[{files:[{content:[{editable:!1,template:"#include &lt;iostream&gt;\n#include &lt;cmath&gt;\n#include &lt;ios&gt;\n#include &lt;iomanip&gt;\nusing namespace std;\n\nint main() {\n   double ${distractor.first_variable};\n   double ${distractor.second_variable};\n   double z;\n\n   cin &gt;&gt; ${distractor.first_variable};\n   cin &gt;&gt; ${distractor.second_variable};\n"},{editable:!0,solution:"z = ${distractor.solution};",template:"\n   /* Your code goes here */\n"},{editable:!1,template:"\n   cout &lt;&lt; fixed &lt;&lt; setprecision(2); // This will output only 2 decimal places.\n   cout &lt;&lt; z &lt;&lt; endl;\n\n   return 0;\n}"}],input:!1,main:!0,name:"main.cpp"}],randomization:{test:"\n'''\nPerform test randomization.\nReturn a dictionary of values.\nThe values may be used as a parameter in &lt;tests&gt; tag.\n'''\ndef make_test_permutation(meaningful_permutation, distractor_permutation):\n    smaller_value, larger_value = sorted(random.sample(range(20, 31), 2))\n\n    first_value = smaller_value\n    second_value = larger_value\n    if meaningful_permutation['expression'] in expression_group_2:\n       first_value = larger_value\n       second_value = smaller_value\n\n    return {\n        'random_test': '{} {}'.format(first_value, second_value),\n    }\n         ",setup:"\nexpression_group_1 = ['\\\\sqrt{x + y}', 'x + \\\\sqrt{y}', 'x - \\\\sqrt{y}', '\\\\sqrt{y} - x', 'x * \\\\sqrt{y}', 'x / \\\\sqrt{y}', '\\\\sqrt{y} / x', 'x^y', '(x + y)^5', '(x - y)^5', '(y - x)^5', '(x * y)^5', '(x / y)^5', '(y / x)^5', 'y^x', '|x + y|', '|x - y|', '|y - x|', '|x * y|', '|x / y|', '|y / x|', 'x + |y|', 'x - |y|', '|y| - x', 'x * |x|', 'x / |y|', '|y| / x', 'y + |x|', 'y - |x|', '|x| - y', 'y * |x|', 'y / |x|', '|x| / y']\nexpression_group_2 = ['\\\\sqrt{x - y}', '\\\\sqrt{x * y}', '\\\\sqrt{x / y}', 'y + \\\\sqrt{x}', 'y - \\\\sqrt{x}', '\\\\sqrt{x} - y', 'y * \\\\sqrt{x}', 'y / \\\\sqrt{x}', '\\\\sqrt{x} / y']\nexpression_group_3 = ['\\\\sqrt{y - x}']\nexpressions = expression_group_1 + expression_group_2 + expression_group_3\n\nsolution_group_1 = ['sqrt(x + y)', 'x + sqrt(y)', 'x - sqrt(y)', 'sqrt(y) - x', 'x * sqrt(y)', 'x / sqrt(y)', 'sqrt(y) / x', 'pow(x, y)', 'pow(x + y, 5)', 'pow(x - y, 5)', 'pow(y - x, 5)', 'pow(x * y, 5)', 'pow(x / y, 5)', 'pow(y / x, 5)', 'pow(y, x)', 'fabs(x + y)', 'fabs(x - y)', 'fabs(y - x)', 'fabs(x * y)', 'fabs(x / y)', 'fabs(y / x)', 'x + fabs(y)', 'x - fabs(y)', 'fabs(y) - x', 'x * fabs(x)', 'x / fabs(y)', 'fabs(y) / x', 'y + fabs(x)', 'y - fabs(x)', 'fabs(x) - y', 'y * fabs(x)', 'y / fabs(x)', 'fabs(x) / y']\nsolution_group_2 = ['sqrt(x - y)', 'sqrt(x * y)', 'sqrt(x / y)', 'y + sqrt(x)', 'y - sqrt(x)', 'sqrt(x) - y', 'y * sqrt(x)', 'y / sqrt(x)', 'sqrt(x) / y']\nsolution_group_3 = ['sqrt(y - x)']\nsolutions = solution_group_1 + solution_group_2 + solution_group_3\n\ngroup_1_tests = ['4.0 6.0', '8.0 5.0', '-10.0 19.0']\ngroup_2_tests = ['6.0 4.0', '8.0 5.0', '19.0 10.0']\ngroup_3_tests = ['4.0 6.0', '5.0 8.0', '10.0 19.0']\n         ",meaningful:"\n'''\nPerform meaningful randomizations.\nReturn a dictionary of values.\nThe values may be used in distractor randomization, test randomization, and/or template parameters.\n'''\ndef make_meaningful_permutation():\n    expression = random.choice(expressions)\n    solution = solutions[expressions.index(expression)]\n\n    # Choose tests appropriate for each expression group.\n    tests = group_1_tests\n    if expression in expression_group_2:\n       tests = group_2_tests\n    elif expression in expression_group_3:\n       tests = group_3_tests\n\n    return {\n        'expression': expression,\n        'solution': solution,\n        'test1': tests[0],\n        'test2': tests[1],\n        'test3': tests[2],\n    }\n         ",distractor:"\n'''\nPerform distractor randomizations.\nReturn a dictionary of values.\nThe values may be used in test randomization and/or template parameters.\n'''\ndef make_distractor_permutation(meaningful_permutation):\n    first_variable, second_variable, expression, solution = randomize_variables(meaningful_permutation['expression'], meaningful_permutation['solution'])\n\n    return {\n        'expression': expression,\n        'solution': solution,\n        'first_variable': first_variable,\n        'second_variable': second_variable,\n    }\n         "},prompt:"Compute: \\\\( z = ${distractor.expression} \\\\)",explanation:null,tests:[{stdin:"${meaningful.test1}",args:null,out:{type:"std",value:null}},{stdin:"${meaningful.test2}",args:null,out:{type:"std",value:null}},{stdin:"${meaningful.test3}",args:null,out:{type:"std",value:null}},{stdin:"${test.random_test}",args:null,out:{type:"std",value:null}}]}]}},{name:"Multi-file Java",options:{global:"import random",language:"java",levels:[{explanation:null,files:[{content:[{editable:!1,solution:null,template:"import java.util.Scanner;\n\npublic class Runner {\n   public static void main (String[] args) {\n      BankAccount petersAccount = new BankAccount(10000);\n      BankAccount paulsAccount = new BankAccount(10000);\n      BankAccount marysAccount = new BankAccount(10000);\n      Scanner in = new Scanner(System.in);\n      double fee = in.nextDouble();\n      double amount = in.nextDouble();\n"},{editable:!0,solution:"      petersAccount.withdraw(amount + fee);\n      paulsAccount.deposit(amount + fee);\n      paulsAccount.withdraw(amount);\n      marysAccount.deposit(amount);",template:"\n      /* Your code goes here */\n"},{editable:!1,solution:null,template:"\n      System.out.println(petersAccount.getBalance());\n      System.out.println(paulsAccount.getBalance());\n      System.out.println(marysAccount.getBalance());\n   }\n}"}],input:!1,main:!0,name:"Runner.java"},{content:[{editable:!1,solution:null,template:"class BankAccount {\n   private double balance;\n   public BankAccount() {\n      balance = 0;\n   }\n   public BankAccount(double initialBalance) {\n      balance = initialBalance;\n   }\n   public void deposit(double amount) {\n      balance = balance + amount;\n   }\n   public void withdraw(double amount) {\n      balance = balance - amount;\n   }\n   public double getBalance() {\n      return balance;\n   }\n}"}],input:!1,main:!1,name:"BankAccount.java"}],prompt:"Write a program for the following situation. Peter wants to send $1000 to Mary, but he doesn't want her to know that he sent it. So he sends it to Paul first, who collects $10 for his trouble.",randomization:{distractor:"def make_distractor_permutation(meaningful_permutation):\n    return {}\n",meaningful:"def make_meaningful_permutation():\n    return {}",setup:null,test:"def make_test_permutation(meaningful_permutation, distractor_permutation):\n    return {}"},tests:[{args:null,out:{type:"std",value:null},stdin:"10 1000"},{args:null,out:{type:"std",value:null},stdin:"35 2000"}]}]}},{name:"1 level. No randomization.",options:{global:"import random",language:"cpp",isRandomized:!1,levels:[{files:[{content:[{editable:!1,template:"#include &lt;iostream&gt;\nusing namespace std;\n\nint main() {\n"},{editable:!0,solution:'cout &lt;&lt; "Hello world" &lt;&lt; endl;',template:"\n   /* Your code goes here */\n"},{editable:!1,template:"\n   return 0;\n}"}],input:!1,main:!0,name:"main.cpp"}],randomization:{test:"def make_test_permutation(meaningful_permutation, distractor_permutation):\n    return {}",setup:"",meaningful:"def make_meaningful_permutation():\n    return {}",distractor:"def make_distractor_permutation(meaningful_permutation):\n    return {}"},promp
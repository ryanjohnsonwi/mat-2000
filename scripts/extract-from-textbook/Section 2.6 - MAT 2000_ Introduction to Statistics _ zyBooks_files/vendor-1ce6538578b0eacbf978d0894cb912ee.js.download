 Skulpt")\n',"src/lib/unittest/gui.py":"import document\nfrom unittest import TestCase\n\nclass TestCaseGui(TestCase):\n     def __init__(self):\n          TestCase.__init__(self)\n          self.divid = document.currentDiv()\n          self.mydiv = document.getElementById(self.divid)\n          res = document.getElementById(self.divid+'_unit_results')\n          if res:\n              self.resdiv = res\n              res.innerHTML = ''\n          else:\n              self.resdiv = document.createElement('div')\n              self.resdiv.setAttribute('id',self.divid+'_unit_results')\n              self.resdiv.setAttribute('class','unittest-results')\n              self.mydiv.appendChild(self.resdiv)\n\n\n     def main(self):\n         t = document.createElement('table')\n         self.resTable = t\n         self.resdiv.appendChild(self.resTable)\n\n         headers = ['Result','Actual Value','Expected Value','Notes']\n         row = document.createElement('tr')\n         for item in headers:\n             head = document.createElement('th')\n             head.setAttribute('class','ac-feedback')\n             head.innerHTML = item\n             head.setCSS('text-align','center')\n             row.appendChild(head)\n         self.resTable.appendChild(row)\n\n         for func in self.tlist:\n             try:\n                 self.setUp()\n                 func()\n                 self.tearDown()\n             except Exception as e:\n                 self.appendResult('Error', None, None, e)\n                 self.numFailed += 1\n                 self.showSummary()\n\n     def appendResult(self,res,actual,expected,param):\n         trimActual = False\n         if len(str(actual)) > 15:\n             trimActual = True\n             actualType = type(actual)\n         trimExpected = False\n         if len(str(expected)) > 15:\n             trimExpected = True\n             expectedType = type(expected)\n         row = document.createElement('tr')\n         err = False\n         if res == 'Error':\n             err = True\n             msg = 'Error: %s' % param\n             errorData = document.createElement('td')\n             errorData.setAttribute('class','ac-feedback')\n             errorData.innerHTML = 'ERROR'\n             errorData.setCSS('background-color','#de8e96')\n             errorData.setCSS('text-align','center')\n             row.appendChild(errorData)\n         elif res:\n             passed = document.createElement('td')\n             passed.setAttribute('class','ac-feedback')\n             passed.innerHTML = 'Pass'\n             passed.setCSS('background-color','#83d382')\n             passed.setCSS('text-align','center')\n             row.appendChild(passed)\n             self.numPassed += 1\n         else:\n             fail = document.createElement('td')\n             fail.setAttribute('class','ac-feedback')\n             fail.innerHTML = 'Fail'\n             fail.setCSS('background-color','#de8e96')\n             fail.setCSS('text-align','center')\n             row.appendChild(fail)\n             self.numFailed += 1\n\n\n         act = document.createElement('td')\n         act.setAttribute('class','ac-feedback')\n         if trimActual:\n             actHTML = str(actual)[:5] + \"...\" + str(actual)[-5:]\n             if actualType == str:\n                 actHTML = repr(actHTML)\n             act.innerHTML = actHTML\n         else:\n             act.innerHTML = repr(actual)\n         act.setCSS('text-align','center')\n         row.appendChild(act)\n\n         expect = document.createElement('td')\n         expect.setAttribute('class','ac-feedback')\n\n         if trimExpected:\n             expectedHTML = str(expected)[:5] + \"...\" + str(expected)[-5:]\n             if expectedType == str:\n                 expectedHTML = repr(expectedHTML)\n             expect.innerHTML = expectedHTML\n         else:\n             expect.innerHTML = repr(expected)\n         expect.setCSS('text-align','center')\n         row.appendChild(expect)\n         inp = document.createElement('td')\n         inp.setAttribute('class','ac-feedback')\n\n         if err:\n             inp.innerHTML = msg\n         else:\n             inp.innerHTML = param\n         inp.setCSS('text-align','center')\n         row.appendChild(inp)\n         self.resTable.appendChild(row)\n\n\n     def showSummary(self):\n         pct = self.numPassed / (self.numPassed+self.numFailed) * 100\n         pTag = document.createElement('p')\n         pTag.innerHTML = \"You passed: \" + str(pct) + \"% of the tests\"\n         self.resdiv.appendChild(pTag)\n","src/lib/os.py":'raise NotImplementedError("os is not yet implemented in Skulpt")\n',"src/lib/pythonds/basic/__init__.py":'\n#__all__ = ["stack"]\n\n\n#from .stack import Stack\n#from .queue import Queue\n\n\n\n',"src/lib/audiodev.py":'raise NotImplementedError("audiodev is not yet implemented in Skulpt")\n',"src/lib/locale.py":'raise NotImplementedError("locale is not yet implemented in Skulpt")\n',"src/lib/getopt.py":'raise NotImplementedError("getopt is not yet implemented in Skulpt")\n',"src/lib/CGIHTTPServer.py":'raise NotImplementedError("CGIHTTPServer is not yet implemented in Skulpt")\n',"src/lib/stringprep.py":'raise NotImplementedError("stringprep is not yet implemented in Skulpt")\n',"src/lib/sre_parse.py":'raise NotImplementedError("sre_parse is not yet implemented in Skulpt")\n',"src/lib/httplib.py":'raise NotImplementedError("httplib is not yet implemented in Skulpt")\n',"src/lib/multifile.py":'raise NotImplementedError("multifile is not yet implemented in Skulpt")\n',"src/lib/pythonds/graphs/priorityQueue.py":"# Bradley N. Miller, David L. Ranum\n# Introduction to Data Structures and Algorithms in Python\n# Copyright 2005\n# \nimport unittest\n\n# this implementation of binary heap takes key value pairs,\n# we will assume that the keys are all comparable\n\nclass PriorityQueue:\n    def __init__(self):\n        self.heapArray = [(0,0)]\n        self.currentSize = 0\n\n    def buildHeap(self,alist):\n        self.currentSize = len(alist)\n        self.heapArray = [(0,0)]\n        for i in alist:\n            self.heapArray.append(i)\n        i = len(alist) // 2            \n        while (i > 0):\n            self.percDown(i)\n            i = i - 1\n                        \n    def percDown(self,i):\n        while (i * 2) <= self.currentSize:\n            mc = self.minChild(i)\n            if self.heapArray[i][0] > self.heapArray[mc][0]:\n                tmp = self.heapArray[i]\n                self.heapArray[i] = self.heapArray[mc]\n                self.heapArray[mc] = tmp\n            i = mc\n                \n    def minChild(self,i):\n        if i*2 > self.currentSize:\n            return -1\n        else:\n            if i*2 + 1 > self.currentSize:\n                return i*2\n            else:\n                if self.heapArray[i*2][0] < self.heapArray[i*2+1][0]:\n                    return i*2\n                else:\n                    return i*2+1\n\n    def percUp(self,i):\n        while i // 2 > 0:\n            if self.heapArray[i][0] < self.heapArray[i//2][0]:\n               tmp = self.heapArray[i//2]\n               self.heapArray[i//2] = self.heapArray[i]\n               self.heapArray[i] = tmp\n            i = i//2\n \n    def add(self,k):\n        self.heapArray.append(k)\n        self.currentSize = self.currentSize + 1\n        self.percUp(self.currentSize)\n\n    def delMin(self):\n        retval = self.heapArray[1][1]\n        self.heapArray[1] = self.heapArray[self.currentSize]\n        self.currentSize = self.currentSize - 1\n        self.heapArray.pop()\n        self.percDown(1)\n        return retval\n        \n    def isEmpty(self):\n        if self.currentSize == 0:\n            return True\n        else:\n            return False\n\n    def decreaseKey(self,val,amt):\n        # this is a little wierd, but we need to find the heap thing to decrease by\n        # looking at its value\n        done = False\n        i = 1\n        myKey = 0\n        while not done and i <= self.currentSize:\n            if self.heapArray[i][1] == val:\n                done = True\n                myKey = i\n            else:\n                i = i + 1\n        if myKey > 0:\n            self.heapArray[myKey] = (amt,self.heapArray[myKey][1])\n            self.percUp(myKey)\n            \n    def __contains__(self,vtx):\n        for pair in self.heapArray:\n            if pair[1] == vtx:\n                return True\n        return False\n        \nclass TestBinHeap(unittest.TestCase):\n    def setUp(self):\n        self.theHeap = PriorityQueue()\n        self.theHeap.add((2,'x'))\n        self.theHeap.add((3,'y'))\n        self.theHeap.add((5,'z'))\n        self.theHeap.add((6,'a'))\n        self.theHeap.add((4,'d'))\n\n\n    def testInsert(self):\n        assert self.theHeap.currentSize == 5\n\n    def testDelmin(self):\n        assert self.theHeap.delMin() == 'x'\n        assert self.theHeap.delMin() == 'y'\n    \n    def testDecKey(self):\n        self.theHeap.decreaseKey('d',1)\n        assert self.theHeap.delMin() == 'd'\n        \nif __name__ == '__main__':\n    unittest.main()\n","src/lib/idlelib/Icons/__init__.py":'raise NotImplementedError("Icons is not yet implemented in Skulpt")\n',"src/lib/tempfile.py":'raise NotImplementedError("tempfile is not yet implemented in Skulpt")\n',"src/lib/sre.py":'raise NotImplementedError("sre is not yet implemented in Skulpt")\n',"src/lib/email/test/data/__init__.py":'raise NotImplementedError("data is not yet implemented in Skulpt")\n',"src/lib/htmlentitydefs.py":'raise NotImplementedError("htmlentitydefs is not yet implemented in Skulpt")\n',"src/lib/pty.py":'raise NotImplementedError("pty is not yet implemented in Skulpt")\n',"src/lib/cgitb.py":'raise NotImplementedError("cgitb is not yet implemented in Skulpt")\n',"src/lib/statvfs.py":'raise NotImplementedError("statvfs is not yet implemented in Skulpt")\n',"src/lib/dumbdbm.py":'raise NotImplementedError("dumbdbm is not yet implemented in Skulpt")\n',"src/lib/chunk.py":'raise NotImplementedError("chunk is not yet implemented in Skulpt")\n',"src/lib/ctypes/macholib/__init__.py":'raise NotImplementedError("macholib is not yet implemented in Skulpt")\n',"src/lib/linecache.py":'raise NotImplementedError("linecache is not yet implemented in Skulpt")\n',"src/lib/zyversions/__init__.py":"from common_functions import pick_from, pick_from_range, scientific_notation\nfrom math import floor, log10\nimport re\n\n\ndef placeholder_is_possible_answer(placeholder, answer, tolerance, absolute_tolerance=False):\n    '''Checks to see if a placeholder is potentially a correct answer by performing\n    calculations using the tolerance parameter and the numerical value of the answer\n    parameter. If the placeholder parameter is within the range, then we return True\n    signifying that the placeholder is potentially an answer and cannot be used.'''\n    if answer == 0 and placeholder == 0 and absolute_tolerance is False:\n        return True\n\n    if absolute_tolerance:\n        min_acceptable_answer = answer - tolerance\n        max_acceptable_answer = answer + tolerance\n    else:\n        tolerance *= 0.01\n        min_acceptable_answer = answer * (1 - tolerance)\n        max_acceptable_answer = answer * (1 + tolerance)\n    if placeholder >= min_acceptable_answer and placeholder <= max_acceptable_answer:\n        return True\n\n    return False\n\n\ndef build_placeholder(answer, tolerance, trailing_zeroes_are_significant=True, absolute_tolerance=False, significant_figs=None):\n    # Strip out any commas before working on the given answer.\n    if ',' in answer:\n        answer = answer.replace(',', '')\n    \n    try:\n        float(answer)\n    except ValueError:\n        raise ValueError('Answer parameter provided to build_placeholder() function cannot be '\n                         'converted to a float')\n\n    def _build_tolerance_error_msg():\n        error_msg = 'Exhausted all patterns without being able to avoid a placeholder that\\'s a possible answer. '\n        if absolute_tolerance:\n            lower_range = float(answer) - tolerance\n            upper_range = float(answer) + tolerance\n            error_msg += 'The absolute tolerance might be causing the range of correct answers to '\n            error_msg += 'span the entire numerical range that matches the answer\\'s formatting. Check the following values '\n            error_msg += 'and consider adjusting the tolerance:'\n            error_msg += '\\nAcceptable Answer Range: {} to {}.\\nAnswer: {}\\n'.format(lower_range, upper_range, answer)\n            error_msg += 'Tolerance: +/- {}\\n'.format(tolerance)\n        else:\n            lower_range = float(answer) * (1 - (tolerance * .01))\n            upper_range = float(answer) * (1 + (tolerance * .01))\n            error_msg += 'The percentage tolerance might be causing the range of correct answers to '\n            error_msg += 'span the entire numerical range that matches the answer\\'s formatting. Check the following values '\n            error_msg += 'and consider adjusting the tolerance:'\n            error_msg += '\\nAcceptable Answer Range: {} to {}.\\nAnswer: {}\\nTolerance: {}'.format(lower_range, upper_range, answer, tolerance)\n            error_msg += '%\\n'\n        return error_msg\n\n    def _finalize_placeholder(temp_placeholder, pattern):\n        '''Replaces all instances of # in temp_placeholder by following a sequence\n        defined in the pattern parameter. The pattern is just a string containing\n        some arbitrary sequence of numbers. The function will loop through the pattern\n        if the end of the string is reached before replacing all instances of #.'''\n        i = 0\n        while '#' in temp_placeholder:\n            temp_placeholder = temp_placeholder.replace('#', pattern[i % len(pattern)], 1)\n            i += 1\n\n        return temp_placeholder\n\n    def _rsplit(original_string, separator, maxsplit):\n        '''Split strings from the right, rather than the left. This mimics how rsplit()\n        works in newer versions of python.'''\n        # Reverse the string\n        original_string = original_string[::-1]\n\n        # Split the reversed string\n        split = original_string.split(separator, maxsplit)\n\n        # Reverse all strings contained in the split,\n        # so that they are no longer reversed.\n        for index, reversed_string in enumerate(split):\n            split[index] = reversed_string[::-1]\n\n        # Finally return a reversed version of the list\n        split.reverse()\n        return split\n\n    if type(answer) is not str:\n        raise TypeError('Only strings can be used with the build_placeholder() function\\'s answer'\n                        'parameter')\n    if type(tolerance) not in [int, float]:\n        raise TypeError('Only integers or floats can be used with the build_placeholder() function\\'s'\n                        'tolerance parameter.')\n\n    # Strip out any negative signs, as we don't use negative signs in placeholders.\n    if answer[0] == '-':\n        answer = answer[1:]\n\n    if len(answer) > 1 and answer[0] == '0':\n        if answer[0] == '0' and answer[1] != '.':\n            raise ValueError('Your answer has multiple leading zeroes in the whole number portion. '\n                             'Unable to build placeholder')\n    if 'e' in answer.lower():\n        raise ValueError('Your answer is in the \"E\" format. If you are converting a float to a '\n                         'string, use string formatting instead of type conversion.')\n\n    # Handle the case when the answer is just 0.\n    if answer == '0':\n        if absolute_tolerance:\n            patterns = ['1', '2', '3', '4', '5', '6', '7', '8', '9']\n            placeholder = answer\n            while placeholder_is_possible_answer(float(placeholder), float(answer), tolerance, absolute_tolerance) and patterns:\n                pattern = pick_from(patterns)\n                patterns.remove(pattern)\n                placeholder = _finalize_placeholder('#', pattern)\n\n            if not patterns:\n                raise ValueError(_build_tolerance_error_msg())\n\n            return placeholder\n        else:\n            return str(pick_from_range(1, 9))\n\n    # Handle when answer is some form of 0.0, and trailing zeros are not significant.\n    if float(answer) == 0 and trailing_zeroes_are_significant is False:\n        return str(pick_from_range(1, 9)) + answer[1:]\n    \n    # Initialize a list of patterns and choose one that we'll initially attempt to use.\n    # Also create a variable that will contain the temporary placeholder.\n    patterns = ['123456789', '2468', '987654321', '1', '2', '3', '4', '5', '6', '7', '8', '9']\n    pattern = pick_from(patterns)\n    patterns.remove(pattern)\n    temp_placeholder = ''\n    avoidance_index = 0\n\n    # If we're building a placeholder for an answer that's a decimal value.\n    if '.' in answer:\n        whole_number_part, decimals = answer.split('.')\n        leading_zeroes = re.search(r'^0+', decimals)\n\n        if whole_number_part == '0':\n            temp_placeholder += '0'\n            \n            # Set avoidance index to 2 in order to avoid matching similar patterns\n            avoidance_index = 2\n        else:\n            for char in whole_number_part:\n                temp_placeholder += '#'\n\n        temp_placeholder += '.'\n\n        if leading_zeroes is not None and (whole_number_part == '0' or whole_number_part == ''):\n            leading_zeroes = leading_zeroes.group(0)\n\n            # If we only have zeroes in the decimal portion.\n            if leading_zeroes == decimals and trailing_zeroes_are_significant is True:\n                for char in decimals:\n                    temp_placeholder += '#'\n\n                decimals = None\n            else:\n                temp_placeholder += leading_zeroes\n                decimals = decimals.split(leading_zeroes, 1)[1]\n\n        if decimals is not None:\n            trailing_zeroes = re.search(r'0+$',  decimals)\n            if trailing_zeroes is not None and trailing_zeroes_are_significant is False:\n                trailing_zeroes = trailing_zeroes.group(0)\n                decimals = _rsplit(decimals, trailing_zeroes, 1)[0]\n                for char in decimals:\n                    temp_placeholder += '#'\n\n                temp_placeholder += trailing_zeroes\n            else:\n                for char in decimals:\n                    temp_placeholder += '#'\n\n    # If we're building a placeholder for an answer that's a whole number.\n    else:\n        trailing_zeroes = None\n        answer_no_trailing_zeroes = None\n        if trailing_zeroes_are_significant is False:\n            trailing_zeroes = re.search(r'0+$', answer)\n            if trailing_zeroes is not None:\n                trailing_zeroes = trailing_zeroes.group(0)\n                answer_no_trailing_zeroes = _rsplit(answer, trailing_zeroes, 1)[0]\n\n        num_hashes = len(answer_no_trailing_zeroes or answer)\n        temp_placeholder += '#' * num_hashes\n\n        if trailing_zeroes:\n            temp_placeholder += trailing_zeroes\n\n    if significant_figs is not None and trailing_zeroes_are_significant is False:\n        if type(significant_figs) is not int:\n            raise TypeError('Only integers can be used with the build_placeholder() function\\'s'\n                            'significant_figs parameter.')\n                            \n        if significant_figs <= 0:\n            raise ValueError('The build_placeholder() function\\'s significant_figs parameter cannot be less than or equal to 0.')\n            \n        count = temp_placeholder.count('#')\n        if count > significant_figs:\n            last_hash_index = [i for i, char in enumerate(temp_placeholder) if char == '#'][significant_figs:]\n            for index in last_hash_index:\n                temp_placeholder = temp_placeholder[:index] + '0' + temp_placeholder[index + 1:]\n        elif count < significant_figs:\n            first_zero_index = [i for i, char in enumerate(temp_placeholder) if char == '0'][:significant_figs - count]\n            for index in first_zero_index:\n                temp_placeholder = temp_placeholder[:index] + '#' + temp_placeholder[index + 1:]\n\n    placeholder = _finalize_placeholder(temp_placeholder, pattern)\n    \n    # Last condition checks if the first value in the pattern would match the first non-zero number of the answer.\n    while placeholder_is_possible_answer(float(placeholder), float(answer), tolerance, absolute_tolerance) and patterns or (pattern[0] is answer[avoidance_index]):\n        pattern = pick_from(patterns)\n        patterns.remove(pattern)\n        placeholder = _finalize_placeholder(temp_placeholder, pattern)\n\n    if not patterns:\n        raise ValueError(_build_tolerance_error_msg())\n\n    return placeholder\n  \n\ndef zyv_sig_fig_round(num_to_round, sig_figs):\n    '''\n    Takes in a number and rounds it to a specified\n    number of significant figures\n    '''\n\n    def convert_sig_fig_to_round(digits, sig_figs):\n        '''Used to calculate digit to round to with pythons round() function'''\n        return sig_figs - len(digits)\n\n    def float_to_str(float_val):\n        '''\n        Used when the input is a float with such a small value that python\n        formats it using scientific notation. This converts those\n        scientific notation floats into strings, while getting rid of the\n        scientific notation formatting.\n        '''\n        float_string = str(float_val)\n        number, exp = float_string.split('e')\n        number = number.replace('.', '').replace('-', '')\n        exp = int(exp)\n        zero = '0' * (abs(int(exp)) - 1)\n        sign = '-' if float_val < 0 else ''\n        if exp > 0:\n            float_string = '{}{}{}.0'.format(sign, number, zero)\n        else:\n            float_string = '{}0.{}{}'.format(sign, zero, number)\n        return float_string\n        \n    def check_final_answer(answer):\n        '''\n        Used as a last case check to make sure len of answer is equal to \n        sig figs\n        '''\n        final_answer = answer\n\n        if '.' in answer:\n            whole_number, decimal = answer.split('.')\n            num_trailing_zeros = sig_figs - len(whole_number) - len(decimal)\n\n            if num_trailing_zeros > 0:\n                final_answer = whole_number + '.' + decimal + ('0' * num_trailing_zeros)\n\n        return final_answer\n\n    def conditionally_return_negative(answer):\n        '''\n        Used to return the input with a negative sign\n        if negative_flag is true\n        '''\n        answer = check_final_answer(answer)\n        if negative_flag:\n            return '-' + answer\n        else:\n            return answer\n\n    def int_round_to_string(num_to_round, sig_figs):\n        '''\n        This takes input as string converts to int then\n        rounds to sig_figs and converts back to string\n        '''\n        return str(round(int(num_to_round), sig_figs))\n\n    def round_decimal_number(num_to_round, sig_figs):\n        '''\n        This takes input as string converts to int then rounds\n        to sig_figs and converts back to string and sends to\n        conditionally_return_negative function\n        '''\n        float_num = float(num_to_round)\n        rounded_num_temp = round(float_num, sig_figs)\n        string_conversion = str(rounded_num_temp)\n        return conditionally_return_negative(string_conversion)\n\n    def round_whole_number(num_to_round, sig_figs=0):\n        '''\n        Rounds a whole number to specified amount of significant figures,\n        adding a '-' if negative_flag is set.\n        '''\n        float_num = float(num_to_round)\n        rounded_num_temp = round(float_num, sig_figs)\n        string_int_conversion = str(int(rounded_num_temp))\n        return conditionally_return_negative(string_int_conversion)\n\n    # Initialize variables\n    negative_flag = False\n    rounded_num = ''\n\n    # Check for errors\n    if type(sig_figs) is not int:\n        raise TypeError('Error: sig fig input must be int')\n    if sig_figs < 1:\n        raise ValueError('Error: sig_fig value cannot be less than 1')\n\n    # Handles case when input is just 0\n    if num_to_round == 0 or num_to_round == '0':\n        return '0'\n\n    # Convert num_to_round to a string if it is not already a string.\n    # If num_to_round is in scientific notation, use float_to_str()\n    # function to convert.\n    if type(num_to_round) is float and 'e' in str(num_to_round):\n        num_to_round = float_to_str(num_to_round)\n    if type(num_to_round) is not str:\n        num_to_round = str(num_to_round)\n\n    # Handle cases where num_to_round is a whole number\n    if '.' not in num_to_round:\n        leading_zeroes_whole = re.search(r'^0+', num_to_round)\n\n        if leading_zeroes_whole is not None:\n            raise ValueError('Error: Leading zeros in whole number')\n\n        # If num_to_round is a negative whole number\n        if num_to_round.isnumeric() is False and num_to_round[0] == '-' and num_to_round[1:len(num_to_round)].isnumeric():\n            if sig_figs <= len(num_to_round) - 1:\n                rounded_num = int_round_to_string(num_to_round, sig_figs - len(num_to_round) + 1)\n            else:\n                return num_to_round + '.' + '0' * (sig_figs - len(num_to_round) + 1)\n        elif num_to_round.isnumeric() is False:\n            raise TypeError('Error: input not numeric')\n        elif sig_figs > len(num_to_round):\n            rounded_num = num_to_round + '.' + '0' * (sig_figs - len(num_to_round))\n        else:\n            rounded_num = int_round_to_string(num_to_round, convert_sig_fig_to_round(num_to_round, sig_figs))\n\n    # Handle the cases when num contains a '.' aka is not a whole number\n    else:\n        whole_number, decimal = num_to_round.split('.')\n        # If whole_number exists, check to see if it is negative.\n        # If whole_number is negative, strip the negative sign\n        # so that we can use the isnumeric() function, and\n        # set the negative_flag to True.\n        if whole_number:\n            if whole_number[0] == '-':\n                whole_number = whole_number[1:]\n                num_to_round = num_to_round[1:]\n                negative_flag = True\n            if whole_number.isnumeric() is False:\n                raise TypeError('Error: input not numeric')\n\n        # Check if decimal exists. Then raise\n        # a TypeError if it is not a number.\n        if decimal:\n            if decimal.isnumeric() is False:\n                raise TypeError('Error: input not numeric')\n            \n        # This covers case when you have a number\n        # in to the left of the period but no\n        # number to the right of the period\n        if not decimal:\n            rounded_num = whole_number[0: sig_figs] + '.'\n        else:\n            # This checks if sig fig length is equal to the\n            # whole number and if so returns round as an int\n            if len(whole_number) == sig_figs and float(whole_number) != 0:\n                rounded_num = round_whole_number(num_to_round)\n            # This checks if sig fig length is less than the\n            # whole number and if so returns round as an int\n            elif sig_figs < len(whole_number):\n                round_to = convert_sig_fig_to_round(whole_number, sig_figs)\n                rounded_num = round_whole_number(num_to_round, round_to)\n            # This checks if sig fig length is greater than\n            # whole_number + decimal and if so adds zero and returns\n            elif (sig_figs > len(whole_number) + len(decimal)) and len(whole_number) != 0 and float(whole_number) != 0:\n                rounded_num = whole_number + '.' + decimal\n                rounded_num += ('0' * (sig_figs - (len(whole_number) + len(decimal))))\n                rounded_num = conditionally_return_negative(rounded_num)\n\n            # This handles all decimal numbers smaller than 1\n            else:\n                if not whole_number or whole_number == '0':\n                    leading_zeroes_decimal = re.search(r'^0+', decimal)\n\n                    if leading_zeroes_decimal is not None:\n                        if float(decimal) == 0:\n                            return '0'\n                        leading_zeroes_decimal_size = 0\n                        decimal_part = decimal\n                        while (decimal_part[0] == '0'):\n                            leading_zeroes_decimal_size += 1\n                            decimal_part = decimal_part[1:]\n                        if sig_figs <= len(decimal_part):\n                            num_to_round_to = convert_sig_fig_to_round(decimal_part, sig_figs)\n                            answer = int_round_to_string(decimal_part, num_to_round_to)\n                            trailing_nines_answer = re.search(r'9+$', answer)\n                            if(trailing_nines_answer is not None):\n                                answer = str(int(answer) + 1)\n                            answer = answer[0: sig_figs]\n                            rounded_num = '0.' + leading_zeroes_decimal.group(0) + answer\n                            rounded_num = conditionally_return_negative(rounded_num)\n                        # This checks if sig figs required is larger than\n                        # current sig_figs in input and if so\n                        # just adds required zeros to the end\n                        else:\n                            rounded_num = '0.' + leading_zeroes_decimal.group(0) + decimal_part\n                            rounded_num += ('0' * (sig_figs-len(decimal_part)))\n                            rounded_num = conditionally_return_negative(rounded_num)\n                    else:\n                        if sig_figs > len(decimal):\n                            rounded_num = '0.'+ decimal\n                            rounded_num += ('0' * (sig_figs-len(decimal)))\n                            rounded_num = conditionally_return_negative(rounded_num)\n                        else:\n                            rounded_num = round_decimal_number(num_to_round, sig_figs)\n                            if len(rounded_num) - 2 < sig_figs:\n                                rounded_num += ('0' * (2 - len(rounded_num) + sig_figs))\n\n                else:\n                    trailing_zeroes_decimal = re.search(r'0+$', decimal)\n                    trailing_nines_decimal = re.search(r'9+$', decimal)\n                    num_to_round_to = sig_figs - len(whole_number)\n                    whole_number_size = len(whole_number)\n                    decimal_size = len(decimal)\n                    # This covers case when you have numbers larger\n                    # than 0 ending with multiple 0's\n                    if trailing_zeroes_decimal is not None:\n                        if (whole_number_size + decimal_size) - sig_figs <= len(trailing_zeroes_decimal.group(0)):\n                            rounded_num = whole_number + '.' + decimal[0:num_to_round_to]\n                            rounded_num = conditionally_return_negative(rounded_num)\n                        else:\n                            rounded_num = round_decimal_number(num_to_round, num_to_round_to)\n                    # This covers case when you have numbers ending\n                    # with multiple 9's, without this case\n                    # python would just round up\n                    elif trailing_nines_decimal is not None:\n                        if (whole_number_size + decimal_size) - sig_figs < len(trailing_nines_decimal.group(0)):\n                            index = sig_figs - whole_number_size\n                            rounded_num = whole_number + '.' + decimal[0: index]\n                            rounded_num = conditionally_return_negative(rounded_num)\n                        else:\n                            rounded_num = round_decimal_number(num_to_round, num_to_round_to)\n                    # This covers all other 'regular' decimal cases\n                    else:\n                        rounded_num = round_decimal_number(num_to_round, num_to_round_to)\n                        if (len(rounded_num)-1) < sig_figs:\n                            rounded_num += ('0' * (sig_figs-(len(rounded_num)-1)))\n\n    return rounded_num\n\ndef isAllNums(list):\n    ## https://stackoverflow.com/questions/13252333/check-if-all-elements-of-a-list-are-of-the-same-type\n    return all(isinstance(x, (int, float)) for x in list)\n\ndef find_closest_indices(list_to_search, num_to_search):\n    '''\n    Takes in a list and a number and returns the list indices that are next largest and \n    next smallest from the provided number. If the provided number is within the list, returns\n    the index twice.\n    \n    Arguments:\n    list_to_search must be a sorted list of ints or floats of length 2 or greater, with no duplicates\n    num_to_search must be an int or float with a value between the minimum and maximum of list_to_search\n    '''\n    i = None\n    j = None\n    list_to_search_sorted = list(set(list_to_search)) # Converting list->set->list removes duplicates and sorts\n    isasc = all(list_to_search[i] < list_to_search[i+1] for i in range(len(list_to_search) - 1))\n    isdesc = all(list_to_search[i] > list_to_search[i+1] for i in range(len(list_to_search) - 1))\n    \n    if type(num_to_search) not in [int, float]:\n        raise TypeError(\"Only integers or floats can be used with the find_closest_indices() function\\'s num_to_search parameter\")\n\n    if type(list_to_search) is not list or len(list_to_search) < 2 or not isAllNums(list_to_search):\n        raise TypeError(\"Only lists of length larger than 1 can be used with the find_closest_indices() function\\'s list_to_search parameter\")\n    \n    if len(list_to_search_sorted) < len(list_to_search):\n        raise Exception(\"Only lists without duplicates can be used with the find_closest_indices() function\\'s list_to_search parameter.\")\n        \n    if not isasc and not isdesc:\n        raise Exception(\"Only sorted lists can be used with the find_closest_indices() function\\'s list_to_search parameter.\")\n\n    if isasc and (num_to_search < list_to_search[0] or num_to_search > list_to_search[-1]):\n            raise ValueError(\"Your num_to_search parameter within the find_closest_indices() functions is out of range of the provided list\")\n        \n    if isdesc and (num_to_search > list_to_search[0] or num_to_search < list_to_search[-1]):\n            raise ValueError(\"Your num_to_search parameter within the find_closest_indices() functions is out of range of the provided list\")\n\n\n    if num_to_search in list_to_search:\n        i = j = list_to_search.index(num_to_search)\n    elif isdesc:\n        for index, val in enumerate(list_to_search):\n            if num_to_search < val:\n                i = index\n                j = index + 1\n    else:\n        for index, val in enumerate(list_to_search):\n            if num_to_search > val:\n                i = index\n                j = index + 1\n    return i, j\n\ndef convert_to_scinot(num_to_convert, num_to_round = 3):\n    '''\n    Takes in a number (Must be either float or int) and converts it to scientific notation, returning two string variables, \n    the left hand side and the exponent in that order. Optionally can also input a number to round left hand side to (must be an int).\n    Used this calculator to verify results:\n    https://www.calculator.net/scientific-notation-calculator.html\n    '''\n    if type(num_to_convert) not in [int, float, long]:\n        raise TypeError(\"Only integers or floats can be used with the convert_to_scinot() function's num_to_convert parameter\")\n\n    if type(num_to_round) is not int:\n        raise TypeError(\"Only integers can be used with the convert_to_scinot() function's num_to_round parameter\")\n\n    if num_to_round < 0:\n        raise ValueError(\"Only integers larger than 0 can be used with the convert_to_scinot() function's num_to_round parameter\")\n        \n    sci_not = scientific_notation(num_to_convert, num_to_round)\n    lhs, exp = sci_not.split('E')\n    if exp[0] == '+':\n        exp = exp[1:]\n    return lhs, exp\n\ndef linear_interpolation(list1, list2, index1, index2, num_to_find):\n    '''\n    Takes in two lists, two integer indexes, and a integer or float number to do linear interploation. Returns a float.\n    Used this calculator to verify results:\n    https://www.johndcook.com/interpolator.html\n    '''\n    if type(list1) is not list or type(list2) is not list or len(list1) < 2 or len(list2) < 2:\n        raise TypeError(\"Only lists of length larger than 1 can be used with the linear_interpolation() function\\'s list1 and list2 parameters\")\n\n    if not isAllNums(list1) or not isAllNums(list2):\n        raise TypeError(\"Only lists of integers or floats can be used with the linear_interpolation() function\\'s list1 and list2 parameters\")\n\n    if type(index1) is not int or type(index2) is not int:\n        raise TypeError(\"Only integers can be used with the linear_interpolation() functions\\'s index1 and index2 parameters\")\n\n    if index1 < 0 or index2 < 0:\n        raise TypeError(\"Only positive integers can be used with the linear_interpolation() functions\\'s index1 and index2 parameters\")\n\n    if type(num_to_find) not in [int, float]:\n        raise TypeError(\"Only integers or floats can be used with the linear_interpolation() functions\\'s num_to_find parameter\")\n\n    if index2 == index1:\n        return list2[index1]\n\n    return (num_to_find - list1[index1]) * ((list2[index2] - list2[index1]) / (list1[index2] - list1[index1])) + list2[index1]\n\ndef linear_interpolation_complete(list1, list2, num_to_find):\n    '''\n    Takes in two lists and a integer or float number to do linear interploation. Returns a float.\n    Used this calculator to verify results:\n    https://www.johndcook.com/interpolator.html\n    '''\n    index1, index2 = find_closest_indices(list1, num_to_find)\n    return linear_interpolation(list1, list2, index1, index2, num_to_find)\n","src/lib/math.js":'var $builtinmodule = function (name) {\n    var mod = {};\n    mod.pi = new Sk.builtin.float_(Math.PI);\n    mod.e = new Sk.builtin.float_(Math.E);\n\n    mod.fabs = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("fabs", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.float_(Math.abs(Sk.builtin.asnum$(x)));\n    });\n\n    mod.asin = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("asin", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        return new Sk.builtin.float_(Math.asin(Sk.builtin.asnum$(rad)));\n    });\n\n    mod.acos = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("acos", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        return new Sk.builtin.float_(Math.acos(Sk.builtin.asnum$(rad)));\n    });\n\n    mod.atan = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("atan", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        return new Sk.builtin.float_(Math.atan(Sk.builtin.asnum$(rad)));\n    });\n\n    mod.atan2 = new Sk.builtin.func(function (y, x) {\n        Sk.builtin.pyCheckArgs("atan2", arguments, 2, 2);\n        Sk.builtin.pyCheckType("y", "number", Sk.builtin.checkNumber(y));\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.float_(Math.atan2(Sk.builtin.asnum$(y), Sk.builtin.asnum$(x)));\n    });\n\n    mod.sin = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("sin", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        return new Sk.builtin.float_(Math.sin(Sk.builtin.asnum$(rad)));\n    });\n\n    mod.cos = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("cos", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        return new Sk.builtin.float_(Math.cos(Sk.builtin.asnum$(rad)));\n    });\n\n    mod.tan = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("tan", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        return new Sk.builtin.float_(Math.tan(Sk.builtin.asnum$(rad)));\n    });\n\n    mod.asinh = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("asinh", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Sk.builtin.asnum$(x);\n\n        var L = x + Math.sqrt(x * x + 1);\n\n        return new Sk.builtin.float_(Math.log(L));\n    });\n\n    mod.acosh = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("acosh", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Sk.builtin.asnum$(x);\n\n        var L = x + Math.sqrt(x * x - 1);\n\n        return new Sk.builtin.float_(Math.log(L));\n    });\n\n    mod.atanh = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("atanh", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Sk.builtin.asnum$(x);\n\n        var L = (1 + x) / (1 - x);\n\n        return new Sk.builtin.float_(Math.log(L) / 2);\n    });\n\n    mod.sinh = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("sinh", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Sk.builtin.asnum$(x);\n\n        var e = Math.E;\n        var p = Math.pow(e, x);\n        var n = 1 / p;\n        var result = (p - n) / 2;\n\n        return new Sk.builtin.float_(result);\n    });\n\n    mod.cosh = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("cosh", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Sk.builtin.asnum$(x);\n\n        var e = Math.E;\n        var p = Math.pow(e, x);\n        var n = 1 / p;\n        var result = (p + n) / 2;\n\n        return new Sk.builtin.float_(result);\n    });\n\n    mod.tanh = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("tanh", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Sk.builtin.asnum$(x);\n\n        var e = Math.E;\n        var p = Math.pow(e, x);\n        var n = 1 / p;\n        var result = ((p - n) / 2) / ((p + n) / 2);\n\n        return new Sk.builtin.float_(result);\n    });\n\n    mod.ceil = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("ceil", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.float_(Math.ceil(Sk.builtin.asnum$(x)));\n    });\n\n    // returns y with the sign of x\n    mod.copysign = new Sk.builtin.func(function (x, y) {\n        Sk.builtin.pyCheckArgs("ceil", arguments, 2, 2);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n        Sk.builtin.pyCheckType("y", "number", Sk.builtin.checkNumber(y));\n\n        var _x = Sk.ffi.remapToJs(x);\n        var _y = Sk.ffi.remapToJs(y);\n        var res;\n\n        var isNeg_x = _x < 0;\n        var isNeg_y = _x < 0;\n\n        // special case for floats with negative zero\n        if(Sk.builtin.checkFloat(x)) {\n            if(_x === 0) {\n                isNeg_x = 1/_x === -Infinity ? true : false;\n            }\n        }\n\n        if(Sk.builtin.checkFloat(y)) {\n            if(_y === 0) {\n                isNeg_y = 1/_y === -Infinity ? true : false;\n            }\n        }\n\n        // if both signs are equal, just return _y\n        if((isNeg_x && isNeg_y) || (!isNeg_x && !isNeg_y)) {\n            res = _y;\n        } else if((isNeg_x && !isNeg_y) || (!isNeg_x && isNeg_y)) {\n            // if different, invert sign\n            if(y === 0) {\n                // special case for zero\n                res = isNeg_x ? -0.0 : 0.0;\n            } else {\n                res = _y * -1;\n            }\n        }\n\n        return new Sk.builtin.float_(res);\n    });\n\n    mod.floor = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("floor", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.float_(Math.floor(Sk.builtin.asnum$(x)));\n    });\n\n    mod.sqrt = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("sqrt", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.float_(Math.sqrt(Sk.builtin.asnum$(x)));\n    });\n\n    mod.trunc = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("trunc", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.int_(Sk.builtin.asnum$(x) | 0);\n    });\n\n    mod.log = new Sk.builtin.func(function (x, base) {\n        Sk.builtin.pyCheckArgs("log", arguments, 1, 2);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        if (base === undefined) {\n            return new Sk.builtin.float_(Math.log(Sk.builtin.asnum$(x)));\n        } else {\n            Sk.builtin.pyCheckType("base", "number", Sk.builtin.checkNumber(base));\n            var ret = Math.log(Sk.builtin.asnum$(x)) / Math.log(Sk.builtin.asnum$(base));\n            return new Sk.builtin.float_(ret);\n        }\n    });\n\n    mod.log10 = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("log10", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        var ret = Math.log(Sk.builtin.asnum$(x)) / Math.log(10);\n        return new Sk.builtin.float_(ret);\n    });\n\n    /* Return True if x is infinite, and False otherwise. */\n    mod.isinf = new Sk.builtin.func(function(x) {\n        Sk.builtin.pyCheckArgs("isinf", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        var _x = Sk.builtin.asnum$(x);\n        if(isFinite(_x) && !isNaN(_x)) {\n            return Sk.builtin.bool.false$;\n        } else {\n            return Sk.builtin.bool.true$\n        }\n    });\n\n    /* Return True if x is a NaN (not a number), and False otherwise. */\n    mod.isnan = new Sk.builtin.func(function(x) {\n        Sk.builtin.pyCheckArgs("isnan", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "float", Sk.builtin.checkFloat(x));\n\n        var _x = Sk.builtin.asnum$(x);\n        if(isNaN(_x)) {\n            return Sk.builtin.bool.true$;\n        } else {\n            return Sk.builtin.bool.false$;\n        }\n    });\n\n    mod.exp = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("exp", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        return new Sk.builtin.float_(Math.exp(Sk.builtin.asnum$(x)));\n    });\n\n    mod.pow = new Sk.builtin.func(function (x, y) {\n        Sk.builtin.pyCheckArgs("pow", arguments, 2, 2);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n        Sk.builtin.pyCheckType("y", "number", Sk.builtin.checkNumber(y));\n\n        return new Sk.builtin.float_(Math.pow(Sk.builtin.asnum$(x), Sk.builtin.asnum$(y)));\n    });\n\n    mod.radians = new Sk.builtin.func(function (deg) {\n        Sk.builtin.pyCheckArgs("radians", arguments, 1, 1);\n        Sk.builtin.pyCheckType("deg", "number", Sk.builtin.checkNumber(deg));\n\n        var ret = Math.PI / 180.0 * Sk.builtin.asnum$(deg);\n        return new Sk.builtin.float_(ret);\n    });\n\n    mod.degrees = new Sk.builtin.func(function (rad) {\n        Sk.builtin.pyCheckArgs("degrees", arguments, 1, 1);\n        Sk.builtin.pyCheckType("rad", "number", Sk.builtin.checkNumber(rad));\n\n        var ret = 180.0 / Math.PI * Sk.builtin.asnum$(rad);\n        return new Sk.builtin.float_(ret);\n    });\n\n    mod.hypot = new Sk.builtin.func(function (x, y) {\n        Sk.builtin.pyCheckArgs("hypot", arguments, 2, 2);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n        Sk.builtin.pyCheckType("y", "number", Sk.builtin.checkNumber(y));\n\n        x = Sk.builtin.asnum$(x);\n        y = Sk.builtin.asnum$(y);\n        return new Sk.builtin.float_(Math.sqrt((x * x) + (y * y)));\n    });\n\n    mod.factorial = new Sk.builtin.func(function (x) {\n        Sk.builtin.pyCheckArgs("factorial", arguments, 1, 1);\n        Sk.builtin.pyCheckType("x", "number", Sk.builtin.checkNumber(x));\n\n        x = Math.floor(Sk.builtin.asnum$(x));\n        var r = 1;\n        for (var i = 2; i <= x; i++) {\n            r *= i;\n        }\n        return new Sk.builtin.int_(r);\n    });\n\n    return mod;\n}',"src/lib/smtplib.py":'raise NotImplementedError("smtplib is not yet implemented in Skulpt")\n',"src/lib/cmd.py":'raise NotImplementedError("cmd is not yet implemented in Skulpt")\n',"src/lib/filecmp.py":'raise NotImplementedError("filecmp is not yet implemented in Skulpt")\n',"src/lib/PB234Trees/__init__.py":'# PB234Trees.py ----------------------------------------------------------------\n#\n# Made by Evan Olds for zyBooks/Wiley\n# Uploaded to GitHub May 2, 2025\n#\n# Classes declared in this module:\n#   PB234Node\n#   PB234Tree\n\nfrom PBCore import PBBox\nfrom PBCore import PBColors\nfrom PBCore import PBRandom\nfrom PBCore import PBRenderable\nfrom PBCore import PBBaseNode\n\nclass PB234Node(PBBaseNode):\n    def __init__(self, key0, child0 = None, child1 = None):\n        PBBaseNode.__init__(self)\n        self.keys = [key0, 0, 0]\n        self.key_count = 1\n        self.children = [child0, child1, None, None]\n        \n        # Assign attributes related to rendering\n        self.render_info["borderThickness"] = 2\n        # Our data structures zyBooks use black borders for 2-3-4 tree nodes\n        # when in light mode, white borders when in dark mode\n        self.render_info["borderColorLight"] = "rgb(0,0,0)"\n        self.render_info["borderColorDark"] = "rgb(255,255,255)"\n    \n    # Returns True if all of this nodes keys exist in the collection, False\n    # otherwise.\n    def are_all_keys_in(self, collection):\n        for i in range(self.key_count):\n            if self.keys[i] not in collection:\n                return False\n        return True\n    \n    @staticmethod\n    def create_full_node(key0, key1, key2, child0, child1, child2, child3):\n        node = PB234Node(key0, child0, child1)\n        node.keys = [key0, key1, key2]\n        node.children = [child0, child1, child2, child3]\n        node.key_count = 3\n        return node\n    \n    # Returns a PBBox object representing this node\'s bounding box\n    def get_bounding_box(self):\n        bound_size = self.get_bounding_size()\n        wo2 = bound_size[0] / 2.0\n        ho2 = bound_size[1] / 2.0\n        cx = self.render_info["centerX"]\n        cy = self.render_info["centerY"]\n        return PBBox(cx - wo2, cy - ho2, cx + wo2, cy + ho2)\n    \n    # Returns a list with 2 numbers representing the size of the bounding box\n    # needed to render this node:\n    #   [box_width, box_height]\n    # The box size represents this node\'s render size only and does not\n    # include subtrees.\n    def get_bounding_size(self):\n        r = self.render_info["height"] / 2.0\n        kc = self.get_key_count()\n        \n        # Each key fits inside a 2r x 2r box area that does NOT include\n        # borders. Borders between key boxes are shared, so widths are:\n        # 1 key: 2*r + 2*border_thickness\n        # 2 keys: 4*r + 3*border_thickness\n        # 3 keys: 6*r + 4*border_thickness\n        return [\n            kc * 2.0 * r + ((kc + 1) * self.render_info["borderThickness"]),\n            2.0 * r + 2.0 * self.render_info["borderThickness"]\n        ]\n    \n    # Returns an [x,y] ordered pair list indicating where the branch line\n    # starts for the child at the specified index.\n    def get_branch_line_start(self, child_index):\n        box = self.get_bounding_box()\n        if 0 == child_index:\n            # Corners are slightly rounded, hence the + 2 and - 2\n            return [box.get_min_x() + 2, box.get_max_y() - 2]\n        elif child_index == self.key_count: # last key\n            # Corners are slightly rounded, hence the - 2 and - 2\n            return [box.get_max_x() - 2, box.get_max_y() - 2]\n        elif 1 == child_index:\n            if 1 == self.key_count:\n                return [box.get_max_x(), box.get_max_y()]\n            elif 2 == self.key_count:\n                return [box.get_center_x(), box.get_max_y()]\n            else:\n                return [box.get_min_x() + box.get_width() / 3.0, box.get_max_y()]\n        elif 2 == child_index:\n            # This node\'s key_count is expected to be 3 because:\n            # - If key_count is 1, this call is invalid\n            # - If key_count is 2, then the child_index === self.key_count case\n            #   above will have executed\n            return [box.get_min_x() + 2.0 * box.get_width() / 3.0, box.get_max_y()]\n        return [box.get_center_x(), box.get_center_y()]\n    \n    # If child_index is >= 0 and <= key_count then the child at child_index is\n    # returned. Otherwise None is returned.\n    def get_child(self, child_index):\n        if child_index >= 0 and child_index <= self.key_count:\n            return self.children[child_index]\n        return None\n    \n    # Returns 0 if this node is a leaf. Otherwise returns this node\'s child\n    # count, which will be this node\'s key count plus 1.\n    def get_child_count(self):\n        if self.children[0] == None:\n            return 0\n        return self.key_count + 1\n    \n    # Returns 0, 1, 2, or 3 if the child argument is this node\'s child 0,\n    # child 1, child 2, or child 3, respectively.\n    # Returns -1 if the child argument is not a child of this node.\n    def get_child_index(self, child):\n        for i in range(4):\n            if self.children[i] is child:\n                return i\n        return -1\n    \n    # Returns the key at key_index\n    def get_key(self, key_index):\n        return self.keys[key_index]\n    \n    # Returns the number of keys in this node, which will be 1, 2, or 3\n    def get_key_count(self):\n        return self.key_count\n    \n    # Returns the index of the key within this node, or -1 if this node does\n    # not contain the key\n    def get_key_index(self, key):\n        for i in range(self.key_count):\n            if self.keys[i] == key:\n                return i\n        return -1\n    \n    def get_key_render_center_x(self, key_index):\n        # Each key is centered within an r x r space within the node (where r\n        # is self.render_info["height"] / 2.0). Borders exist but are not\n        # included in the r x r space. So the formula for a key\'s center X, as\n        # an offset from this node\'s leftmost edge, is:\n        #   (key_index + 1) * border_thickness + (key_index + 1) * (2r) - r\n        # or\n        #   (key_index + 1) * (border_thickness + 2r) - r\n        r = self.render_info["height"] / 2.0\n        return (self.get_bounding_box().get_min_x() +\n            (key_index + 1) * (self.render_info["borderThickness"] + 2 * r) - r)\n    \n    def get_last_child(self):\n        if self.children[0] == None:\n            return None\n        return self.children[self.key_count]\n    \n    def get_renderables(self, light_list, dark_list, keys_to_highlight):\n        LISTS = [light_list, dark_list]\n        bbox = self.get_bounding_box()\n        \n        # Compute center point and radius\n        cx = self.render_info["centerX"]\n        cy = self.render_info["centerY"]\n        r = self.render_info["height"] / 2.0\n        \n        # Make lists of colors for light and dark modes\n        BGS = [\n            self.render_info["bgColorLight"],\n            self.render_info["bgColorDark"]\n        ]\n        BORDERS = [\n            self.render_info["borderColorLight"],\n            self.render_info["borderColorDark"]\n        ]\n        HIGHLIGHTS = [\n            PBColors.get_light_mode_colors()["highlight1"],\n            PBColors.get_dark_mode_colors()["highlight1"]\n        ]\n        TEXT_COLORS = [\n            self.render_info["textColorLight"],\n            self.render_info["textColorDark"]\n        ]\n        \n        # Compute x values for vertical separator lines (if needed)\n        vertical_lines_x = []\n        if 2 == self.key_count:\n            # Add separator line in the center of the node\n            vertical_lines_x.append(cx)\n        else:\n            border_thickness = self.render_info["borderThickness"]\n            for i in range(self.key_count - 1):\n                line_x = (bbox.get_min_x() +\n                    (2.0 * r + border_thickness) * (i + 1))\n                vertical_lines_x.append(line_x)\n        \n        for list_index in range(len(LISTS)):\n            bg_color = BGS[list_index]\n            # Background changes if all keys in the node are highlighted\n            whole_node_highlighted = False\n            if self.are_all_keys_in(keys_to_highlight):\n                bg_color = HIGHLIGHTS[list_index]\n                whole_node_highlighted = True\n            # Add a rectangle with rounded corners\n            LISTS[list_index].append({\n                "renderType": "rectangle",\n                "left": cx - bbox.get_width() / 2.0,\n                "top": cy - bbox.get_height() / 2.0,\n                "width": bbox.get_width(),\n                "height": bbox.get_height(),\n                "radius": 4.0,\n                "backgroundColor": bg_color,\n                "borderColor": BORDERS[list_index]\n            })\n            if not whole_node_highlighted:\n                # Add highlights for keys as needed\n                for i in range(self.key_count):\n                    key = self.get_key(i)\n                    if key in keys_to_highlight:\n                        text_center_x = self.get_key_render_center_x(i)\n                        LISTS[list_index].append({\n                            "renderType": "rectangle",\n                            "centerX": text_center_x,\n                            "centerY": cy,\n                            "width": r * 2.0,\n                            "height": r * 2.0,\n                            "backgroundColor": HIGHLIGHTS[list_index]\n                        })\n            # Add any needed vertical lines to separate keys within the node\n            for line_x in vertical_lines_x:\n                LISTS[list_index].append({\n                    "renderType": "line",\n                    "x1": line_x,\n                    "y1": bbox.get_min_y(),\n                    "x2": line_x,\n                    "y2": bbox.get_max_y(),\n                    "borderColor": BORDERS[list_index]\n                })\n            \n            # Add text objects for the node\'s keys\n            for i in range(self.key_count):\n                text_center_x = self.get_key_render_center_x(i)\n                LISTS[list_index].append({\n                    "renderType": "text",\n                    "centerX": text_center_x,\n                    "centerY": cy,\n                    "color": TEXT_COLORS[list_index],\n                    "font": "18px sans-serif",\n                    "text": str(self.get_key(i))\n                })\n    \n    def get_text(self):\n        result = str(self.keys[0])\n        if 2 == self.key_count:\n            result += ("," + str(self.keys[1]))\n        elif 3 == self.key_count:\n            result += ("," + str(self.keys[1]) + "," + str(self.keys[2]))\n        return result\n    \n    def has_key(self, key):\n        for i in range(self.key_count):\n            if self.keys[i] == key:\n                return True\n        return False\n    \n    # Inserts a new key into the proper location in this node, and assigns the\n    # children on either side of the inserted key.\n    # Precondition: This node\'s key count is <= 2.\n    def insert_key_with_children(self, key, left_child, right_child):\n        if key < self.keys[0]:\n            self.keys[2] = self.keys[1]\n            self.keys[1] = self.keys[0]\n            self.keys[0] = key\n            self.children[3] = self.children[2]\n            self.children[2] = self.children[1]\n            self.children[1] = right_child\n            self.children[0] = left_child\n        elif self.key_count == 1 or key < self.keys[1]:\n            self.keys[2] = self.keys[1]\n            self.keys[1] = key\n            self.children[3] = self.children[2]\n            self.children[2] = right_child\n            self.children[1] = left_child\n        else:\n            self.keys[2] = key\n            self.children[3] = right_child\n            self.children[2] = left_child\n        self.key_count += 1\n    \n    # Returns True if this node is a leaf, False otherwise\n    def is_leaf(self):\n        return self.children[0] == None\n    \n    # Returns the child of this node that must be visited next in the\n    # traversal to find the specified key\n    def next_node(self, key):\n        i = 0\n        while i < self.key_count:\n            if key < self.keys[i]:\n                return self.children[i]\n            i += 1\n        return self.children[i]\n    \n    # Removes key 0, 1, or 2 from this node, if key_index is 0, 1, or 2,\n    # respectively. Other keys and children are shifted as needed.\n    def remove_key(self, key_index):\n        if key_index == 0:\n            self.keys[0] = self.keys[1]\n            self.keys[1] = self.keys[2]\n            self.children[0] = self.children[1]\n            self.children[1] = self.children[2]\n            self.children[2] = self.children[3]\n            self.children[3] = None\n            self.key_count -= 1\n        elif key_index == 1:\n            self.keys[1] = self.keys[2]\n            self.children[2] = self.children[3]\n            self.children[3] = None\n            self.key_count -= 1\n        elif key_index == 2:\n            self.children[3] = None\n            self.key_count -= 1\n    \n    # Sets a child by index. Returns this node to allow chaining.\n    def set_child(self, child_index, child):\n        self.children[child_index] = child\n        return self\n    \n    # Sets a key by index. Returns this node to allow chaining.\n    def set_key(self, key_index, key_value):\n        self.keys[key_index] = key_value\n        return self\n    \n    # Sets this node\'s key count. Returns this node to allow chaining.\n    def set_key_count(self, new_key_count):\n        self.key_count = new_key_count\n        return self\n\nclass PB234Tree(PBRenderable):\n    def __init__(self, to_copy = None):\n        PBRenderable.__init__(self)\n        self.root = None\n        self._nodes_to_highlight = set()\n        self._keys_to_highlight = set()\n        \n        # _needs_respositioning indicates whether or not nodes need to be\n        # positioned. Most tree-altering methods assign _needs_repositioning\n        # with True so that the next call to get_renderables() updates node\n        # positions before building renderables.\n        self._needs_positioning = True\n        \n        if isinstance(to_copy, PB234Tree):\n            # Deep copy the _keys_to_highlight set\n            self._keys_to_highlight = set(to_copy._keys_to_highlight)\n            \n            # Copy tree nodes\n            copied_root = PB234Tree._duplicate(to_copy.root)\n            self.root = copied_root\n            \n            # Populate the nodes-to-highlight set\n            for other_node in to_copy._nodes_to_highlight:\n                our_node = self.get_node_with_key(other_node.get_key())\n                self._nodes_to_highlight.add(our_node)\n    \n    # Returns True if this tree contains the given key, False otherwise.\n    def contains_key(self, key):\n        return self.get_node_with_key(key) != None\n    \n    @staticmethod\n    def create_from_keys(keys):\n        tree = PB234Tree()\n        for key in keys:\n            tree.insert_key(key)\n        return tree\n    \n    @staticmethod\n    def create_structured_height_1_tree(num_root_keys, num_child0_keys,\n        num_child1_keys, num_child2_keys, num_child3_keys):\n        # Check parameters\n        if num_root_keys not in range(1, 4):\n            print("DEBUG ERROR: Bad call to PB234Tree." +\n                "create_structured_height_1_tree(). num_root_keys must be " +\n                "in the range [1, 3].")\n            return None\n        child_counts = [num_child0_keys, num_child1_keys, num_child2_keys,\n            num_child3_keys]\n        ok_ranges = [range(1, 4), range(1, 4), range(0, 4), range(0, 4)]\n        total_key_count = num_root_keys\n        for i in range(len(child_counts)):\n            if child_counts[i] not in ok_ranges[i]:\n                print("DEBUG ERROR: Bad call to PB234Tree." +\n                "create_structured_height_1_tree(). Child " + str(i) +\n                "\'s key count of " + str(child_counts[i]) + " is out of range")\n                return None\n            total_key_count += child_counts[i]\n        \n        # Create the root with placeholder keys\n        root = PB234Node.create_full_node(99, 99, 99, None, None, None, None)\n        root.set_key_count(num_root_keys)\n        \n        # Create child nodes with placeholder keys\n        for i in range(len(child_counts)):\n            if child_counts[i] > 0:\n                child = PB234Node.create_full_node(99, 99, 99, None, None,\n                    None, None)\n                child.set_key_count(child_counts[i])\n                root.set_child(i, child)\n        \n        # Create total_key_count random, distinct integers\n        int_set = set()\n        while len(int_set) < total_key_count:\n            int_set.add(PBRandom.get_int_inclusive(10, 99))\n        int_list = list(int_set)\n        int_list.sort()\n        \n        visitor = lambda node, i: node.set_key(i, int_list.pop(0))\n        PB234Tree._visit_keys_in_order(root, visitor)\n        \n        # Create the tree, assign root, and return the tree\n        tree = PB234Tree()\n        tree.set_root(root)\n        return tree\n    \n    def for_each(self, callback):\n        self._for_each(callback, self.root)\n    \n    # Fuses a parent node and two children into one node.\n    # Precondition: left_node and right_node must have one key each.\n    def fuse(self, parent, left_node, right_node):\n        if parent is self.root and parent.get_key_count() == 1:\n            return self.fuse_root()\n        \n        self._needs_positioning = True\n        \n        left_node_index = parent.get_child_index(left_node)\n        middle_key = parent.get_key(left_node_index)\n        fused_node = PB234Node.create_full_node(\n            # Keys:\n            left_node.get_key(0), middle_key, right_node.get_key(0),\n                                                 \n            # Children:\n            left_node.get_child(0), left_node.get_child(1),\n            right_node.get_child(0), right_node.get_child(1)\n        )\n        key_index = parent.get_key_index(middle_key)\n        parent.remove_key(key_index)\n        parent.set_child(key_index, fused_node)\n        return fused_node\n    \n    # Fuses the tree\'s root node with the root\'s two children.\n    # Precondition: Each of the three nodes must have one key each.\n    def fuse_root(self):\n        # Fusing the root lowers the tree\'s height, so repositioning will be\n        # required\n        self._needs_positioning = True\n        \n        old_child0 = self.root.get_child(0)\n        old_child1 = self.root.get_child(1)\n        self.root.set_key(1, self.root.get_key(0))\n        self.root.set_key(0, old_child0.get_key(0))\n        self.root.set_key(2, old_child1.get_key(0))\n        self.root.set_key_count(3)\n        self.root.set_child(0, old_child0.get_child(0))\n        self.root.set_child(1, old_child0.get_child(1))\n        self.root.set_child(2, old_child1.get_child(0))\n        self.root.set_child(3, old_child1.get_child(1))\n        return self.root\n    \n    def get_alt_text(self):\n        # Special case if root is None\n        if self.root == None:\n            return ""\n        \n        # Start building the alt text string\n        key_count = self.get_length()\n        text = "2-3-4 tree with " + str(key_count) + " key"\n        if key_count != 1:\n            text += "s"\n        text += ": Root " + self._get_node_keys_string(self.root) + "."\n        \n        # Process remaining nodes\n        parents = [self.root]\n        while len(parents) > 0:\n            parent = parents.pop(0)\n            \n            # Nodes with no children have already been processed via parent\n            if 0 == parent.get_child_count():\n                continue\n            \n            # Append a sentence for each child\n            for i in range(parent.get_child_count()):\n                child = parent.get_child(i)\n                sentence = " Root\'s"\n                if parent is not self.root:\n                    sentence = " Node [" + parent.get_text() + "]\'s"\n                sentence += (" child " + str(i) + " ")\n                sentence += (self._get_node_keys_string(child) + ".")\n                \n                # Append to main text\n                text += sentence\n                \n                # Append child\n                parents.append(child)\n        \n        # Add information about highlighted keys\n        keys_to_highlight = self._keys_to_highlight\n        if 1 == len(keys_to_highlight):\n            highlighted_key = 0\n            for key in keys_to_highlight:\n                highlighted_key = key\n            text += " Key " + str(highlighted_key) + " is highlighted."\n        elif len(keys_to_highlight) > 1:\n            text += " The following keys are highlighted: "\n            added_first = False\n            for key in keys_to_highlight:\n                if added_first:\n                    text += ", " + str(key)\n                else:\n                    text += str(key)\n                    added_first = True\n            text += "."\n        return text\n    \n    def get_bounding_box(self):\n        return PB234Tree.get_subtree_bounding_box(self.root)\n    \n    # Returns a list of PBBox objects, one per child of node, representing the\n    # bounds of each child subtree. Returns an empty list if node is a leaf.\n    @staticmethod\n    def get_child_subtree_bounding_boxes(node):\n        boxes = []\n        for i in range(node.get_child_count()):\n            child = node.get_child(i)\n            boxes.append(PB234Tree.get_subtree_bounding_box(child))\n        return boxes\n    \n    def get_filtered_nodes(self, predicate):\n        result = []\n        node_stack = [self.root]\n        while len(node_stack) > 0:\n            node = node_stack.pop()\n            \n            # Skip if None\n            if None == node:\n                continue\n            \n            # Include the node in the result only if the predicate returns true\n            if predicate(node):\n                result.append(node)\n            \n            # Push children\n            for i in range(node.get_child_count()):\n                node_stack.append(node.get_child(i))\n        return result\n    \n    # Returns the height of this tree\n    def get_height(self):\n        return PB234Tree.get_height_recursive(self.root)\n    \n    @staticmethod\n    def get_height_recursive(node):\n        if node == None:\n            return -1\n        return 1 + PB234Tree.get_height_recursive(node.get_child(0))\n    \n    # Returns a list with all this tree\'s keys, sorted in ascending order\n    def get_keys(self):\n        result = []\n        self.for_each(lambda key: result.append(key))\n        return result\n    \n    # Returns a list with all this tree\'s keys, sorted in ascending order. Same\n    # functionality as the get_keys() method.\n    def get_keys_in_sorted_order(self):\n        result = []\n        self.for_each(lambda key: result.append(key))\n        return result\n    \n    # Returns the number of keys in this tree\n    def get_length(self):\n        count = 0\n        nodes = [self.root]\n         \n        while len(nodes) > 0:\n            node = nodes.pop()\n            if node != None:\n                # Add the number of keys in the node to the count\n                count += node.get_key_count()\n                \n                # Append children\n                for i in range(node.get_child_count()):\n                    nodes.append(node.get_child(i))\n        return count\n    \n    # Returns the maximum key in this tree, or NaN if this tree is empty\n    def get_max_key(self):\n        if self.root == None:\n            return float("nan")\n        return PB234Tree._get_max_key(self.root)\n    \n    # Returns the minimum key in this tree, or NaN if this tree is empty\n    def get_min_key(self):\n        if self.root == None:\n            return float("nan")\n        return PB234Tree._get_min_key(self.root)\n    \n    # Gets a node\'s parent in O(log N) time. If the node is not in this tree or\n    # is this tree\'s root, None is returned. Otherwise the node\'s parent node\n    # is returned.\n    def get_node_parent(self, node):\n        # Special case for root\n        if node is self.root:\n            return None\n        \n        parent = self.root\n        while parent != None:\n            if parent.get_child_index(node) >= 0:\n                return parent\n            parent = parent.next_node(node.get_key(0))\n        return None\n    \n    # Returns the first found node with the specified key, or None if no such\n    # node exists.\n    def get_node_with_key(self, key):\n        node = self.root\n        while node != None:\n            if node.has_key(key):\n                return node\n            node = node.next_node(key)\n        # Not found:\n        return None\n    \n    # Returns a Python dictionary with the following keys:\n    #\n    # "renderables":\n    #   The corresponding value is a list of objects, each also a Python\n    #   dictionary, to render. Each object has a "renderType" key and a\n    #   corresponding value indicating the type of object to render (exs:\n    #   "line" or "rectangle").\n    #\n    # "alt":\n    #   Corresponding value is a string for the rendered content\'s alt text.\n    #\n    # "renderables_dark":\n    #   List of renderables to be used in dark mode.\n    #\n    # "alt_dark":\n    #   Alt text string to be used in dark mode.\n    def get_renderables(self):\n        # Get the alt text\n        alt = self.get_alt_text()\n        \n        # Special case if no tree\n        if self.root == None:\n            return { "renderables": [], "renderables_dark": [], "alt": alt,\n                "alt_dark": alt }\n        \n        # Position nodes first, if needed\n        if self._needs_positioning:\n            self._position_all_nodes()\n        \n        LIGHT_MODE_COLORS = PBColors.get_light_mode_colors()\n        DARK_MODE_COLORS = PBColors.get_dark_mode_colors()\n        \n        # Initialize lists of renderable objects\n        light_list = []\n        dark_list = []\n        \n        # Initialize a stack of (node, node_parent) tuples\n        node_stack = [ (self.root, None) ]\n        \n        # Pass 1: Lines between each parent-child pair\n        while len(node_stack) > 0:\n            tuple = node_stack.pop()\n            node = tuple[0]\n            parent = tuple[1]\n            \n            if parent != None:\n                child_index = parent.get_child_index(node)\n                start = parent.get_branch_line_start(child_index)\n                \n                light_list.append({\n                    "renderType": "line",\n                    "x1": start[0],\n                    "y1": start[1],\n                    "x2": node.get_center_x(),\n                    "y2": node.get_top_center_y(),\n                    "borderColor": LIGHT_MODE_COLORS["line"]\n                })\n                dark_list.append({\n                    "renderType": "line",\n                    "x1": start[0],\n                    "y1": start[1],\n                    "x2": node.get_center_x(),\n                    "y2": node.get_top_center_y(),\n                    "borderColor": DARK_MODE_COLORS["line"]\n                })\n            # Append children\n            for i in range(node.get_child_count()):\n                node_stack.append( (node.get_child(i), node) )\n        \n        # Pass 2: All nodes\n        node_stack = [self.root]\n        while len(node_stack) > 0:\n            node = node_stack.pop()\n            node.get_renderables(light_list, dark_list, self._keys_to_highlight)\n            \n            # Append children\n            for i in range(node.get_child_count()):\n                node_stack.append(node.get_child(i))\n        \n        return { "renderables": light_list, "renderables_dark": dark_list,\n            "alt": alt, "alt_dark": alt }\n    \n    def get_root(self):\n        return self.root\n    \n    @staticmethod\n    def get_subtree_bounding_box(node):\n        if node == None:\n            return PBBox()\n        \n        box = node.get_bounding_box()\n        remaining_nodes = list(node.children)\n        while len(remaining_nodes) > 0:\n            node = remaining_nodes.pop()\n            if node == None:\n                continue\n            # Build a box that bounds the existing bounds plus the node\'s box\n            box = PBBox.bound(box, node.get_bounding_box())\n            # Append children\n            for i in range(node.get_key_count()):\n                remaining_nodes.append(node.get_child(i))\n        return box\n    \n    def highlight_key(self, key):\n        if self.contains_key(key):\n            self._keys_to_highlight.add(key)\n        return self\n    \n    def highlight_node(self, node):\n        self._nodes_to_highlight.add(node)\n        node.render_info["bgColorLight"] = "rgb(255,255,0)"\n    \n    # Inserts a new key into this tree, provided the tree doesn\'t already\n    # contain the same key. Returns True if the key was inserted successfully,\n    # False if the key already exists and so was not inserted.\n    def insert_key(self, key):\n        result = self._insert_recursive(key, self.root, None)\n        return result\n    \n    # Finds and replaces one key with another. The replacement key must be\n    # a key that can be used as a replacement without violating any of the\n    # 2-3-4 tree rules.\n    def key_swap(self, node, existing_key, replacement_key):\n        if node == None:\n            return False\n        \n        key_index = node.get_key_index(existing_key)\n        if key_index == -1:\n            next = node.next_node(existing_key)\n            return self.key_swap(next, existing_key, replacement_key)\n        \n        node.set_key(key_index, replacement_key)\n        return True\n    \n    # Rotates or fuses to add 1 or 2 additional keys to a node with 1 key\n    def merge(self, node, node_parent):\n        # Get references to node\'s siblings\n        node_index = node_parent.get_child_index(node)\n        left_sibling = node_parent.get_child(node_index - 1)\n        right_sibling = node_parent.get_child(node_index + 1)\n         \n        # Check siblings for a key that can be transferred\n        if left_sibling != None and left_sibling.get_key_count() >= 2:\n            self.rotate_right(left_sibling, node_parent)\n        elif right_sibling != None and right_sibling.get_key_count() >= 2:\n            self.rotate_left(right_sibling, node_parent)\n        else: # fuse\n            if left_sibling == None:\n                node = self.fuse(node_parent, node, right_sibling)\n            else:\n                node = self.fuse(node_parent, left_sibling, node)\n        \n        self._needs_positioning = True\n        return node\n    \n    # Finds and removes the specified key from this tree\n    def remove_key(self, key):\n        # Special case for tree with 1 key\n        if self.root.is_leaf() and self.root.get_key_count() == 1:\n            if self.root.get_key(0) == key:\n                self.root = None\n                self._needs_positioning = True\n                return True\n            return False\n        \n        current_parent = None\n        current = self.root\n        while current != None:\n            # Merge any non-root node with 1 key\n            if current.get_key_count() == 1 and current is not self.root:\n                current = self.merge(current, current_parent)\n             \n            # Check if current node contains key\n            key_index = current.get_key_index(key)\n            if key_index != -1:\n                if current.is_leaf():\n                    current.remove_key(key_index)\n                    self._needs_positioning = True\n                    return True\n                # The node contains the key and is not a leaf, so the key is\n                # replaced with the successor\n                tmp_child = current.get_child(key_index + 1)\n                tmp_key = PB234Tree._get_min_key(tmp_child)\n                self.remove_key(tmp_key)\n                self.key_swap(self.root, key, tmp_key)\n                self._needs_positioning = True\n                return True\n            \n            # Current node does not contain key, so continue down tree\n            current_parent = current\n            current = current.next_node(key)\n        # key not found\n        return False\n    \n    def rotate_left(self, node, node_parent):\n        # Get the node\'s left sibling\n        node_index = node_parent.get_child_index(node)\n        left_sibling = node_parent.get_child(node_index - 1)\n        \n        # Append the key to the left sibling\n        left_sibling.insert_key_with_children(\n            node_parent.get_key(node_index - 1),\n            left_sibling.get_child(left_sibling.get_key_count()),\n            node.get_child(0))\n         \n        # Replace the parent\'s key that was appended to the left sibling\n        node_parent.set_key(node_index - 1, node.get_key(0))\n         \n        # Remove key 0 and child 0 from node\n        node.remove_key(0)\n        \n        self._needs_positioning = True\n    \n    def rotate_right(self, node, node_parent):\n        # Get the node\'s right sibling\n        node_index = node_parent.get_child_index(node)\n        right_sibling = node_parent.get_child(node_index + 1)\n         \n        # Get the child from the node that will move to the sibling\n        node_rightmost_child = node.get_child(node.get_key_count())\n         \n        # Get the key from the parent that move into the right sibling\n        key_for_right_sibling = node_parent.get_key(node_index)\n         \n        # Insert new key and child into right sibling\n        right_sibling.insert_key_with_children(key_for_right_sibling,\n            node_rightmost_child, right_sibling.get_child(0))\n         \n        # Replace the parent\'s key that moved to the right sibling\n        node_parent.set_key(node_index, node.get_key(node.get_key_count() - 1))\n         \n        # Remove node\'s rightmost key and child\n        node.set_child(node.get_key_count(), None)\n        node.set_key_count(node.get_key_count() - 1)\n        \n        self._needs_positioning = True\n    \n    # Searches this tree for the specified key. If found, the node containing\n    # the key is returned. Otherwise None is returned.\n    def search(self, key):\n        return self.search_recursive(key, self.root)\n    \n    # Recursive helper method for search\n    def search_recursive(self, key, node):\n        if node == None:\n            return None\n         \n        # Check if the node contains the key\n        if node.has_key(key):\n            return node\n        \n        # Recursively search the appropriate subtree\n        return self.search_recursive(key, node.next_node(key))\n    \n    def set_root(self, new_root):\n        self.root = new_root\n        self._needs_positioning = True\n        return self\n    \n    # Static utility method to shift the render position of all nodes in a\n    # subtree\n    @staticmethod\n    def shift_subtree(node, shift_x, shift_y):\n        # No action needed if both shift_x and shift_y are 0\n        if 0 == shift_x and 0 == shift_y:\n            return\n        \n        nodes = [node]\n        while len(nodes) > 0:\n            node = nodes.pop()\n            \n            # Shift the node\n            nodeCX = node.render_info["centerX"]\n            nodeCY = node.render_info["centerY"]\n            node.render_info["centerX"] = nodeCX + shift_x\n            node.render_info["centerY"] = nodeCY + shift_y\n            \n            # Append children\n            for i in range(node.get_child_count()):\n                nodes.append(node.get_child(i))\n    \n    # Splits a full node, moving the middle key up into the parent node.\n    # Precondition: node_parent has one or two keys.\n    def split(self, node, node_parent):\n        split_left = PB234Node(\n            node.get_key(0), node.get_child(0), node.get_child(1))\n        split_right = PB234Node(\n            node.get_key(2), node.get_child(2), node.get_child(3))\n         \n        if node_parent != None:\n            # Split non-root node\n            node_parent.insert_key_with_children(node.get_key(1), split_left,\n                split_right)\n        else:\n            # Split root node\n            node_parent = PB234Node(node.get_key(1), split_left, split_right)\n            self.root = node_parent\n        \n        # Repositioning is required after a split\n        self._needs_positioning = True\n        \n        return node_parent\n    \n    def unhighlight_key(self, key):\n        if key in self._keys_to_highlight:\n            self._keys_to_highlight.remove(key)\n        return self\n    \n    # Calls the visitor function for every key in this tree. Calls are made in\n    # ascending order by key value. The visitor function is passed two\n    # arguments:\n    # - node: The PB234Node containing the key\n    # - index: The integer index of the key being visited\n    def visit_keys_in_order(self, visitor):\n        PB234Tree._visit_keys_in_order(self.root, visitor)\n        return self\n    \n    @staticmethod\n    def _duplicate(node):\n        if node == None:\n            return None\n        copied_node = PB234Node(node.get_key(0))\n        copied_node.set_key_count(node.get_key_count())\n        for i in range(node.get_key_count()):\n            copied_node.set_key(i, node.get_key(i))\n        for i in range(node.get_child_count()):\n            existing_child = node.get_child(i)\n            copied_node.set_child(i, PB234Tree._duplicate(existing_child))\n        \n        # Copy render_info and then return the copied node\n        copied_node.render_info = dict(node.render_info)\n        return copied_node\n    \n    def _for_each(self, callback, node):\n        if node == None:\n            return\n        \n        # Recursively visit node\'s leftmost child subtree first\n        self._for_each(callback, node.get_child(0))\n        \n        for i in range(node.get_key_count()):\n            # Invoke callback for key at index i, then recursively visit\n            # subtree to the right of that key\n            callback(node.get_key(i))\n            self._for_each(callback, node.get_child(i + 1))\n    \n    # Searches for, and returns, the maximum key in a subtree. The node\n    # argument must not be None.\n    @staticmethod\n    def _get_max_key(node):\n        current = node\n        while current.get_child(0) != None:\n            current = current.get_child(current.get_child_count() - 1)\n        return current.get_key(current.get_key_count() - 1)\n    \n    # Searches for, and returns, the minimum key in a subtree. The node\n    # argument must not be None.\n    @staticmethod\n    def _get_min_key(node):\n        current = node\n        while current.get_child(0) != None:\n            current = current.get_child(0)\n        return current.get_key(0)\n    \n    def _get_node_keys_string(self, node):\n        if 1 == node.get_key_count():\n            return "has key " + str(node.get_key(0))\n        \n        pre = "has keys "\n        if 2 == node.get_key_count():\n            return pre + str(node.get_key(0)) + " and " + str(node.get_key(1))\n        # 3 keys:\n        return (pre + str(node.get_key(0)) + ", " + str(node.get_key(1)) +\n            ", and " + str(node.get_key(2)))\n    \n    # Inserts a new key into this tree, provided the tree doesn\'t already\n    # contain the same key. Returns True if the key was inserted successfully,\n    # False if the key already exists and so was not inserted.\n    def _insert_recursive(self, key, node, node_parent):\n        # Special case for empty tree\n        if self.root == None:\n            self.root = PB234Node(key)\n            self._needs_positioning = True\n            return True\n         \n        # Check for duplicate key\n        if node.has_key(key):\n            # Duplicate keys are not allowed\n            return False\n         \n        # Preemptively split full nodes\n        if 3 == node.get_key_count():\n            node = self.split(node, node_parent)\n         \n        # If node is not a leaf, recursively insert into child subtree\n        if not node.is_leaf():\n            return self._insert_recursive(key, node.next_node(key), node)\n         \n        # key can be inserted into leaf node\n        node.insert_key_with_children(key, None, None)\n        \n        self._needs_positioning = True\n        return True\n    \n    def _per_node_postorder(self, callback, node, ancestors, level_index):\n        if node == None:\n            return\n        \n        # Recursively visit child subtrees from left to right\n        for i in range(node.get_child_count()):\n            self._per_node_postorder(callback, node.get_child(i),\n                ancestors + [node], level_index + 1)\n        \n        # Visit the node itself\n        callback(node, ancestors, level_index)\n    \n    def _position_all_nodes(self):\n        # First reset self._needs_positioning to False\n        self._needs_positioning = False\n        \n        # Nothing to do if no nodes\n        if self.root == None:\n            return\n        \n        # H_SPACE represents the minimum horizontal spacing between any two\n        # nodes\' bounding boxes\n        H_SPACE = 8\n        \n        # Vertical space between levels, hard-coded for now\n        V_SPACE = 64\n        \n        # Position root at (0, 0)\n        self.root.set_render_center(0, 0)\n        \n        # Pass 1: Position each node\'s children below the node itself, with no\n        # regard for possible overlaps with other subtrees\n        nodes = [self.root]\n        while len(nodes) > 0:\n            node = nodes.pop()\n            \n            # Case 1: No children\n            if node.is_leaf():\n                # Move on to next node\n                continue\n            \n            # Get the node\'s bounding size\n            nodeBS = node.get_bounding_size()\n            \n            # Get each child\'s bounding size and append to nodes list\n            child_sizes = []\n            for i in range(node.get_child_count()):\n                childI = node.get_child(i)\n                child_sizes.append(childI.get_bounding_size())\n                nodes.append(childI)\n            \n            # Get maximum child height\n            max_child_height = child_sizes[0][1]\n            for i in range(1, len(child_sizes)):\n                max_child_height = max(max_child_height, child_sizes[i][1])\n            \n            # Case 2: 3 children\n            # In this case the middle child (child1) must be centered below\n            # the parent\n            if 3 == node.get_child_count():\n                c1cx = node.get_center_x()\n                c1cy = (node.get_center_y() + nodeBS[1] / 2.0 + V_SPACE -\n                    max_child_height / 2.0)\n                \n                # Set child1\'s center\n                node.get_child(1).set_render_center(c1cx, c1cy)\n                \n                # Position child0 and child2 on the sides of child1\n                node.get_child(0).set_render_center(c1cx -\n                    child_sizes[1][0] / 2.0 - H_SPACE - child_sizes[0][0] / 2.0,\n                    c1cy)\n                node.get_child(2).set_render_center(c1cx +\n                    child_sizes[1][0] / 2.0 + H_SPACE + child_sizes[2][0] / 2.0,\n                    c1cy)\n                \n                # Move on to next node\n                continue\n            \n            # Case 3: 2 or 4 children\n            # In this case the combined bounding box of all children must be\n            # centered below the parent\n            \n            # Compute combined width of children with H_SPACE between each\n            # pair of child nodes\n            children_width = node.get_child(0).get_bounding_size()[0]\n            for i in range(1, node.get_child_count()):\n                children_width += (H_SPACE + child_sizes[i][0])\n            \n            # Position children\n            child_x = node.get_center_x() - children_width / 2.0\n            child_y = (node.get_center_y() + nodeBS[1] / 2.0 + V_SPACE -\n                max_child_height / 2.0)\n            for i in range(node.get_child_count()):\n                childI = node.get_child(i)\n                child_i_width = child_sizes[i][0]\n                childI.set_render_center(child_x + child_i_width / 2.0, child_y)\n                \n                # Update child_x for next child\n                child_x += child_i_width + H_SPACE\n        \n        # Pass 2: Find overlaps from the bottom up and resolve each\n        callback = lambda n, a, l: self._resolve_child_overlap(n, a, l)\n        self._per_node_postorder(callback, self.root, [], 0)\n    \n    def _resolve_child_overlap(self, node, ancestors, level_index):\n        # H_SPACE represents the minimum horizontal spacing between any two\n        # nodes\' bounding boxes\n        H_SPACE = 8\n        \n        # No possible child overlap if no children\n        if 0 == node.get_child_count():\n            return\n        \n        # Get bounding boxes for all child subtrees\n        child_subtree_boxes = PB234Tree.get_child_subtree_bounding_boxes(node)\n        \n        # Compute the combined width needed to render all child subtrees\n        # with minimal spacing between them\n        width_needed = 0\n        for subtree_box in child_subtree_boxes:\n            width_needed += subtree_box.get_width()\n        width_needed += H_SPACE * (node.get_child_count() - 1)\n        \n        # Shift child subtrees as needed\n        left_x = node.get_center_x() - width_needed / 2.0\n        for i in range(node.get_child_count()):\n            childI = node.get_child(i)\n            \n            # Child subtree\'s existing "left" value is\n            # child_subtree_boxes[i]\'s min X. The subtree must be shifted so\n            # that the new left value is left_x.\n            PB234Tree.shift_subtree(\n                childI, left_x - child_subtree_boxes[i].get_min_x(), 0)\n            \n            # Update left_x for next iteration\n            left_x += child_subtree_boxes[i].get_width() + H_SPACE\n    \n    # Calls the visitor function for every key in the subtree rooted at node.\n    # Calls are made in ascending order by key value. The visitor function is\n    # passed two arguments:\n    # - node: The PB234Node containing the key\n    # - index: The integer index of the key being visited\n    @staticmethod\n    def _visit_keys_in_order(node, visitor):\n        if node == None:\n            return\n        for i in range(node.get_key_count()):\n            # Recursively visit child to left of key\n            PB234Tree._visit_keys_in_order(node.get_child(i), visitor)\n            # Visit key\n            visitor(node, i)\n        # Recursively visit child to right of last key\n        PB234Tree._visit_keys_in_order(node.get_last_child(), visitor)\n',"src/lib/whichdb.py":'raise NotImplementedError("whichdb is not yet implemented in Skulpt")\n',"src/builtin/sys.js":'var $builtinmodule = function (name) {\n    var i;\n    var sys = {};\n\n    var args = [];\n    var argv = Sk.getSysArgv();\n    for (i = 0; i < argv.length; ++i) {\n        args.push(new Sk.builtin.str(argv[i]));\n    }\n    sys.argv = new Sk.builtins["list"](args);\n\n    sys.copyright = Sk.builtin["str"]("Copyright 2009-2010 Scott Graham.\\nAll Rights Reserved.\\n");\n\n    sys.maxint = new Sk.builtin.int_(Math.pow(2,53)-1);\n\n    /*  The largest positive integer supported by the platform’s Py_ssize_t type,\n     *  and thus the maximum size lists, strings, dicts, and many other containers can have.\n     *\n     *  In skulpt this is the same as maxint, due to the underlying implementation in javascript\n     */\n    sys.maxsize = new Sk.builtin.int_(Math.pow(2,53)-1);\n\n    sys.modules = Sk.sysmodules;\n\n    sys.path = Sk.realsyspath;\n\n    sys.getExecutionLimit = new Sk.builtin.func(function () {\n        if (Sk.execLimit === null) {\n            return Sk.builtin.none.none$;\n        }\n        return new Sk.builtin.int_(Sk.execLimit);\n    });\n\n    sys.setExecutionLimit = new Sk.builtin.func(function (t) {\n        if (Sk.execLimit === null) {\n            throw new Sk.builtin.NotImplementedError("Execution limiting is not enabled");\n        }\n        if (t !== undefined) {\n            Sk.execLimit = Sk.builtin.asnum$(t);\n        }\n    });\n\n    sys.resetTimeout = new Sk.builtin.func(function () {\n        Sk.execStart = new Date();\n    });\n\n    sys.getYieldLimit = new Sk.builtin.func(function () {\n        if (Sk.yieldLimit === null) {\n            return Sk.builtin.none.none$;\n        }\n        return new Sk.builtin.int_(Sk.yieldLimit);\n    });\n\n    sys.setYieldLimit = new Sk.builtin.func(function (t) {\n        if (Sk.yieldLimit === null) {\n            throw new Sk.builtin.NotImplementedError("Yielding is not enabled");\n        }\n        if (t !== undefined) {\n            Sk.yieldLimit = Sk.builtin.asnum$(t);\n        }\n    });\n\n    sys.debug = new Sk.builtin.func(function () {\n        return Sk.builtin.none.none$;\n    });\n\n    sys.__stdout__ = new Sk.builtin.file(new Sk.builtin.str("/dev/stdout"), new Sk.builtin.str("w"));\n    sys.__stdin__ = new Sk.builtin.file(new Sk.builtin.str("/dev/stdin"), new Sk.builtin.str("r"));\n\n    sys.stdout = sys.__stdout__;\n    sys.stdin = sys.__stdin__;\n\n    return sys;\n};\n',"src/lib/functools.py":'raise NotImplementedError("functools is not yet implemented in Skulpt")\n',"src/lib/sre_constants.py":'raise NotImplementedError("sre_constants is not yet implemented in Skulpt")\n',"src/lib/cookielib.py":'raise NotImplementedError("cookielib is not yet implemented in Skulpt")\n',"src/lib/shelve.py":'raise NotImplementedError("shelve is not yet implemented in Skulpt")\n',"src/lib/compiler/__init__.py":'raise NotImplementedError("compiler is not yet implemented in Skulpt")\n',"src/lib/xmllib.py":'raise NotImplementedError("xmllib is not yet implemented in Skulpt")\n',"src/lib/meb/PeriodicElements.py":"class PeriodicElement:\n    def __init__(self, name, atomic_number, mw, symbol):\n        self.name = name\n        self.atomic_number = atomic_number\n        self.mw = mw\n        self.symbol = symbol\n\nperiodic_elements = {\n    'hydrogen': PeriodicElement('hydrogen', 1, 1.008, 'H'),\n    'helium': PeriodicElement('helium', 2, 4.003, 'He'),\n    'lithium': PeriodicElement('lithium', 3, 6.941, 'Li'),\n    'beryllium': PeriodicElement('beryllium', 4, 9.012, 'Be'),\n    'boron': PeriodicElement('boron', 5, 10.81, 'B'),\n    'carbon': PeriodicElement('carbon', 6, 12.01, 'C'),\n    'nitrogen': PeriodicElement('nitrogen', 7, 19.00, 'N'),\n    'oxygen': PeriodicElement('oxygen', 8, 16.00, 'O'),\n    'fluorine': PeriodicElement('fluorine', 9, 4.003, 'F'),\n    'neon': PeriodicElement('neon', 10, 20.18, 'Ne'),\n    'sodium': PeriodicElement('sodium', 11, 22.99, 'Na'),\n    'magnesium': PeriodicElement('magnesium', 12, 24.31, 'Mg'),\n    'aluminum': PeriodicElement('aluminum', 13, 26.98, 'Al'),\n    'silicon': PeriodicElement('silicon', 14, 28.09, 'Si'),\n    'phosphorus': PeriodicElement('phosphorus', 15, 30.97, 'P'),\n    'sulfur': PeriodicElement('sulfur', 16, 32.07, 'S'),\n    'chlorine': PeriodicElement('chlorine', 17, 35.45, 'Cl'),\n    'argon': PeriodicElement('argon', 18, 39.95, 'Ar'),\n    'potassium': PeriodicElement('potassium', 19, 39.10, 'K'),\n    'calcium': PeriodicElement('calcium', 20, 40.08, 'Ca'),\n    'scandium': PeriodicElement('scandium', 21, 44.96, 'Sc'),\n    'titanium': PeriodicElement('titanium', 22, 47.87, 'Ti'),\n    'vanadium': PeriodicElement('vanadium', 23, 50.94, 'V'),\n    'chromium': PeriodicElement('chromium', 24, 52.00, 'Cr'),\n    'manganese': PeriodicElement('manganese', 25, 54.94, 'Mn'),\n    'iron': PeriodicElement('iron', 26, 55.85, 'Fe'),\n    'cobalt': PeriodicElement('cobalt', 27, 58.93, 'Co'),\n    'nickel': PeriodicElement('nickel', 28, 58.69, 'Ni'),\n    'copper': PeriodicElement('copper', 29, 63.55, 'Cu'),\n    'zinc': PeriodicElement('zinc', 30, 65.41, 'Zn'),\n    'gallium': PeriodicElement('gallium', 31, 69.72, 'Ga'),\n    'germanium': PeriodicElement('germanium', 32, 72.64, 'Ge'),\n    'arsenic': PeriodicElement('arsenic', 33, 74.92, 'As'),\n    'selenium': PeriodicElement('selenium', 34, 78.96, 'Se'),\n    'bromine': PeriodicElement('bromine', 35, 79.90, 'Br'),\n    'krypton': PeriodicElement('krypton', 36, 83.80, 'Kr'),\n    'rubidium': PeriodicElement('rubidium', 37, 85.47, 'Rb'),\n    'strontium': PeriodicElement('strontium', 38, 87.62, 'Sr'),\n    'yttrium': PeriodicElement('yttrium', 39, 88.91, 'Y'),\n    'zirconium': PeriodicElement('zirconium', 40, 91.22, 'Zr'),\n    'niobium': PeriodicElement('niobium', 41, 92.91, 'Nb'),\n    'molybdenum': PeriodicElement('molybdenum', 42, 95.94, 'Mo'),\n    'technetium': PeriodicElement('technetium', 43, 98, 'Tc'),\n    'ruthenium': PeriodicElement('ruthenium', 44, 101.1, 'Ru'),\n    'rhodium': PeriodicElement('rhodium', 45, 102.9, 'Rh'),\n    'palladium': PeriodicElement('palladium', 46, 106.4, 'Pd'),\n    'silver': PeriodicElement('silver', 47, 107.9, 'Ag'),\n    'cadmium': PeriodicElement('cadmium', 48, 112.4, 'Cd'),\n    'indium': PeriodicElement('indium', 49, 114.8, 'In'),\n    'tin': PeriodicElement('tin', 50, 118.71, 'Sn'),\n    'antimony': PeriodicElement('antimony', 51, 121.8, 'Sb'),\n    'tellurium': PeriodicElement('tellurium', 52, 127.6, 'Te'),\n    'iodine': PeriodicElement('iodine', 53, 126.9, 'I'),\n    'xenon': PeriodicElement('xenon', 54, 131.3, 'Xe'),\n    'cesium': PeriodicElement('cesium', 55, 132.9, 'Cs'),\n    'barium': PeriodicElement('barium', 56, 137.3, 'Ba'),\n    'lanthanum': PeriodicElement('lanthanum', 57, 138.9, 'La'),\n    'cerium': PeriodicElement('cerium', 58, 140.1, 'Ce'),\n    'praseodymium': PeriodicElement('praseodymium', 59, 140.9, 'Pr'),\n    'neodymium': PeriodicElement('neodymium', 60, 144.2, 'Nd'),\n    'promethium': PeriodicElement('promethium', 61, 145, 'Pm'),\n    'samarium': PeriodicElement('samarium', 62, 150.4, 'Sm'),\n    'europium': PeriodicElement('europium', 63, 152.0, 'Eu'),\n    'gadolinium': PeriodicElement('gadolinium', 64, 157.3, 'Gd'),\n    'terbium': PeriodicElement('terbium', 65, 158.9, 'Tb'),\n    'dysprosium': PeriodicElement('dysprosium', 66, 162.5, 'Dy'),\n    'holmium': PeriodicElement('holmium', 67, 164.9, 'Ho'),\n    'erbium': PeriodicElement('erbium', 68, 167.3, 'Er'),\n    'thulium': PeriodicElement('thulium', 69, 168.9, 'Tm'),\n    'ytterbium': PeriodicElement('ytterbium', 70, 173.0, 'Yb'),\n    'lutetium': PeriodicElement('lutetium', 71, 175.0, 'Lu'),\n    'hafnium': PeriodicElement('hafnium', 72, 178.5, 'Hf'),\n    'tantalum': PeriodicElement('tantalum', 73, 180.9, 'Ta'),\n    'tungsten': PeriodicElement('tungsten', 74, 183.8, 'W'),\n    'rhenium': PeriodicElement('rhenium', 75, 186.2, 'Re'),\n    'osmium': PeriodicElement('osmium', 76, 190.2, 'Os'),\n    'iridium': PeriodicElement('iridium', 77, 192.2, 'Ir'),\n    'platinum': PeriodicElement('platinum', 78, 195.1, 'Pt'),\n    'gold': PeriodicElement('gold', 79, 197.0, 'Au'),\n    'mercury': PeriodicElement('mercury', 80, 200.6, 'Hg'),\n    'thallium': PeriodicElement('thallium', 81, 204.4, 'Tl'),\n    'lead': PeriodicElement('lead', 82, 207.2, 'Pb'),\n    'bismuth': PeriodicElement('bismuth', 83, 209.0, 'Bi'),\n    'polonium': PeriodicElement('polonium', 84, 209, 'Po'),\n    'astatine': PeriodicElement('astatine', 85, 210, 'At'),\n    'radon': PeriodicElement('radon', 86, 222, 'Rn'),\n    'francium': PeriodicElement('francium', 87, 223, 'Fr'),\n    'radium': PeriodicElement('radium', 88, 226, 'Ra'),\n    'actinium': PeriodicElement('actinium', 89, 227, 'Ac'),\n    'thorium': PeriodicElement('thorium', 90, 232.0, 'Th'),\n    'protactinium': PeriodicElement('protactinium', 91, 231.0, 'Pa'),\n    'uranium': PeriodicElement('uranium', 92, 238.0, 'U'),\n    'neptunium': PeriodicElement('neptunium', 93, 237, 'Np'),\n    'plutonium': PeriodicElement('plutonium', 94, 244, 'Pu'),\n    'americium': PeriodicElement('americium', 95, 243, 'Am'),\n    'curium': PeriodicElement('curium', 96, 247, 'Cm')\n}","src/lib/ConfigParser.py":'raise NotImplementedError("ConfigParser is not yet implemented in Skulpt")\n',"src/lib/pickle.py":'raise NotImplementedError("pickle is not yet implemented in Skulpt")\n',"src/lib/MimeWriter.py":'raise NotImplementedError("MimeWriter is not yet implemented in Skulpt")\n',"src/lib/code.py":'raise NotImplementedError("code is not yet implemented in Skulpt")\n',"src/lib/UserDict.py":'raise NotImplementedError("UserDict is not yet implemented in Skulpt")\n',"src/lib/PBArray/__init__.py":'# PBArray.py -------------------------------------------------------------------\n#\n# Made by Evan Olds for zyBooks/Wiley\n# Uploaded to GitHub May 2, 2025\n#\n# Note: This code is made to run in Skulpt, an in-browser Python implementation.\n# The following are NOT supported by Skulpt, and so are not used in this code:\n# - f-strings\n# - math.isfinite\n# - list class\'s clear() method\n#\n# Classes declared in this module:\n#   PBArrayCell\n#   PBArray\n\nimport math\nfrom PBCore import PBBox\nfrom PBCore import PBColors\nfrom PBCore import PBVector\nfrom PBCore import PBRenderable\n\n# PBArrayCell represents an individual cell/element in a PBArray. Immutable.\nclass PBArrayCell:\n    def __init__(self, value, bg_color_light = None, bg_color_dark = None):\n        self._value = value\n        # Set defaults for omitted colors\n        if bg_color_light == None:\n            bg_color_light = PBColors.get_light_mode_colors()["bg"]\n        if bg_color_dark == None:\n            bg_color_dark = PBColors.get_dark_mode_colors()["bg"]\n        self._bg_colors = [bg_color_light, bg_color_dark]\n    \n    def get_bg_color(self, optional_index = 0):\n        return self._bg_colors[optional_index]\n    \n    def get_value(self):\n        return self._value\n    \n    def get_value_string(self):\n        return str(self._value)\n    \n    def reset_bg_colors(self):\n        return PBArrayCell(self._value, PBColors.get_light_mode_colors()["bg"],\n            PBColors.get_dark_mode_colors()["bg"])\n    \n    def set_bg_colors(self, new_light, new_dark):\n        return PBArrayCell(self._value, new_light, new_dark)\n\nclass PBArray(PBRenderable):\n    def __init__(self, optional_data = None):\n        PBRenderable.__init__(self)\n        self._cells = []\n        self.render_info = {\n            "cellHeight": 24, # cell height, not including borders\n            "cellWidth": 24,  # cell width, not including borders\n            "borderSize": 2,\n            "defaultBorderColorDark": "rgb(255,255,255)",\n            "defaultBorderColorLight": "rgb(0,0,0)",\n            "fontSize": 16,\n            "highlightColorsLight": ["rgb(255,255,0)"],\n            "indexColumnWidth": 24, # used only when vertical\n            "indexFontColorDark": "rgb(200,200,200)",\n            "indexFontColorLight": "rgb(175,175,175)",\n            "label": None,\n            "labelWidth": 0,\n            "labelFontColorDark": "rgb(255,255,255)",\n            "labelFontColorLight": "rgb(0,0,0)",\n            "nameIsList": False,\n            "showIndices": False,\n            "textColorDark": "rgb(255,255,255)",\n            "textColorLight": "rgb(0,0,0)",\n            "vertical": False\n        }\n        if isinstance(optional_data, PBArray):\n            self._cells = list(optional_data._cells)\n            self.render_info = dict(optional_data.render_info)\n        elif isinstance(optional_data, list):\n            self.set_data(optional_data)\n    \n    def append(self, value):\n        new_cell = PBArrayCell(value)\n        self._cells.append(new_cell)\n        return self\n    \n    # Computes and sets the cell width to the width of the widest item plus a\n    # small amount of padding. Chooses a preset default size if the array is\n    # empty.\n    def auto_size_cell_width(self):\n        PADDING = 4\n        font_size = self.render_info["fontSize"]\n        # Across all our books an empty array box almost always has a width of\n        # at least 20 pixels. Hence the initialization to 20 below.\n        max_width = 20\n        # Compute max width of widest data value string\n        for cell in self._cells:\n            text = cell.get_value_string()\n            text_size = PBRenderable.measure_text(text, font_size)\n            max_width = max(max_width, text_size[0])\n        # Assign render_info["cellWidth"] with the max plus padding on sides\n        new_width = int(math.ceil(PADDING * 2 + max_width))\n        self.render_info["cellWidth"] = new_width\n        return self\n    \n    # Clears this array\'s content, resetting the length to 0. Returns self to\n    # allow chaining.\n    def clear(self):\n        self._cells = []\n        return self\n    \n    def get_alt_text(self):\n        if 0 == len(self._cells):\n            # Nothing is rendered for an empty array, so no alt text is needed\n            return ""\n        alt_text = ""\n        if isinstance(self.render_info["label"], str):\n            alt_text = \'Label "\' + self.render_info["label"] + \'" before \'\n            if self.render_info["nameIsList"]:\n                alt_text += "a list"\n            else:\n                alt_text += "an array"\n        else:\n            alt_text = "List" if self.render_info["nameIsList"] else "Array"\n        alt_text += " with " + str(len(self._cells)) + " element"\n        if len(self._cells) > 1:\n            alt_text += "s"\n        alt_text += ": " + self._cells[0].get_value_string()\n        for i in range(1, len(self._cells)):\n            alt_text += ", " + self._cells[i].get_value_string()\n        return alt_text + "."\n    \n    def get_cell_box(self, index):\n        cell_width = self.render_info["cellWidth"]\n        cell_height = self.render_info["cellHeight"]\n        center = self.get_cell_center_as_vector(index)\n        return PBBox(\n            center.x - cell_width / 2.0, center.y - cell_height / 2.0,\n            center.x + cell_width / 2.0, center.y + cell_height / 2.0)\n    \n    # Returns a PBVector for the center point of the cell at the specified\n    # index. The index argument must be in range.\n    def get_cell_center_as_vector(self, index):\n        border_size = self.render_info["borderSize"]\n        # Reminder: cell width and height values don\'t include borders\n        cell_width = self.render_info["cellWidth"]\n        cell_height = self.render_info["cellHeight"]\n        \n        if self.render_info["vertical"]:\n            # Vertical alignment mode:\n            x = border_size + cell_width / 2.0\n            if self.render_info["showIndices"]:\n                x += self.render_info["indexColumnWidth"]\n            top = border_size + index * (cell_height + border_size)\n            if isinstance(self.render_info["label"], str):\n                top += cell_height\n            return PBVector(x, top + cell_height / 2)\n        \n        # Horizontal alignment mode:\n        left = border_size + index * (cell_width + border_size)\n        if self.render_info["labelWidth"] > 0:\n            left += self.render_info["labelWidth"]\n        return PBVector(left + cell_width / 2, border_size + cell_height / 2)\n    \n    # Gets the height, in pixels, of a cell in this array. All cells are\n    # rendered with equal height.\n    def get_cell_height(self):\n        return self.render_info["cellHeight"]\n    \n    # Gets the width, in pixels, of a cell in this array. All cells are\n    # rendered with equal width.\n    def get_cell_width(self):\n        return self.render_info["cellWidth"]\n    \n    # Returns an RGB color string (ex: "rgb(175,175,175)") that indicates the\n    # color of index labels for this PBArray. The index labels are only shown\n    # if show-indices property is True. The set_show_indices() method can be\n    # called to set the show-indices property.\n    def get_index_font_color(self):\n        return self.render_info["indexFontColorLight"]\n    \n    # Returns the number of elements in this array.\n    def get_length(self):\n        return len(self._cells)\n    \n    # Returns a bool indicating whether or not "array" or "list" is used as the\n    # data structure\'s name in the alt text. True = "list", False = "array".\n    def get_name_is_list(self):\n        return self.render_info["nameIsList"]\n    \n    # Returns a dictionary with four items:\n    #\n    # "renderables":\n    #   A list of objects to render.\n    #\n    # "alt":\n    #   String for the render content\'s alt text.\n    #\n    # "renderables_dark":\n    #   A list of objects to render when in dark mode.\n    #\n    # "alt_dark":\n    #   String for the render content\'s alt text in dark mode.\n    def get_renderables(self):\n        border_size = self.render_info["borderSize"]\n        cell_width = self.render_info["cellWidth"]\n        cell_height = self.render_info["cellHeight"]\n        font_size = self.render_info["fontSize"]\n        lights = []\n        darks = []\n        LISTS = [lights, darks]\n        BORDERS = [\n            self.render_info["defaultBorderColorLight"],\n            self.render_info["defaultBorderColorDark"]\n        ]\n        TEXT_COLORS = [\n            self.render_info["textColorLight"],\n            self.render_info["textColorDark"]\n        ]\n        INDEX_FONT_COLORS = [\n            self.render_info["indexFontColorLight"],\n            self.render_info["indexFontColorDark"]\n        ]\n        LABEL_FONT_COLORS = [\n            self.render_info["labelFontColorLight"],\n            self.render_info["labelFontColorDark"]\n        ]\n        \n        for list_index in range(len(LISTS)):\n            # A "background" rectangle is used for all borders, both around all\n            # cells and in between cells.\n            left_top = self._get_bg_left_top_vector()\n            bg_width = len(self._cells) * (cell_width + border_size) + border_size\n            bg_height = cell_height + border_size * 2\n            if self.render_info["vertical"]:\n                bg_width = cell_width + border_size * 2\n                bg_height = (len(self._cells) * (cell_height + border_size) +\n                    border_size)\n            LISTS[list_index].append({\n                "renderType": "rectangle",\n                "left": left_top.x,\n                "top": left_top.y,\n                "width": bg_width,\n                "height": bg_height,\n                "backgroundColor": BORDERS[list_index]\n            })\n        \n            # Add a rectangle and text for each cell\n            for i in range(len(self._cells)):\n                cell_box = self.get_cell_box(i)\n                LISTS[list_index].append({\n                    "renderType": "rectangle",\n                    "centerX": cell_box.get_center_x(),\n                    "centerY": cell_box.get_center_y(),\n                    "width": cell_box.get_width(),\n                    "height": cell_box.get_height(),\n                    "backgroundColor": self._cells[i].get_bg_color(list_index)\n                })\n                LISTS[list_index].append({\n                    "renderType": "text",\n                    "centerX": cell_box.get_center_x(),\n                    "centerY": cell_box.get_center_y(),\n                    "color": TEXT_COLORS[list_index],\n                    "font": str(font_size) + "px sans-serif",\n                    "text": self._cells[i].get_value_string()\n                })\n                if self.render_info["showIndices"]:\n                    tcx = cell_box.get_center_x()\n                    tcy = cell_box.get_center_y() + cell_height\n                    if self.render_info["vertical"]:\n                        tcx -= (cell_box.get_width() / 2 +\n                            self.render_info["indexColumnWidth"] / 2)\n                        tcy = cell_box.get_center_y()\n                    LISTS[list_index].append({\n                        "renderType": "text",\n                        "centerX": tcx,\n                        "centerY": tcy,\n                        "color": INDEX_FONT_COLORS[list_index],\n                        "font": str(font_size - 4) + "px sans-serif",\n                        "text": str(i)\n                    })\n            # Add label, if needed\n            label_width = self.render_info["labelWidth"]\n            if label_width > 0 and isinstance(self.render_info["label"], str):\n                cell0_box = self.get_cell_box(0)\n                lcy = cell0_box.get_center_y()\n                if self.render_info["vertical"]:\n                    lcy = cell_height / 2\n                LISTS[list_index].append({\n                    "renderType": "text",\n                    "centerX": label_width / 2,\n                    "centerY": lcy,\n                    "color": LABEL_FONT_COLORS[list_index],\n                    "font": str(font_size) + "px sans-serif",\n                    "text": self.render_info["label"]\n                })\n        alt = self.get_alt_text()\n        return { "renderables": lights, "renderables_dark": darks,\n            "alt": alt, "alt_dark": alt }\n    \n    def get_show_indices(self):\n        return self.render_info["showIndices"]\n    \n    # Returns True or False, indicating if the PBArray is rendered vertically.\n    def get_vertical(self):\n        return self.render_info["vertical"]\n    \n    # Sets the background color(s) for a cell. Should NOT be used if a\n    # highlighting method like set_highlight1() can be used instead. Returns\n    # self to allow chaining.\n    def set_cell_background(self, index, bg_color_light, bg_color_dark = None):\n        # If no dark-mode color was given, use inverted light color\n        if bg_color_dark == None:\n            bg_color_dark = PBColors.invert(bg_color_light)\n        # Update the cell\n        self._cells[index] = self._cells[index].set_bg_colors(\n            bg_color_light, bg_color_dark)\n        return self\n    \n    def set_cell_height(self, new_height):\n        if new_height >= 1:\n            self.render_info["cellHeight"] = new_height\n        return self\n    \n    def set_cell_width(self, new_width):\n        if new_width >= 1:\n            self.render_info["cellWidth"] = new_width\n        return self\n    \n    # Sets this array\'s data. Clears out all existing content first and so\n    # resets all cell colors to defaults. Returns self to allow chaining.\n    def set_data(self, list_to_copy):\n        self.clear()\n        for element in list_to_copy:\n            new_cell = PBArrayCell(element)\n            self._cells.append(new_cell)\n        return self\n    \n    # Highlights a collection of cells, specified by the collection_of_indices\n    # argument, with a single color. Clears out any existing highlighting info\n    # first. Returns self to allow chaining.\n    def set_highlight1(self, collection_of_indices):\n        highlight_light = PBColors.get_light_mode_colors()["highlight1"]\n        highlight_dark = PBColors.get_dark_mode_colors()["highlight1"]\n        # Go through ALL cell indices. If the index is in collection_of_indices\n        # then change the cell\'s background to the highlight color. Otherwise\n        # restore cell\'s background to the default.\n        for i in range(len(self._cells)):\n            # Reminder: PBArrayCell objects are immutable\n            old_cell = self._cells[i]\n            if i in collection_of_indices:\n                self._cells[i] = old_cell.set_bg_colors(highlight_light,\n                    highlight_dark)\n            else:\n                self._cells[i] = old_cell.reset_bg_colors()\n        return self\n    \n    def set_index_font_color(self, light_color, dark_color = None):\n        if dark_color == None:\n            dark_color = PBColors.invert(light_color)\n        self.render_info["indexFontColorLight"] = light_color\n        self.render_info["indexFontColorDark"] = dark_color\n        return self\n    \n    # Sets a text label for this array, or removes the label if the label\n    # argument is None. Returns self to allow chaining.\n    def set_label(self, label, label_width=-1, label_font_color="rgb(0,0,0)"):\n        self.render_info["label"] = label\n        self.render_info["labelFontColorLight"] = label_font_color\n        \n        if label == None:\n            self.render_info["labelWidth"] = 0\n        elif label_width < 0:\n            # Width must be computed if the label_width argument is negative\n            label_size = PBRenderable.measure_text(label,\n                self.render_info["fontSize"])\n            PAD = 8\n            self.render_info["labelWidth"] = label_size[0] + PAD\n        else:\n            self.render_info["labelWidth"] = label_width\n        \n        return self\n    \n    # Sets a bool indicating whether or not "array" or "list" is used as the\n    # data structure\'s name in the alt text. True = "list", False = "array".\n    # Returns self to allow chaining.\n    def set_name_is_list(self, name_is_list):\n        self.render_info["nameIsList"] = name_is_list\n        return self\n    \n    # Sets a bool indicating whether or not element indices are shown. Returns\n    # self to allow chaining.\n    def set_show_indices(self, show_indices):\n        self.render_info["showIndices"] = show_indices\n        return self\n    \n    # Set\'s this PBArray\'s "vertical" property to True or False. If True, the\n    # array is rendered vertically. Otherwise, the array is rendered\n    # horizontally. Returns self to allow chaining.\n    def set_vertical(self, vertical):\n        self.render_info["vertical"] = vertical\n        return self\n    \n    def _get_bg_left_top_vector(self):\n        left = 0\n        top = 0\n        if self.render_info["vertical"]:\n            # Vertical alignment mode:\n            if self.render_info["showIndices"]:\n                left = self.render_info["indexColumnWidth"]\n            if isinstance(self.render_info["label"], str):\n                top = self.render_info["cellHeight"]\n        else:\n            # Horizontal alignment mode:\n            if self.render_info["labelWidth"] > 0:\n                left = self.render_info["labelWidth"]\n        return PBVector(left, top)\n',"src/lib/codecs.py":'raise NotImplementedError("codecs is not yet implemented in Skulpt")\n',"src/lib/tty.py":'raise NotImplementedError("tty is not yet implemented in Skulpt")\n',"src/lib/pythonds/graphs/adjGraph.py":'#\n#  adjGraph\n#\n#  Created by Brad Miller on 2005-02-24.\n#  Copyright (c) 2005 Brad Miller, David Ranum, Luther College. All rights reserved.\n#\n\nimport sys\nimport os\nimport unittest\n\nclass Graph:\n    def __init__(self):\n        self.vertices = {}\n        self.numVertices = 0\n        \n    def addVertex(self,key):\n        self.numVertices = self.numVertices + 1\n        newVertex = Vertex(key)\n        self.vertices[key] = newVertex\n        return newVertex\n    \n    def getVertex(self,n):\n        if n in self.vertices:\n            return self.vertices[n]\n        else:\n            return None\n\n    def __contains__(self,n):\n        return n in self.vertices\n    \n    def addEdge(self,f,t,cost=0):\n            if f not in self.vertices:\n                nv = self.addVertex(f)\n            if t not in self.vertices:\n                nv = self.addVertex(t)\n            self.vertices[f].addNeighbor(self.vertices[t],cost)\n    \n    def getVertices(self):\n        return list(self.vertices.keys())\n        \n    def __iter__(self):\n        return iter(self.vertices.values())\n                \nclass Vertex:\n    def __init__(self,num):\n        self.id = num\n        self.connectedTo = {}\n        self.color = \'white\'\n        self.dist = sys.maxsize\n        self.pred = None\n        self.disc = 0\n        self.fin = 0\n\n    # def __lt__(self,o):\n    #     return self.id < o.id\n    \n    def addNeighbor(self,nbr,weight=0):\n        self.connectedTo[nbr] = weight\n        \n    def setColor(self,color):\n        self.color = color\n        \n    def setDistance(self,d):\n        self.dist = d\n\n    def setPred(self,p):\n        self.pred = p\n\n    def setDiscovery(self,dtime):\n        self.disc = dtime\n        \n    def setFinish(self,ftime):\n        self.fin = ftime\n        \n    def getFinish(self):\n        return self.fin\n        \n    def getDiscovery(self):\n        return self.disc\n        \n    def getPred(self):\n        return self.pred\n        \n    def getDistance(self):\n        return self.dist\n        \n    def getColor(self):\n        return self.color\n    \n    def getConnections(self):\n        return self.connectedTo.keys()\n        \n    def getWeight(self,nbr):\n        return self.connectedTo[nbr]\n                \n    def __str__(self):\n        return str(self.id) + ":color " + self.color + ":disc " + str(self.disc) + ":fin " + str(self.fin) + ":dist " + str(self.dist) + ":pred \\n\\t[" + str(self.pred)+ "]\\n"\n    \n    def getId(self):\n        return self.id\n\nclass adjGraphTests(unittest.TestCase):\n    def setUp(self):\n        self.tGraph = Graph()\n        \n    def testMakeGraph(self):\n        gFile = open("test.dat")\n        for line in gFile:\n            fVertex, tVertex = line.split(\'|\')\n            fVertex = int(fVertex)\n            tVertex = int(tVertex)\n            self.tGraph.addEdge(fVertex,tVertex)\n        for i in self.tGraph:\n            adj = i.getAdj()\n            for k in adj:\n                print(i, k)\n\n        \nif __name__ == \'__main__\':\n    unittest.main()\n              \n',"src/lib/macurl2path.py":'raise NotImplementedError("macurl2path is not yet implemented in Skulpt")\n',"src/lib/new.py":'raise NotImplementedError("new is not yet implemented in Skulpt")\n',"src/lib/nturl2path.py":'raise NotImplementedError("nturl2path is not yet implemented in Skulpt")\n',"src/lib/_abcoll.py":'raise NotImplementedError("_abcoll is not yet implemented in Skulpt")\n',"src/lib/hotshot/__init__.py":'raise NotImplementedError("hotshot is not yet implemented in Skulpt")\n',"src/lib/urllib2.py":'raise NotImplementedError("urllib2 is not yet implemented in Skulpt")\n',"src/lib/atexit.py":'raise NotImplementedError("atexit is not yet implemented in Skulpt")\n',"src/lib/compileall.py":'raise NotImplementedError("compileall is not yet implemented in Skulpt")\n',"src/lib/symtable.py":'raise NotImplementedError("symtable is not yet implemented in Skulpt")\n',"src/lib/warnings.py":'raise NotImplementedError("warnings is not yet implemented in Skulpt")\n',"src/lib/keyword.py":"\n__all__ = [\"iskeyword\", \"kwlist\"]\n\nkwlist = [\n#--start keywords--\n        'and',\n        'as',\n        'assert',\n        'break',\n        'class',\n        'continue',\n        'def',\n        'del',\n        'elif',\n        'else',\n        'except',\n        'exec',\n        'finally',\n        'for',\n        'from',\n        'global',\n        'if',\n        'import',\n        'in',\n        'is',\n        'lambda',\n        'not',\n        'or',\n        'pass',\n        'print',\n        'raise',\n        'return',\n        'try',\n        'while',\n        'with',\n        'yield',\n#--end keywords--\n        ]\n\ndef iskeyword(wd):\n    return wd in kwlist\n\n","src/lib/timeit.py":'raise NotImplementedError("timeit is not yet implemented in Skulpt")\n',"src/lib/statistics/__init__.py":"import math\nfrom P_DF_and_T import p_df_ts\nfrom P_DF_and_Chi import p_df_chis\nfrom P_and_Z import p_zscores\nfrom P_from_f import p_from_f_0_25, p_from_f_010, p_from_f_005, p_from_f_0025, p_from_f_001\n\nclass StatisticsError(ValueError):\n    pass\n\ndef raise_error_if_not_enough_elements(num_elements, needed_elements, function_name):\n    '''\n    Raises a StatisticsError if |num_elements| is less than |needed_elements.\n\n    Keyword arguments:\n    num_elements -- The number of elements passed to the function.\n    needed_elements -- The minimum number of elements needed in the function.\n    function_name -- The function that called this function.\n    '''\n    if num_elements < needed_elements:\n        message = '%s requires at least %d data point(s).' % (function_name, needed_elements)\n        raise StatisticsError(message)\n\ndef mean(data):\n    '''\n    Return the arithmetic mean of data.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the mean.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 1, 'mean')\n    return sum(data) / float(num_elements)\n\ndef median(data):\n    '''\n    Return the median (middle value) of numeric data.\n\n    Keyword arguments:\n    data -- The sample from which to get the median.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 1, 'median')\n    data = sorted(data)\n    center_index = num_elements / 2\n    is_odd = (num_elements % 2) == 1\n\n    return data[center_index] if is_odd else mean([ data[center_index - 1], data[center_index] ])\n\ndef modes(data):\n    '''\n    Returns a list of the most common data points from data.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the mode.\n    '''\n    raise_error_if_not_enough_elements(len(data), 1, 'modes')\n    value_to_frequency = {}\n    for value in data:\n        value_to_frequency[value] = data.count(value)\n    max_frequency = max([ frequency for frequency in value_to_frequency.values() ])\n    return [ value for value in value_to_frequency if value_to_frequency[value] == max_frequency ]\n\ndef variance(data, calculated_mean=None):\n    '''\n    Return the variance of data.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the variance.\n    calculated_mean -- The arithmetic mean of data, if not given, it's calculated. Defaults to None.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 2, 'variance')\n    if calculated_mean is None:\n        calculated_mean = mean(data)\n\n    sum_of_mean_difference_squared = 0\n    for value in data:\n        sum_of_mean_difference_squared += math.pow((value - calculated_mean), 2)\n\n    return sum_of_mean_difference_squared / float(num_elements - 1)\n\ndef stdev(data, calculated_mean=None):\n    '''\n    Return the square root of the variance.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the standard deviation.\n    calculated_mean -- The arithmetic mean of data, if not given, it's calculated. Defaults to None.\n    '''\n    raise_error_if_not_enough_elements(len(data), 2, 'stdev')\n    return math.sqrt(variance(data, calculated_mean))\n\ndef mean_absolute_deviation(data, calculated_mean=None):\n    '''\n    Return the mean absolute deviation of a dataset.\n\n    Keyword arguments:\n    data -- The sample from which to calculate the mean absolute deviation.\n    calculated_mean -- The arithmetic mean of data, if not given it's calculated. Defaults to None.\n    '''\n    num_elements = len(data)\n    raise_error_if_not_enough_elements(num_elements, 2, 'mean_absolute_deviation')\n    if calculated_mean is None:\n        calculated_mean = mean(data)\n\n    sum_of_absolute_mean_difference = sum([ abs(value - calculated_mean) for value in data ])\n    return sum_of_absolute_mean_difference / float(num_elements)\n\ndef undefined_p_value_for_z_error(z_score):\n    raise StatisticsError('No defined p-value for z %f' % z_score)\n\ndef isclose(a, b, rel_tol=1e-09, abs_tol=0.0):\n    '''\n    Compares floating-point numbers.\n    '''\n    return abs(a-b) <= max(rel_tol * max(abs(a), abs(b)), abs_tol)\n\ndef find_p_from_z(z_score):\n    '''\n    Return the p-value for the given z-score.\n    Keyword argument:\n    z-score -- The z-score to find.\n    '''\n\n    if type(z_score) != float:\n        raise TypeError('Input for find_p_from_z must be a float')\n\n    # Ex: If z-score is 3.45, then |z_ones_and_tenths_places| is 3.4 and |z_hundredths_place| is 0.05.\n    z_ones_and_tenths_places = math.floor(z_score * 10) / 10.0\n    z_hundredths_place = z_score - z_ones_and_tenths_places\n\n    # Find p_zscore pairs wherein z_ones_and_tenths_places (index 1) is |z_ones_and_tenths_places|.\n    filter_for_z_ones_and_tenths_places = [ p_zscore for p_zscore in p_zscores if isclose(p_zscore[1], z_ones_and_tenths_places) ]\n    if not filter_for_z_ones_and_tenths_places:\n        undefined_p_value_for_z_error(z_score)\n\n    # Find p_zscore pairs wherein z_hundredths_place (index 0) is |z_hundredths_place|.\n    filter_for_z_hundredths_place = [ p_zscore for p_zscore in filter_for_z_ones_and_tenths_places if isclose(p_zscore[0], z_hundredths_place) ]\n    if not filter_for_z_hundredths_place:\n        undefined_p_value_for_z_error(z_score)\n\n    p_value = filter_for_z_hundredths_place[0][2]\n\n    return p_value\n\ndef undefined_p_value_for_df_and_statistic_error(degree_of_freedom, statistic_name, statistic_value):\n    raise StatisticsError(\n        'No defined p-value for df %d, %s %f' % (degree_of_freedom, statistic_name, statistic_value)\n    )\n\ndef _find_p_range_from_df_and_statistic(degree_of_freedom, statistic_name, statistic_value, table):\n    '''\n    Return the lower and upper-bound p-values for the given df, statistic, and table.x\n\n    Keyword arguments:\n    degree_of_freedom -- The degrees of freedom to find.\n    statistic_name -- The name of the statistic to find. Ex: chi-squared.\n    statistic_value -- The value of the statistic to find.\n    table -- The table from which to find. Ex: p_df_ts and p_df_chis.\n    '''\n\n    # Find rows wherein df (index 1) is |degree_of_freedom|.\n    filter_for_df = [ row for row in table if row[1] == degree_of_freedom ]\n    if not filter_for_df:\n        undefined_p_value_for_df_and_statistic_error(degree_of_freedom, statistic_name, statistic_value)\n\n    # Sort from smallest-to-largest statistic to make finding the lower- and upper-bound easier. Statistic is index 2.\n    filter_for_df.sort(key = lambda row: row[2])\n\n    # Find statistic greater than |statistic_value|.\n    larger_statistic_indices = [ index for index, row in enumerate(filter_for_df) if row[2] > statistic_value ]\n\n    lower_bound_index = len(filter_for_df)\n    lower_bound_p_value = 0\n    if larger_statistic_indices:\n        # The smallest of the larger statistics is the upper-bound statistic and lower-bound p (statistic and p are inversely correlated).\n        # p-value is at index 0.\n        lower_bound_index = larger_statistic_indices[0]\n        lower_bound_p_value = filter_for_df[lower_bound_index][0]\n\n    # The upper-bound p-value is at index 1 less than lower-bound.\n    upper_bound_index = lower_bound_index - 1\n    upper_bound_p_value = 1\n    if upper_bound_index >= 0:\n        upper_bound_p_value = filter_for_df[upper_bound_index][0]\n\n    return lower_bound_p_value, upper_bound_p_value\n\ndef find_p_range_from_df_and_t(degree_of_freedom, t_statistic):\n    '''\n    Refer to _find_p_range_from_df_and_statistic().\n    '''\n    return _find_p_range_from_df_and_statistic(degree_of_freedom, 't', t_statistic, p_df_ts)\n\ndef find_p_range_from_df_and_chi(degree_of_freedom, chi_squared_statistic):\n    '''\n    Refer to _find_p_range_from_df_and_statistic().\n    '''\n    return _find_p_range_from_df_and_statistic(degree_of_freedom, 'chi-squared', chi_squared_statistic, p_df_chis)\n    \nindex_map_alphas = [0.25, 0.10, 0.05, 0.025, 0.01]\n\ndef get_values_from_all_tables(df_n, df_d):\n    '''\n    Helper function to return f-stats from every table at the supplied df_n, df_d\n    '''\n    try:\n        index_1 = [i[0] for i in p_from_f_0_25][1:].index(df_d) + 1\n        index_2 = p_from_f_0_25[0].index(df_n) + 1\n    except ValueError:\n        raise ValueError('find_p_range_from_dfn_dfd_and_f_statistic: Degree of freedom out of range')\n\n    tables = [p_from_f_0_25, p_from_f_010, p_from_f_005, p_from_f_0025, p_from_f_001]\n    return [table[index_1][index_2] for table in tables]\n\ndef find_p_range_from_dfn_dfd_and_f_statistic(df_n, df_d, f_stat):\n    '''\n    Return the lower and upper-bound p-values for the given df_n, df_d, and f_statistic\n\n    Keyword arguments:\n    degree_of_freedom_n -- The degrees of freedom in the numerator to find.\n    degree_of_freedom_d -- The degrees of freedom in the denominator to find.\n    f_statistic -- The value of the f_statistic to find.\n\n    Values for this function come from tables in Mont 16.2.7 here:\n    https://learn.zybooks.com/zybook/AppliedStatisticsAndProbabilityForEngineersDev/chapter/16/section/2?content_resource_id=105620640 \n    '''\n    if type(df_n) is not int or type(df_d) is not int:\n        raise TypeError('find_p_range_from_dfn_dfd_and_f_statistic: Both degrees of freedom should be of type int')\n    if type(f_stat) not in [int, float]:\n        raise TypeError('find_p_range_from_dfn_dfd_and_f_statistic: f_stat should be of type int/float')\n    if f_stat < 0:\n        raise ValueError('find_p_range_from_dfn_dfd_and_f_statistic: f_stat should be non-negative')\n\n    # The f-stat is above or below the table's p-values\n    p_values = get_values_from_all_tables(df_n, df_d)\n    if f_stat < p_values[0]:\n        return 1.00, 0.25\n    if f_stat > p_values[4]:\n        return 0.01, 0.00\n\n    # Find the largest index, wherein the f-stat is larger than the table's p-value\n    lower_bound_index = max([index for index, p_value in enumerate(p_values) if p_value < f_stat])\n    return index_map_alphas[lower_bound_index], index_map_alphas[lower_bound_index + 1]\n\n","src/lib/meb/SaturatedWaterPressure.py":"class SaturatedWaterPressure:\n    def __init__(self, properties):\n        self.P = properties[0] # kPa\n        self.T = properties[1] # degrees C\n        self.vf = properties[2] # m^3/kg\n        self.vg = properties[3] # m^3/kg\n        self.uf = properties[4] # kJ/kg\n        self.ug = properties[5] # kJ/kg\n        self.ufg = properties[6] # kJ/kg\n        self.hf = properties[7] # kJ/kg\n        self.hg = properties[8] # kJ/kg\n        self.hfg = properties[9] # kJ/kg\n        self.sf = properties[10] # kJ/kg*K\n        self.sg = properties[11] # kJ/kg*K\n        self.sfg = properties[12] # kJ/kg*K\n\nsaturated_water_pressure_property_to_index = {\n    'P': 0,\n    'T': 1,\n    'vf': 2,\n    'vg': 3,\n    'uf': 4,\n    'ug': 5,\n    'ufg': 6,\n    'hf': 7,\n    'hg': 8,\n    'hfg': 9,\n    'sf': 10,\n    'sg': 11,\n    'sfg': 12,\n}\n\nsaturated_water_pressures = [\n    [ 0.6117, 0.01, 0.001000, 205.99, 0.0000, 2374.9, 2374.9, 0.00061178, 2500.9, 2500.9, 0.0000, 9.1555, 9.1555 ],\n    [ 1.0, 6.97, 0.001000, 129.18, 29.298, 2384.5, 2355.2, 29.299, 2513.7, 2484.4, 0.10591, 8.9749, 8.8690 ],\n    [ 1.5, 13.02, 0.001001, 87.959, 54.681, 2392.8, 2338.1, 54.683, 2524.7, 2470.0, 0.19556, 8.8270, 8.6314 ],\n    [ 2.0, 17.50, 0.001001, 66.987, 73.426, 2398.9, 2325.5, 73.428, 2532.9, 2459.5, 0.26056, 8.7226, 8.4620 ],\n    [ 2.5, 21.08, 0.001002, 54.240, 88.417, 2403.8, 2315.4, 88.420, 2539.4, 2451.0, 0.31182, 8.6420, 8.3302 ],\n    [ 3.0, 24.08, 0.001003, 45.653, 100.970, 2407.9, 2306.9, 100.980, 2544.8, 2443.8, 0.35429, 8.5764, 8.2221 ],\n    [ 4.0, 28.96, 0.001004, 34.791, 121.38, 2414.5, 2293.1, 121.39, 2553.7, 2432.3, 0.42239, 8.4734, 8.0510 ],\n    [ 5.0, 32.87, 0.001005, 28.185, 137.74, 2419.8, 2282.1, 137.75, 2560.7, 2423.0, 0.47620, 8.3938, 7.9176 ],\n    [ 7.5, 40.29, 0.001008, 19.233, 168.74, 2429.8, 2261.1, 168.75, 2574.0, 240
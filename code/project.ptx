<?xml version="1.0" encoding="utf-8"?>
<!--
    This file provides the overall configuration for your PreTeXt
    project. To edit the content of your document, open `source/main.ptx`
    (default location).
-->
<project>
  <targets>
    <!-- To build this target, run `pretext build web` -->
    <target name="web">
      <format>html</format>
      <source>source/main.ptx</source>
      <publication>publication/publication.ptx</publication>
      <output-dir>../worksheets-html</output-dir>
    </target>
    <target name="print" pdf-method="xelatex">
      <format>pdf</format>
      <source>source/main.ptx</source>
      <publication>publication/publication.ptx</publication>
      <output-dir>../worksheets-pdf</output-dir>
      <output-filename>worksheets-mat-2000.pdf</output-filename>
    </target>
    <target name="print-ch-2" pdf-method="xelatex">
      <format>pdf</format>
      <source>source/chapter_2_investigation_2.ptx</source>
      <publication>publication/publication-inv.ptx</publication>
      <output-dir>../intestigations-pdf</output-dir>
    </target>
    <target name="print-latex">
      <format>latex</format>
      <source>source/main.ptx</source>
      <publication>publication/publication.ptx</publication>
      <output-dir>../print-latex</output-dir>
    </target>
    <target name="solutions">
      <format>pdf</format>
      <source>source/main.ptx</source>
      <publication>publication/pub-solutions.ptx</publication>
      <output-dir>../ws-solutions</output-dir>
    </target>
    <target name="subset">
      <format>html</format>
      <source>source/main.ptx</source>
      <publication>publication/publication.ptx</publication>
      <output-dir>output/subset</output-dir>
      <stringparam key="debug.skip-knowls" value="yes"/>
      <!-- edit this to change the section/chapter/etc. to include
           in your subset build -->
      <xmlid-root>section_2_2</xmlid-root>
    </target>

var n=(0,t.createTemplateFactory)({id:"USj65Qt+",block:'[[[8,[39,0],[[24,0,"zybook-help-page"]],null,[["default"],[[[[1,"\\n    "],[10,"h1"],[12],[1,"zyLabs similarity checker"],[13],[1,"\\n    "],[10,2],[12],[1,"Instructors can generate a report that checks the similarity between each student’s latest, best submission of a specific zyLab. The report shows a list of submission pairs ordered by textual similarity, with the pairs having the highest similarity scores at the top."],[13],[1,"\\n\\n    "],[10,"h3"],[12],[1,"Generating and viewing a report"],[13],[1,"\\n    "],[10,2],[12],[1,"A similarity report can be generated by clicking "],[10,"b"],[12],[1,"Run similarity check"],[13],[1," in the "],[10,"b"],[12],[1,"Lab statistics and submissions"],[13],[1," expandable card."],[13],[1,"\\n    "],[10,"img"],[14,"alt","Use the \'Run similarity check\' button to activate the checker"],[14,"src","/assets/sim-checker-help-img1.png"],[12],[13],[1,"\\n\\n    "],[10,2],[12],[1,"You can re-run a report at any time. Only the latest, best submission of each student will be compared at the time the report is ran. Re-running a report will overwrite any previously generated report."],[13],[1,"\\n\\n    "],[10,2],[12],[1,"Once a report has been generated, click the report button text to view the results."],[13],[1,"\\n    "],[10,2],[12],[1,"Anonymize the names that will display in your report by ticking the “Anonymize names” checkbox. Selecting this option ensures that names are anonymized before you visit the report."],[13],[1,"\\n    "],[10,"img"],[14,"alt","Your last run similarity check will be displayed if available"],[14,"src","/assets/sim-checker-help-img2.png"],[12],[13],[1,"\\n\\n    "],[10,"h3"],[12],[1,"Reading a report"],[13],[1,"\\n    "],[10,2],[12],[1,"The top portion of a report shows pairs of submissions, where the most similar pair is at the top. Each row contains the student names and scores between 0 and 10 that represent the portion of code from one submission that appears in the other submission. The meaning of the numbers is described below in more detail - but essentially, a higher number indicates more similarity."],[13],[1,"\\n    "],[10,2],[12],[1,"Selecting a submission pair at the top will load both submissions for a more detailed review. If the lab consists of multiple files, those files are concatenated together."],[13],[1,"\\n    "],[10,2],[12],[1,"Names in the report can be instantly anonymized by ticking the “Anonymize names” checkbox."],[13],[1,"\\n    "],[10,"img"],[14,"alt","The Similarity Check report starts with a table of interesting results, sorted highest to lowest, clicking on a pair will show the differences highlighted"],[14,"src","/assets/sim-checker-help-img3.png"],[12],[13],[1,"\\n    "],[10,"img"],[14,"alt","The Similarity Check report starts with a table of interesting results, sorted highest to lowest, clicking on a pair will show the differences highlighted"],[14,"src","/assets/sim-checker-help-img4.png"],[12],[13],[1,"\\n\\n    "],[10,2],[12],[1,"Snippets of code that have been determined to be similar are highlighted. Use the \\"Jump To\\" snippet controls to single out matching snippets from each submission."],[13],[1,"\\n    "],[10,2],[12],[1,"There may be minor differences, especially around the start or end of a snippet, where highlighting may or may not exactly accurate. These differences do not factor into the score at the top of the report. Additionally, comments may be highlighted but do not contribute to the similarity score."],[13],[1,"\\n\\n    "],[10,"h3"],[12],[1,"Algorithmic details and information"],[13],[1,"\\n    "],[10,2],[12],[1,"Code similarity is determined using a custom variant of the "],[10,"i"],[12],[1,"winnowing"],[13],[1," algorithm, which generates a fingerprint of the submission by computing text hashes over a sliding window. The similarity score in the report is a custom metric derived from the percentage of matching hashes between submissions. zyBooks implements the following optimizations when computing the similarity score:"],[13],[1,"\\n    "],[10,"ul"],[12],[1,"\\n        "],[10,"li"],[12],[1,"Variable names are normalized - e.g., a submission containing "],[10,"i"],[12],[1,"foo = 1234"],[13],[1," will have the variable name \\"foo\\" normalized to a standard internal representation. Thus, simple modification of variable names can not subvert the similarity comparison."],[13],[1,"\\n        "],[10,"li"],[12],[1,"Comments in the code are normalized."],[13],[1,"\\n        "],[10,"li"],[12],[1,"Differences in whitespace are ignored."],[13],[1,"\\n        "],[10,"li"],[12],[1,"Instructor provided template code is ignored."],[13],[1,"\\n        "],[10,"li"],[12],[1,"Instructor provided read-only files are ignored."],[13],[1,"\\n    "],[13],[1,"\\n\\n    "],[10,"h3"],[12],[1,"Notes"],[13],[1,"\\n    "],[10,2],[12],[1,"Similarity checker reports may not be useful for certain types of zyLabs. Small zyLabs that require only a few lines of code will likely generate many false positive high-scoring submission pairs. Similarly, copy/paste of provided third party code not found in instructor-provided templates or files can lead to artificially high similarity scores. Instructors should carefully consider a zyLab\'s implementation details when using this feature."],[13],[1,"\\n    "],[10,2],[12],[1,"Similarity checker reports are not currently available for MATLAB zyLabs."],[13],[1,"\\n"]],[]]]]],[1,"\\n"]],[],false,["zb-card"]]',moduleName:"zybooks-web/zybook/sim-checker-help/template.hbs",isStrictMode:!1})

var n=(0,t.createTemplateFactory)({id:"09ldxCyn",block:'[[[10,"section"],[12],[1,"\\n    "],[10,"h3"],[12],[1,"Overview"],[13],[1,"\\n    "],[10,2],[14,0,"body-text"],[12],[1,"\\n        zyLabs is an assignment auto-grader, key features include:\\n    "],[13],[1,"\\n    "],[10,"ul"],[14,0,"body-text"],[12],[1,"\\n        "],[10,"li"],[12],[1,"\\n            "],[10,"b"],[12],[1,"IT Labs:"],[13],[1," The IT zyLabs provide a real-world learning experience for students by having them work inside virtual machines. The IT zyLabs provide students detailed steps with screenshots. Some IT zyLabs give students a scenario and provide students the opportunity to independently solve the IT zyLabs.\\n        "],[13],[1,"\\n        "],[10,"li"],[12],[1,"\\n            "],[10,"b"],[12],[1,"Virtual machines:"],[13],[1," Students can connect to virtual machines within the zyBooks platform. Both Windows and Linux labs are supported.\\n        "],[13],[1,"\\n        "],[10,"li"],[12],[1,"\\n            "],[10,"b"],[12],[1,"Integrated:"],[13],[1," zyLabs is a low-cost add-on to any zyBook, integrated into its chapters -- no extra logins, data transfers, etc.\\n        "],[13],[1,"\\n        "],[10,"li"],[12],[1,"\\n            "],[10,"b"],[12],[1,"Save and return:"],[13],[1," Virtual machine states are saved to allow students to complete a lab over multiple sessions.\\n        "],[13],[1,"\\n        "],[10,"li"],[12],[1,"\\n            "],[10,"b"],[12],[1,"Cost savings:"],[13],[1," Auto-grading saves instructors and departments time and money.\\n        "],[13],[1,"\\n        "],[10,"li"],[12],[1,"\\n            "],[10,"b"],[12],[1,"Use standalone:"],[13],[1," zyLabs can also be used standalone for classes using a different book or no book.\\n        "],[13],[1,"\\n    "],[13],[1,"\\n"],[13],[1,"\\n"]],[],false,[]]',moduleName:"zybooks-web/components/modals/about-zybook/itzylabs-about/template.hbs",isStrictMode:!1})

<exercise>
 <title> Question 3a</title>
<statement>
<p>Find and report the draft number assigned to your birthday.</p>
</statement>
</exercise>

<exercise>
 <title> Question 3b</title>
<statement>
<p>Is your draft number in the bottom third (1–122), middle third (123–244), or top third
(245–366)?</p>
</statement>
</exercise>


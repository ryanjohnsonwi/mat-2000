    <title>11-1 : Two quantitative variables: Scatterplot and correlation</title>
    <subtitle>MAT 2100: Introduction to Statistics</subtitle>
    <frontmatter>
      <titlepage>
        <event>Grace College</event>
        <date>Last updated <today/>
        </date>
      </titlepage>
